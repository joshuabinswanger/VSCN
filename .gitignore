# build output
dist/
.site-data.json
.site-data.json.tmp
gha-creds-*.json
# generated types
.astro/

# firebase deploy caches (hashes of the last uploaded dist/, regenerated on
# every deploy — noise in every diff and useless to anyone else)
.firebase/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# firebase emulator debug logs (npm run test:rules regenerates these)
firestore-debug.log
storage-debug.log
ui-debug.log


# environment variables
.env
.env.production
.env.development

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# pre-migration dumps written by scripts/migrate-image-records.mjs
scripts/snapshots/

# Serena MCP indexes and project cache — tooling state, not project source.
.serena/

# Claude Code per-machine permission grants. The tool rewrites this file on every
# approval and it fills with absolute paths from one developer machine, so it is
# local state, not project config. .claude/settings.json and launch.json are the
# shared ones and stay tracked.
.claude/settings.local.json
