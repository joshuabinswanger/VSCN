# Dev-project overrides, loaded by the Firebase CLI when deploying with -P dev.
# Without these, a staging profile save would dispatch the PRODUCTION deploy.
GITHUB_OWNER=joshuabinswanger
GITHUB_REPO=VSCN
GITHUB_WORKFLOW=firebase-hosting-staging.yml
GITHUB_REF=dev

# App Check via Cloudflare Turnstile. Dev runs on Cloudflare's always-pass TEST
# key pair; its siteverify answers with hostname example.com, hence the entry.
APP_CHECK_WEB_APP_ID=1:640269226461:web:658ca21c76db45f43f6634
TURNSTILE_ALLOWED_HOSTS=localhost,vscn-dev-f4b60.web.app,vscn-dev-f4b60.firebaseapp.com,example.com
