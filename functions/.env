# Non-secret deploy-time params for Cloud Functions (loaded by the Firebase CLI).
# The GitHub token is NOT here — it is a Secret Manager secret:
#   npx -y firebase-tools@latest functions:secrets:set GITHUB_REBUILD_TOKEN
GITHUB_OWNER=joshuabinswanger
GITHUB_REPO=VSCN

# Sender of the admin ping on account creation (functions/src/authTriggers.ts).
# Brevo honours it only once vscn.ch is authenticated in their dashboard. The
# API key and the RECIPIENT are Secret Manager secrets, not params — the repo
# is public and the recipient is a private mailbox:
#   npx -y firebase-tools@latest functions:secrets:set BREVO_API_KEY
#   npx -y firebase-tools@latest functions:secrets:set ADMIN_NOTIFY_TO
NOTIFY_FROM="VSCN <notifications@vscn.ch>"
