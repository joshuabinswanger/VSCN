# Non-secret deploy-time params for Cloud Functions (loaded by the Firebase CLI).
# The GitHub token is NOT here — it is a Secret Manager secret:
#   npx -y firebase-tools@latest functions:secrets:set GITHUB_REBUILD_TOKEN
GITHUB_OWNER=joshuabinswanger
GITHUB_REPO=VSCN

# Operator mail: the digest and the signup notice (functions/src/mail.ts).
# Host and sender are public facts; the mailbox password and the RECIPIENT are
# Secret Manager secrets, because the repo is public and the recipient is a
# private mailbox:
#   npx -y firebase-tools@latest functions:secrets:set INFOMANIAK_SMTP_PASSWORD
#   npx -y firebase-tools@latest functions:secrets:set ADMIN_NOTIFY_TO
#
# NOTIFY_FROM must be the mailbox that authenticates the SMTP session, or an
# alias of it — Infomaniak refuses to send as anything else. It still said
# notifications@vscn.ch on 2026-09-22, left over from Brevo, and nothing had
# noticed: the digest returns early when no event is due, so it had never
# actually sent. The first real signup after the release would have been the
# first send, and it would have failed.
#
# All three are listed even though the code carries the same defaults, because
# a non-interactive deploy refuses a param that has no value here.
NOTIFY_FROM="VSCN <info@vscn.ch>"
SMTP_HOST=mail.infomaniak.com
SMTP_USER=info@vscn.ch
