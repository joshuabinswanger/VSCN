{
  "name": "vscn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "format": "prettier --write src",
    "deploy:dev": "astro build --mode development && firebase deploy -P dev --only hosting",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-vscn-rules \"node --test tests/rules/**/*.test.mjs\""
  },
  "dependencies": {
    "astro": "^6.3.5",
    "embla-carousel": "^8.6.0",
    "firebase": "^12.12.0",
    "gsap": "^3.15.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.2",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "firebase-admin": "^13.8.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
