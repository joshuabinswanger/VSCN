{
  "name": "vscn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/export-site-data.mjs development && astro dev",
    "build": "npm run export:site-data && npm run build:site",
    "build:site": "node scripts/filter-site-images.mjs && astro build",
    "export:site-data": "node scripts/export-site-data.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "format": "prettier --write src",
    "deploy:dev": "node scripts/export-site-data.mjs development && npm run build:site -- --mode development && npx -y firebase-tools@latest deploy -P dev --only hosting",
    "worktree": "node scripts/new-worktree.mjs",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore,storage --project demo-vscn-rules \"node --test --test-concurrency=1 tests/rules/**/*.test.mjs\""
  },
  "dependencies": {
    "astro": "^7.3.2",
    "embla-carousel": "^8.6.0",
    "firebase": "^12.12.0",
    "gsap": "^3.15.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "firebase-admin": "^14.4.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
