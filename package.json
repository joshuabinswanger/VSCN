{
  "name": "vscn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/export-site-data.mjs development && astro dev",
    "build": "npm run export:site-data && npm run build:site",
    "build:site": "node scripts/filter-site-images.mjs && astro build",
    "export:site-data": "node scripts/export-site-data.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "format": "prettier --write src",
    "deploy:dev": "node scripts/export-site-data.mjs development && npm run build:site -- --mode development && npx -y firebase-tools@15.32.0 deploy -P dev --only hosting",
    "worktree": "node scripts/new-worktree.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:rules": "npm --prefix functions run build && npx -y firebase-tools@15.32.0 emulators:exec --config firebase.security-audit.json --only firestore,storage --project demo-vscn-rules \"node --test --test-concurrency=1 \\\"tests/rules/**/*.test.mjs\\\" \\\"tests/functions/*.test.cjs\\\"\"",
    "check": "astro check",
    "verify": "npm run lint && npm run check && npm run test:unit && npm run test:rules",
    "verify:release": "node scripts/verify-release.mjs",
    "walk:release": "node scripts/walk-release.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "embla-carousel": "^8.6.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "postcss-custom-media": "^12.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
