---
import { ClientRouter } from "astro:transitions";

// THE PAGE CHANGE (2026-10-12, Josh: "make a smooth animation when switching
// pages"). Only <main> moves: the old page fades out and lifts, the new one
// rises in from below; Back plays it reversed in direction. Both halves are
// WAAPI on the live <main> (the leave and enter sequences in the script
// below), NOT a view-transition name on <main> — see enterPage() for why.
import Navbar from "../components/Navbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageLoader from "../components/PageLoader.astro";
import favicon from "../assets/favicon.png";
import { BUILD_COMMIT, BUILD_TIME } from "../lib/buildInfo.ts";
import type { Lang } from "../i18n/utils.ts";
import ogImageAsset from "../assets/OG_Image.png";
import { alternateLinks, jsonLdScript } from "../lib/seo.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  fullscreen?: boolean;
  lang?: string;
  wide?: boolean;
  contentWide?: boolean;
  /** Absolute URL overriding the default OG image — e.g. a member's first work. */
  ogImage?: string;
  /**
   * Alias pages: canonical points here and a meta refresh sends the visitor
   * on. Static hosting has no 301, so this is the honest equivalent.
   */
  redirectTo?: string;
  /** Open Graph object type. A member's page is a `profile`; everything else is the site. */
  ogType?: "website" | "profile";
  /**
   * Structured data for this page, already shaped (see src/lib/seo.ts). The
   * layout only serialises it — safely, since every string in it is
   * member-authored.
   */
  jsonLd?: unknown;
}

const {
  title,
  description,
  noindex = false,
  fullscreen = false,
  lang = "en",
  wide = false,
  contentWide = false,
  ogImage,
  redirectTo,
  ogType = "website",
  jsonLd,
} = Astro.props;

const DEFAULT_DESCRIPTION =
  "VSCN — Visual Science Communication Network — brings together illustrators, scientists, designers, and storytellers dedicated to making knowledge visible.";

const metaDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(redirectTo ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? new URL(ogImageAsset.src, Astro.site).href;
// The other language's copy of this page (2026-09-10). Every public page is
// built twice, /x and /de/x, and until now nothing told a crawler the two were
// one page in two languages — so they could be read as duplicates, or the
// wrong one served. Computed from the canonical path so an alias page's
// alternates point at the current URL, like its canonical does. Not on noindex
// pages: an alternate of a page that asks not to be indexed is noise.
const alternates = noindex ? [] : alternateLinks(redirectTo ?? Astro.url.pathname, Astro.site!.href);

const BRAND_LETTERS = [
  { head: "V", tail: "isual" },
  { head: "S", tail: "cience" },
  { head: "C", tail: "ommunication" },
  { head: "N", tail: "etwork" },
];
// HOW MANY TIMES THE TITLE SAYS VSCN, AND WHY THE TWO NUMBERS DIFFER.
// The title is fitted to --shell-max (see fitBrandName), so its WIDTH is fixed
// and the repeat count is the only thing that decides its HEIGHT: more letters
// across the same measure means a smaller font, which means a shorter header.
// That is the whole lever. On a MacBook Pro 16 the four-repeat line stood 70px
// tall and read as oversized (2026-09-22, Josh: "the header should be smaller
// ... can we make on desktop to have more added vscnvscn so it is longer and
// less high"), so desktop gets six and the line drops to roughly 49px while
// still reaching both edges of the measure — the edge-to-edge fit is the
// design rule here and six repeats keeps it rather than breaking it.
// Mobile stays at four: there the measure is the phone's width, so six repeats
// would shrink the title past the point where it reads as a title at all.
// ONE VSCN (2026-10-12, Josh: "we also only want a VSCN and not the wide
// banner. it should still expand on hovering over the text", and "the header
// should be inline with the Menu buttons"). BRAND_COMPACT draws the title as a
// single copy at a fixed size at the left of a --header-h row, with the nav's
// MENU at the row's right end; the word overwrite on hover is unchanged. The
// repeat, fit and overshoot machinery below stays, switched off by these
// numbers, so the banner is a constant away.
const BRAND_COMPACT = true;
const BRAND_REPEATS_MOBILE = BRAND_COMPACT ? 1 : 4;
const BRAND_REPEATS_DESKTOP = BRAND_COMPACT ? 1 : 6;
// One slot per glyph position of the resting title, then a run of spill slots.
// Hovering a slot writes its tail OVER the slots that follow it, so the line
// rewrites itself in place instead of growing and shoving its neighbours
// sideways. A hover near the right end has fewer letters left to overwrite
// than its tail is long, so the word runs on into the spill slots — their
// resting glyph is empty (head ""), which measures zero wide until a word
// reaches them.
const BRAND_SPILL_COUNT = Math.max(...BRAND_LETTERS.map((l) => l.tail.length));
// THE TITLE FITS THE WINDOW, NOT THE MEASURE (2026-09-26, Josh: "the header is
// now too wide. we need to perfectly fit it to the viewport"). On desktop the
// line is a whole number of VSCNs, sized so the first V touches the left edge
// of the window and the last N the right: no letter cut, nothing hanging off.
// The COUNT is what changes with the window (initBrandRepeats picks it), so the
// letters stay about the size six repeats gave them across the 900px measure —
// BRAND_COPY_TARGET_PX, one VSCN's width at that size. The fit then settles the
// last few pixels, so the height steps a little as a copy is added or dropped
// rather than growing with the window.
// This replaced a day-old full-bleed version (fixed-size copies running past
// both edges, cut at the screen edge), which read as too wide.
// Accepted cost: on desktop the title's edges no longer line up with INFO /
// LOGIN and <main> — it is the one element of the three-way --shell-max
// contract that now answers to the window instead.
// Phones keep BRAND_REPEATS_MOBILE: there the measure already IS the window.
// To compare: ?wordmark=shell shows the old measure-fitted title and
// ?wordmark=fit brings this back, for the rest of the tab's session (see
// initWordmarkChoice). To revert: set BRAND_FIT_VIEWPORT to false.
const BRAND_FIT_VIEWPORT = true;
const BRAND_COPY_TARGET_PX = 145;
// OVERSHOOT (2026-09-26, Josh: "it should overshoot on the right a bit so when
// a word shorten the header it pulls in letters"). Wherever the line ends on
// the window's right edge — fitted to the window, and on every phone — this
// many further copies run on past that edge, where the ticker's clip hides
// them. They are not part of the fit: the last FITTED N still lands on the
// edge. They are there for the overwrite: a word is narrower than the capitals
// it writes over, so the line shortens while it shows, and without letters
// waiting off-screen that shortening opened a gap at the right end. With them
// the next letters slide in from the edge. One copy covers the worst case,
// "Communication" over twelve capitals, with room to spare.
// ?wordmark=shell has none: that line ends at the measure, inside the window,
// so letters past it would be seen.
const BRAND_OVERSHOOT_REPEATS = BRAND_COMPACT ? 0 : 1;
// Enough copies for a ~3500px window at the target size, plus the overshoot;
// wider than that the line keeps this many and the fit lets the letters grow.
const BRAND_POOL_REPEATS = BRAND_COMPACT ? 1 : 24 + BRAND_OVERSHOOT_REPEATS;
// The markup carries the whole pool, one slot per glyph, every slot tagged with
// its copy number. Without JS a desktop shows the first BRAND_REPEATS_DESKTOP
// (`.brand-slot--pool` is display:none) and a phone the first
// BRAND_REPEATS_MOBILE (`.brand-slot--wide` too) — the old title, never a
// screenful of letters at 8rem. initBrandRepeats then shows exactly the count
// it picked. Rendering the larger set and hiding part of it — rather than
// rendering per breakpoint — keeps this DOM a single server-rendered thing,
// which matters because .brand-ticker is transition:persist and survives every
// navigation.
// The spill slots stay AFTER the whole pool so they are reachable at every
// count; the JS walks the visible list, so a word overwritten near the right
// end never disappears into a hidden slot.
type BrandSlot = { head: string; tail: string; repeat: number };
const BRAND_SLOTS: BrandSlot[] = [
  ...Array.from({ length: BRAND_POOL_REPEATS }, (_, repeat) =>
    BRAND_LETTERS.map((letter) => ({ ...letter, repeat })),
  ).flat(),
  ...Array.from({ length: BRAND_SPILL_COUNT }, () => ({ head: "", tail: "", repeat: -1 })),
];---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The paper colour, so the browser's own furniture and any strip of canvas
        it exposes match the page instead of flashing white. See the shell note
        at the top of global.css. */}
    <meta name="theme-color" content="#fcfbfa" />

    {
      /* THE SHELL WATCHDOG. Inline and in the head on purpose: it has to have
        written --shell-h before the first paint, or the very load it exists to
        rescue is the one it misses. See the shell note at the top of
        global.css for what it is rescuing.
        `100dvh` is a promise about the toolbars that iOS does not always keep.
        window.visualViewport is the only thing that knows what is ACTUALLY
        visible, so the shell is sized from it and re-sized whenever it moves.
        Two things it must NOT react to, both of which shrink the visual
        viewport without shrinking the page:
          - the on-screen keyboard. Collapsing the shell into the keyboard's
            leftovers on every /login, /profile and /signup field would be a
            far worse bug than the one being fixed, so a focused editable
            suspends the sync and the last good height stands.
          - pinch zoom, where vv.height is a magnification artefact.
        The scroll nudge is separate and DEBOUNCED, because it must not fight a
        toolbar animation that is still running: only once the visual viewport
        has been still for a moment is a non-zero offset a stuck state rather
        than a gesture in progress. */
    }
    <script is:inline>
      (function () {
        const vv = window.visualViewport;
        if (!vv) return;
        const root = document.documentElement;
        // -1, not 0. In the head there is no layout yet and vv.height reads 0;
        // seeded with 0 the "nothing changed" guard below swallowed that first
        // measurement AND recorded it as synced, and no resize event follows a
        // first layout — so --shell-h was never written at all. Caught on the
        // dev server before this went anywhere near a phone.
        let last = -1;
        let settleTimer = 0;

        function editing() {
          const el = document.activeElement;
          if (!el) return false;
          const tag = el.tagName;
          return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || el.isContentEditable;
        }

        function sync() {
          if (window.matchMedia("(max-width: 767px)").matches) return;
          if (vv.scale !== 1 || editing()) return;
          const h = Math.round(vv.height);
          // A zero height is "not laid out yet", never a shell to adopt.
          if (h <= 0 || h === last) return;
          last = h;
          root.style.setProperty("--shell-h", h + "px");
        }

        function settle() {
          settleTimer = 0;
          if (vv.scale !== 1 || window.matchMedia("(max-width: 767px)").matches) return;
          // Parked past the page's own end, or above its start: the state from
          // the bug report. Nothing else can undo it, because a document with
          // `overflow: hidden` gives the reader nothing to scroll back with.
          if (vv.offsetTop !== 0 || window.scrollY !== 0) window.scrollTo(0, 0);
        }

        function onChange() {
          sync();
          if (settleTimer) clearTimeout(settleTimer);
          settleTimer = setTimeout(settle, 300);
        }

        // A view transition swaps the document and takes the inline style on
        // <html> with it, so --shell-h is GONE after every in-site navigation —
        // and `last` still holds the height that was just thrown away, so the
        // guard in sync() would call it a no-op and the shell would quietly
        // fall back to the 100dvh this exists to replace. Forget the cached
        // value, then measure again. (Verified against ClientRouter: without
        // this, one tap on COMMUNITY undid the fix for the rest of the visit.)
        function resync() {
          last = -1;
          sync();
        }

        sync();
        // The head-time measurement above is usually 0; this is the one that
        // actually lands, and sync() is idempotent so running it twice is free.
        document.addEventListener("DOMContentLoaded", sync);
        document.addEventListener("astro:after-swap", resync);
        document.addEventListener("astro:page-load", resync);
        vv.addEventListener("resize", onChange);
        vv.addEventListener("scroll", onChange);
        window.addEventListener("orientationchange", onChange);
        // Coming back from the bfcache is a fresh chance to be wrong.
        window.addEventListener("pageshow", onChange);
      })();
    </script>
    {
      /* DID THE BROWSER ANIMATE THIS BACK ITSELF? An iOS edge swipe shows the
        previous page sliding in before popstate fires, and says so on the
        event (hasUAVisualTransition). The router's own popstate listener runs
        before any listener added after it — same-target listeners fire in
        registration order — and it dispatches astro:before-preparation
        synchronously from inside it, so the flag has to be caught by a
        listener registered BEFORE the router's: this inline script, which
        runs ahead of every module. gestureHistory.ts reads the slot. */
    }
    <script is:inline>
      addEventListener("popstate", function (e) {
        window.__vscnPopstateUA = e.hasUAVisualTransition === true;
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="VSCN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      /* WHICH BUILD THIS IS (2026-09-03). Every page on this site is a
        build-time snapshot of Firestore, so "is what I am looking at current?"
        is a question anyone reviewing the deployed site has to be able to
        answer — and it used to take counting sitemap entries and asking the
        Hosting API for a release time. Now:
          curl -s https://…/community | grep 'name="build-'
        Not `noindex`-gated and not stripped in production on purpose: the
        whole value is that it is there on the page a reviewer actually opens.
        See src/lib/buildInfo.ts for what the values can be. */
    }
    <meta name="build-commit" content={BUILD_COMMIT} />
    <meta name="build-time" content={BUILD_TIME} />

    {
      /* set:html because a <script> body is not text content — Astro would
        entity-escape the quotes. jsonLdScript() is what makes that safe: it
        writes <, > and & as JSON escapes, so member-authored text cannot
        close this element. */
    }
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}

    <ClientRouter />
  </head>
  <body class:list={[{ "content-wide": contentWide }]}>
    <div
      class="brand-ticker"
      data-wordmark={BRAND_COMPACT ? "compact" : BRAND_FIT_VIEWPORT ? "fit" : "shell"}
      data-wordmark-default={BRAND_COMPACT ? "compact" : BRAND_FIT_VIEWPORT ? "fit" : "shell"}
      data-brand-copy-target={BRAND_COPY_TARGET_PX}
      data-brand-repeats-desktop={BRAND_REPEATS_DESKTOP}
      data-brand-repeats-mobile={BRAND_REPEATS_MOBILE}
      data-brand-overshoot={BRAND_OVERSHOOT_REPEATS}
      transition:persist
    >
      <a
        id="brand-home-link"
        href={lang === "de" ? "/de" : "/"}
        class="brand-link"
        aria-label="Visual Science Communication Network"
      >
        <span class="brand-name" id="brand-name" aria-hidden="true">
          {
            BRAND_SLOTS.map(({ head, tail, repeat }) => (
              <span
                class:list={[
                  "brand-slot",
                  {
                    "brand-slot--wide": repeat >= BRAND_REPEATS_MOBILE,
                    "brand-slot--pool": repeat >= BRAND_REPEATS_DESKTOP,
                  },
                ]}
                data-brand-tail={tail}
                data-brand-repeat={repeat}
              >
                <span class="brand-slot__rest">{head}</span>
                <span class="brand-slot__over" />
              </span>
            ))
          }
        </span>
      </a>
    </div>
    <PageLoader />
    <!-- Where App Check's Cloudflare Turnstile widget lives (src/lib/appCheckTurnstile.ts).
         Empty and invisible unless Cloudflare decides a visitor must click; persisted so the
         view-transition router does not throw the widget away between pages. -->
    <div id="turnstile-slot" class="turnstile-slot" transition:persist></div>
    <div class:list={["page-wrap", { "has-footer": !fullscreen }]}>
      <Navbar />
      {
        fullscreen ? (
          <slot />
        ) : (
          <main class:list={[{ "is-wide": wide }]}>
            <slot />
          </main>
        )
      }
      {/* Inside .page-wrap so it scrolls with the content and sits above the
          wrap's own bottom padding; the fullscreen hero keeps its edges. */}
      {!fullscreen && <SiteFooter lang={lang as Lang} />}
    </div>
  </body>
</html>

<style>
  .page-wrap {
    /* Named because a sticky child pins INSIDE this padding: ProfileForm's
       Save reads it back to cancel it out, and needs to follow any change. */
    --page-wrap-pad-bottom: 80px;
    padding-bottom: var(--page-wrap-pad-bottom);
  }

  /* The 80px is room for FIXED chrome to sit in at the end of the scroll — the
     desktop footer and the language toggle. On a phone neither floats any more
     wherever there is a footer (the footer is in the flow and carries the
     switch, see SiteFooter.astro), so the padding would only be blank paper
     under the last link. The landing hero has no footer and keeps its fixed
     toggle, so it keeps the 80px. */
  @media (--bp-mobile) {
    .brand-ticker { margin-top: 0; }
    .page-wrap.has-footer {
      --page-wrap-pad-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }

    /* THE FOOTER WAITS BELOW THE FIRST SCREEN (2026-09-27, Josh: "footer
       should only show on mobile if you scroll down, never from the
       beginning"). On a long page it already did. On a short one (the
       onboarding wizard, /profile before its form arrives, a tag filter that
       leaves one member) it stood in the middle of the first screen. So the
       content is never shorter than the scrollport, and the footer, which
       follows it with its own 3rem margin, starts past the bottom edge.
       Every page can therefore scroll at least far enough to reach it: the
       Impressum is always one short scroll away and never on screen at load.
       Layout rather than a scroll trigger on purpose: nothing to observe,
       nothing for iOS WebKit to get wrong, and it keeps working when the
       content grows after load. `100%` resolves because .page-wrap is a flex
       item with a definite height (body is the visual viewport's height). */
    .page-wrap.has-footer > main {
      min-height: 100%;
    }

    /* The fixed EN / DE toggle (Navbar.astro) gives way to the footer's copy
       on a phone — see the note there. Here because this is the component
       that knows the page has a footer. */
    .page-wrap.has-footer :global(.lang-toggle) {
      display: none;
    }
  }

  .brand-ticker {
    display: block;
    width: 100%;
    /* Shared with <main> and the navbar — see --shell-max in global.css. The
       15px inline padding matches main's, so the title's first glyph lands on
       the content edge rather than 15px outside it. fitBrandName subtracts
       this padding when it measures. */
    /* FULL WIDTH, PADDED BACK TO THE MEASURE (2026-09-25). The box spans the
       screen and the padding puts its CONTENT box exactly where the old
       max-width: var(--shell-max) + 15px padding put it — min(100% - 30px,
       870px), centred — so fitBrandName, which reads the padding back, fits the
       same title to the same edges. The box had to reach the screen edges so
       it can CLIP there (below). That is the ?wordmark=shell title; the
       default one fits the window and drops the padding (rule below). */
    padding: 0 max(15px, calc((100% - var(--shell-max)) / 2 + 15px));
    flex-shrink: 0;
    box-sizing: border-box;
    /* A word overwriting near the right end runs on past the last letter; it
       stops at the screen edge. `clip`, not `hidden`, and not left to
       body { overflow: hidden }: both of those still let a script, or
       find-in-page landing on an off-screen letter, scroll the page sideways.
       `clip` contributes no scrollable overflow at all, and on one axis only it
       leaves the flap turns free to overhang vertically. */
    overflow-x: clip;
    overflow-y: visible;
    /* THE TITLE IS A BANNER, NOT A FIXTURE — ON EVERY SIZE. It rides up out of
       the way as .page-wrap scrolls and hands that height to the content,
       leaving the navbar pinned at the top edge. --brand-hide is written by the
       scroll handler in the script below. margin-top does the whole job in one
       property: the ticker moves up by exactly the footprint it gives up, so
       .page-wrap (flex: 1) grows into the space with no gap in between.
       This was mobile-only until 2026-09-22, on the reasoning that only a phone
       could not spare the height. Desktop was given it too when the laptop
       screen turned out to be the same argument at a different scale (Josh,
       MacBook Pro 16: "make the header flip away on scrolling also on
       desktop") — a 16" panel is wide, not tall. */
    margin-top: calc(-1 * var(--brand-hide, 0px));
  }

  /* Fitted to the WINDOW — the default since 2026-09-26, see
     BRAND_FIT_VIEWPORT. No padding, so the content box is the window and the
     fit puts the first V and the last N on its two edges. */
  .brand-ticker[data-wordmark="fit"] {
    padding-inline: 0;
  }

  /* HOW MANY COPIES SHOW. The pool past BRAND_REPEATS_DESKTOP is hidden until
     initBrandRepeats picks a count; then --on / --off say which copies are in
     the line. display:none rather than zero width: the JS reads the visible
     slots back out of the DOM to build both the string it fits and the line it
     writes words along. Two classes each for the reason given in the mobile
     block below, and --on after --pool so it wins the tie; the mobile block
     comes after both, so a phone never shows a copy past its own count. */
  .brand-slot.brand-slot--pool {
    display: none;
  }

  .brand-slot.brand-slot--on {
    display: inline-grid;
  }

  .brand-slot.brand-slot--off {
    display: none;
  }

  @media (--bp-mobile) {
    .brand-ticker {
      /* Flush to the screen edges, like the navbar under it — on a phone the
         measure's 15px content edge only makes the title smaller. fitBrandName
         reads the padding off the element, so the fit follows on its own. */
      padding-inline: 0;
    }

    /* The repeats past BRAND_REPEATS_MOBILE exist in the markup at every size
       and are shown only where the measure is wide enough to carry them. This
       has to be `display: none` rather than zero width: the JS reads the
       visible slots back out of the DOM to build both the string it fits and
       the line it writes words along.
       BOTH CLASSES ARE NAMED ON PURPOSE. `.brand-slot` sets display:inline-grid
       and is declared further down this file, so a single-class rule here ties
       with it on specificity and LOSES on source order — which showed up as a
       phone rendering all six repeats at 21px while desktop was correct. The
       0,2,0 selector settles it wherever either rule ends up sitting. */
    .brand-slot.brand-slot--wide {
      display: none;
    }
  }

  /* The overshoot copies (see BRAND_OVERSHOOT_REPEATS). On a phone they are
     --wide copies, which the rule above hides; three classes outrank its two
     wherever the rules sit. */
  .brand-slot.brand-slot--on.brand-slot--overshoot {
    display: inline-grid;
  }

  /* THE COMPACT HEADER (BRAND_COMPACT): one row --header-h tall, the title at
     its left at a fixed size, the nav fixed over its right end (Navbar.astro).
     On a desktop the ticker stands above .page-wrap, and on a phone, where
     the document scrolls, it is sticky. Since 2026-10-19 it rides away on a
     scroll down and comes back on a scroll up (data-header-away, global.css).
     NO FILL (2026-10-13, Josh: "remove the background behind the VSCN title
     and the menu"): the row paints nothing, the page passes under the bare
     letters on a phone as it does under the nav on a desktop.
     The two numbers Josh tunes by eye are the custom properties on the row:
     the title's size and how far in from the screen's left edge it starts
     (2026-10-13: "smaller and a bit to the left", 30px at 15px -> 24px at
     8px on a desktop, 26px -> 20px on a phone). */
  .brand-ticker[data-wordmark="compact"] {
    --brand-compact-size: 24px;
    --brand-compact-inset: 8px;
    display: flex;
    align-items: center;
    height: var(--header-h);
    padding: 0 15px 0 var(--brand-compact-inset);
    margin-top: 0;
    overflow-x: clip;
  }
  .brand-ticker[data-wordmark="compact"] .brand-link {
    height: auto;
  }
  .brand-ticker[data-wordmark="compact"] .brand-name {
    font-size: var(--brand-compact-size);
    line-height: 1;
  }
  /* NO BAND ON A DESKTOP EITHER (2026-10-14, Josh: "on desktop the logo and
     menu buttons should not be over a filled BG bar at the top"). The row
     painted nothing, but it stood ABOVE .page-wrap, the desktop's scroller,
     so the paper between the title and the pills was a strip the content
     could never enter — a bar by position. Now the row floats over the
     scroller's top and .page-wrap starts at the window's top edge, padded
     down by the row's height, so the page passes under the bare letters as
     it does on a phone. Sticky children pin inside that padding (ProfileForm
     relies on the same for the bottom), so every sticky top keeps its place.
     Only the title takes pointer events; the empty row lets clicks through. */
  @media (--bp-desktop) {
    .brand-ticker[data-wordmark="compact"] {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 25;
      pointer-events: none;
    }
    .brand-ticker[data-wordmark="compact"] .brand-link {
      pointer-events: auto;
    }
    .brand-ticker[data-wordmark="compact"] ~ .page-wrap {
      padding-top: var(--header-h);
      scroll-padding-top: var(--header-h);
    }
  }
  @media (--bp-mobile) {
    .brand-ticker[data-wordmark="compact"] {
      /* 26px since 2026-10-20 (Josh: "VSCN bigger"), with the phone menu's
         40px lines under it; was 20px. */
      --brand-compact-size: 26px;
      position: sticky;
      top: 0;
      z-index: 25;
      padding: 0 8px 0 var(--brand-compact-inset);
      background: transparent;
    }
  }

  .brand-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .brand-link:visited {
    color: black;
  }

  .brand-name {
    display: block;
    font-size: 8rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
    /* No overflow clip here — a word overwriting near the right end is allowed
       to run past the 900px shell. */
    overflow: visible;
  }

  /* One slot per glyph position, holding the resting VSCN letter and the word
     letter that overwrites it. Exactly one of the two is ever open, the other
     clipped to zero width, so hovering V swaps the letters that follow it for
     "isual" in place — the line rewrites itself rather than growing and
     shoving its neighbours sideways.

     The slot is a GRID so the whitespace between its two children generates no
     boxes; formatted markup would otherwise put a real space between the two
     halves of one glyph. */
  .brand-slot {
    display: inline-grid;
    /* Both letters sit in the same cell, stacked and left-aligned, each at its
       own natural width. The cell's width is the thing JS animates, so neither
       letter is ever narrowed while it is turning. */
    justify-items: start;
    /* A beat is half a flip. The cell resizes on the second beat only, as the
       incoming letter drops in: on the first beat it has to stay the outgoing
       letter's width, or that letter would squeeze as it tips away. */
    --brand-flap-beat: 0.25s;
    --brand-flap-early: var(--brand-slot-delay, 0s);
    --brand-flap-late: calc(var(--brand-slot-delay, 0s) + var(--brand-flap-beat));
    transition-property: width;
    transition-duration: var(--brand-flap-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: var(--brand-flap-late);
    /* Every slot is one line of the same font and line-height, so aligning
       tops keeps the glyphs level without depending on how a grid box with
       overflow: hidden items synthesises its baseline. */
    vertical-align: top;
    /* The same shallow vanishing point GsapTextHeadline flips its words
       against, so a header letter and a hero letter turn through the same
       depth. Per slot, not per line: each letter flips about itself. */
    perspective: 12ch;
  }

  /* A slot showing a word letter must not be a hover target of its own —
     otherwise dragging the pointer along "isual" would fire S→cience halfway
     through and the two words would fight over the line. */
  .brand-slot--over {
    pointer-events: none;
  }

  /* The cell's width is a measured px value rather than the inline-grid
     0fr↔1fr collapse used elsewhere in this project because a transition
     cannot interpolate from `auto`, and every glyph a slot may show is a
     different width — so the target has to be a number JS knows.

     The letters turn like the flaps on a split-flap board, on the power3.inOut
     curve GsapTextHeadline turns its words with. The two turns do not overlap:
     the outgoing letter tips all the way away on the first beat, and only then
     does the incoming letter start dropping in, both the same way round so the
     pair reads as one continuous fall. The per-slot delay set by JS sends that
     flip across the line, left to right.

     Opacity never fades: it switches in zero time at the changeover, when both
     letters are edge-on and invisible anyway, so a letter stays solid ink the
     whole way down. */
  .brand-slot__rest,
  .brand-slot__over {
    /* Stacked, so the cell holds one letter's worth of space no matter which
       of the two is showing. */
    grid-area: 1 / 1;
    /* Each letter turns about its own centre rather than travelling, so the
       motion stays inside its line box: nothing needs clipping and no glyph
       sweeps down across the nav. */
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    transition-property: opacity, transform;
    transition-duration: 0s, var(--brand-flap-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Resting. Read these as the destination of the flip home: the word letter
     is the one tipping away, so it turns on the first beat and the resting
     letter drops in after it on the second. */
  .brand-slot__rest {
    opacity: 1;
    transform: rotateX(0deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-late);
  }

  .brand-slot__over {
    opacity: 0;
    transform: rotateX(-90deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-early);
  }

  /* Overwritten. The resting letter tips away on the first beat, the word
     letter drops in on the second. */
  .brand-slot--over .brand-slot__rest {
    opacity: 0;
    transform: rotateX(90deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-early);
  }

  .brand-slot--over .brand-slot__over {
    opacity: 1;
    transform: rotateX(0deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-late);
  }

  /* Re-measuring after a resize rewrites every resting width. Without this the
     new values would animate, so the title would visibly lag the window. */
  .brand-name--measuring .brand-slot,
  .brand-name--measuring .brand-slot__rest,
  .brand-name--measuring .brand-slot__over {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-slot,
    .brand-slot__rest,
    .brand-slot__over {
      transition: none;
    }

    .brand-slot__rest,
    .brand-slot__over {
      transform: none !important;
    }
  }
</style>

<script>
  // The directory's Portfolios deal, run on the incoming page before a swap
  // — on every page, because the directory's own script is not loaded yet.
  import "../lib/communityDealSwap.ts";
  // The history entry of every navigation is pushed INSIDE the tap, or iOS's
  // own Back skips it (gestureHistory.ts) — which also knows when the
  // browser has already animated a Back, the iOS edge swipe.
  import { browserAnimatedThisTraversal } from "../lib/gestureHistory.ts";

  type Lang = "en" | "de";

  function updateBrandHomeLink(lang: Lang) {
    const brandLink = document.getElementById("brand-home-link") as HTMLAnchorElement | null;
    if (!brandLink) return;
    brandLink.href = lang === "de" ? "/de" : "/";
  }

  let brandResizeObserver: ResizeObserver | null = null;

  // The slots the line currently shows: the copies initBrandRepeats switched
  // on, less whatever the breakpoint hides, plus the spill slots — and
  // everything downstream, the fit and the word-overwrite walk alike, has to
  // count the visible ones only. offsetParent is the read that asks the layout
  // rather than re-deriving the CSS: a slot inside a display:none rule has none.
  function visibleBrandSlots(brandName: HTMLElement): HTMLElement[] {
    return Array.from(brandName.querySelectorAll<HTMLElement>(".brand-slot")).filter(
      (slot) => slot.offsetParent !== null,
    );
  }

  // What the title reads when no word is written over it, at THIS width. Read
  // back off the DOM rather than handed down from the frontmatter, which could
  // only ever state one of the lengths. The overshoot copies are left out: they
  // are on the line but past the window's edge, so the fit must not count them.
  function restingBrandText(brandName: HTMLElement): string {
    return visibleBrandSlots(brandName)
      .filter((slot) => !slot.classList.contains("brand-slot--overshoot"))
      .map((slot) => slot.querySelector<HTMLElement>(".brand-slot__rest")?.textContent ?? "")
      .join("");
  }

  // HOW MANY VSCNs THE LINE HOLDS. On a phone, and for ?wordmark=shell, the
  // fixed counts from the frontmatter. Fitted to the window, as many copies as
  // fit at about BRAND_COPY_TARGET_PX each, so the fit that follows only has to
  // settle the remainder: the letters stay the size the desktop title has always
  // had, and the height steps slightly as the window crosses a copy boundary
  // instead of scaling with the window's width.
  // Whether this is a phone is asked of the layout, not re-derived from the
  // breakpoint: with the pool classes cleared, the mobile block's rule is the
  // only thing that can hide a `.brand-slot--wide` copy that is not in the pool.
  function applyBrandRepeats(ticker: HTMLElement, brandName: HTMLElement) {
    const slots = Array.from(brandName.querySelectorAll<HTMLElement>("[data-brand-repeat]")).filter(
      (slot) => Number(slot.dataset.brandRepeat) >= 0,
    );
    slots.forEach((slot) =>
      slot.classList.remove("brand-slot--on", "brand-slot--off", "brand-slot--overshoot"),
    );
    const probe = slots.find(
      (slot) =>
        slot.classList.contains("brand-slot--wide") && !slot.classList.contains("brand-slot--pool"),
    );
    const isPhone = probe ? probe.offsetParent === null : false;
    const mobile = Number(ticker.dataset.brandRepeatsMobile) || 4;
    const desktop = Number(ticker.dataset.brandRepeatsDesktop) || 6;
    const pool = slots.reduce((max, slot) => Math.max(max, Number(slot.dataset.brandRepeat) + 1), 0);
    // Copies past the right edge, where the line ends on it (see
    // BRAND_OVERSHOOT_REPEATS). Taken out of the pool first, so the widest
    // window still has them.
    if (ticker.dataset.wordmark === "compact") {
      slots.forEach((slot) => {
        const inLine = Number(slot.dataset.brandRepeat) === 0;
        slot.classList.toggle("brand-slot--on", inLine);
        slot.classList.toggle("brand-slot--off", !inLine);
      });
      return;
    }
    const endsOnWindowEdge = isPhone || ticker.dataset.wordmark === "fit";
    const overshoot = endsOnWindowEdge ? Number(ticker.dataset.brandOvershoot) || 0 : 0;
    let count = desktop;
    if (isPhone) {
      count = mobile;
    } else if (ticker.dataset.wordmark === "fit") {
      const cs = getComputedStyle(ticker);
      const available =
        ticker.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const target = Number(ticker.dataset.brandCopyTarget) || 145;
      count = Math.min(pool - overshoot, Math.max(mobile, Math.round(available / target)));
    }
    slots.forEach((slot) => {
      const repeat = Number(slot.dataset.brandRepeat);
      const inLine = repeat < count + overshoot;
      slot.classList.toggle("brand-slot--on", inLine);
      slot.classList.toggle("brand-slot--off", !inLine);
      slot.classList.toggle("brand-slot--overshoot", inLine && repeat >= count);
    });
  }

  // ?wordmark=shell | fit flips between the measure-fitted title and the
  // window-fitted one for the rest of the tab's session, so the two can be
  // compared on one deploy. Stored on the persisted ticker, not on <html>, whose
  // attributes every view transition replaces.
  const WORDMARK_KEY = "vscn:wordmark";
  function initWordmarkChoice(ticker: HTMLElement) {
    let choice: string | null = new URLSearchParams(location.search).get("wordmark");
    try {
      if (choice === "shell" || choice === "fit") sessionStorage.setItem(WORDMARK_KEY, choice);
      else choice = sessionStorage.getItem(WORDMARK_KEY);
    } catch {
      /* Private mode: the URL still works for this one page. */
    }
    // The compact title has one copy in its markup, so the banner modes have
    // nothing to show there; the choice only applies to a banner build.
    const fallback = ticker.dataset.wordmarkDefault ?? "shell";
    ticker.dataset.wordmark =
      fallback !== "compact" && (choice === "shell" || choice === "fit") ? choice : fallback;
  }

  function fitBrandName() {
    const el = document.getElementById("brand-name") as HTMLElement | null;
    if (!el) return;
    const ticker = el.closest<HTMLElement>(".brand-ticker");
    // The compact title is a fixed size (the CSS states it); nothing to fit.
    if (ticker?.dataset.wordmark === "compact") {
      el.style.fontSize = "";
      return;
    }
    el.style.fontSize = "8rem";
    if (!ticker) return;
    // clientWidth includes the ticker's inline padding; the text can only use
    // the content box, so subtract it or the title overflows by exactly the
    // padding and the last glyph is clipped.
    const cs = getComputedStyle(ticker);
    const available = ticker.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    // Measure with a text-only mirror rather than the live .brand-name, whose
    // width depends on the pixel widths JS has written onto every glyph —
    // measuring it would feed the fit its own previous output.
    const restingText = restingBrandText(el);
    if (!restingText) return;
    const mirror = document.createElement("span");
    mirror.textContent = restingText;
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:nowrap;left:0;top:0";
    el.appendChild(mirror);
    const textWidth = mirror.getBoundingClientRect().width;
    mirror.remove();
    if (available > 0 && textWidth > 0) {
      const current = parseFloat(getComputedStyle(el).fontSize);
      // 8rem is a CEILING, not a starting point: this fit shrinks the title to
      // the measure and never grows it past its design size. At the 900px
      // measure the shrink always runs, so the title fills the header exactly —
      // that is the production look, and the reason no page widens --shell-max.
      el.style.fontSize = `${Math.min(current, (current * available) / textWidth)}px`;
    }
  }

  // Seconds of delay added per slot, so the word flips itself across the line
  // rather than every letter turning at once.
  const BRAND_STAGGER_S = 0.025;
  // One letter's whole flip — both beats of --brand-flap-beat in the CSS above.
  // Kept in step with it by hand: JS needs the number to know when a word has
  // finished leaving the line.
  const BRAND_FLIP_S = 0.5;

  // Advance width of every glyph the title can show, at the current font size.
  let brandGlyphWidths = new Map<string, number>();
  let brandSlots: HTMLElement[] = [];
  let activeBrandOrigin: HTMLElement | null = null;
  // Two words must never be turning at the same time. This is the moment the
  // word currently leaving the line will have finished doing so.
  let brandRetractEndsAt = 0;
  let brandRetractTimer: ReturnType<typeof setTimeout> | null = null;
  let pendingBrandOrigin: number | null = null;

  // Measure every resting letter and every letter any word can write, then
  // pin the resting widths. Must run after fitBrandName has settled the font
  // size, and again whenever that size changes.
  function measureBrandGlyphs(brandName: HTMLElement) {
    const mirror = document.createElement("span");
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:pre;left:0;top:0";
    brandName.appendChild(mirror);

    const widths = new Map<string, number>();
    const widthOf = (char: string) => {
      let w = widths.get(char);
      if (w === undefined) {
        mirror.textContent = char;
        w = mirror.getBoundingClientRect().width;
        widths.set(char, w);
      }
      return w;
    };

    const slots = Array.from(brandName.querySelectorAll<HTMLElement>(".brand-slot"));
    slots.forEach((slot) => {
      const head = slot.querySelector<HTMLElement>(".brand-slot__rest")?.textContent ?? "";
      slot.dataset.brandRestWidth = String(head ? widthOf(head) : 0);
      // Any word can land on any slot, so the map needs every tail's letters,
      // not just this slot's.
      Array.from(slot.dataset.brandTail ?? "").forEach(widthOf);
    });

    mirror.remove();
    brandGlyphWidths = widths;

    brandName.classList.add("brand-name--measuring");
    slots.forEach((slot) => {
      if (slot.classList.contains("brand-slot--over")) return;
      restBrandSlot(slot);
    });
    // Flush the un-transitioned widths before motion is allowed back on.
    void brandName.offsetWidth;
    brandName.classList.remove("brand-name--measuring");
    // Those widths snapped rather than animating, so nothing is in flight and
    // the next hover must not be made to wait for a retraction that is over.
    brandRetractEndsAt = 0;
  }

  // Back to the resting VSCN letter. The width lives on the slot, not on the
  // two letters — they stay at their natural size so neither is squeezed mid-turn.
  function restBrandSlot(slot: HTMLElement) {
    slot.classList.remove("brand-slot--over");
    slot.style.width = `${slot.dataset.brandRestWidth ?? 0}px`;
  }

  // Show one letter of a word in place of the resting letter.
  function overwriteBrandSlot(slot: HTMLElement, char: string) {
    const over = slot.querySelector<HTMLElement>(".brand-slot__over");
    if (over) over.textContent = char;
    slot.style.width = `${brandGlyphWidths.get(char) ?? 0}px`;
    slot.classList.add("brand-slot--over");
  }

  // Send whatever word is showing back to VSCN, and record when that will be
  // done. The slots keep their per-slot delays, so the word unwinds left to
  // right exactly as it arrived — which is why the last letter to leave, not
  // the first, decides when the line is still again.
  function clearBrandOverwrite() {
    const brandName = document.getElementById("brand-name");
    const showing = brandName?.querySelectorAll<HTMLElement>(".brand-slot--over");
    if (showing?.length) {
      const lastLetterEnds = BRAND_FLIP_S + (showing.length - 1) * BRAND_STAGGER_S;
      brandRetractEndsAt = performance.now() + lastLetterEnds * 1000;
      showing.forEach(restBrandSlot);
    }
    activeBrandOrigin = null;
  }

  function cancelPendingBrandOverwrite() {
    pendingBrandOrigin = null;
    if (brandRetractTimer !== null) {
      clearTimeout(brandRetractTimer);
      brandRetractTimer = null;
    }
  }

  function runPendingBrandOverwrite() {
    brandRetractTimer = null;
    const next = pendingBrandOrigin;
    pendingBrandOrigin = null;
    if (next !== null) applyBrandOverwrite(brandSlots, next);
  }

  // Hovering a letter. If another word is still on the line, or still on its
  // way off it, this one waits its turn instead of flipping over the top of
  // it — sliding along the title queues words, it never overlays them. Only
  // the letter the pointer ended on gets spelled; anything crossed on the way
  // is replaced as the pending target, so a fast sweep costs one word, not one
  // per letter.
  function requestBrandOverwrite(originIndex: number) {
    const slot = brandSlots[originIndex];
    // Spill slots carry no tail, so they are never an origin.
    if (!slot?.dataset.brandTail) return;
    if (slot === activeBrandOrigin) return;

    clearBrandOverwrite();
    cancelPendingBrandOverwrite();
    const wait = brandRetractEndsAt - performance.now();
    if (wait <= 0) {
      applyBrandOverwrite(brandSlots, originIndex);
      return;
    }
    pendingBrandOrigin = originIndex;
    brandRetractTimer = setTimeout(runPendingBrandOverwrite, wait);
  }

  function leaveBrandName() {
    clearBrandOverwrite();
    cancelPendingBrandOverwrite();
  }

  // Write the hovered letter's tail over the slots that follow it.
  function applyBrandOverwrite(slots: HTMLElement[], originIndex: number) {
    const tail = slots[originIndex]?.dataset.brandTail ?? "";
    if (!tail) return;
    for (let i = 0; i < tail.length; i += 1) {
      const slot = slots[originIndex + 1 + i];
      // Out of slots entirely — can't happen while BRAND_SPILL_COUNT is the
      // longest tail, but a shorter pool should truncate, not throw.
      if (!slot) break;
      slot.style.setProperty("--brand-slot-delay", `${(i * BRAND_STAGGER_S).toFixed(3)}s`);
      overwriteBrandSlot(slot, tail[i]);
    }
    activeBrandOrigin = slots[originIndex];
  }

  function attachBrandOverwrite() {
    const brandName = document.getElementById("brand-name") as HTMLElement | null;
    if (!brandName) return;
    // .brand-ticker has transition:persist, so this DOM survives navigations —
    // guard against re-binding listeners on every astro:page-load.
    if (brandName.dataset.hoverAttached === "1") return;
    brandName.dataset.hoverAttached = "1";

    brandSlots = visibleBrandSlots(brandName);
    // Bound to every slot including the hidden ones, because a slot hidden now
    // is shown after a resize and these listeners are attached exactly once
    // (the ticker is transition:persist). The index is looked up at event time
    // against the CURRENT visible list, so it survives the breakpoint moving
    // under it; a slot that is not on that list resolves to -1, which
    // requestBrandOverwrite already treats as "no tail here, do nothing".
    Array.from(brandName.querySelectorAll<HTMLElement>(".brand-slot")).forEach((slot) => {
      slot.addEventListener("pointerenter", () => requestBrandOverwrite(brandSlots.indexOf(slot)));
    });

    // Cleared on leaving the whole line, not the individual slot: the letters a
    // word has written over are pointer-events: none, so sliding the pointer
    // along the word leaves the origin slot without meaning to end the hover.
    brandName.addEventListener("pointerleave", leaveBrandName);
  }

  function refreshBrandName() {
    const brandName = document.getElementById("brand-name") as HTMLElement | null;
    if (!brandName) return;
    const ticker = brandName.closest<HTMLElement>(".brand-ticker");
    if (ticker) applyBrandRepeats(ticker, brandName);
    fitBrandName();
    measureBrandGlyphs(brandName);
    // Crossing the mobile breakpoint changes which slots exist on the line, and
    // the walk is index-based — so the list is rebuilt on every refresh, not
    // just once when the listeners are bound.
    brandSlots = visibleBrandSlots(brandName);
  }

  function initBrandFit() {
    brandResizeObserver?.disconnect();
    const ticker = document.querySelector<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    initWordmarkChoice(ticker);
    refreshBrandName();
    attachBrandOverwrite();
    // observe() always reports once at the start, and refreshBrandName has
    // just run above: that first report re-fitted the title for nothing and
    // forced a second full layout of the page being arrived on — ~75–140ms
    // of a phone's arrival (2026-10-16, the Portfolios stutter). Only a size
    // that actually CHANGED does the work.
    let fitted = `${ticker.offsetWidth}x${ticker.offsetHeight}`;
    brandResizeObserver = new ResizeObserver(() => {
      const size = `${ticker.offsetWidth}x${ticker.offsetHeight}`;
      if (size === fitted) return;
      fitted = size;
      leaveBrandName();
      refreshBrandName();
      // The clamp on --brand-hide is the ticker's own height, and a resize is
      // exactly when that changes — crossing the mobile breakpoint swaps six
      // VSCNs for four and the line gets taller. This replaced a listener on
      // the breakpoint itself, which only caught the crossing and not the
      // continuous resizes either side of it.
      applyBrandHide();
    });
    brandResizeObserver.observe(ticker);
  }

  // ── Ride the title up out of the way on scroll ──
  // Mobile-only until 2026-09-22; see the --brand-hide note in the style block
  // above for why desktop was given the same behaviour.
  let brandScroller: HTMLElement | null = null;
  let brandHideFrame = 0;
  let leavingPage = false;

  // ── THE HEADER RIDES AWAY ON A SCROLL DOWN, BACK ON A SCROLL UP ──
  // (2026-10-19, Josh: "the navbar should move away on scrolling up".) The
  // scroll's DIRECTION, not its offset: past the row's own height, a few px
  // down puts data-header-away on <html> and the title row and the nav
  // slide up together (global.css); a few px up brings them back, and the
  // top always shows them. Not while a page is arriving or leaving: the
  // arrival places the scroll itself (Back to a member), and that would read
  // as a scroll down.
  let headerLastY = 0;
  function applyHeaderAway() {
    const root = document.documentElement;
    if (!brandScroller) return;
    const y = brandScroller.scrollTop;
    if (leavingPage || root.hasAttribute("data-arriving") || root.hasAttribute("data-arrive-hold")) {
      headerLastY = y;
      return;
    }
    const header = parseFloat(getComputedStyle(root).getPropertyValue("--header-h")) || 48;
    if (y <= header) delete root.dataset.headerAway;
    else if (y > headerLastY + 6) root.dataset.headerAway = "";
    else if (y < headerLastY - 6) delete root.dataset.headerAway;
    headerLastY = y;
  }

  function applyBrandHide() {
    brandHideFrame = 0;
    applyHeaderAway();
    const ticker = document.querySelector<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    // On mobile the ticker leaves naturally with document scrolling, and the
    // compact title never leaves at all.
    if (
      !brandScroller ||
      ticker.dataset.wordmark === "compact" ||
      window.matchMedia("(max-width: 767px)").matches
    ) {
      ticker.style.removeProperty("--brand-hide");
      return;
    }
    // offsetHeight is the border box, which the negative margin never touches —
    // so the clamp stays put instead of chasing its own output.
    const hidden = Math.max(0, Math.min(brandScroller.scrollTop, ticker.offsetHeight));
    ticker.style.setProperty("--brand-hide", `${hidden}px`);
  }

  function onBrandHideScroll() {
    // The leave sequence below owns the title while a page is being left.
    if (leavingPage) return;
    if (brandHideFrame) return;
    brandHideFrame = requestAnimationFrame(applyBrandHide);
  }

  // .page-wrap is replaced on every navigation (only the ticker is persisted),
  // so the listener has to be moved to the new scroller each time.
  function initBrandScrollHide() {
    brandScroller?.removeEventListener("scroll", onBrandHideScroll);
    window.removeEventListener("scroll", onBrandHideScroll);
    brandScroller = window.matchMedia("(max-width: 767px)").matches
      ? document.documentElement
      : document.querySelector<HTMLElement>(".page-wrap");
    if (brandScroller === document.documentElement) {
      window.addEventListener("scroll", onBrandHideScroll, { passive: true });
    }
    brandScroller?.addEventListener("scroll", onBrandHideScroll, { passive: true });
    // A new page starts with the header shown, whatever the last one did.
    delete document.documentElement.dataset.headerAway;
    headerLastY = brandScroller?.scrollTop ?? 0;
    applyBrandHide();
  }

  window.matchMedia("(max-width: 767px)").addEventListener("change", initBrandScrollHide);

  // ── EVERY ARRIVAL STARTS AT THE TOP ──
  // (2026-10-16, Josh: "you dont have to keep scroll position when switching
  // pages".) Back used to land where the page was left — offsets saved per
  // history entry in sessionStorage and re-applied after the swap (since
  // 2026-09-01) — and that re-application was the "portfolio page slides
  // around" on arrival. Now nothing is remembered. A desktop arrival is at
  // the top by construction (.page-wrap is a new element); on a phone the
  // DOCUMENT scrolls and ClientRouter restores its offset on Back, so a
  // traversal is put back at the top once the view transition is done (the
  // router's own restore, and the browser's, can land as late as that).
  let arrivalWasTraverse = false;
  let scrollTransitionDone: Promise<unknown> = Promise.resolve();
  let scrollNavigation = 0;

  // ── LEAVING A PAGE: FINISH THE OLD MOTION, THEN SWAP ──
  // (2026-10-12, Josh: "the animation trips up because of the disappearing
  // header. check that animations are done before switching page".) The
  // title rides away as a page scrolls, and a new page starts at the top, so
  // the swap used to bring the title back in the same frame the content
  // started moving — and the view transition's group for <main> slid the new
  // page from the OLD page's scrolled position to its own, which is the
  // stumble. Now the leave is a sequence the router waits for: the old page
  // fades out where it stands, the title comes back (sliding down on a
  // desktop; on a phone, where the document itself scrolls, the scroll is
  // reset under the invisible page and the title fades in), and only then is
  // the swap allowed. The loader is wrapped, so the fetch runs in parallel
  // and the swap waits for whichever finishes last. With nothing left
  // moving, the new page only rises (global.css stops the group's slide).
  // Same-path navigations (the directory's view switches) keep their own
  // behaviour, and reduced motion skips all of it.
  const LEAVE_MS = 220;
  const TITLE_MS = 260;

  function leavePage(): Promise<void> {
    const main = document.querySelector<HTMLElement>(".page-wrap main");
    const ticker = document.querySelector<HTMLElement>(".brand-ticker");
    if (!main || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return Promise.resolve();
    }
    leavingPage = true;
    const phone = window.matchMedia("(max-width: 767px)").matches;
    const fade = main
      .animate(
        // A PLAIN FADE since 2026-10-20: the translate made WebKit's scroll
        // follow it on a phone (the page's saved offset came back wrong).
        [{}, { opacity: 0 }],
        { duration: LEAVE_MS, easing: "cubic-bezier(.5,0,.9,.4)", fill: "forwards" }
      )
      .finished.then(() => {});
    let title: Promise<void> = Promise.resolve();
    // The compact title never leaves the screen, so there is nothing to bring
    // back; the old page only fades.
    if (ticker?.dataset.wordmark === "compact") {
      // nothing
    } else if (ticker && !phone && (parseFloat(ticker.style.getPropertyValue("--brand-hide")) || 0) > 0) {
      ticker.style.transition = `margin-top ${TITLE_MS}ms cubic-bezier(.2,.7,.2,1)`;
      ticker.style.setProperty("--brand-hide", "0px");
      title = new Promise<void>((resolve) => setTimeout(resolve, TITLE_MS)).then(() => {
        ticker.style.transition = "";
      });
    } else if (ticker && phone && window.scrollY > 0) {
      title = fade.then(() => {
        window.scrollTo({ top: 0, behavior: "instant" });
        return ticker
          .animate([{ opacity: 0 }, { opacity: 1 }], { duration: TITLE_MS, easing: "ease-out" })
          .finished.then(() => {});
      });
    }
    return Promise.all([fade, title])
      .then(() => {})
      .catch(() => {});
  }

  document.addEventListener("astro:before-preparation", (event) => {
    if (event.to.pathname === event.from.pathname) return;
    // An iOS edge swipe has already shown the page coming back; fading the
    // one just left on top of that shows it a second time.
    if (browserAnimatedThisTraversal()) return;
    const load = event.loader;
    event.loader = async () => {
      await Promise.all([load(), leavePage()]);
    };
  });

  // ── ARRIVING: THE NEW PAGE RISES IN ──
  // This used to be <main>'s transition:name + transition:animate, and that
  // was the flash (2026-10-14, Josh: "on page transitions there is still this
  // weird flashing"). A named element is lifted out of the page into its own
  // ::view-transition-group, which the browser paints ABOVE the root snapshot
  // — and the paper grain (body::before, a multiply overlay) lives in the
  // root. So for the whole 620ms rise the content showed bare, un-grained and
  // brighter, and the grain snapped back over it the moment the transition
  // ended. Animating the live <main> instead keeps it in the root, under the
  // grain, the whole way. Same keyframes, same curve.
  const ENTER_MS = 620;
  // A PLAIN FADE AFTER A FIXED PAUSE (2026-10-20, Josh: "replace the initial
  // painting of the site after a short delay of 500ms it should then start
  // fading in"). Until then the page rose out of a translate + scale + blur,
  // held until fonts, pictures and two calm frames (cap 1.4s): the translate
  // made WebKit's scroll follow it on a phone, and the variable hold was
  // never quite the same twice. Now the arriving page is invisible for
  // exactly this long after the swap and then only fades. data-arrive-hold
  // on <html> holds the Portfolios entrance too (CommunityGrid.astro), and
  // each card then waits for its own picture (pagesEntrance.ts).
  const ARRIVE_DELAY_MS = 500;
  // No element morphs across this pause any more: the card's picture and
  // name used to carry view-transition names into the member page, and
  // WebKit paints a named element at full strength under an opacity-0
  // ancestor, so on an iPhone they flew in, vanished with the transition,
  // and faded back in (2026-10-20; MemberWork.astro).

  document.addEventListener("astro:after-swap", () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const main = document.querySelector<HTMLElement>(".page-wrap main");
    if (!main) return;
    // The browser animated this Back itself (the iOS edge swipe): the page
    // is already on screen, so no hold and no fade — a blank half second
    // after the swipe would read as the page failing to come back.
    if (browserAnimatedThisTraversal()) return;
    // NO SNAPPING WHILE THE PAGE ARRIVES (2026-10-15, the Portfolios
    // flutter; global.css only snaps while <html> carries no data-arriving).
    const root = document.documentElement;
    root.dataset.arriving = "";
    // A PAGE THAT PAINTS ITSELF IN (2026-10-20, the member page): the same
    // pause, no whole-page fade — its head builds up piece by piece once
    // data-arrive-hold is gone (profilePaint.ts), and it holds its own
    // start state from the first frame (profile.css).
    if (main.querySelector("[data-paints-in]")) {
      root.dataset.arriveHold = "";
      setTimeout(() => {
        delete root.dataset.arriveHold;
        delete root.dataset.arriving;
      }, ARRIVE_DELAY_MS);
      return;
    }
    const enter = main.animate([{ opacity: 0 }, { opacity: 1 }], {
      duration: ENTER_MS,
      easing: "cubic-bezier(0.22, 0.61, 0.36, 1)",
      fill: "backwards",
    });
    enter.pause();
    root.dataset.arriveHold = "";
    setTimeout(() => {
      delete root.dataset.arriveHold;
      if (enter.playState === "paused") enter.play();
    }, ARRIVE_DELAY_MS);
    enter.finished.catch(() => {}).finally(() => delete root.dataset.arriving);
  });

  document.addEventListener("astro:before-swap", (event) => {
    const swapEvent = event as unknown as {
      newDocument?: Document;
      navigationType?: string;
      viewTransition?: { finished: Promise<void> };
    };
    arrivalWasTraverse = swapEvent.navigationType === "traverse";
    scrollNavigation++;
    scrollTransitionDone = swapEvent.viewTransition?.finished.catch(() => {}) ?? Promise.resolve();
    const newLang = swapEvent.newDocument?.documentElement?.lang === "de" ? "de" : "en";
    updateBrandHomeLink(newLang);
    swapEvent.newDocument?.getElementById("page-loader")?.remove();
  });

  document.addEventListener("astro:page-load", () => {
    leavingPage = false;
    const lang = document.documentElement.lang === "de" ? "de" : "en";
    updateBrandHomeLink(lang);
    initBrandFit();
    initBrandScrollHide();
    const navigation = scrollNavigation;
    if (arrivalWasTraverse && window.matchMedia("(max-width: 767px)").matches) {
      // At once, before the first frame shows the router's restored offset,
      // and again once the transition is done, in case it lands later.
      // Not when the page placed itself: Back to Portfolios returns to the
      // member left (data-scroll-kept, communityDirectoryController.ts).
      const toTop = () => {
        if (document.documentElement.hasAttribute("data-scroll-kept")) return;
        if (navigation === scrollNavigation && window.scrollY !== 0) {
          window.scrollTo({ top: 0, behavior: "instant" });
        }
      };
      toTop();
      void scrollTransitionDone.then(() => requestAnimationFrame(toTop));
    }
    // On client-side navigation there's no loader, so start animations immediately
    if (!document.getElementById("page-loader")) {
      document.body.classList.add("page-loaded");
    }
  });
</script>
