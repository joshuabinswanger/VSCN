---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import PageLoader from "../components/PageLoader.astro";
import favicon from "../assets/favicon.png";
import ogImageAsset from "../assets/OG_Image.png";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  fullscreen?: boolean;
  lang?: string;
  wide?: boolean;
  contentWide?: boolean;
  /** Absolute URL overriding the default OG image — e.g. a member's first work. */
  ogImage?: string;
}

const {
  title,
  description,
  noindex = false,
  fullscreen = false,
  lang = "en",
  wide = false,
  contentWide = false,
  ogImage,
} = Astro.props;

const DEFAULT_DESCRIPTION =
  "VSCN — Visual Science Communication Network — brings together illustrators, scientists, designers, and storytellers dedicated to making knowledge visible.";

const metaDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? new URL(ogImageAsset.src, Astro.site).href;

const BRAND_LETTERS = [
  { head: "V", tail: "isual" },
  { head: "S", tail: "cience" },
  { head: "C", tail: "ommunication" },
  { head: "N", tail: "etwork" },
];
const BRAND_REPEATS = 4;
const BRAND_RESTING_TEXT = BRAND_LETTERS.map((l) => l.head)
  .join("")
  .repeat(BRAND_REPEATS);
// One slot per glyph position of the resting title, then a run of spill slots.
// Hovering a slot writes its tail OVER the slots that follow it, so the line
// rewrites itself in place instead of growing and shoving its neighbours
// sideways. A hover near the right end has fewer letters left to overwrite
// than its tail is long, so the word runs on into the spill slots — their
// resting glyph is empty (head ""), which measures zero wide until a word
// reaches them.
const BRAND_SPILL_COUNT = Math.max(...BRAND_LETTERS.map((l) => l.tail.length));
const BRAND_SLOTS = [
  ...Array.from({ length: BRAND_REPEATS }, () => BRAND_LETTERS).flat(),
  ...Array.from({ length: BRAND_SPILL_COUNT }, () => ({ head: "", tail: "" })),
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VSCN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
  </head>
  <body class:list={[{ "content-wide": contentWide }]}>
    <div class="brand-ticker" transition:persist>
      <a
        id="brand-home-link"
        href={lang === "de" ? "/de" : "/"}
        class="brand-link"
        aria-label="Visual Science Communication Network"
      >
        <span
          class="brand-name"
          id="brand-name"
          data-resting-text={BRAND_RESTING_TEXT}
          aria-hidden="true"
        >
          {
            BRAND_SLOTS.map(({ head, tail }) => (
              <span class="brand-slot" data-brand-tail={tail}>
                <span class="brand-slot__rest">{head}</span>
                <span class="brand-slot__over" />
              </span>
            ))
          }
        </span>
      </a>
    </div>
    <PageLoader />
    <div class="page-wrap">
      <Navbar />
      {
        fullscreen ? (
          <slot />
        ) : (
          <main class:list={[{ "is-wide": wide }]}>
            <slot />
          </main>
        )
      }
    </div>
  </body>
</html>

<style>
  .page-wrap {
    padding-bottom: 80px;
  }

  .brand-ticker {
    display: block;
    width: 100%;
    /* Shared with <main> and the navbar — see --shell-max in global.css. The
       15px inline padding matches main's, so the title's first glyph lands on
       the content edge rather than 15px outside it. fitBrandName subtracts
       this padding when it measures. */
    max-width: var(--shell-max);
    margin: auto;
    /* overflow: visible so a word overwriting near the right end can run on
       into the empty space next to the 900px shell instead of being clipped
       at the shell edge. body { overflow: hidden } in global.css catches any
       horizontal spill at the viewport edge, so we can't grow a scrollbar. */
    overflow: visible;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 0 15px;
  }

  .brand-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .brand-link:visited {
    color: black;
  }

  .brand-name {
    display: block;
    font-size: 8rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
    /* No overflow clip here — a word overwriting near the right end is allowed
       to run past the 900px shell. */
    overflow: visible;
  }

  /* One slot per glyph position, holding the resting VSCN letter and the word
     letter that overwrites it. Exactly one of the two is ever open, the other
     clipped to zero width, so hovering V swaps the letters that follow it for
     "isual" in place — the line rewrites itself rather than growing and
     shoving its neighbours sideways.

     The slot is a GRID so the whitespace between its two children generates no
     boxes; formatted markup would otherwise put a real space between the two
     halves of one glyph. */
  .brand-slot {
    display: inline-grid;
    /* Both letters sit in the same cell, stacked and left-aligned, each at its
       own natural width. The cell's width is the thing JS animates, so neither
       letter is ever narrowed while it is turning. */
    justify-items: start;
    /* A beat is half a flip. The cell resizes on the second beat only, as the
       incoming letter drops in: on the first beat it has to stay the outgoing
       letter's width, or that letter would squeeze as it tips away. */
    --brand-flap-beat: 0.25s;
    --brand-flap-early: var(--brand-slot-delay, 0s);
    --brand-flap-late: calc(var(--brand-slot-delay, 0s) + var(--brand-flap-beat));
    transition-property: width;
    transition-duration: var(--brand-flap-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: var(--brand-flap-late);
    /* Every slot is one line of the same font and line-height, so aligning
       tops keeps the glyphs level without depending on how a grid box with
       overflow: hidden items synthesises its baseline. */
    vertical-align: top;
    /* The same shallow vanishing point GsapTextHeadline flips its words
       against, so a header letter and a hero letter turn through the same
       depth. Per slot, not per line: each letter flips about itself. */
    perspective: 12ch;
  }

  /* A slot showing a word letter must not be a hover target of its own —
     otherwise dragging the pointer along "isual" would fire S→cience halfway
     through and the two words would fight over the line. */
  .brand-slot--over {
    pointer-events: none;
  }

  /* The cell's width is a measured px value rather than the inline-grid
     0fr↔1fr collapse used elsewhere in this project because a transition
     cannot interpolate from `auto`, and every glyph a slot may show is a
     different width — so the target has to be a number JS knows.

     The letters turn like the flaps on a split-flap board, on the power3.inOut
     curve GsapTextHeadline turns its words with. The two turns do not overlap:
     the outgoing letter tips all the way away on the first beat, and only then
     does the incoming letter start dropping in, both the same way round so the
     pair reads as one continuous fall. The per-slot delay set by JS sends that
     flip across the line, left to right.

     Opacity never fades: it switches in zero time at the changeover, when both
     letters are edge-on and invisible anyway, so a letter stays solid ink the
     whole way down. */
  .brand-slot__rest,
  .brand-slot__over {
    /* Stacked, so the cell holds one letter's worth of space no matter which
       of the two is showing. */
    grid-area: 1 / 1;
    /* Each letter turns about its own centre rather than travelling, so the
       motion stays inside its line box: nothing needs clipping and no glyph
       sweeps down across the nav. */
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    transition-property: opacity, transform;
    transition-duration: 0s, var(--brand-flap-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Resting. Read these as the destination of the flip home: the word letter
     is the one tipping away, so it turns on the first beat and the resting
     letter drops in after it on the second. */
  .brand-slot__rest {
    opacity: 1;
    transform: rotateX(0deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-late);
  }

  .brand-slot__over {
    opacity: 0;
    transform: rotateX(-90deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-early);
  }

  /* Overwritten. The resting letter tips away on the first beat, the word
     letter drops in on the second. */
  .brand-slot--over .brand-slot__rest {
    opacity: 0;
    transform: rotateX(90deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-early);
  }

  .brand-slot--over .brand-slot__over {
    opacity: 1;
    transform: rotateX(0deg);
    transition-delay: var(--brand-flap-late), var(--brand-flap-late);
  }

  /* Re-measuring after a resize rewrites every resting width. Without this the
     new values would animate, so the title would visibly lag the window. */
  .brand-name--measuring .brand-slot,
  .brand-name--measuring .brand-slot__rest,
  .brand-name--measuring .brand-slot__over {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-slot,
    .brand-slot__rest,
    .brand-slot__over {
      transition: none;
    }

    .brand-slot__rest,
    .brand-slot__over {
      transform: none !important;
    }
  }
</style>

<script>
  type Lang = "en" | "de";

  function updateBrandHomeLink(lang: Lang) {
    const brandLink = document.getElementById("brand-home-link") as HTMLAnchorElement | null;
    if (!brandLink) return;
    brandLink.href = lang === "de" ? "/de" : "/";
  }

  let brandResizeObserver: ResizeObserver | null = null;

  function fitBrandName() {
    const el = document.getElementById("brand-name") as HTMLElement | null;
    if (!el) return;
    el.style.fontSize = "8rem";
    const ticker = el.closest<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    // clientWidth includes the ticker's inline padding; the text can only use
    // the content box, so subtract it or the title overflows by exactly the
    // padding and the last glyph is clipped.
    const cs = getComputedStyle(ticker);
    const available = ticker.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    // Measure with a text-only mirror rather than the live .brand-name, whose
    // width depends on the pixel widths JS has written onto every glyph —
    // measuring it would feed the fit its own previous output.
    const restingText = el.dataset.restingText ?? "";
    if (!restingText) return;
    const mirror = document.createElement("span");
    mirror.textContent = restingText;
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:nowrap;left:0;top:0";
    el.appendChild(mirror);
    const textWidth = mirror.getBoundingClientRect().width;
    mirror.remove();
    if (available > 0 && textWidth > 0) {
      const current = parseFloat(getComputedStyle(el).fontSize);
      // 8rem is a CEILING, not a starting point: this fit shrinks the title to
      // the measure and never grows it past its design size. At the 900px
      // measure the shrink always runs, so the title fills the header exactly —
      // that is the production look, and the reason no page widens --shell-max.
      el.style.fontSize = `${Math.min(current, (current * available) / textWidth)}px`;
    }
  }

  // Seconds of delay added per slot, so the word flips itself across the line
  // rather than every letter turning at once.
  const BRAND_STAGGER_S = 0.025;
  // One letter's whole flip — both beats of --brand-flap-beat in the CSS above.
  // Kept in step with it by hand: JS needs the number to know when a word has
  // finished leaving the line.
  const BRAND_FLIP_S = 0.5;

  // Advance width of every glyph the title can show, at the current font size.
  let brandGlyphWidths = new Map<string, number>();
  let brandSlots: HTMLElement[] = [];
  let activeBrandOrigin: HTMLElement | null = null;
  // Two words must never be turning at the same time. This is the moment the
  // word currently leaving the line will have finished doing so.
  let brandRetractEndsAt = 0;
  let brandRetractTimer: ReturnType<typeof setTimeout> | null = null;
  let pendingBrandOrigin: number | null = null;

  // Measure every resting letter and every letter any word can write, then
  // pin the resting widths. Must run after fitBrandName has settled the font
  // size, and again whenever that size changes.
  function measureBrandGlyphs(brandName: HTMLElement) {
    const mirror = document.createElement("span");
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:pre;left:0;top:0";
    brandName.appendChild(mirror);

    const widths = new Map<string, number>();
    const widthOf = (char: string) => {
      let w = widths.get(char);
      if (w === undefined) {
        mirror.textContent = char;
        w = mirror.getBoundingClientRect().width;
        widths.set(char, w);
      }
      return w;
    };

    const slots = Array.from(brandName.querySelectorAll<HTMLElement>(".brand-slot"));
    slots.forEach((slot) => {
      const head = slot.querySelector<HTMLElement>(".brand-slot__rest")?.textContent ?? "";
      slot.dataset.brandRestWidth = String(head ? widthOf(head) : 0);
      // Any word can land on any slot, so the map needs every tail's letters,
      // not just this slot's.
      Array.from(slot.dataset.brandTail ?? "").forEach(widthOf);
    });

    mirror.remove();
    brandGlyphWidths = widths;

    brandName.classList.add("brand-name--measuring");
    slots.forEach((slot) => {
      if (slot.classList.contains("brand-slot--over")) return;
      restBrandSlot(slot);
    });
    // Flush the un-transitioned widths before motion is allowed back on.
    void brandName.offsetWidth;
    brandName.classList.remove("brand-name--measuring");
    // Those widths snapped rather than animating, so nothing is in flight and
    // the next hover must not be made to wait for a retraction that is over.
    brandRetractEndsAt = 0;
  }

  // Back to the resting VSCN letter. The width lives on the slot, not on the
  // two letters — they stay at their natural size so neither is squeezed mid-turn.
  function restBrandSlot(slot: HTMLElement) {
    slot.classList.remove("brand-slot--over");
    slot.style.width = `${slot.dataset.brandRestWidth ?? 0}px`;
  }

  // Show one letter of a word in place of the resting letter.
  function overwriteBrandSlot(slot: HTMLElement, char: string) {
    const over = slot.querySelector<HTMLElement>(".brand-slot__over");
    if (over) over.textContent = char;
    slot.style.width = `${brandGlyphWidths.get(char) ?? 0}px`;
    slot.classList.add("brand-slot--over");
  }

  // Send whatever word is showing back to VSCN, and record when that will be
  // done. The slots keep their per-slot delays, so the word unwinds left to
  // right exactly as it arrived — which is why the last letter to leave, not
  // the first, decides when the line is still again.
  function clearBrandOverwrite() {
    const brandName = document.getElementById("brand-name");
    const showing = brandName?.querySelectorAll<HTMLElement>(".brand-slot--over");
    if (showing?.length) {
      const lastLetterEnds = BRAND_FLIP_S + (showing.length - 1) * BRAND_STAGGER_S;
      brandRetractEndsAt = performance.now() + lastLetterEnds * 1000;
      showing.forEach(restBrandSlot);
    }
    activeBrandOrigin = null;
  }

  function cancelPendingBrandOverwrite() {
    pendingBrandOrigin = null;
    if (brandRetractTimer !== null) {
      clearTimeout(brandRetractTimer);
      brandRetractTimer = null;
    }
  }

  function runPendingBrandOverwrite() {
    brandRetractTimer = null;
    const next = pendingBrandOrigin;
    pendingBrandOrigin = null;
    if (next !== null) applyBrandOverwrite(brandSlots, next);
  }

  // Hovering a letter. If another word is still on the line, or still on its
  // way off it, this one waits its turn instead of flipping over the top of
  // it — sliding along the title queues words, it never overlays them. Only
  // the letter the pointer ended on gets spelled; anything crossed on the way
  // is replaced as the pending target, so a fast sweep costs one word, not one
  // per letter.
  function requestBrandOverwrite(originIndex: number) {
    const slot = brandSlots[originIndex];
    // Spill slots carry no tail, so they are never an origin.
    if (!slot?.dataset.brandTail) return;
    if (slot === activeBrandOrigin) return;

    clearBrandOverwrite();
    cancelPendingBrandOverwrite();
    const wait = brandRetractEndsAt - performance.now();
    if (wait <= 0) {
      applyBrandOverwrite(brandSlots, originIndex);
      return;
    }
    pendingBrandOrigin = originIndex;
    brandRetractTimer = setTimeout(runPendingBrandOverwrite, wait);
  }

  function leaveBrandName() {
    clearBrandOverwrite();
    cancelPendingBrandOverwrite();
  }

  // Write the hovered letter's tail over the slots that follow it.
  function applyBrandOverwrite(slots: HTMLElement[], originIndex: number) {
    const tail = slots[originIndex]?.dataset.brandTail ?? "";
    if (!tail) return;
    for (let i = 0; i < tail.length; i += 1) {
      const slot = slots[originIndex + 1 + i];
      // Out of slots entirely — can't happen while BRAND_SPILL_COUNT is the
      // longest tail, but a shorter pool should truncate, not throw.
      if (!slot) break;
      slot.style.setProperty("--brand-slot-delay", `${(i * BRAND_STAGGER_S).toFixed(3)}s`);
      overwriteBrandSlot(slot, tail[i]);
    }
    activeBrandOrigin = slots[originIndex];
  }

  function attachBrandOverwrite() {
    const brandName = document.getElementById("brand-name") as HTMLElement | null;
    if (!brandName) return;
    // .brand-ticker has transition:persist, so this DOM survives navigations —
    // guard against re-binding listeners on every astro:page-load.
    if (brandName.dataset.hoverAttached === "1") return;
    brandName.dataset.hoverAttached = "1";

    brandSlots = Array.from(brandName.querySelectorAll<HTMLElement>(".brand-slot"));
    brandSlots.forEach((slot, index) => {
      slot.addEventListener("pointerenter", () => requestBrandOverwrite(index));
    });

    // Cleared on leaving the whole line, not the individual slot: the letters a
    // word has written over are pointer-events: none, so sliding the pointer
    // along the word leaves the origin slot without meaning to end the hover.
    brandName.addEventListener("pointerleave", leaveBrandName);
  }

  function refreshBrandName() {
    const brandName = document.getElementById("brand-name") as HTMLElement | null;
    if (!brandName) return;
    fitBrandName();
    measureBrandGlyphs(brandName);
  }

  function initBrandFit() {
    brandResizeObserver?.disconnect();
    const ticker = document.querySelector<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    refreshBrandName();
    attachBrandOverwrite();
    brandResizeObserver = new ResizeObserver(() => {
      leaveBrandName();
      refreshBrandName();
    });
    brandResizeObserver.observe(ticker);
  }

  document.addEventListener("astro:before-swap", (event) => {
    const swapEvent = event as unknown as { newDocument?: Document };
    const newLang = swapEvent.newDocument?.documentElement?.lang === "de" ? "de" : "en";
    updateBrandHomeLink(newLang);
    swapEvent.newDocument?.getElementById("page-loader")?.remove();
  });

  document.addEventListener("astro:page-load", () => {
    const lang = document.documentElement.lang === "de" ? "de" : "en";
    updateBrandHomeLink(lang);
    initBrandFit();
    // On client-side navigation there's no loader, so start animations immediately
    if (!document.getElementById("page-loader")) {
      document.body.classList.add("page-loaded");
    }
  });
</script>
