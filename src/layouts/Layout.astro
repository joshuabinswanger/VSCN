---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import favicon from "../assets/favicon.png";
import ogImageAsset from "../assets/OG_Image.png";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  fullscreen?: boolean;
  lang?: string;
  wide?: boolean;
}

const {
  title,
  description,
  noindex = false,
  fullscreen = false,
  lang = "en",
  wide = false,
} = Astro.props;

const DEFAULT_DESCRIPTION =
  "VSCN — Visual Science Communication Network — brings together illustrators, scientists, designers, and storytellers dedicated to making knowledge visible.";

const metaDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImageAsset.src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VSCN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
  </head>
  <body>
    <div class="brand-ticker" transition:persist>
      <a id="brand-home-link" href={lang === "de" ? "/de" : "/"} class="brand-link">
        <span class="brand-name" id="brand-name" aria-label="Visual Science Communication Network">VSCNVSCNVSCNVSCN</span>
      </a>
    </div>
    <div id="page-loader" aria-hidden="true">
      <span class="loader-brand">VSCN</span>
    </div>
    <div class="page-wrap">
      <Navbar />
      {
        fullscreen ? (
          <slot />
        ) : (
          <main class:list={[{ "is-wide": wide }]}>
            <slot />
          </main>
        )
      }
    </div>
  </body>
</html>

<style>
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg, #fff);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .loader-brand {
    font-size: clamp(4rem, 15vw, 10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-dark);
  }

  .page-wrap {
    padding-bottom: 80px;
  }

  .brand-ticker {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: auto;
    overflow: hidden;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 0 5px;
  }

  .brand-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .brand-link:visited {
    color: black;
  }

  .brand-name {
    display: block;
    font-size: 8rem;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
    overflow: hidden;
  }
</style>

<script>
  type Lang = "en" | "de";

  function updateBrandHomeLink(lang: Lang) {
    const brandLink = document.getElementById("brand-home-link") as HTMLAnchorElement | null;
    if (!brandLink) return;
    brandLink.href = lang === "de" ? "/de" : "/";
  }

  let brandResizeObserver: ResizeObserver | null = null;

  function fitBrandName() {
    const el = document.getElementById("brand-name") as HTMLElement | null;
    if (!el) return;
    el.style.fontSize = "8rem";
    const ticker = el.closest<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    const available = ticker.clientWidth;
    const textWidth = el.scrollWidth;
    if (available > 0 && textWidth > 0) {
      const current = parseFloat(getComputedStyle(el).fontSize);
      el.style.fontSize = `${(current * available) / textWidth}px`;
    }
  }

  function initBrandFit() {
    brandResizeObserver?.disconnect();
    const ticker = document.querySelector<HTMLElement>(".brand-ticker");
    if (!ticker) return;
    fitBrandName();
    brandResizeObserver = new ResizeObserver(fitBrandName);
    brandResizeObserver.observe(ticker);
  }

  window.addEventListener("load", () => {
    const loader = document.getElementById("page-loader");
    if (!loader) return;
    setTimeout(() => {
      loader.style.opacity = "0";
      loader.addEventListener("transitionend", () => loader.remove(), { once: true });
    }, 700);
  });

  document.addEventListener("astro:before-swap", (event) => {
    const swapEvent = event as unknown as { newDocument?: Document };
    const newLang = swapEvent.newDocument?.documentElement?.lang === "de" ? "de" : "en";
    updateBrandHomeLink(newLang);
    swapEvent.newDocument?.getElementById("page-loader")?.remove();
  });

  document.addEventListener("astro:page-load", () => {
    const lang = document.documentElement.lang === "de" ? "de" : "en";
    updateBrandHomeLink(lang);
    initBrandFit();
  });
</script>
