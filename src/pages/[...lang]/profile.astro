---
import Layout from "../../layouts/Layout.astro";
import ProfileForm from "../../components/ProfileForm.astro";
import EditorSidePanel from "../../components/profile/EditorSidePanel.astro";
import type { Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "de" } },
  ];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;

const title = currentLang === "de" ? "Profil bearbeiten — VSCN" : "Edit Profile — VSCN";
---

{/* contentWide (2026-10-13): the Works tab renders the member page, which
    lays out on that measure since it went to two columns on a desktop. The
    Profile and Account tabs keep their own 560px column inside it. */}
{/* THE SIDE-PANEL EDITOR IS THE EDITOR (2026-10-26, Josh: "make it the
    default on dev"). Trialled at /profile-panel from 2026-10-25: picking a
    work, a project or a carousel moves its fields into a panel at the right
    (a full-screen page on a phone), and the profile saves on its own.
    /profile-panel now redirects here (firebase.json). */}
<Layout title={title} noindex lang={currentLang} contentWide>
  <ProfileForm lang={currentLang} autosave />
  <EditorSidePanel lang={currentLang} />
</Layout>
