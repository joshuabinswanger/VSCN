---
import Layout from "../../layouts/Layout.astro";
import ProfileForm from "../../components/ProfileForm.astro";
import type { Lang } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "de" } },
  ];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;

const title = currentLang === "de" ? "Profil bearbeiten — VSCN" : "Edit Profile — VSCN";
---

{/* contentWide (2026-10-13): the Works tab renders the member page, which
    lays out on that measure since it went to two columns on a desktop. The
    Profile and Account tabs keep their own 560px column inside it. */}
<Layout title={title} noindex lang={currentLang} contentWide>
  <ProfileForm lang={currentLang} />
</Layout>
