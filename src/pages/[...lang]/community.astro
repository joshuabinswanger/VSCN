---
import Layout from "../../layouts/Layout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import { fetchMemberViews } from "../../lib/membersBuild.ts";
import { workCaption, workDescription } from "../../lib/links.ts";
import { communityJsonLd, memberPageUrl } from "../../lib/seo.ts";
import type { Lang } from "../../i18n/utils";
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "de" } }];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;

// Same producer as the member profile pages, so the card and the page can
// never disagree about a member. fetchMemberViews() returns [] and logs when
// credentials are missing — "no members" and "no credentials" look identical
// here, by long-standing (documented) design.
//
// Each work's caption and description are picked for THIS page's locale here,
// once — fetchMemberViews() is lang-agnostic (one build, reused by both
// /community and /de/community), so the German fields would otherwise reach
// the grid and its lightbox unresolved. See workCaption()/workDescription()
// in links.ts.
const members = (await fetchMemberViews()).map((m) => ({
  ...m,
  works: m.works.map((w) => ({
    ...w,
    caption: workCaption(w, currentLang),
    description: workDescription(w, currentLang),
  })),
}));

const title = "Community — VSCN";
const description =
  currentLang === "de"
    ? "Entdecken Sie die VSCN-Community — ein wachsendes Verzeichnis von Wissenschaftlern, Illustratoren, Designern und Wissenschaftskommunikatoren."
    : "Browse the VSCN community — a growing directory of scientists, illustrators, designers, and science communicators.";

// Every picture on this page, with its maker (2026-09-10; see src/lib/seo.ts).
// The wall's tiles link the ORIGINAL on Storage, and that is the contentUrl
// here too, so the structured data describes the same file the anchor points
// at. The creator's @id is the member page's Person node, so the two pages
// agree about who this is.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = communityJsonLd({
  entries: members.map((m) => ({
    member: { ...m, memberUrl: memberPageUrl(currentLang, m.slug, Astro.site!.href) },
    works: m.works,
  })),
  pageUrl,
  site: Astro.site!.href,
  name: title,
  description,
});
---

{/* contentWide: the irregular multicol grid was designed at the wide measure
    (min(94vw, 2000px)); the 900px header shell stays untouched, and wide
    content starting outside the header's left edge is the accepted trade. */}
<Layout
  title={title}
  description={description}
  lang={currentLang}
  jsonLd={jsonLd}
  wide={true}
  contentWide={true}
>
  <CommunityGrid members={members} lang={currentLang} />
</Layout>
