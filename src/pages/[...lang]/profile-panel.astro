---
import Layout from "../../layouts/Layout.astro";
import ProfileForm from "../../components/ProfileForm.astro";
import EditorSidePanel from "../../components/profile/EditorSidePanel.astro";
import type { Lang } from "../../i18n/utils";

// THE SIDE-PANEL EDITOR, ON TRIAL (2026-10-25, Josh: "edit fields in a
// separate right panel … and on mobile in a separate frame on the bottom").
// The same editor as /profile — same form, same controller, same Save — with
// EditorSidePanel added: picking a work, a project or a carousel moves its
// fields and keys out of the list into a panel at the right (desktop) or a
// sheet at the foot (phone). /profile itself is untouched; whichever of the
// two wins replaces the other.
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "de" } },
  ];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;

const title = currentLang === "de" ? "Profil bearbeiten — VSCN" : "Edit Profile — VSCN";
---

<Layout title={title} noindex lang={currentLang} contentWide>
  <ProfileForm lang={currentLang} autosave />
  <EditorSidePanel lang={currentLang} />
</Layout>
