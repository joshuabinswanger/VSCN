---
import { getImage } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import { fetchMemberViews } from "../../../lib/membersBuild.ts";
import type { MemberView } from "../../../lib/memberView.ts";
import { href, socialLinks } from "../../../lib/links.ts";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/utils";

// One page per member per locale: `/members/<slug>` and `/de/members/<slug>`,
// where the slug comes from the display name ("daniel-roettele").
//
// The slug is derived on every build rather than stored, so it follows a
// rename — with the accepted consequence that the old URL 404s, since nothing
// records what it used to be.
//
// Deliberately NOT under /profile: astro.config.mjs filters the sitemap with
// `!page.includes("/profile")` to keep the private editor out of it, and member
// pages under that prefix would be caught by the same test and silently
// dropped — the opposite of what a public profile wants.
export async function getStaticPaths() {
  const members = await fetchMemberViews();
  return members.flatMap((member) =>
    [undefined, "de"].map((lang) => ({
      params: { lang, slug: member.slug },
      props: { member },
    })),
  );
}

interface Props {
  member: MemberView;
}

const { member } = Astro.props;
const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;
const t = useTranslations(currentLang);

// Gallery originals are already client-side compressed to max 2000px WebP; this
// generates the responsive sizes the page actually lays out. The lightbox still
// opens the original.
const works = await Promise.all(
  member.works.map(async (w) => ({
    ...w,
    rendered: await getImage({
      src: w.url,
      width: w.width,
      height: w.height,
      widths: [600, 1000, 1600],
      format: "webp",
    }),
    // What the lightbox says under the image. Resolved here rather than in the
    // client script because it is translated, and the script is a module that
    // cannot take `define:vars`; it travels on the trigger link instead.
    //
    // The whose-and-what-of-it line, not a repeat of the caption: full screen,
    // the page's own name heading is covered, so the member's name is the one
    // thing the view has lost. It is just the name now — the project credit
    // that used to follow it went with the projects feature (2026-09-01).
    pswpMeta: member.displayName,
  })),
);

// The lightbox's own labels. One attribute rather than five, for the same
// reason as pswpMeta above: the client script is a module, so `define:vars` is
// not available to it and the strings have to arrive through the DOM.
const lightboxStrings = JSON.stringify({
  close: t("member.lightbox.close"),
  zoom: t("member.lightbox.zoom"),
  prev: t("member.lightbox.prev"),
  next: t("member.lightbox.next"),
  error: t("member.lightbox.error"),
});

const social = socialLinks(member.socialMedia);

// One line for where and in what: "Zurich, Switzerland · DE, EN".
const where = [member.location, member.languages.map((c) => c.toUpperCase()).join(", ")]
  .filter(Boolean)
  .join(" · ");
const communityHref = currentLang === "de" ? "/de/community" : "/community";

const description = member.caption
  ? `${member.displayName} — ${member.role}. ${member.caption}`
  : `${member.displayName} — ${member.role}. VSCN.`;

// A member's share card shows their own first work, not the generic site
// image. getImage already produced the responsive set; the widest source is
// the one link previews want.
const ogImage = works.length ? new URL(works[0].rendered.src, Astro.site).href : undefined;
---

<Layout
  title={`${member.displayName} — VSCN`}
  description={description}
  lang={currentLang}
  ogImage={ogImage}
>
  <article class="mprof">
    <a class="mprof__back" href={communityHref}>&#8592; {t("member.backToCommunity")}</a>

    <header class="mprof__head">
      {member.photoURL && (
        <img
          class="mprof__avatar"
          src={member.photoURL}
          width="144"
          height="144"
          alt={`${member.displayName} — profile picture`}
          style={`background-color: ${member.photoColor ?? "var(--color-border)"}`}
        />
      )}
      <div class="mprof__head-copy">
        <h1 class="mprof__name" transition:name={`mname-${member.id}`}>{member.displayName}</h1>
        {member.role && <p class="mprof__role">{member.role}</p>}
        {member.affiliation && <p class="mprof__affiliation">{member.affiliation}</p>}
        {where && <p class="mprof__where">{where}</p>}
        {
          member.openTo.length > 0 && (
            <p class="mprof__open">
              {t("member.openTo")} {member.openTo.join(", ")}
            </p>
          )
        }
      </div>
    </header>

    {member.bio && <p class="mprof__bio">{member.bio}</p>}

    <div class="mprof__meta">
      {
        member.visualNeeds.length > 0 && (
          <div class="mprof__row">
            <h2 class="mprof__key">{t("member.needs")}</h2>
            <ul class="mprof__vals">
              {member.visualNeeds.map((need) => (
                <li class="mprof__val">{need}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        member.tags.length > 0 && (
          <div class="mprof__row">
            <ul class="mprof__vals">
              {member.tags.map((tag) => (
                <li class="mprof__val">{tag}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        (member.portfolio || social.length > 0) && (
          <div class="mprof__row">
            <ul class="mprof__vals mprof__vals--links">
              {member.portfolio && (
                <li>
                  <a
                    class="mprof__link"
                    href={href(member.portfolio)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {member.portfolio}
                  </a>
                </li>
              )}
              {social.map((entry) =>
                entry.href ? (
                  <li>
                    <a
                      class="mprof__link"
                      href={entry.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {entry.label}
                    </a>
                  </li>
                ) : (
                  <li class="mprof__val">{entry.label}</li>
                ),
              )}
            </ul>
          </div>
        )
      }

    </div>

    {
      works.length > 0 && (
        <div class="mprof__works" data-pswp-i18n={lightboxStrings}>
          {/* Each work is a link to the original, which is what PhotoSwipe
              binds to — and what makes the image openable with scripting off
              rather than being inert. */}
          {works.map((w, i) => (
            <figure class="mprof__work" transition:name={i === 0 ? `mimg-${member.id}` : undefined}>
              <a
                class="mprof__work-link"
                href={w.url}
                target="_blank"
                rel="noreferrer"
                data-pswp-width={w.width}
                data-pswp-height={w.height}
                data-pswp-caption={w.caption?.trim() || undefined}
                data-pswp-description={w.description || undefined}
                data-pswp-meta={w.pswpMeta || undefined}
              >
                <img
                  class="mprof__img"
                  src={w.rendered.src}
                  srcset={w.rendered.srcSet.attribute}
                  sizes="(min-width: 768px) min(94vw, 900px), 94vw"
                  width={w.width}
                  height={w.height}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  alt={w.caption?.trim() || `${member.displayName} — ${t("member.workAlt")}`}
                  style={`background-color: ${w.color ?? "var(--color-border)"}`}
                />
              </a>
              {(w.caption?.trim() || w.description) && (
                <figcaption class="mprof__caption">
                  {w.caption?.trim() && <span class="mprof__caption-line">{w.caption}</span>}
                  {w.description && <span class="mprof__desc">{w.description}</span>}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )
    }
  </article>
</Layout>

<style>
  .mprof {
    font-family: "Archivo", sans-serif;
    padding-block: 3rem 10rem;
  }

  .mprof__back {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-muted);
  }
  .mprof__back:hover,
  .mprof__back:focus-visible {
    color: var(--color-dark);
  }

  /* ── Identity ─────────────────────────────────────────── */
  .mprof__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .mprof__avatar {
    display: block;
    width: clamp(5rem, 14vw, 9rem);
    height: clamp(5rem, 14vw, 9rem);
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    object-fit: cover;
  }

  /* The card's name band grown to page scale — same face, same tightness, so
     arriving from a card reads as the same object opening up. */
  .mprof__name {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    overflow-wrap: anywhere;
  }

  .mprof__role {
    margin: 0.7rem 0 0;
    max-width: 36rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-dark);
  }

  /* Institution sits with the title block, but a step quieter than the
     role: it identifies, it is not the headline. */
  .mprof__affiliation {
    margin: 0.25rem 0 0;
    max-width: 36rem;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--color-dark);
  }

  .mprof__where {
    margin: 0.25rem 0 0;
    max-width: 36rem;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* A dot plus the words, never a bare coloured pill: the site has no accent
     colour, and a dot alone carries no meaning to anyone who cannot see it. */
  .mprof__open {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mprof__open::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    border-radius: 50%;
  }

  .mprof__bio {
    margin: 2.2rem 0 0;
    max-width: 38rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-dark);
    white-space: pre-line;
  }

  /* ── Meta ─────────────────────────────────────────────── */
  .mprof__meta {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .mprof__row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* A real heading, so the page has an outline rather than styled spans. */
  .mprof__key {
    margin: 0;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .mprof__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mprof__val {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 5px 7px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    /* Square corners throughout, as on the cards. */
    border-radius: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* One line, wrapping only when it must — same treatment as the card's
     disclosure panel (.pdisc__vals--links), which links.ts requires this to
     agree with. Inherits the base row direction. */
  .mprof__vals--links {
    column-gap: 1.1rem;
    row-gap: 0.35rem;
    align-items: baseline;
  }

  .mprof__link {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .mprof__link:hover {
    color: var(--color-muted);
  }

  /* ── Work ─────────────────────────────────────────────── */
  .mprof__works {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 4.5rem;
  }

  .mprof__works-key {
    margin-bottom: -2rem;
  }

  .mprof__work {
    margin: 0;
  }

  .mprof__work-link {
    display: block;
    border: 1.5px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    overflow: hidden;
    cursor: zoom-in;
  }

  .mprof__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Captions ─────────────────────────────────────────── */
  /* One block under the image holding the caption line and the longer
     description. A column rather than two siblings so the gaps stay the
     caption's business, not the gallery's. */
  .mprof__caption {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .mprof__caption-line {
    color: var(--color-dark);
  }

  .mprof__desc {
    max-width: 62ch;
    white-space: pre-line;
  }

  @media (--bp-mobile) {
    .mprof {
      padding-block: 2rem 6rem;
    }
    .mprof__works {
      gap: 2.5rem;
      margin-top: 3rem;
    }
    .mprof__works-key {
      margin-bottom: -1.25rem;
    }
  }
</style>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";
  // Immediately after the package sheet, never before: this is the chrome that
  // replaces it. The overrides are also written to win on specificity alone
  // (see the header of lightbox.css), so the order here states the intent
  // rather than carrying it.
  import "../../../styles/lightbox.css";

  interface LightboxStrings {
    close: string;
    zoom: string;
    prev: string;
    next: string;
    error: string;
  }

  // English is the fallback, matching useTranslations() — a missing or
  // malformed attribute costs the translation, never the lightbox.
  const FALLBACK: LightboxStrings = {
    close: "Close",
    zoom: "Zoom",
    prev: "Previous image",
    next: "Next image",
    error: "The image cannot be loaded",
  };

  // These options take raw HTML, which is how the stock SVG icons get replaced
  // with markup this site can style. Everything injected here is either a
  // static string or an escaped translation.
  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

  // Two borders on a box turned 45deg — the drawing .ccard__arrow uses on the
  // community card, reproduced so both pagers on the site are one control.
  const CHEVRON = '<span class="pswp__vscn-chevron" aria-hidden="true"></span>';

  // Rebuilt per navigation rather than once: ClientRouter swaps the document,
  // so a lightbox bound to the previous page's nodes would be holding dead
  // elements. MemberCard is the existing precedent for this pair.
  let lightbox: PhotoSwipeLightbox | null = null;

  document.addEventListener("astro:page-load", () => {
    lightbox?.destroy();
    lightbox = null;
    const gallery = document.querySelector<HTMLElement>(".mprof__works");
    if (!gallery) return;

    let strings = FALLBACK;
    try {
      strings = { ...FALLBACK, ...JSON.parse(gallery.dataset.pswpI18n || "{}") };
    } catch {
      /* keep the fallback */
    }

    // The site drops transitions and leaves the thing in its final state
    // rather than substituting a gentler animation. PhotoSwipe drives its
    // open, close and zoom from JS, so they have to be switched off here; the
    // CSS half lives in lightbox.css.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    lightbox = new PhotoSwipeLightbox({
      gallery: ".mprof__works",
      children: ".mprof__work-link",
      pswpModule: () => import("photoswipe"),

      // ── Chrome. Nothing below changes behaviour. ──
      // The hook every rule in lightbox.css hangs off.
      mainClass: "pswp--vscn",
      // Solid: the ground is the page's own paper, not a veil over it. Drag to
      // dismiss still fades it, which is what makes the gesture legible.
      bgOpacity: 1,
      // Reserves the top bar and the caption band so the artwork sits between
      // them instead of running under them — which is what lets both carry a
      // real hairline rule. Kept in step with the mobile block in lightbox.css.
      // The bottom figures GREW with the description line (2026-09-01) and are
      // the band's max-height in lightbox.css — that pair is the whole reason a
      // long description scrolls rather than overlapping the picture. Change
      // them together.
      paddingFn: (viewportSize) =>
        viewportSize.x <= 767
          ? { top: 44, bottom: 116, left: 12, right: 12 }
          : { top: 56, bottom: 140, left: 32, right: 32 },
      closeSVG: `<span class="pswp__vscn-word">${esc(strings.close)}</span>`,
      arrowPrevSVG: CHEVRON,
      arrowNextSVG: CHEVRON,
      zoomSVG: '<span class="pswp__vscn-zoom" aria-hidden="true"></span>',
      // The glyphs above are all aria-hidden, so these are what a screen
      // reader gets; PhotoSwipe writes each to both `title` and `aria-label`.
      closeTitle: strings.close,
      zoomTitle: strings.zoom,
      arrowPrevTitle: strings.prev,
      arrowNextTitle: strings.next,
      errorMsg: strings.error,

      // Spread rather than a ternary per key: PhotoSwipe merges options over
      // its defaults, so writing `undefined` into one of these would erase the
      // default instead of keeping it.
      ...(reduced
        ? {
            showHideAnimationType: "none" as const,
            showAnimationDuration: 0,
            hideAnimationDuration: 0,
            zoomAnimationDuration: false as const,
          }
        : {}),
    });

    // PhotoSwipe 5 has no caption of its own; this is the documented way to
    // add one. Text comes off the trigger link, so the lightbox and the page
    // under it cannot say different things about the same image.
    lightbox.on("uiRegister", () => {
      lightbox?.pswp?.ui?.registerElement({
        name: "vscn-caption",
        className: "pswp__vscn-caption",
        appendTo: "root",
        // After the top bar's elements, before nothing — it is the only thing
        // at the foot.
        order: 9,
        onInit: (el, pswp) => {
          const render = () => {
            const trigger = pswp.currSlide?.data.element as HTMLElement | undefined;
            const caption = trigger?.dataset.pswpCaption?.trim() || "";
            // THE LONG TEXT, in the lightbox as of 2026-09-01 (Josh: "add it
            // to lightbox"). It used to live only under the image on the
            // member's page, which meant the one view where the artwork is
            // big enough to warrant an explanation was the one view without
            // one. Unlike the caption it is NOT clamped: the band is a scroll
            // container capped at the padding the artwork reserves (see
            // lightbox.css), so a paragraph scrolls inside the band instead of
            // being cut off or growing up over the picture.
            const description = trigger?.dataset.pswpDescription?.trim() || "";
            const meta = trigger?.dataset.pswpMeta?.trim() || "";

            // textContent, not innerHTML: this is member-authored text.
            el.replaceChildren();
            if (caption) {
              const line = document.createElement("span");
              line.className = "pswp__vscn-caption-line";
              line.textContent = caption;
              el.append(line);
            }
            if (description) {
              const desc = document.createElement("span");
              desc.className = "pswp__vscn-caption-desc";
              desc.textContent = description;
              el.append(desc);
            }
            if (meta) {
              const credit = document.createElement("span");
              credit.className = "pswp__vscn-caption-meta";
              credit.textContent = meta;
              el.append(credit);
            }
            // A class rather than `hidden`, which the element's own
            // `display: flex` would outrank.
            el.classList.toggle("is-empty", !caption && !description && !meta);
            // The band scrolls; a slide change has to start it at the top or
            // the next caption opens mid-paragraph.
            el.scrollTop = 0;
          };

          pswp.on("change", render);
          render();
        },
      });
    });

    lightbox.init();
  });

  document.addEventListener("astro:before-swap", () => {
    lightbox?.destroy();
    lightbox = null;
  });
</script>
