---
import { getImage } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import { fetchMemberViews, fetchSlugAliases } from "../../../lib/membersBuild.ts";
import { localizeMember, type MemberView } from "../../../lib/memberView.ts";
import {
  communityTagHref,
  href,
  memberHref,
  socialLinks,
  workCaption,
  workDescription,
} from "../../../lib/links.ts";
import { memberPageJsonLd, memberPageUrl, memberTitle } from "../../../lib/seo.ts";
import { groupWorks, withProjectSlider, projectTitle, projectDescription, projectSlideData, type ProfileProject } from "../../../lib/projects.ts";
import MemberWork from "../../../components/MemberWork.astro";
import MemberProject from "../../../components/MemberProject.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Lang } from "../../../i18n/utils";
// THIS PAGE'S SURFACE, in a file of its own so the profile editor's preview
// can render the identical composition instead of an imitation of it. See the
// header of profile.css — moving these rules out of a scoped <style> is the
// whole mechanism, because a scoped block cannot be shared.
import "../../../styles/profile.css";

// One page per member per locale: `/members/<slug>` and `/de/members/<slug>`.
// The slug comes from slugs/ (owned by the onPublicProfileWritten function),
// so a rename claims a new one and RETIRES the old — and the old still
// resolves: a retired slug renders the same page with its canonical pointing
// at the current URL and a meta refresh, which is what static hosting has
// instead of a 301.
//
// Deliberately NOT under /profile: astro.config.mjs filters the sitemap with
// `!page.includes("/profile")` to keep the private editor out of it, and member
// pages under that prefix would be caught by the same test and silently
// dropped — the opposite of what a public profile wants.
export async function getStaticPaths() {
  const [members, aliases] = await Promise.all([fetchMemberViews(), fetchSlugAliases()]);
  const byUid = new Map(members.map((m) => [m.id, m]));
  // A retired slug that some member now resolves to (a rowless member's
  // derived fallback, or a re-claim) must not become an alias too — Astro
  // fails the build on duplicate params. Dropping the alias is the right
  // degradation for a page that only ever redirects.
  const takenSlugs = new Set(members.map((m) => m.slug));
  const langs = [undefined, "de"] as const;
  return [
    ...members.flatMap((member) =>
      langs.map((lang) => ({ params: { lang, slug: member.slug }, props: { member } })),
    ),
    ...aliases.flatMap(({ slug, uid }) => {
      const member = byUid.get(uid);
      if (!member || takenSlugs.has(slug)) return [];
      return langs.map((lang) => ({
        params: { lang, slug },
        props: { member, aliasOf: memberHref(lang ?? "en", member.slug) },
      }));
    }),
  ];
}

interface Props {
  member: MemberView;
  /** Set on alias pages: the current URL of this member. */
  aliasOf?: string;
}

const { member: sharedMember, aliasOf } = Astro.props as Props;
const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;
// The props are shared with the other locale's page for the same member, so
// role, bio and caption are picked for this one here — see localizeMember().
const member = localizeMember(sharedMember, currentLang);
const t = useTranslations(currentLang);

// Gallery originals are already client-side compressed to a 4K-capped WebP (see
// MAX_EDGE in gallery.ts, raised from 2000px on 2026-09-02); this generates the
// responsive sizes the page actually lays out. The lightbox still opens the
// stored file, which is what the bigger cap is FOR — full screen is the one
// view where 2000px was visibly short.
const works = await Promise.all(
  member.works.map(async (w) => {
    const project = member.projects?.find((p) => p.id === w.projectId);
    return {
      ...w,
      // Picked for this page's locale — member.works is built once and shared
      // with the /de page for the same member (see toMemberViewBase's
      // callers), so the raw caption/description pairs are only resolved here,
      // where currentLang is known. See workCaption()/workDescription() in
      // links.ts. w.caption is what the <img alt> and the lightbox trigger's
      // data-pswp-caption both read below, so this is also what a German
      // screen reader speaks for this image.
      caption: workCaption(w, currentLang),
      description: workDescription(w, currentLang),
      rendered: await getImage({
        src: w.url,
        width: w.width,
        height: w.height,
        widths: [600, 1000, 1600],
        format: "webp",
      }),
      // What the lightbox says under the image. Resolved here rather than in the
      // client script because it is translated, and the script is a module that
      // cannot take `define:vars`; it travels on the trigger link instead.
      //
      // The whose-and-what-of-it line, not a repeat of the caption: full screen,
      // the page's own name heading is covered, so the member's name is the one
      // thing the view has lost. It is just the name now — the project credit
      // that used to follow it went with the projects feature (2026-09-01, and
      // is back as its own block below the picture since 2026-09-23).
      pswpMeta: member.displayName,
      // The project this work is in, as data-pswp-* strings for the lightbox's
      // shared renderer — see projectSlideData() in lib/projects.ts.
      slide: projectSlideData(project, currentLang),
      // The project this work is in, resolved once above for SEO and lightbox.
      project,
    };
  }),
);

// PROJECT BLOCKS (2026-09-23): the gallery stays one list in the member's
// order; a project's images sit together under its heading, loose works in
// between. groupWorks() is the same cut the editor preview makes.
const sections = groupWorks(works, member.projects ?? []);
// Two or more projects are gathered into one slider (2026-09-25).
const pageSections = withProjectSlider(sections);

// The lightbox's own labels. One attribute rather than five, for the same
// reason as pswpMeta above: the client script is a module, so `define:vars` is
// not available to it and the strings have to arrive through the DOM.
const lightboxStrings = JSON.stringify({
  close: t("member.lightbox.close"),
  zoom: t("member.lightbox.zoom"),
  prev: t("member.lightbox.prev"),
  next: t("member.lightbox.next"),
  error: t("member.lightbox.error"),
  linkTitle: t("member.lightbox.link"),
  siteLinkTitle: t("member.lightbox.siteLink"),
  play: t("member.lightbox.play"),
  partOf: t("member.project.partOf"),
  with: t("member.project.with"),
});

const social = socialLinks(member.socialMedia);

// One line for where and in what: "Zurich, Switzerland · DE, EN".
const where = [member.location, member.languages.map((c) => c.toUpperCase()).join(", ")]
  .filter(Boolean)
  .join(" · ");
const communityHref = currentLang === "de" ? "/de/community" : "/community";

const description = member.caption
  ? `${member.displayName} — ${member.role}. ${member.caption}`
  : `${member.displayName} — ${member.role}. VSCN.`;

// A member's share card shows their own first work, not the generic site
// image. getImage already produced the responsive set; the widest source is
// the one link previews want.
const ogImage = works.length ? new URL(works[0].rendered.src, Astro.site).href : undefined;

// WHO MADE EVERY PICTURE, for machines (2026-09-10; see src/lib/seo.ts). The
// canonical URL is the page's own on a member's real page and the CURRENT page
// on an alias, the same rule the layout applies to <link rel="canonical">.
type ProjectAffiliation = ProfileProject["affiliations"][number];

function seoProject(p: ProfileProject | undefined) {
  if (!p) return undefined;
  return {
    id: p.id,
    name: projectTitle(p, currentLang),
    description: projectDescription(p, currentLang),
    url: p.link,
    affiliations: p.affiliations.map((a: ProjectAffiliation) =>
      a.memberSlug
        ? { name: a.name, personUrl: memberPageUrl(currentLang, a.memberSlug, Astro.site!.href) }
        : { name: a.name, url: a.href },
    ),
  };
}

const pageUrl = new URL(aliasOf ?? Astro.url.pathname, Astro.site).href;
const jsonLd = memberPageJsonLd({
  member,
  works: works.map((w) => ({
    url: w.url,
    thumbnailUrl: w.rendered.src,
    width: w.width,
    height: w.height,
    caption: w.caption,
    description: w.description,
    link: w.link,
    siteLink: w.siteLink,
    embed: w.embed,
    addedAt: w.addedAt,
    project: seoProject(w.project),
  })),
  pageUrl,
  site: Astro.site!.href,
  description,
});
---

<Layout
  title={memberTitle(member)}
  description={description}
  lang={currentLang}
  ogImage={ogImage}
  ogType="profile"
  jsonLd={aliasOf ? undefined : jsonLd}
  noindex={Boolean(aliasOf)}
  redirectTo={aliasOf}
>
  <article class="mprof">
    <a class="mprof__back" href={communityHref}>&#8592; {t("member.backToCommunity")}</a>

    <header class="mprof__head">
      {member.photoURL && (
        <img
          class="mprof__avatar"
          src={member.photoURL}
          width="144"
          height="144"
          alt={`${member.displayName} — profile picture`}
          style={`background-color: ${member.photoColor ?? "var(--color-border)"}`}
        />
      )}
      <div class="mprof__head-copy">
        <h1 class="mprof__name" transition:name={`mname-${member.id}`}>{member.displayName}</h1>
        {member.role && <p class="mprof__role">{member.role}</p>}
        {member.affiliation && <p class="mprof__affiliation">{member.affiliation}</p>}
        {where && <p class="mprof__where">{where}</p>}
        {
          member.openTo.length > 0 && (
            <p class="mprof__open">
              {t("member.openTo")} {member.openTo.join(", ")}
            </p>
          )
        }
      </div>
    </header>

    {member.bio && <p class="mprof__bio">{member.bio}</p>}

    <div class="mprof__meta">
      {
        member.visualNeeds.length > 0 && (
          <div class="mprof__row">
            <h2 class="mprof__key">{t("member.needs")}</h2>
            <ul class="mprof__vals">
              {member.visualNeeds.map((need) => (
                <li class="mprof__val">{need}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        member.tags.length > 0 && (
          <div class="mprof__row">
            {/* THE TAGS ARE THE WAY BACK OUT (2026-09-03, Josh: "clicking on
                tags opens gallery with tag filter applied"). Same change as the
                directory's disclosure chips, and it matters more here: this
                page is the end of a journey, and a tag on it is the one thing
                that says "there are others like this". */}
            <ul class="mprof__vals">
              {member.tags.map((tag) => (
                <li>
                  <a class="mprof__val mprof__tag tagchip" href={communityTagHref(lang, tag)}>
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        (member.portfolio || social.length > 0) && (
          <div class="mprof__row">
            {/* THE MEMBER'S OWN LINKS SEND A REFERRER (2026-09-10). These were
                rel="noopener noreferrer", and noreferrer strips the Referer
                header — so a member's analytics never showed vscn.ch sending
                anyone. The referrer is the one proof a member gets that being
                listed here does something; withholding it was the site being
                private on their behalf. `noopener` stays (target=_blank). The
                same change on every surface that links a member's site: the
                card, the disclosure, the editor preview, the lightbox. */}
            <ul class="mprof__vals mprof__vals--links">
              {member.portfolio && (
                <li>
                  <a
                    class="mprof__link"
                    href={href(member.portfolio)}
                    target="_blank"
                    rel="noopener"
                  >
                    {member.portfolio}
                  </a>
                </li>
              )}
              {social.map((entry) =>
                entry.href ? (
                  <li>
                    <a
                      class="mprof__link"
                      href={entry.href}
                      target="_blank"
                      rel="noopener"
                    >
                      {entry.label}
                    </a>
                  </li>
                ) : (
                  <li class="mprof__val">{entry.label}</li>
                ),
              )}
            </ul>
          </div>
        )
      }

    </div>

    {
      works.length > 0 && (
        <div class="mprof__works" data-pswp-i18n={lightboxStrings}>
          {/* Each work is a link to the original, which is what PhotoSwipe
              binds to — and what makes the image openable with scripting off
              rather than being inert. The gallery is still one list in the
              member's own order (works.indexOf below); a project only draws a
              heading and a rule around the run of its own works within it. */}
          {pageSections.map((section) =>
            "slider" in section ? (
              /* THE PROJECTS SLIDER (2026-09-25, Josh: projects as a
                 horizontal slider that moves one project per step, prev/next
                 and swipe). Each step is one project at the width a project
                 has always had — the page's column — and the track bleeds
                 out to the window's edges, so the first project sits exactly
                 where it did and the next one spills out to the right. The
                 bleed is measured, not assumed: see src/lib/projectSlider.ts.
                 Two or more projects only; withProjectSlider() says why. */
              <div
                class="mprof__projects"
                data-project-slider
                data-position-label={t("member.projects.position")}
              >
                <div class="mprof__projects-bar">
                  <p class="mprof__projects-key">{t("member.projects.label")}</p>
                  <span class="mprof__projects-count" data-project-count aria-hidden="true">
                    1 / {section.slider.length}
                  </span>
                  <button
                    class="mprof__projects-btn mprof__projects-btn--prev"
                    type="button"
                    data-project-prev
                    aria-controls={`mprof-projects-${member.id}`}
                    aria-label={t("member.projects.prev")}
                  >
                    <span aria-hidden="true" />
                  </button>
                  <button
                    class="mprof__projects-btn mprof__projects-btn--next"
                    type="button"
                    data-project-next
                    aria-controls={`mprof-projects-${member.id}`}
                    aria-label={t("member.projects.next")}
                  >
                    <span aria-hidden="true" />
                  </button>
                </div>
                {/* The track is a real scroll container, so swipe, trackpad
                    and the arrow keys (it is a tab stop) all page it natively,
                    and scroll-snap makes every one of them land on a project. */}
                <div
                  class="mprof__projects-track"
                  id={`mprof-projects-${member.id}`}
                  data-project-track
                  tabindex="0"
                  role="region"
                  aria-roledescription={t("community.card.carousel")}
                  aria-label={t("member.projects.label")}
                >
                  {section.slider.map((s, k) => (
                    <MemberProject
                      class="mprof__projects-slide"
                      role="group"
                      aria-label={t("member.projects.position")
                        .replace("{n}", String(k + 1))
                        .replace("{total}", String(section.slider.length))}
                      project={s.project!}
                      works={s.works}
                      allWorks={works}
                      memberId={member.id}
                      displayName={member.displayName}
                      lang={currentLang}
                    />
                  ))}
                </div>
                <p class="mprof__projects-live" aria-live="polite" aria-atomic="true" data-project-live />
              </div>
            ) : section.project ? (
              <MemberProject
                project={section.project}
                works={section.works}
                allWorks={works}
                memberId={member.id}
                displayName={member.displayName}
                lang={currentLang}
              />
            ) : (
              section.works.map((w) => (
                <MemberWork
                  work={w}
                  index={works.indexOf(w)}
                  memberId={member.id}
                  displayName={member.displayName}
                  workAlt={t("member.workAlt")}
                  linkTitle={t("member.lightbox.link")}
                  siteLinkTitle={t("member.lightbox.siteLink")}
                />
              ))
            ),
          )}
        </div>
      )
    }
  </article>
</Layout>


<script>
  import type PhotoSwipeLightbox from "photoswipe/lightbox";
  // The options, the words and the video slides: one lightbox for the whole
  // site, defined once in lib/lightbox.ts (the grid and the editor's preview
  // build theirs from the same function).
  import { createLightbox, parseLightboxStrings } from "../../../lib/lightbox.ts";
  // The projects slider (2026-09-25); it releases itself on astro:before-swap.
  import { initProjectSliders } from "../../../lib/projectSlider.ts";
  import "photoswipe/style.css";
  // Immediately after the package sheet, never before: this is the chrome that
  // replaces it. The overrides are also written to win on specificity alone
  // (see the header of lightbox.css), so the order here states the intent
  // rather than carrying it.
  import "../../../styles/lightbox.css";

  // Rebuilt per navigation rather than once: ClientRouter swaps the document,
  // so a lightbox bound to the previous page's nodes would be holding dead
  // elements. MemberCard is the existing precedent for this pair.
  let lightbox: PhotoSwipeLightbox | null = null;

  document.addEventListener("astro:page-load", () => {
    initProjectSliders();
    lightbox?.destroy();
    lightbox = null;
    const gallery = document.querySelector<HTMLElement>(".mprof__works");
    if (!gallery) return;

    lightbox = createLightbox(parseLightboxStrings(gallery.dataset.pswpI18n), {
      gallery: ".mprof__works",
      children: ".mprof__work-link",
    });
    lightbox.init();
  });

  document.addEventListener("astro:before-swap", () => {
    lightbox?.destroy();
    lightbox = null;
  });
</script>
