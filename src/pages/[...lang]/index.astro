---
import Layout from "../../layouts/Layout.astro";
import InfoPage from "../../components/InfoPage.astro";
import ViewsPill from "../../components/ViewsPill.astro";
import type { Lang } from "../../i18n/utils";

// THE HOME PAGE IS THE STORY (2026-11-05, Josh: "make / the story"). On the
// host, firebase.json answers / with a 302 to /info before this page is ever
// served. This copy is for everything that does not apply host redirects (the
// local dev server, a plain static preview): it shows the same story and
// forwards to /info, which stays the one canonical address. The old start page
// (LandingHero.astro) is no longer used.
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "de" } },
  ];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;
const infoPath = currentLang === "de" ? "/de/info" : "/info";

const title = "VSCN — Visual Science Communication Network";
const description = currentLang === "de"
  ? "Eine Community aus Illustration, Design und Wissenschaft für Menschen, die Wissenschaft sichtbar machen. Werde Teil des Visual Science Communication Network."
  : "A home for illustrators, scientists, designers, and storytellers who make knowledge visible. Join the Visual Science Communication Network.";
---
<Layout
  title={title}
  description={description}
  lang={currentLang}
  redirectTo={infoPath}
>
  <ViewsPill lang={currentLang} />
  <InfoPage lang={currentLang} />
</Layout>
