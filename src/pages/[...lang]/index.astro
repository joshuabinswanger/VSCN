---
import Layout from "../../layouts/Layout.astro";
import InfoPage from "../../components/InfoPage.astro";
import ViewsPill from "../../components/ViewsPill.astro";
import type { Lang } from "../../i18n/utils";

// THE HOME PAGE IS THE STORY (2026-11-05, Josh: "make / the story"), THE
// FIRST TIME (2026-11-07, Josh: "store something so we know when someone was
// already on the site"). This page decides in the browser: a first visit goes
// on to /info, which stays the one canonical address; a browser that has
// been here before goes to the Portfolios (Layout's returnTo, the
// vscn:visited flag). Until 11-07 firebase.json answered / with a 302 to
// /info, which no host rule can make depend on a return visit, so that
// redirect is gone and this page is what the host serves. The story is still
// rendered under it for a crawler that runs no script. The old start page
// (LandingHero.astro) is no longer used.
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "de" } },
  ];
}

const { lang = "en" } = Astro.params;
const currentLang = (lang || "en") as Lang;
const infoPath = currentLang === "de" ? "/de/info" : "/info";
// A visitor who has been here before skips the story (2026-11-07, Josh).
const portfoliosPath = currentLang === "de" ? "/de/community" : "/community";

const title = "VSCN — Visual Science Communication Network";
const description = currentLang === "de"
  ? "Eine Community aus Illustration, Design und Wissenschaft für Menschen, die Wissenschaft sichtbar machen. Werde Teil des Visual Science Communication Network."
  : "A home for illustrators, scientists, designers, and storytellers who make knowledge visible. Join the Visual Science Communication Network.";
---
<Layout
  title={title}
  description={description}
  lang={currentLang}
  redirectTo={infoPath}
  returnTo={portfoliosPath}
>
  <ViewsPill lang={currentLang} />
  <InfoPage lang={currentLang} />
</Layout>
