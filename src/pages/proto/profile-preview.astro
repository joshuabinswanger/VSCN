---
import Layout from "../../layouts/Layout.astro";
import ProfileViewPreview from "../../components/ProfileViewPreview.astro";
import CommunityCardPreview from "../../components/community/CommunityCardPreview.astro";
import { fetchMemberViews } from "../../lib/membersBuild.ts";
import { MEMBER_TYPES } from "../../lib/firestore.ts";
import { ui } from "../../i18n/translations.ts";

// Harness for the previews ProfileForm shows in preview mode: the profile-page
// preview and the directory card's face (renderCardPreview).
//
// It exists because /profile is behind auth and its form only renders for a
// signed-in user, so the preview cannot be seen — by a reviewer or by me —
// without credentials. This page feeds the same component and the same
// renderer from real member data, with a picker for the interesting cases:
// a full profile, one with no artwork, and an empty one.
//
// It is a harness, not a feature: no client Firebase, noindex, excluded from
// the sitemap with the rest of /proto. Data comes from the same build-time
// fetch the real pages use, so the cases are whatever the directory holds.
const members = await fetchMemberViews();

// Serialised for the client so the picker can re-render without a round trip.
const cases = members.map((m) => ({
  id: m.slug,
  label: `${m.displayName}${m.works.length === 0 ? " — no artwork" : ""}`,
  view: {
    displayName: m.displayName,
    role: m.role,
    memberType: m.memberType,
    bio: m.bio,
    affiliation: m.affiliation,
    location: m.location,
    languages: m.languages,
    visualNeeds: m.visualNeeds,
    tags: m.tags,
    openTo: m.openTo,
    portfolio: m.portfolio,
    socialMedia: m.socialMedia,
    works: m.works,
    projects: m.projects,
  },
}));

const labels = {
  defaultName: "Your name",
  tags: "Tags",
  elsewhere: "Elsewhere",
  openTo: "Open to",
  noWorks: "No images yet. Add work in the gallery field and it will appear here.",
  projects: "Projects",
  needs: "Looking for",
  partOf: "Part of",
};

// English member-type labels for the directory card's typographic face —
// the harness is English-only, like its other labels.
const cardLabels = {
  defaultName: labels.defaultName,
  memberTypeLabels: Object.fromEntries(
    MEMBER_TYPES.map((type) => [type, ui.en[`profile.memberType.${type}`]])
  ),
};
---

<Layout title="Profile preview harness — VSCN (prototype)" noindex={true}>
  <div class="harness">
    <div class="harness__bar">
      <label class="harness__label" for="case">Member</label>
      <select id="case" class="harness__select">
        {cases.map((c) => <option value={c.id}>{c.label}</option>)}
      </select>
      <button type="button" id="blank" class="harness__btn">Empty profile</button>
    </div>

    <div class="harness__stage">
      <ProfileViewPreview />
    </div>

    <div class="harness__stage harness__stage--card">
      <p class="harness__label">Directory card</p>
      <CommunityCardPreview />
    </div>
  </div>

  <script is:inline define:vars={{ cases, labels, cardLabels }}>
    window.__previewCases = cases;
    window.__previewLabels = labels;
    window.__previewCardLabels = cardLabels;
  </script>

  <script>
    import { renderCardPreview, renderProfilePreview } from "../../lib/profilePreview.ts";

    function initHarness() {
      const root = document.querySelector(".ppv");
      const cardRoot = document.querySelector("[data-ccpv-root]");
      const select = document.getElementById("case");
      const blank = document.getElementById("blank");
      if (!(root instanceof HTMLElement) || !(select instanceof HTMLSelectElement)) return;

      const cases = window.__previewCases ?? [];
      const labels = window.__previewLabels;
      const cardLabels = window.__previewCardLabels;

      const drawBoth = (view) => {
        renderProfilePreview(root, view, labels);
        if (cardRoot instanceof HTMLElement) renderCardPreview(cardRoot, view, cardLabels);
      };

      const draw = (id) => {
        const found = cases.find((c) => c.id === id);
        if (found) drawBoth(found.view);
      };

      select.addEventListener("change", () => draw(select.value));
      blank?.addEventListener("click", () => {
        drawBoth({
          displayName: "",
          role: "",
          memberType: "",
          bio: "",
          tags: [],
          openTo: [],
          portfolio: "",
          socialMedia: "",
          works: [],
          projects: [],
        });
      });

      draw(select.value);
    }

    document.addEventListener("astro:page-load", initHarness);
  </script>
</Layout>

<style>
  .harness {
    padding-block: 3rem 8rem;
  }

  .harness__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    font-family: "Archivo", sans-serif;
  }

  .harness__label {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .harness__select,
  .harness__btn {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.4rem 0.6rem;
    border: 1.5px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    color: var(--color-dark);
    cursor: pointer;
  }

  .harness__stage {
    padding-top: 3rem;
  }

  .harness__stage--card {
    margin-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .harness__stage--card .harness__label {
    margin: 0 0 1.5rem;
  }
</style>
