---
import Layout from "../../../layouts/Layout.astro";
import { PROTO_REAL_MEMBERS } from "../../../lib/proto-data-real.ts";
import type { ProtoRealMember } from "../../../lib/proto-data-real.ts";
import { href, socialLinks } from "../../../lib/proto-links.ts";

// One static page per real member. The community cards link here, and the
// site-wide ClientRouter turns the navigation into a view transition: the
// card's name band and artwork frame morph into this page's headline and
// first work via matching transition:name pairs.
export function getStaticPaths() {
  return PROTO_REAL_MEMBERS.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

interface Props {
  member: ProtoRealMember;
}

const { member } = Astro.props;

// `description` is the truncated caption line derived from `bio`, so the full
// text always wins; the fallback only matters if a future snapshot diverges.
const bio = member.bio?.trim() || member.description?.trim() || "";
const portfolio = member.portfolio?.trim() ?? "";
const social = member.socialMedia?.trim() ?? "";
const tags = member.tags ?? [];
// Verbatim, typos included ("coolaborate") — prose is not repaired. Social
// links are the exception: socialLinks() in proto-links.ts cleans those.
const openTo = member.openTo ?? [];
---

<Layout title={`${member.name} — VSCN (prototype)`} noindex={true}>
  <article class="pprof">
    <a class="pprof__back" href="/proto/community">&#8592; Community</a>

    <header class="pprof__head">
      <h1 class="pprof__name" transition:name={`pname-${member.id}`}>{member.name}</h1>
      <p class="pprof__role">{member.role}</p>
      {openTo.length > 0 && <p class="pprof__open">Open to {openTo.join(", ")}</p>}
    </header>

    {bio && <p class="pprof__bio">{bio}</p>}

    <div class="pprof__meta">
      {
        tags.length > 0 && (
          <div class="pprof__row">
            <span class="pprof__key">Tags</span>
            <ul class="pprof__vals">
              {tags.map((t) => (
                <li class="pprof__val">{t}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        (portfolio || social) && (
          <div class="pprof__row">
            <span class="pprof__key">Elsewhere</span>
            <ul class="pprof__vals pprof__vals--links">
              {portfolio && (
                <li>
                  <a class="pprof__link" href={href(portfolio)} target="_blank" rel="noopener noreferrer">
                    {portfolio}
                  </a>
                </li>
              )}
              {socialLinks(social).map((s) =>
                s.href ? (
                  <li>
                    <a class="pprof__link" href={s.href} target="_blank" rel="noopener noreferrer">
                      {s.label}
                    </a>
                  </li>
                ) : (
                  <li class="pprof__val">{s.label}</li>
                ),
              )}
            </ul>
          </div>
        )
      }
    </div>

    {
      member.images.length > 0 && (
        <div class="pprof__works">
          {member.images.map((img, i) =>
            i === 0 ? (
              <figure class="pprof__work" transition:name={`pimg-${member.id}`}>
                <img
                  class="pprof__img"
                  src={img.src}
                  width={img.width}
                  height={img.height}
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              </figure>
            ) : (
              <figure class="pprof__work">
                <img
                  class="pprof__img"
                  src={img.src}
                  width={img.width}
                  height={img.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ),
          )}
        </div>
      )
    }
  </article>
</Layout>

<style>
  .pprof {
    font-family: "Archivo", sans-serif;
    padding-block: 3rem 10rem;
  }

  /* ── Way back ─────────────────────────────────────────── */
  .pprof__back {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-muted);
  }
  .pprof__back:hover,
  .pprof__back:focus-visible {
    color: var(--color-dark);
  }

  /* ── Identity ─────────────────────────────────────────── */
  .pprof__head {
    margin-top: 2.5rem;
  }

  /* The card's 1.2rem name band grown to page scale — same face, same
     tightness, so the view-transition morph reads as the same object. */
  .pprof__name {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    overflow-wrap: anywhere;
  }

  .pprof__role {
    margin: 0.7rem 0 0;
    max-width: 36rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-dark);
  }

  /* Availability — the dot + words treatment from the cards, and still the
     only round thing on the page. */
  .pprof__open {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pprof__open::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    border-radius: 50%;
  }

  /* ── Bio ──────────────────────────────────────────────── */
  .pprof__bio {
    margin: 2.2rem 0 0;
    max-width: 38rem;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-dark);
  }

  /* ── Meta rows — same anatomy as the card disclosure ──── */
  .pprof__meta {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 2.4rem;
  }

  .pprof__row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .pprof__key {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pprof__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pprof__val {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 5px 7px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .pprof__vals--links {
    flex-direction: column;
    gap: 0.35rem;
  }

  .pprof__link {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .pprof__link:hover {
    color: var(--color-muted);
  }

  /* ── Work ─────────────────────────────────────────────── */
  .pprof__works {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 4.5rem;
  }

  .pprof__work {
    margin: 0;
    border: 1.5px solid var(--color-border);
    /* Square corners throughout, as on the cards. */
    border-radius: 0;
    background: var(--color-bg);
    overflow: hidden;
  }

  .pprof__img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (--bp-mobile) {
    .pprof {
      padding-block: 2rem 6rem;
    }
    .pprof__works {
      gap: 2.5rem;
      margin-top: 3rem;
    }
  }
</style>
