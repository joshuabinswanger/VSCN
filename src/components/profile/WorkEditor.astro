---
// THE WORKS TAB IS THE MEMBER PAGE (2026-10-13, Josh: "instead of separate
// Preview and Works tabs, have ONE Works tab with a sleek toggle that switches
// between Preview and Edit. Edit mode should look like the preview: the same
// layout, the same widths, and no horizontal shrinking of the content").
//
// So the tab renders the page the visitor gets — ProfileViewPreview, the
// real `.mprof` markup styled by the one stylesheet the page imports — and
// the editor lives INSIDE it, in the page's works column, dressed in the
// page's own classes: every editor row is a `.mprof__work` figure at the
// page's width, with its tools above the picture and its title and
// description as inline fields where the page prints them. The bar at the
// foot of the form (ProfileForm.astro) switches Preview | Edit, Profile |
// Card and EN | DE, and holds Save.
//
// Preview mode shows the page's own works slot, filled by renderProfilePreview;
// edit mode hides that slot and shows the editor's list in its place
// ([data-works-editor]). Both are children of the same `.mprof` article, so
// the head, the bio and the meta rows are the same nodes either way.
//
// The directory card (CommunityCardPreview) is the second view of the same
// data; the bar's Profile | Card switch shows one or the other.
import ProjectEditor from "./ProjectEditor.astro";
import InfoTip from "../InfoTip.astro";
import TagSelector from "../TagSelector.astro";
import ProfileViewPreview from "../ProfileViewPreview.astro";
import CommunityCardPreview from "../community/CommunityCardPreview.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/utils";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---
  <div class="form-section" data-section="work" role="tabpanel" id="panel-work" aria-labelledby="tab-work">
    {
      /* data-mode / data-view / data-lang are written by the controller from
        the bar's three switches; the stylesheet shows and hides by them. The
        language defaults to the tab's locale, as the old Preview tab did. */
    }
    <div class="works-stage" id="works-stage" data-mode="edit" data-view="profile" data-lang={lang}>
      {
        /* THE PROJECT PAGES (2026-10-27, Josh, on the desktop editor mock:
          "having a project view and then a project edit page it is very
          nice"). The tab opens on a LIST of the projects, each a card with
          an Edit key; Edit opens ONE project as the whole page, every block
          edited in place, and the bar's Edit | Preview switches that page
          between the form and what a visitor gets. editorProjectPages.ts
          keeps the level on the stage (data-level, data-focus). This row is
          the project page's way back, in both modes. ONE KEY since
          2026-10-28 (Josh: "the Projects back button and the done button are
          very close together. also they are redundant"): Done did exactly
          what ‹ Projects does, and edits save as they are made. */
      }
      <nav class="pp-top" data-pp-top hidden aria-label={t("profile.projects.back")}>
        <button type="button" class="pp-top__back" data-pp-back
          ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg><span>{t("profile.projects.back")}</span></button
        >
      </nav>
      <div class="works-view" data-works-pane="profile">
        <ProfileViewPreview lang={lang}>
          {
            /* THE EDITOR, in the page's works column. Files dropped on the
              list land in the project block under the pointer (2026-10-16:
              nowhere else, since every work belongs to a project). Pending
              uploads sit inside their project block, where a finished
              upload lands, so a row does not jump when it completes. */
          }
          <div slot="editor" class="works-editor" data-works-editor>
            {
              /* THE LIST LEVEL: one card per project block, drawn by
                editorProjectPages.ts from the block itself (its words, its
                first pictures, its work count and tags), so a card can never
                disagree with the project page it opens. */
            }
            {
              /* + PROJECT AFTER THE LAST PROJECT (2026-10-29, Josh: "add
                project button after last project and not in the panel"):
                the list's own last line, kept there by drawCards; it left
                the bar. */
            }
            <section class="pp-cards" data-pp-cards aria-label={t("profile.projects.list")} hidden>
              <button type="button" id="pp-add" class="pp-add" data-pp-add title={t("profile.works.add")}
                ><svg class="ebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg><span
                  >{t("profile.project.new")}</span
                ></button
              >
            </section>
            {
              /* THE WAY IN WITHOUT A PROJECT (2026-10-16, Josh: "We need
                always a Project, just a title is mandatory"). A member with
                no project yet has nowhere to add a work, so the list starts
                with this instead; the controller hides it once a block
                exists. Same action as the Plus menu's Add project. */
            }
            <div id="gallery-first" class="gallery-first" hidden>
              <p class="field-note">{t("profile.project.firstNote")}</p>
              <button type="button" id="gallery-first-project" class="btn-solid">{t("profile.project.new")}</button>
            </div>
            <div id="gallery-drop" class="gallery-drop">
              <div id="gallery-editor" class="gallery-editor"></div>
              {
                /* NOT aria-live: the state text carries a percentage that
                  updates several times a second per upload. Progress is a
                  progressbar; only a FAILURE is announced, by paintTaskRow
                  promoting that one row to role="alert". */
              }
              <div id="gallery-queue" class="gallery-queue"></div>
              {
                /* ADDING (2026-10-13, narrowed 2026-10-16): the Plus in the
                  form's footer adds a project (ProfileForm.astro); images
                  and videos come in through a project block's own buttons
                  or a drop onto the block.
                  ONE picker for every row's "Replace image": the row that
                  was pressed is remembered in the script, not in the input. */
              }
              <input
                id="gallery-replace-file"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/avif"
                style="display:none;"
              />
            </div>
            <p id="gallery-status" class="field-note" style="display:none;"></p>
            {
              /* The ceiling, next to the uploader: two notes, one shown, the
                unverified one swapped in by the controller. The cover note
                behind the ⓘ says what the first image does (the card's
                aspect box). */
            }
            <div class="gallery-notes">
              <p id="gallery-note" class="field-note">
                {t("profile.note.gallery")}
                <InfoTip lang={lang} for="note-gallery-cover" />
              </p>
              <p id="gallery-note-unverified" class="field-note" hidden>
                {t("profile.note.galleryUnverified")}
              </p>
              <p id="note-gallery-cover" class="field-note" data-tip hidden>{t("profile.gallery.coverNote")}</p>
              {
                /* The directory is image-led: a member without a gallery holds
                  a typographic card. Hidden the moment the first image lands. */
              }
              <p id="gallery-nudge" class="field-note gallery-nudge" hidden>{t("profile.gallery.nudge")}</p>
            </div>
          </div>
        </ProfileViewPreview>
      </div>
      {
        /* THE CARD IS NAMED (2026-09-26, Josh: "in the preview clearly label
          the gallery card!"): the page names itself; the card says where it
          appears. Read-only in both modes: the card is drawn from the same
          fields the page is. No hairlines above and below it since
          2026-10-13 (Josh: "the horizontal bars on the gallery card can be
          removed!"). The "Gallery card" label and its note went on
          2026-10-15 (Josh: "can be gone"): the bar's Card toggle names it. */
      }
      <div class="works-view" data-works-pane="card" hidden>
        <div class="preview-card">
          <CommunityCardPreview lang={lang} />
        </div>
      </div>
    </div>

    {
      /* Cloned by renderGallery(). Astro scopes component CSS by appending
        data-astro-cid-* to every selector, so rows built with createElement()
        would match none of the scoped rules; clones carry the attribute. */
    }
    <template data-gallery-tpl="item">
      {
        /* A WORK IN THE PAGE'S CLOTHES. The figure, the frame and the
          caption carry the page's own classes (profile.css draws them), so
          the picture is the size and in the place the visitor gets it;
          `--work-ar` is set per row by renderGallery, as the page sets it
          per figure. What the editor adds: the toolbar on its own line above
          the picture (↑ ↓ ↻ ✕ and the project select), the title and description as
          inline fields where the caption prints them — one language at a
          time, the bar's — and a fold under the words for the links and the
          tags. Named per row by renderGallery ("Work 3 of 12"), so the
          row's identical buttons say which work they act on. */
      }
      <figure class="mprof__work gallery-item" role="group">
        {
          /* THE BOX'S OWN HEAD (2026-10-27, Josh: the side panel is
            obsolete, "fold all the settings in there into the boxes";
            mock vscn-desktop-editor): what the panel's deck held, on the
            box itself. The kind, then size S | L, ↑ ↓, Remove. Replace is
            on the picture; the rest (the pickers, In gallery, the links,
            the tags) is the box's More fold under the words. */
        }
        <div class="gallery-boxhead">
          <span class="gallery-boxhead__lbl t-label">{t("profile.deck.image")}</span>
          <div class="gallery-boxhead__keys" role="group" aria-label={t("profile.gallery.toolbar")}>
            <div class="gallery-boxhead__grp gallery-size" role="group" data-gallery-size>
              <button type="button" class="gallery-key" data-size="s">S</button>
              <button type="button" class="gallery-key" data-size="l">L</button>
            </div>
            <div class="gallery-boxhead__grp">
              <button type="button" class="gallery-key gallery-tbtn" data-gallery-move="up"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></button>
              <button type="button" class="gallery-key gallery-tbtn" data-gallery-move="down"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></button>
            </div>
            <button type="button" class="gallery-boxhead__word gallery-boxhead__word--danger" data-gallery-remove>{t("profile.deck.remove")}</button>
          </div>
        </div>
        {
          /* A <div>, not the page's <a>: the editor's picture opens nothing.
            Both labels bottom left, stacked, so a video that is also the
            cover wears both. Replace at the top right. */
        }
        <div class="mprof__work-link gallery-thumb">
          <img class="mprof__img" alt="" loading="lazy" data-gallery-img />
          <button type="button" class="gallery-thumb-replace" data-gallery-replace>{t("profile.deck.replace")}</button>
          <div class="gallery-thumb-labels">
            <span class="gallery-cover" data-gallery-cover hidden></span>
            <span class="gallery-video-badge" data-gallery-video-badge hidden
              ><span class="vscn-play" aria-hidden="true"></span><span data-gallery-video-name></span></span
            >
          </div>
        </div>
        <figcaption class="mprof__caption gallery-fields">
          {
            /* THE WORDS AS FIELDS (2026-10-23, Josh: "make the title,
              description and so on more clear and similar style to edit"):
              title and description as labelled soft boxes in the row's
              column — a form, not the page in disguise, which is what the
              dotted inline fields of 2026-10-13 were. Two panes, English
              and German, and the bar's EN | DE decides which one is on
              screen (the stylesheet reads the stage's data-lang). The German
              pair is optional: the German site reads the English pane until
              it is filled in (GalleryItem.captionDe / descriptionDe). */
          }
          <div class="gallery-lang-pane" data-gallery-lang-pane="en">
            <label class="gfield"><span class="gfield__lbl t-label">{t("profile.gallery.caption")}</span><input type="text" class="mprof__caption-line gallery-inline" data-gallery-field="caption" /></label>
            <label class="gfield"><span class="gfield__lbl t-label">{t("profile.gallery.description.label")}</span><textarea class="mprof__desc gallery-inline" rows="1" data-gallery-field="description"></textarea></label>
          </div>
          <div class="gallery-lang-pane" data-gallery-lang-pane="de">
            <label class="gfield"><span class="gfield__lbl t-label">{t("profile.gallery.caption.de")}</span><input type="text" class="mprof__caption-line gallery-inline" data-gallery-field="captionDe" /></label>
            <label class="gfield"><span class="gfield__lbl t-label">{t("profile.gallery.description.de")}</span><textarea class="mprof__desc gallery-inline" rows="1" data-gallery-field="descriptionDe"></textarea></label>
          </div>
          {
            /* EVERYTHING ELSE IS BEHIND EDIT (2026-10-23, Josh: "hide most of
              those options behind an edit button"): one key under the words
              opens the row's PANEL — its deck of keys (size, move, replace,
              delete, the project and carousel pickers, In gallery), the two
              links in the order the page prints them, and the tags. A
              <details>, so the panel is a fold like the ones before it
              (galleryDetailsOpenUI remembers it per imageId across
              re-renders); the controller keeps ONE panel open at a time. A
              row already in the gallery when the page loads starts closed;
              one uploaded in this session starts open. */
          }
          <details class="gallery-details">
            <summary class="gallery-details-summary gallery-key gallery-key--more"><span class="gallery-details-title">{t("profile.deck.more")}</span><span class="gallery-details-chevron" aria-hidden="true"></span></summary>
            <div class="gallery-details-body gallery-panel">
              <div class="gallery-row-tools gallery-deck">
                <div class="gallery-deck__row" data-deck-row>
                  <div class="gallery-select-wrap gallery-key gallery-key--wide" data-gallery-project-wrap hidden>
                    <select class="gallery-project-select" data-gallery-project></select>
                  </div>
                  <div class="gallery-select-wrap gallery-key gallery-key--wide" data-gallery-carousel-wrap hidden>
                    <select class="gallery-project-select" data-gallery-carousel></select>
                  </div>
                  <button type="button" class="gallery-key gallery-key--wide" data-gallery-auto-thumb hidden></button>
                  <label class="gallery-key gallery-key--wide gallery-include">
                    <input type="checkbox" data-gallery-include checked />
                    <span data-gallery-include-label></span>
                  </label>
                </div>
              </div>
              <div class="gallery-panel__sec">
                <div class="label-row">
                  <label class="row-label" data-row-label="siteLink">{t("profile.gallery.siteLink")}</label>
                  <span class="row-optional">{t("profile.optional")}</span>
                </div>
                <div class="input-prefix-wrap">
                  <span class="input-prefix">https://</span>
                  <input type="text" class="input input-prefixed" data-gallery-field="siteLink" />
                </div>
                <div class="label-row">
                  <label class="row-label" data-row-label="link">{t("profile.gallery.link")}</label>
                  <span class="row-optional">{t("profile.optional")}</span>
                </div>
                <div class="input-prefix-wrap">
                  <span class="input-prefix">https://</span>
                  <input type="text" class="input input-prefixed" data-gallery-field="link" />
                </div>
              </div>
              {
                /* WHAT IS IN THE PICTURE — the community wall filters by
                  this. Same element and registry as the member's own tags,
                  capped lower. Folded, closed to start with (its picked tags
                  show on the folded line), remembered per imageId
                  (galleryTagsOpenUI) across the re-renders every move and
                  upload causes. */
              }
              <details class="gallery-tags" open>
                <summary class="gallery-tags-summary">
                  <span class="gallery-tags-title">{t("profile.label.tags")}</span>
                  <span class="gallery-tags-count" data-gallery-tags-count></span>
                  <span class="gallery-tags-chevron" aria-hidden="true"></span>
                  <span class="gallery-tags-picked" data-gallery-tags-picked></span>
                </summary>
                <TagSelector lang={lang} maxTags={7} />
              </details>
            </div>
          </details>
        </figcaption>
        {
          /* THE TEXT BLOCK AFTER THE WORK (2026-10-16, Josh: "make it
            possible to add text block in between image in projects"). Typed
            where the page prints it, under the work and before the next one,
            in the bar's language. Empty, it is only its placeholder; the
            page prints nothing for it. */
        }
        <div class="mprof__text gallery-text" hidden>
          <div class="gallery-boxhead">
            <span class="gallery-boxhead__lbl t-label">{t("profile.deck.text")}</span>
            <div class="gallery-boxhead__keys">
              <button type="button" class="gallery-boxhead__word gallery-boxhead__word--danger" data-gallery-text-remove>{t("profile.deck.remove")}</button>
            </div>
          </div>
          <div class="gallery-lang-pane" data-gallery-lang-pane="en">
            <label class="gfield"><textarea class="gallery-inline" rows="1" data-gallery-field="textAfter"></textarea></label>
          </div>
          <div class="gallery-lang-pane" data-gallery-lang-pane="de">
            <label class="gfield"><textarea class="gallery-inline" rows="1" data-gallery-field="textAfterDe"></textarea></label>
          </div>
        </div>
      </figure>
    </template>
    {
      /* A PROJECT BLOCK (2026-09-23), cloned by renderGallery() once per
        project: a frame INSIDE the one gallery list, holding its own image
        rows in [data-project-images], so the list stays linear — loose rows
        and blocks in one order, the gallery array's order. */
    }
    <ProjectEditor lang={lang} />
    {
      /* A PROJECT CARD on the list level, cloned by editorProjectPages.ts.
        The whole card opens the project; the Edit key says so. */
    }
    <template data-pp-tpl="card">
      <article class="pp-card" data-pp-card>
        <div class="pp-card__head">
          <h3 class="pp-card__title mprof__project-title" data-pp-card-title></h3>
          <button type="button" class="pp-card__edit gallery-key gallery-key--edit" data-pp-card-edit
            ><span>{t("profile.deck.edit")}</span></button
          >
        </div>
        <p class="pp-card__desc mprof__project-desc" data-pp-card-desc hidden></p>
        <div class="pp-card__thumbs" data-pp-card-thumbs></div>
        <p class="pp-card__meta t-label" data-pp-card-meta></p>
      </article>
    </template>
    <div
      hidden
      data-pp-strings
      data-untitled={t("profile.projects.untitled")}
      data-works={t("profile.projects.works")}
      data-work={t("profile.projects.work")}
      data-edit-one={t("profile.projects.editOne")}
    ></div>
    <script>import "../../lib/editorProjectPages.ts";</script>
    {
      /* A CAROUSEL IN THE EDITOR (2026-10-23, documentation/20261023-work-
        carousels-design.md): one unit in its project's line, cloned by
        buildTray (src/lib/carouselTray.ts) for every run of works sharing a
        carouselId, a run of one included. A muted "Carousel · N works"
        line, then the TRAY:
        a dashed strip of thumbnail buttons (built by buildTray) with the +
        slot at its end, which uploads straight into this carousel. Under
        the tray, the carousel's DECK (2026-10-23, the works' soft panel of
        keys: S/L, ↑ ↓ moving the run as a whole, ✕ dissolving it, the
        project select); under that stands the selected slide as an
        ordinary work row in slide mode, and after it the carousel's text block (on the lead slide's
        record, carousels.ts). */
    }
    <template data-gallery-tpl="carousel">
      <section class="gallery-carousel" data-carousel-block role="group">
        {
          /* The carousel's own head (2026-10-27): its name, then size S | L,
            ↑ ↓ moving the run as a whole and Dissolve. The project select
            and the text block's key are its More fold. */
        }
        <div class="gallery-boxhead">
          <p class="gallery-boxhead__lbl gallery-carousel-label t-label" data-carousel-label></p>
          <div class="gallery-boxhead__keys" role="group" aria-label={t("profile.carousel.toolbar")}>
            <div class="gallery-boxhead__grp gallery-size" role="group" data-carousel-size>
              <button type="button" class="gallery-key" data-size="s">S</button>
              <button type="button" class="gallery-key" data-size="l">L</button>
            </div>
            <div class="gallery-boxhead__grp">
              <button type="button" class="gallery-key gallery-tbtn" data-carousel-move="up"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></button>
              <button type="button" class="gallery-key gallery-tbtn" data-carousel-move="down"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></button>
            </div>
            <button type="button" class="gallery-boxhead__word gallery-boxhead__word--danger" data-carousel-dissolve>{t("profile.deck.dissolve")}</button>
          </div>
        </div>
        <div class="gallery-tray" data-carousel-tray>
          <label class="gallery-tray-add" data-carousel-add>
            <svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
            <input type="file" class="picker-input" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-carousel-files />
          </label>
        </div>
        {
          /* The carousel's own controls behind Edit (2026-10-23), like a
            work's: S/L, ↑ ↓ moving the run as a whole, ✕ dissolving it,
            the project select. buildTray remembers the fold per carouselId
            (TrayHooks.panelOpen). */
        }
        <details class="gallery-details gallery-carousel-details" data-carousel-details>
          <summary class="gallery-details-summary gallery-key gallery-key--more"><span class="gallery-details-title">{t("profile.deck.more")}</span><span class="gallery-details-chevron" aria-hidden="true"></span></summary>
          <div class="gallery-details-body gallery-panel">
            <div class="gallery-row-tools gallery-carousel-tools gallery-deck">
              <div class="gallery-deck__row">
                <div class="gallery-select-wrap gallery-key gallery-key--wide" data-carousel-project-wrap hidden>
                  <select class="gallery-project-select" data-carousel-project></select>
                </div>
              </div>
            </div>
          </div>
        </details>
        <div class="gallery-carousel-slide" data-carousel-slide-row></div>
        <div class="mprof__text gallery-text gallery-carousel-text" data-carousel-text hidden>
          <div class="gallery-boxhead">
            <span class="gallery-boxhead__lbl t-label">{t("profile.deck.text")}</span>
            <div class="gallery-boxhead__keys">
              <button type="button" class="gallery-boxhead__word gallery-boxhead__word--danger" data-carousel-text-remove>{t("profile.deck.remove")}</button>
            </div>
          </div>
          <div class="gallery-lang-pane" data-gallery-lang-pane="en">
            <label class="gfield"><textarea class="gallery-inline" rows="1" data-carousel-field="textAfter"></textarea></label>
          </div>
          <div class="gallery-lang-pane" data-gallery-lang-pane="de">
            <label class="gfield"><textarea class="gallery-inline" rows="1" data-carousel-field="textAfterDe"></textarea></label>
          </div>
        </div>
      </section>
    </template>
    <template data-gallery-tpl="affiliation">
      <div class="social-row gallery-aff-row">
        <div class="gallery-lang-switch seg" role="group">
          <button type="button" class="gallery-lang-btn is-active" data-aff-mode="name">{t("profile.project.affiliation.name")}</button>
          <button type="button" class="gallery-lang-btn" data-aff-mode="member">{t("profile.project.affiliation.member")}</button>
        </div>
        <div class="gallery-aff-fields" data-aff-pane="name">
          <input type="text" class="input" data-aff-field="name" />
          <div class="input-prefix-wrap">
            <span class="input-prefix">https://</span>
            <input type="text" class="input input-prefixed" data-aff-field="url" />
          </div>
        </div>
        <div class="gallery-aff-fields" data-aff-pane="member" hidden>
          <input type="text" class="input" data-aff-field="member" list="gallery-member-options" autocomplete="off" />
          <p class="field-note gallery-aff-nomatch" hidden>{t("profile.project.affiliation.noMatch")}</p>
        </div>
        <button type="button" class="social-row-remove" data-aff-remove>✕</button>
      </div>
    </template>
    {
      /* ONE datalist for every Member-mode input on the page, filled once
        from publicProfiles on the first Member focus (loadMemberOptions). */
    }
    <datalist id="gallery-member-options"></datalist>
    {
      /* One pending upload, cloned by renderQueue(). The same figure geometry
        as a committed row, so a completed upload reads as the row settling
        rather than as one row vanishing and a different one appearing. */
    }
    <template data-gallery-tpl="task">
      <figure class="mprof__work gallery-item gallery-task">
        <div class="mprof__work-link gallery-thumb">
          <img class="mprof__img" alt="" data-task-img />
          <button type="button" class="gallery-thumb-remove" data-task-cancel>✕</button>
        </div>
        <figcaption class="mprof__caption gallery-fields">
          <p class="gallery-task-name" data-task-name></p>
          <div
            class="gallery-bar"
            data-task-track
            role="progressbar"
            aria-label={t("profile.gallery.progress")}
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <span data-task-bar></span>
          </div>
          <p class="gallery-task-state" data-task-state></p>
          <div class="gallery-tools" data-task-tools hidden>
            <button type="button" class="gallery-tool" data-task-retry></button>
            <button type="button" class="gallery-tool" data-task-dismiss></button>
          </div>
        </figcaption>
      </figure>
    </template>
  </div>
