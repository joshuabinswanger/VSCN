---
import TagSelector from "../TagSelector.astro";
import InfoTip from "../InfoTip.astro";
import { useTranslations, type Lang } from "../../i18n/utils";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---
      <template data-gallery-tpl="project">
        {
          /* A PROJECT IN THE PAGE'S CLOTHES (2026-10-13): the block is the
            page's own `.mprof__project` — its heading group, then its works —
            with the title and the description as inline fields in the
            heading's own voices. The tools stand above the heading: the
            block's ↑/↓ (moveProject: the block moves as a whole, past the
            neighbouring row or block), Delete, which ungroups in place (the
            images stay, loose, where the block stood; the document goes at
            Save), and the block's own picker (uploads land after its last
            image, insertUploaded).
            The works inside are listed one under the other here; on the page
            two or more page as a carousel. */
        }
        <section class="mprof__project gallery-project" data-project-block>
          <div class="gallery-row-tools gallery-project-tools">
            <div class="gallery-toolbar gallery-toolbar--head" role="group">
              <button type="button" class="gallery-tbtn" data-project-move="up"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></button>
              <button type="button" class="gallery-tbtn" data-project-move="down"><svg class="gallery-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></button>
            </div>
            <label class="gallery-tpill gallery-project-add">
              {t("profile.project.addImages")}
              <input type="file" class="picker-input" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-project-files />
            </label>
            <button type="button" class="gallery-tpill gallery-tpill--danger" data-project-delete>{t("profile.project.delete")}</button>
          </div>
          <div class="mprof__project-head gallery-project-fields">
            {
              /* The block's name for the controls that act on it, read by
                renderGallery (projectLabel); the title field below is what
                the member sees. */
            }
            <span class="gallery-project-name" data-project-name hidden></span>
            {
              /* Title and description, one language at a time — the bar's
                EN | DE, like a work's words. The German pair is optional and
                falls back to the English one on the German site. */
            }
            <div class="gallery-lang-pane" data-gallery-lang-pane="en">
              <input type="text" class="mprof__project-title gallery-inline" data-project-field="title" />
              <textarea class="mprof__project-desc gallery-inline" rows="1" data-project-field="description"></textarea>
            </div>
            <div class="gallery-lang-pane" data-gallery-lang-pane="de">
              <input type="text" class="mprof__project-title gallery-inline" data-project-field="titleDe" />
              <textarea class="mprof__project-desc gallery-inline" rows="1" data-project-field="descriptionDe"></textarea>
            </div>
            {
              /* THE PROJECT'S FOLD: the link (images inside the block without
                a site link of their own inherit it — inheritedSiteLink in
                projects.ts, which is what the ⓘ says), the affiliations and
                the tags. A project already saved starts FOLDED, one added in
                this session starts OPEN (projectDetailsOpenUI). */
            }
            <details class="gallery-details gallery-project-details">
              <summary class="gallery-details-summary">
                <span class="gallery-details-title">{t("profile.project.details")}</span>
                <span class="gallery-details-chevron" aria-hidden="true"></span>
              </summary>
              <div class="gallery-details-body">
                <div class="label-row">
                  <label class="row-label" data-row-label="link">{t("profile.project.website")}</label>
                  <span class="row-optional">{t("profile.optional")}</span>
                </div>
                <p class="field-note" data-tip data-tip-note="link" hidden>{t("profile.project.linkNote")}</p>
                <div class="input-prefix-wrap">
                  <span class="input-prefix">https://</span>
                  <input type="text" class="input input-prefixed" data-project-field="link" />
                  <InfoTip lang={lang} rowKey="link" />
                </div>
                {
                  /* AFFILIATIONS, like the Social Media rows: repeatable, + Add
                    and ✕ per row. Each row is a name with an optional link OR a
                    credit to a VSCN member; the Name | Member switch is the
                    rows' EN/DE switch at the same scale. Rows are cloned from
                    the template in WorkEditor. */
                }
                <div class="gallery-project-affiliations">
                  <div class="label-row">
                    <p class="row-label">{t("profile.project.affiliations")}</p>
                    <span class="row-optional">{t("profile.optional")}</span>
                  </div>
                  <div class="social-editor" data-affiliations></div>
                  <button type="button" class="btn-outline choose-img gallery-aff-add" data-aff-add>
                    {t("profile.project.affiliations.add")}
                  </button>
                </div>
                {
                  /* A PROJECT'S TAGS (2026-09-27): the work row's own fold and
                    picker, cloned per block the same way, remembered per
                    projectId (projectTagsOpenUI). */
                }
                <details class="gallery-tags gallery-project-tags" open>
                  <summary class="gallery-tags-summary">
                    <span class="gallery-tags-title">{t("profile.label.tags")}</span>
                    <span class="gallery-tags-count" data-project-tags-count></span>
                    <span class="gallery-tags-chevron" aria-hidden="true"></span>
                  </summary>
                  <TagSelector lang={lang} maxTags={7} />
                </details>
              </div>
            </details>
            {
              /* Save writes only the projects an image names, so a block that
                holds none stays local and is gone after a reload. Said here,
                in the block, not behind an ⓘ. renderGallery() shows it while
                block.indices is empty. */
            }
            <p class="field-note gallery-project-empty" data-project-empty hidden>{t("profile.project.emptyNote")}</p>
          </div>
          <div class="gallery-project-images" data-project-images></div>
        </section>
      </template>
