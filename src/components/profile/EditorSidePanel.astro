---
// The panel the side-panel editor (/profile-panel) edits in. Rendered empty
// and parked here; editorSidePanel.ts moves it into #works-stage, so the
// editor's own rules (`.profile-editor …`, the stage's data-lang) still reach
// the fields it borrows from the list.
import { useTranslations, type Lang } from "../../i18n/utils";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---
<aside
  class="epanel"
  id="epanel"
  hidden
  data-label-work={t("profile.deck.work")}
  data-label-project={t("profile.deck.project")}
  data-label-carousel={t("profile.deck.carousel")}
>
  <div class="epanel__head">
    <button type="button" class="epanel__back" data-epanel-back
      ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg><span>{t("profile.panel.back")}</span></button
    >
    <p class="epanel__title t-label" data-epanel-title>{t("profile.deck.edit")}</p>
    <button type="button" class="epanel__done" data-epanel-done>{t("profile.panel.done")}</button>
    <button type="button" class="epanel__save" data-epanel-save>{t("profile.saveShort")}</button>
  </div>
  <img class="epanel__thumb" alt="" data-epanel-thumb hidden />
  <p class="epanel__empty field-note" data-epanel-empty>{t("profile.panel.empty")}</p>
  <div class="epanel__body" data-epanel-body></div>
</aside>

<script>import "../../lib/editorSidePanel.ts";</script>

<style is:global>
  /* Everything here is global on purpose: the panel is moved into the
     editor's stage at runtime, and what it holds are clones of WorkEditor's
     templates, which carry that component's scope, not this one's. All of it
     is keyed to .has-epanel on the stage, so /profile never matches. */

  .works-stage.has-epanel {
    --epanel-w: 360px;
  }

  /* The panel shows in Edit on the page view only. */
  .works-stage.has-epanel:not([data-mode="edit"][data-view="profile"]) > .epanel {
    display: none;
  }

  .profile-editor .works-stage > .epanel {
    position: fixed;
    z-index: 32;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-sizing: border-box;
    padding: 14px 16px 18px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow:
      0 8px 28px rgb(0 0 0 / 0.1),
      0 1px 3px rgb(0 0 0 / 0.06);
    text-align: start;
  }

  .profile-editor .works-stage > .epanel[hidden] {
    display: none;
  }

  @media (--bp-desktop) {
    .profile-editor .works-stage > .epanel {
      top: calc(var(--header-h) + 22px + var(--ebar-h, 0px));
      right: 16px;
      bottom: 20px;
      width: var(--epanel-w);
      border-radius: 20px !important;
    }

    /* The works keep clear of the right column: the stage gives up as much
       of its right edge as the column reaches into it, in every mode, since
       the bar stands there in Preview too. */
    .profile-form.has-epanel.is-works .works-stage.has-epanel {
      padding-inline-end: max(0px, calc(var(--epanel-w) + 32px - (100vw - 100%) / 2));
    }

    /* THE BAR IN THE RIGHT COLUMN (2026-10-25, Josh: "all the bottom bar
       should be in the right side but make it so that we can see the
       preview / edit button very clearly"). On a desktop the bar leaves the
       window's foot for the top of the column, over the panel; on the Works
       tab it is the column's width and Preview / Edit is its first, widest
       row. editorBar.ts's measured size is set aside here: the column
       decides. What opened above the bar (the message, the + menu, the
       video sheet) opens under it. */
    .profile-form.has-epanel .form-footer {
      top: calc(var(--header-h) + 12px);
      right: 16px;
      bottom: auto;
      left: auto;
      transform: none;
      align-items: flex-end;
    }

    .profile-form.has-epanel.is-works .form-footer {
      width: var(--epanel-w);
      align-items: stretch;
    }

    .profile-form.has-epanel .form-footer .ebar {
      width: auto !important;
      height: auto !important;
      border-radius: 20px !important;
    }

    .profile-form.has-epanel .form-footer .ebar__in {
      width: auto;
      max-width: none;
    }

    .profile-form.has-epanel .form-footer :is(.ebar-pop, .ebar-menu) {
      top: calc(100% + 10px);
      bottom: auto;
    }

    .profile-form.has-epanel .form-footer .ebar-pop {
      left: auto;
      right: 0;
      transform: none;
      align-items: flex-end;
    }

    .profile-form.has-epanel .ebar__group {
      order: -1;
    }

    .profile-form.has-epanel .ebar__group .ebar__mode {
      order: -1;
      flex-basis: 100%;
      display: flex;
      width: 100%;
      box-sizing: border-box;
      padding: 3px;
      border-radius: 14px !important;
    }

    .profile-form.has-epanel .ebar .ebar__mode > button {
      flex: 1 1 0;
      min-height: 40px;
      border-radius: 11px !important;
    }

    /* Edit pressed is the dark one: the state the column is for. */
    .profile-form.has-epanel .ebar .ebar__mode > button[data-works-mode="edit"][aria-pressed="true"] {
      background: var(--color-dark);
      color: var(--color-bg);
    }

    .profile-form.has-epanel.is-works {
      padding-bottom: 3rem;
    }
  }

  /* The tabs are in the header's account menu (Navbar.astro). */
  .profile-form.has-epanel #section-tabs {
    display: none;
  }

  @media (--bp-mobile) {
    /* A FULL-SCREEN PAGE on a phone (2026-10-25, after a bottom sheet: iOS
       zoomed into every field and the keyboard pushed the sheet about). It
       slides in over the list while something is picked; nothing in it is
       pinned to the foot, so the keyboard simply scrolls it like a form. */
    .profile-editor .works-stage > .epanel {
      inset: 0;
      z-index: 40;
      gap: 16px;
      padding: 0 16px calc(32px + env(safe-area-inset-bottom, 0px));
      border: 0;
      box-shadow: none;
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform 0.32s cubic-bezier(0.25, 1, 0.5, 1),
        visibility 0s linear 0.32s;
    }

    .profile-editor .works-stage > .epanel.is-open {
      transform: none;
      visibility: visible;
      transition: transform 0.32s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .profile-editor .works-stage > .epanel .epanel__empty,
    .epanel .epanel__done {
      display: none;
    }

    /* Back · what is edited · Save, stuck to the top of the page. */
    .epanel .epanel__head {
      position: sticky;
      top: 0;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      margin-inline: -16px;
      padding: calc(10px + env(safe-area-inset-top, 0px)) 12px 10px;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }

    .epanel .epanel__title {
      grid-column: 2;
      text-align: center;
    }

    .profile-editor .epanel .epanel__back {
      grid-column: 1;
      justify-self: start;
      display: inline-flex;
      align-items: center;
      gap: 2px;
      padding: 8px 6px;
      border: 0;
      background: none;
      color: var(--color-dark);
      font-family: inherit;
      cursor: pointer;
    }

    .epanel .epanel__back svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .profile-editor .epanel .epanel__save {
      grid-column: 3;
      justify-self: end;
      display: inline-block;
    }

    /* What is being edited, small, so the page says which work this is. */
    .profile-editor .epanel .epanel__thumb:not([hidden]) {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: 28svh;
      margin: 0 auto;
      object-fit: contain;
    }

    /* 16px or more, or iOS zooms the page into every field it focuses. A
       deliberate exception to "components set no font-size" (type.css):
       the phone's form controls, in this panel only. */
    .profile-editor .works-stage > .epanel :is(input:not([type="checkbox"], [type="file"]), textarea, select) {
      font-size: 16px !important;
    }

    /* The bar steps aside while the page is up: its Save is in the head. */
    .profile-form:has(.works-stage.has-epanel.is-picking) .form-footer {
      display: none;
    }
  }

  /* Back, Save and the picture are the phone page's. */
  .epanel__back,
  .epanel__save,
  .epanel__thumb {
    display: none;
  }

  .profile-editor .epanel__save {
    padding: 6px 14px;
    border: 0;
    border-radius: 999px !important;
    background: var(--color-dark);
    color: var(--color-bg);
    font-family: inherit;
    cursor: pointer;
  }

  .profile-editor .epanel__save:disabled {
    opacity: 0.4;
  }

  /* AUTOSAVE'S QUIET STATE (2026-10-25, Josh: "add automatic saving, make
     the UI match the rest"): nothing waiting, so Save reads "Saved" on the
     bar's soft grey, the + key's colours, and turns black again once
     something changed. Pressed, it still saves at once. */
  .profile-editor .ebar .profile-save-button.is-clean,
  .profile-editor .epanel__save.is-clean {
    background: color-mix(in srgb, var(--color-dark) 7%, var(--color-bg));
    color: var(--color-dark);
  }

  /* A carousel's own keys first, then the picked slide's words and keys,
     set apart by a line. */
  .epanel .gallery-carousel-details ~ .gallery-fields {
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-editor .works-stage > .epanel {
      transition: none !important;
    }
  }

  .epanel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .epanel__title {
    margin: 0;
    color: var(--color-muted);
  }

  .profile-editor .epanel__done {
    padding: 6px 14px;
    border: 0;
    border-radius: 999px !important;
    background: var(--color-dark);
    color: var(--color-bg);
    font-family: inherit;
    cursor: pointer;
  }

  @media (--bp-desktop) {
    .epanel:not(.is-open) .epanel__done {
      visibility: hidden;
    }
  }

  .epanel.is-open .epanel__empty {
    display: none;
  }

  .epanel__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .epanel__body:empty {
    display: none;
  }

  /* IN THE PANEL the folds are always open: the Edit key's summary goes and
     its body is simply the rest of the panel. Same for the project's + Add,
     whose keys stand open. */
  .epanel .gallery-details > .gallery-details-summary,
  .epanel [data-project-add-toggle] {
    display: none !important;
  }

  .epanel .gallery-details,
  .epanel .gallery-addrow {
    float: none !important;
    width: 100%;
    margin: 0;
  }

  .epanel [data-project-addkeys] {
    display: flex !important;
    flex-wrap: wrap;
    gap: 6px;
  }

  .epanel .gallery-edit-row {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .epanel .gallery-fields,
  .epanel .gallery-project-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: auto;
    max-width: none;
    margin: 0;
  }

  .epanel .gfield > .gallery-inline {
    width: 100%;
    box-sizing: border-box;
  }

  /* IN THE LIST the words read as the page prints them: no boxes, no labels,
     no + Add. A click on any of it picks the work (or project) and the real
     fields move into the panel.
     THE EDIT KEY SITS ON THE PICTURE (2026-10-25, Josh: "add edit buttons"
     then "top right of images"): editorSidePanel.ts puts one .epanel-edit
     key at the top right of every work's picture, of a carousel's shown
     slide, and of a project's heading. The editor's own Edit fold never
     shows in the list. */
  .works-stage.has-epanel [data-works-editor] :is(.gfield__lbl, .gallery-details, .gallery-edit-row) {
    display: none !important;
  }

  .works-stage.has-epanel [data-works-editor] :is(.gallery-thumb, [data-project-block]) {
    position: relative;
  }

  .works-stage.has-epanel [data-works-editor] :is([data-project-block] > .gallery-project-fields, [data-project-block] > .epanel-ghost) {
    padding-inline-end: 96px;
  }

  .profile-editor .works-stage [data-works-editor] .epanel-edit {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border: 0;
    border-radius: 999px !important;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.08),
      0 0 0 0.5px rgb(0 0 0 / 0.12),
      0 4px 14px rgb(0 0 0 / 0.1);
    color: var(--color-dark);
    font-family: inherit;
    cursor: pointer;
  }

  .profile-editor .works-stage [data-works-editor] [data-project-block] > .epanel-edit {
    top: 14px;
    right: 14px;
  }

  /* SMALLER ON A DESKTOP (2026-10-25, Josh: "edit buttons can be smaller on
     desktop"): a pointer needs no thumb-sized key. */
  @media (--bp-desktop) {
    .profile-editor .works-stage [data-works-editor] .epanel-edit {
      top: 8px;
      right: 8px;
      padding: 3px 8px;
    }

    .works-stage.has-epanel [data-works-editor] :is([data-project-block] > .gallery-project-fields, [data-project-block] > .epanel-ghost) {
      padding-inline-end: 72px;
    }
  }


  /* The picked unit's key is pressed: dark. */
  .profile-editor .works-stage [data-works-editor] .is-epicked .epanel-edit,
  .profile-editor .works-stage [data-works-editor] [data-project-block]:has(> .epanel-ghost.is-epicked) > .epanel-edit {
    background: var(--color-dark);
    color: var(--color-bg);
  }

  .works-stage.has-epanel [data-works-editor] .gfield > .gallery-inline {
    padding: 0;
    background: transparent;
    box-shadow: none;
    pointer-events: none;
    resize: none;
  }

  .works-stage.has-epanel [data-works-editor] :is(.gallery-item[data-image-id], [data-project-block] > .gallery-project-fields, [data-carousel-block]) {
    cursor: pointer;
  }

  /* What is picked: a dark ring round the work, the project's heading or the
     carousel. */
  .works-stage.has-epanel .is-epicked {
    outline: 2px solid var(--color-dark);
    outline-offset: 6px;
    border-radius: 6px !important;
  }

  /* The stand-in left where the words were: the page's own type. */
  .epanel-ghost {
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0.55;
  }

  .epanel-ghost:empty {
    display: none;
  }
</style>
