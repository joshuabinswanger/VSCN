    .nav-sub,
    .nav-acct {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      margin-top: -0.35rem;
    }
    .nav-sub .nav-link::after,
    .nav-acct .nav-link::after {
