       stretches the full width and eats taps across the bottom strip. */
  }
</style>

<script>
  import "../lib/pressFeedback.ts";
  import { auth } from "../lib/firebase.ts";
  import { onAuthStateChanged } from "firebase/auth";
  import { savePreferredLanguage } from "../lib/firestore.ts";
  import { rememberSessionChoice, type SiteLanguage } from "../lib/siteLanguage.ts";

  // ── MENU ──────────────────────────────────────────────
  // Opens and closes the drop-down; a click outside it, Escape, or leaving
  // the page closes it. The nav is persisted across page changes, so it is
  // closed on the navigation itself or it would stay open on the next page.
  // The open state is the button's aria-expanded and nothing else: the CSS
  // shows and animates the list from it (see the drop-down in the style
  // block), so there is no `hidden` to toggle and no exit to wait for here.
  function setMenu(open: boolean) {
    document.getElementById("nav-menu-btn")?.setAttribute("aria-expanded", String(open));
    // A header that had ridden away comes back to hold the cross
    // (global.css, Layout.astro).
    if (open) delete document.documentElement.dataset.headerAway;
  }
  // The menu is the phone's only (on a desktop the pills are always shown),
  // so crossing the breakpoint closes it: a phone menu left open must not
  // come back open after a round trip through the desktop width. The query is
  // --bp-mobile (global.css), which a script cannot read by name.
  window
    .matchMedia("(width <= 767px), (pointer: coarse) and (height <= 500px)")
    .addEventListener("change", () => setMenu(false));
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target?.closest?.("#nav-menu-btn")) return;
    const btn = document.getElementById("nav-menu-btn");
    setMenu(btn?.getAttribute("aria-expanded") !== "true");
  });
  // Outside presses close it at the capture phase: the gallery's pictures
  // and the lightbox stop their clicks from bubbling, and a menu left open
  // over an opened picture is the one place this must not survive.
  document.addEventListener(
    "pointerdown",
    (event) => {
      const target = event.target as Element | null;
      if (!target?.closest?.("#nav-menu, #nav-menu-btn")) setMenu(false);
    },
    { capture: true }
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      setMenu(false);
      setAccountMenu(false);
    }
  });

  // ── THE ACCOUNT MENU ──────────────────────────────────
  // On a desktop the profile button opens it instead of going to /profile.
  // Taken at the WINDOW's capture phase, ahead of the editor's leave guard
  // (editorDraft.ts), which stops link clicks at the document's: opening a
  // menu is not leaving the page.
  // --bp-mobile (custom-media.css), spelled out: a script cannot read it.
  const phone = window.matchMedia("(width <= 767px), (pointer: coarse) and (height <= 500px)");
  function setAccountMenu(open: boolean) {
    document.getElementById("nav-profile")?.setAttribute("aria-expanded", String(open));
  }
  window.addEventListener(
    "click",
    (event) => {
      const target = event.target as Element | null;
      const profile = target?.closest?.("#nav-profile");
      if (profile && !phone.matches) {
        event.preventDefault();
        event.stopPropagation();
        // On the editor the tabs are in the header already: the avatar is
        // the way back to the first one.
        if (profile.closest("nav")?.hasAttribute("data-editor")) {
          document.getElementById("tab-profile")?.click();
          return;
        }
        setAccountMenu(profile.getAttribute("aria-expanded") !== "true");
        return;
      }
      // A tab line on the editor page switches the tab in place.
      const tab = target?.closest?.<HTMLAnchorElement>(".nav-link--tab");
      const tabButton = tab && document.getElementById(`tab-${tab.dataset.tab}`);
      if (tab && tabButton) {
        event.preventDefault();
        event.stopPropagation();
        tabButton.click();
        setAccountMenu(false);
        setMenu(false);
      }
    },
    { capture: true }
  );
  document.addEventListener(
    "pointerdown",
    (event) => {
      const target = event.target as Element | null;
      if (!target?.closest?.("#nav-acct, #nav-profile")) setAccountMenu(false);
    },
    { capture: true }
  );
  document.addEventListener("astro:after-swap", () => setAccountMenu(false));
  // Closed once the new page is in, not when the old one starts to leave:
  // a tapped destination's arrow and the sheet's own leave play whole over
  // the arriving page, which Layout holds invisible for its pause anyway.
  // Two frames late: the persisted nav has just been moved into the new
  // document, and a style change in the same task as that move has no
  // before-change style to transition from — the sheet snapped shut.
  document.addEventListener("astro:after-swap", () => {
    requestAnimationFrame(() => requestAnimationFrame(() => setMenu(false)));
  });

  // The EN / DE switch is an explicit choice, and nothing may route against it:
  // it wins for this session, and a signed-in member's stored language follows
  // it — the same setting /profile labels "Your language". Registered once, at
  // module level: the toggle is transition:persist, and so is this script.
  // #footer-lang is the same switch in the phone footer (SiteFooter.astro);
  // delegation on document catches it although it is re-rendered every page.
  //
  // ON THE NAVIGATION, NOT THE CLICK (2026-09-29). The profile editor's leave
  // guard (editorDraft.ts) takes a link's click at the document's capture
  // phase and stops it there, so a click listener here never ran while the
  // editor was dirty: Leave landed on the other locale with no session
  // choice, and /profile routed the member straight back to the stored one.
  // `astro:before-preparation` fires for every navigation the router makes —
  // the ClientRouter's own and the guard's navigate() alike — and both pass
  // the link as `sourceElement`. It also fires only when the page is actually
  // left, so Stay records nothing. `documentElement.lang` is still the page
  // being left; the choice is its opposite.
  document.addEventListener("astro:before-preparation", (event) => {
    const toggle = event.sourceElement?.closest?.("#nav-lang, #footer-lang, #nav-sheet-lang, #nav-acct-lang");
    if (!toggle) return;
    const chosen: SiteLanguage = document.documentElement.lang === "de" ? "en" : "de";
    rememberSessionChoice(chosen);
    const user = auth.currentUser;
    if (!user) return;
    savePreferredLanguage(user.uid, chosen).catch((err) => {
      console.warn("[nav] Language preference not saved:", err);
    });
  });

  type Lang = "en" | "de";

  const navLabels: Record<
    Lang,
    {
      info: string;
      community: string;
      tabs: [string, string, string];
      views: [string, string, string];
      login: string;
      signup: string;
      profile: string;
    }
  > = {
    en: {
      info: "INFO",
      community: "COMMUNITY",
      tabs: ["PROFILE", "WORK", "ACCOUNT"],
      views: ["PORTFOLIOS", "IMAGES", "PEOPLE"],
      login: "LOGIN",
      signup: "SIGN UP",
      profile: "PROFILE",
    },
    de: {
      info: "INFO",
      community: "COMMUNITY",
      tabs: ["PROFIL", "ARBEITEN", "KONTO"],
      views: ["PORTFOLIOS", "BILDER", "MENSCHEN"],
      login: "ANMELDEN",
      signup: "REGISTRIEREN",
      profile: "PROFIL",
    },
  };

  let unsubscribeAuth: (() => void) | null = null;

  function normalisePath(path: string): string {
    return path.replace(/\/+$/, "") || "/";
  }

  // THE CHIP WIPES BEFORE THE PAGE SWAPS (2026-10-19, Josh: "do animation
  // of nav elements before page swap"): Layout's leave sequence holds the
  // swap while the old page fades, so the destination's chip is marked at
  // before-preparation and its wipe plays through that fade instead of on
  // the new page's first frames. page-load marks it again, harmlessly.
  document.addEventListener("astro:before-preparation", (event) => {
    const to = (event as unknown as { to?: URL }).to;
    if (to) setActiveLink(to.pathname);
  });

  // THE EDITOR'S TABS IN THE HEADER (see nav[data-editor] in the style
  // block): which tab is current is the editor's own aria-selected, watched
  // for as long as the page stands. Set on page load, once the page's own
  // tab row is in the document.
  let tabObserver: MutationObserver | null = null;
  function syncEditorTabs() {
    const current = document.querySelector<HTMLElement>('#section-tabs [role="tab"][aria-selected="true"]')?.dataset
      .section;
    document.querySelectorAll<HTMLElement>(".nav-link--tab").forEach((link) => {
      link.classList.toggle("is-current", link.dataset.tab === current);
    });
  }
  function setEditorMode() {
    tabObserver?.disconnect();
    tabObserver = null;
    const nav = document.querySelector<HTMLElement>('nav[data-astro-transition-persist="navbar"]');
    if (!nav) return;
    const tabs = document.getElementById("section-tabs");
    if (!tabs) {
      nav.removeAttribute("data-editor");
      document.querySelectorAll(".nav-link--tab").forEach((link) => link.classList.remove("is-current"));
      return;
    }
    nav.setAttribute("data-editor", "");
    syncEditorTabs();
    tabObserver = new MutationObserver(syncEditorTabs);
    tabObserver.observe(tabs, { subtree: true, attributes: true, attributeFilter: ["aria-selected"] });
  }
  document.addEventListener("astro:before-swap", () => tabObserver?.disconnect());

  function setActiveLink(pathname = window.location.pathname) {
    const path = normalisePath(pathname);
    document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
      // The account menu's lines are the editor's tabs, not pages.
      if (link.classList.contains("nav-link--lang") || link.classList.contains("nav-link--sub")) return;
      const isActive = normalisePath(link.pathname) === path;
      link.classList.toggle("nav-link--active", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Update nav links and language toggle for the given language + current path.
  // Called both in astro:before-swap (with new page values) and astro:page-load.
  function updateNavLinks(lang: Lang, currentPath: string) {
    const prefix = lang === "de" ? "/de" : "";
    const labels = navLabels[lang];
    const normPath = normalisePath(currentPath);

    const navInfo = document.getElementById("nav-info") as HTMLAnchorElement | null;
    const navCommunity = document.getElementById("nav-community") as HTMLAnchorElement | null;
    const navJoin = document.getElementById("nav-join") as HTMLAnchorElement | null;
    const navProfile = document.getElementById("nav-profile") as HTMLAnchorElement | null;
    const navSignup = document.getElementById("nav-signup") as HTMLAnchorElement | null;
    const navLang = document.getElementById("nav-lang") as HTMLAnchorElement | null;
    const sheetLang = document.getElementById("nav-sheet-lang") as HTMLAnchorElement | null;
    const acctLang = document.getElementById("nav-acct-lang") as HTMLAnchorElement | null;

    // The directory (and the bare root, which is it) has its own views bar.
    const bare = normalisePath(normPath.replace(/^\/de(?=\/|$)/, "")) || "/";
    document
      .querySelector('nav[data-astro-transition-persist="navbar"]')
      ?.toggleAttribute("data-directory", bare === "/" || bare === "/community");
    // The account pages: the editor and the sign-in flow.
    document
      .querySelector('nav[data-astro-transition-persist="navbar"]')
      ?.toggleAttribute(
        "data-account",
        /^\/(profile|login|signup|onboarding|verify-email|auth)(\/|$)/.test(bare),
      );
    const portfolios = document.getElementById("nav-portfolios") as HTMLAnchorElement | null;
    if (portfolios) {
      portfolios.href = `${prefix}/community`;
      const word = portfolios.querySelector("span");
      if (word) word.textContent = labels.views[0];
    }

    if (navInfo) {
      navInfo.href = `${prefix}/info`;
      navInfo.textContent = labels.info;
    }
    if (navCommunity) {
      navCommunity.href = `${prefix}/community`;
      navCommunity.textContent = labels.community;
    }
    document.querySelectorAll<HTMLAnchorElement>(".nav-link--view").forEach((link, k) => {
      const pattern = link.dataset.pattern;
      link.href = `${prefix}/community${pattern ? `?pattern=${pattern}` : ""}`;
      link.textContent = labels.views[k] ?? link.textContent;
    });
    document.querySelectorAll<HTMLAnchorElement>(".nav-link--tab").forEach((link, k) => {
      link.href = `${prefix}/profile?tab=${link.dataset.tab}`;
      link.textContent = labels.tabs[k] ?? link.textContent;
    });
    if (navJoin) {
      navJoin.href = `${prefix}/login`;
      navJoin.textContent = labels.login;
    }
    if (navProfile) {
      navProfile.href = `${prefix}/profile`;
      const word = navProfile.querySelector(".nav-profile__word");
      if (word) word.textContent = labels.profile;
      navProfile.setAttribute("aria-label", labels.profile);
    }
    if (navSignup) {
      navSignup.href = `${prefix}/onboarding`;
      navSignup.textContent = labels.signup;
    }

    for (const toggle of [navLang, sheetLang, acctLang]) {
      if (!toggle) continue;
      if (lang === "de") {
        const enPath = normalisePath(normPath.replace(/^\/de/, "")) || "/";
        toggle.href = enPath;
        toggle.innerHTML =
          '<span class="lang-tgt">EN</span><span class="lang-sep"> / </span><span class="lang-cur">DE</span>';
      } else {
        toggle.href = "/de" + normPath;
        toggle.innerHTML =
          '<span class="lang-cur">EN</span><span class="lang-sep"> / </span><span class="lang-tgt">DE</span>';
      }
    }
  }

  // Pre-update the nav BEFORE the DOM swap so there is no flash of
  // wrong-language links during the View Transition animation.
  document.addEventListener("astro:before-swap", (e) => {
    const event = e as unknown as { newDocument?: Document };
    const newDoc = event.newDocument;
    if (!newDoc) return;
    const newLang = (newDoc.documentElement?.lang ?? "en") as Lang;
    const newPath = newDoc.URL
      ? normalisePath(new URL(newDoc.URL).pathname)
      : normalisePath(window.location.pathname);
    updateNavLinks(newLang === "de" ? "de" : "en", newPath);
  });

  // Handle initial page load and post-navigation cleanup (active link, auth).
  document.addEventListener("astro:page-load", () => {
    const lang = (document.documentElement.lang ?? "en") as Lang;
    updateNavLinks(lang === "de" ? "de" : "en", window.location.pathname);
    setActiveLink();
    setEditorMode();

    const navJoin = document.getElementById("nav-join");
    const navProfile = document.getElementById("nav-profile");
    const navSignup = document.getElementById("nav-signup");
    if (!navJoin || !navProfile) return;

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthStateChanged(auth, (user) => {
      navJoin.style.display = user ? "none" : "block";
      if (navSignup) navSignup.style.display = user ? "none" : "block";
      navProfile.style.display = user ? "block" : "none";
      const acct = document.getElementById("nav-acct");
      if (acct) acct.style.display = user ? "flex" : "none";
      navProfile.closest("nav")?.classList.toggle("is-signed-in", !!user);
      // The avatar, when Auth holds one (profile.ts keeps it in step with the
      // saved photo). A photo that fails to load falls back to the word.
      const pic = navProfile.querySelector(".nav-profile__pic") as HTMLImageElement | null;
      const url = user?.photoURL ?? "";
      if (pic && url) {
        pic.onerror = () => navProfile.classList.remove("has-pic");
        if (pic.src !== url) pic.src = url;
        navProfile.classList.add("has-pic");
      } else {
        navProfile.classList.remove("has-pic");
        if (pic) pic.removeAttribute("src");
      }
      // THE PHONE'S MENU KEY IS THE MEMBER'S FACE (2026-10-28, Josh: "top
      // right should be the avatar when logged in!"): the same picture on the
      // hamburger, which turns to the cross while the sheet is open.
      const menuBtn = document.getElementById("nav-menu-btn");
      const menuPic = menuBtn?.querySelector(".nav-menu-btn__pic") as HTMLImageElement | null;
      if (menuBtn && menuPic && url) {
        menuPic.onerror = () => menuBtn.classList.remove("has-pic");
        if (menuPic.src !== url) menuPic.src = url;
        menuBtn.classList.add("has-pic");
      } else if (menuBtn) {
        menuBtn.classList.remove("has-pic");
        menuPic?.removeAttribute("src");
      }
      setActiveLink();
    });
  });
</script>
