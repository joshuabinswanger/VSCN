    }
    #nav-tab-account {
      order: 1;
    }
    #nav-tab-profile {
      order: 2;
    }
    #nav-tab-work {
      order: 3;
    }
    .nav-link--lang {
      align-self: center;
    }

    /* THE ACCOUNT FOLDS OUT ON THE EDITOR (2026-10-29, Josh: "make the top
       navbar on profile fold out like on desktop"). Signed in on /profile
       the menu key opens no sheet: ACCOUNT / PROFILE / WORK grow out of it
       to the left in one outlined pill on the header's line, the outline
       running round the face, as the desktop's open account pill (board
       04). On the editor a tab switches in place and folds it back (the
       script's tab handler); elsewhere it opens /profile on that tab. The
       sheet's list is that strip: fixed on the header's line at the right,
       as wide as the pill, the language switch left out (the footer has
       it). ON EVERY PAGE, SIGNED IN (2026-10-29, Josh: "make the pill
       interaction on the profile consistent sometimes it still brings up
       the full screen selection"): it keyed on nav[data-editor], so off
       /profile the same face opened the full sheet. Signed out, the menu
       key is still the hamburger and its sheet. */
    nav.is-signed-in .nav-links {
      /* 9px, so the pill's 38px end holds the 30px face 4px in, as the
         views pill holds its buttons (the key sits 8px in, its face 6px
         inside that). */
      inset: 0 9px auto auto;
      height: var(--header-h);
      padding: 0;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      background: none;
      touch-action: auto;
      opacity: 1;
      transition: visibility 0s linear 0.35s;
    }
    nav.is-signed-in .nav-menu-btn[aria-expanded="true"] ~ .nav-links {
      opacity: 1;
      transition: visibility 0s linear 0s;
    }
    /* OUT OF THE FACE (2026-10-29, Josh: "pill needs to extend from
       profile"). The pill keeps its full size and is CLIPPED: shut, the clip
       is the ring round the face; open, it runs out leftward over the whole
       pill, and the tabs follow it out, the nearest first. Until today its
