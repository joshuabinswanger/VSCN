      transition: background-color 0.2s ease;
    }
    nav.is-signed-in .nav-links .nav-acct .nav-link {
      flex: none;
      height: 30px;
      /* 10px, not 12: open, the pill must stay clear of VSCN at 360px. */
      padding: 0 10px;
      white-space: nowrap;
      opacity: 0;
      transform: translateX(14px);
      transition:
