        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) calc(60ms + var(--i, 0) * 60ms);
    }
    .nav-links .nav-link:visited {
      color: var(--nav-ink);
    }
    .nav-links .nav-link:hover {
      text-decoration: none;
    }
    /* No wipe layer on the sheet. THE MARK IS A LINE THAT SWEEPS (2026-10-20,
       Josh: "another animation element than the arrow"): a rule under the
       current page's word, drawn in from the left on the site's curve; when
       another destination is tapped it leaves the old word to the right as
       it arrives under the new one, the way the desktop's underline reads. */
    .nav-links .nav-link::before {
      display: none;
    }
    .nav-links .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.1em;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.35s cubic-bezier(0.5, 0, 0.75, 0);
    }
    .nav-links .nav-link--active::after {
      transform: none;
      transform-origin: left;
      transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
    }
    .nav-link--lang {
      --i: 5;
      margin-top: 1.4rem;
    }
    /* The editor's bar would stand over the open sheet. */
    :root:has(#nav-menu-btn[aria-expanded="true"]) .form-footer {
