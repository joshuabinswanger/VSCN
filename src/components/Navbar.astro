  .nav-menu-btn__pic {
    display: none;
  }

  /* THE PORTFOLIOS KEY: an outlined pill with a back chevron, the editor's
     ‹ Projects drawn at the header's size, centred in the header row. */
  .nav-portfolios {
    position: fixed;
    top: calc((var(--header-h) - 30px) / 2);
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    display: none;
    align-items: center;
    gap: 4px;
    box-sizing: border-box;
    height: 30px;
    padding: 0 14px 0 9px;
    border-radius: var(--radius-pill) !important;
    box-shadow: inset 0 0 0 1px var(--color-border);
    background: var(--nav-paper);
    color: var(--nav-ink);
