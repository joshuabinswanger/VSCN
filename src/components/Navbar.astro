      }
    }
    .nav-links {
      position: fixed;
      inset: 0;
      z-index: 0;
      width: auto;
      justify-content: center;
      /* Taller lines than the type alone, so the rule has room. */
      gap: 1.1rem;
      padding: var(--header-h) 8px 7vh;
      box-sizing: border-box;
