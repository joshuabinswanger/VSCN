    }
    .nav-link--lang::after {
      display: none;
    }
    .nav-link--lang .lang-sep,
    .nav-link--lang .lang-tgt {
      color: var(--color-muted);
    }
    /* THE SHEET REFLECTS THE DESKTOP (2026-10-28, Josh: "update the mobile
       menu. it should reflect the desktop version"). The header's own
       controls, as pills, centred: LOGIN and SIGN UP signed out; signed in,
       the account's three tabs in one outlined capsule with the current one
       black, as the desktop's open account pill. The language switch
       is in the footer. Info is behind VSCN and the directory behind the Portfolios
       key, so the large-type destinations (and Community's views) are not
       drawn; nor is PROFILE, whose tabs are on the sheet. */
    #nav-info,
    #nav-community,
    #nav-views,
    #nav-profile {
      display: none !important;
    }
    .nav-links {
      align-items: center;
    }
    .nav-right-group {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .nav-links .nav-link {
      align-self: center;
    }
    .nav-links .nav-link::after {
      display: none;
    }
    /* LOGIN AND SIGN UP AT THE TOP RIGHT (2026-10-31, Josh: "make the
       Login/ Signup Button be in the top right when opening the menu. the
       EN/DE Swtich can sit in the bottom where the impressum etc ist"). The
       two pills stand on the header's line, left of the cross, at the bar's
       38px; the language switch leaves the sheet for the footer, which
       already carries it (as the signed-in strip left it out). */
    nav:not(.is-signed-in) .nav-right-group {
      position: absolute;
      top: 0;
      right: 56px;
      height: var(--header-h);
      flex-wrap: nowrap;
      gap: 8px;
    }
    #nav-sheet-lang {
      display: none;
    }
    /* Padding, not height: the script sets these two an inline display. */
    .nav-links #nav-join,
    .nav-links #nav-signup {
      box-sizing: border-box;
      min-height: 38px;
      padding: 12px 16px 11px;
      white-space: nowrap;
      border-radius: var(--radius-pill) !important;
    }
    .nav-links #nav-join {
      box-shadow: inset 0 0 0 1px var(--color-border);
    }
    .nav-links #nav-signup,
    .nav-links #nav-signup:visited {
      background: var(--nav-ink);
      color: var(--nav-paper);
    }
    .nav-links .nav-acct {
      flex-direction: row;
      align-items: center;
      gap: 2px;
      margin: 0;
      padding: 4px;
      border-radius: var(--radius-pill) !important;
      box-shadow: inset 0 0 0 1px var(--color-border);
    }
    .nav-links .nav-acct .nav-link {
      display: flex;
      align-items: center;
      height: 40px;
      padding: 0 18px;
      border-radius: var(--radius-pill) !important;
