    /* 38px TALL (2026-10-30, Josh: "open account pill should be changed
       too"): the pill stood 42px, the bar's circles 38. Since 2026-10-31 the
       face is 30 and sits inside its right end, as a button in a pill. */
    nav.is-signed-in .nav-links .nav-acct {
      box-sizing: border-box;
      padding: 4px 38px 4px 4px;
      box-shadow: inset 0 0 0 1px var(--color-border);
      background: var(--nav-paper);
      clip-path: inset(0 0 0 calc(100% - 38px) round 999px);
      opacity: 0;
      transition:
