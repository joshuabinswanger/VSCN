    .nav-links .nav-link--profile.has-pic .nav-profile__pic {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .nav-links .nav-link--profile.has-pic:hover {
      text-decoration: none;
      opacity: 0.85;
    }

  }
  /* The editor's own tab row is not drawn once the header carries the tabs
     (nav[data-editor] is set by the script below). ON A PHONE TOO since
     2026-10-28 (Josh: "loose the top menu in the account in mobile so you
     switch only from the menu"): the sheet's ACCOUNT / PROFILE / WORK switch
     the tab in place and close the sheet. */
  :root:has(nav[data-editor].is-signed-in) .section-tabs {
    display: none;
  }
  /* The picture is a desktop thing: the phone's sheet shows the word. */
  .nav-profile__pic {
    display: none;
  }

  .lang-toggle {
    position: fixed;
    bottom: 20px;
    right: 30px;
    z-index: 20;
    font-family: "Archivo", sans-serif;
    /* Shared with .site-footer, which is the other half of this bar — see
       --font-size-chrome in global.css. Moving one without the other puts the
