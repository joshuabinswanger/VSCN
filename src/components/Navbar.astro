    /* Not display: contents — WebKit's WebContent process died on the page
       change with the sheet open while the group was (headless 2368, the
       same family as documentation/20260831-webkit-details-display-contents-crash.md). */
    .nav-right-group {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .nav-links .nav-link {
      position: relative;
      display: inline-flex;
      align-items: baseline;
      align-self: flex-start;
      width: auto;
      padding: 0;
      background: none;
      box-shadow: none;
      color: var(--nav-ink);
      opacity: 0;
      transform: translateY(1.1rem);
      transition:
        opacity 0.18s ease calc((2 - var(--i, 0)) * 30ms),
        transform 0.24s ease-in calc((2 - var(--i, 0)) * 30ms);
    }
    .nav-menu-btn[aria-expanded="true"] ~ .nav-links .nav-link {
      opacity: 1;
      transform: none;
      transition:
