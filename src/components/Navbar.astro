    }
    .nav-menu-btn.has-pic:not([aria-expanded="true"]) .nav-burger {
      opacity: 0;
    }
  }

  @media (--bp-mobile) {
    /* THE HAMBURGER (2026-10-13, Josh: "a hamburger will be better"): the
       button becomes a 36px tap target holding three black bars on the bare
       page (2026-10-15, Josh: "just black lines not a black dot with lines";
       it was a black square with white bars until then), the word MENU
       clipped out of sight (it stays as the button's name), and the drop-down
       it opens is the three chips, a touch roomier than on a desktop for a
       thumb. Both sit 8px in from the screen edge, where the title sits on
       the left. */
    nav[data-astro-transition-persist="navbar"] {
      --nav-chip-pad: 9px 12px 8px;
      padding-right: 8px;
    }
    .nav-menu-btn {
      /* 40px since 2026-10-28 ("mobile ui buttons a bit bigger"). */
      width: 40px;
      height: 40px;
      padding: 0;
      justify-content: center;
      background: transparent;
      color: var(--nav-ink);
    }
    .nav-menu-btn:hover,
