    nav.is-signed-in #nav-tab-profile {
      --acct-delay: 90ms;
    }
    nav.is-signed-in #nav-tab-account {
      --acct-delay: 140ms;
    }
    /* Open, the key keeps the face inside the pill, not the cross. */
    nav.is-signed-in .nav-menu-btn.has-pic .nav-menu-btn__pic {
      opacity: 1;
    }
    nav.is-signed-in .nav-menu-btn.has-pic .nav-burger {
      opacity: 0;
    }
    :root:has(nav[data-editor].is-signed-in #nav-menu-btn[aria-expanded="true"]) .form-footer {
      visibility: visible;
    }

    /* The page stays put under the sheet by the sheet's own touch-action
       above, NOT by overflow: hidden on the root: that rule, swapped off
       the <html> mid view transition on the page change, crashed WebKit's
