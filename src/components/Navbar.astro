---
import "../styles/global.css";
// After global.css on purpose: a text style must win a tie with a global
// component rule on the same element (see the ORDER note in type.css).
import "../styles/type.css";
---

<nav transition:persist="navbar">
  <div class="nav-links">
    <a href="/info" class="nav-link" id="nav-info">INFO</a>
    <a href="/community" class="nav-link nav-center" id="nav-community">COMMUNITY</a>
    <div class="nav-right-group">
      <a href="/login" class="nav-link" id="nav-join">LOGIN</a>
      <a href="/profile" class="nav-link" id="nav-profile" style="display:none;">PROFILE</a>
    </div>
  </div>
</nav>

<a href="/de" class="lang-toggle" id="nav-lang" transition:persist="lang-toggle">
  <span class="lang-cur">EN</span><span class="lang-sep"> / </span><span class="lang-tgt">DE</span>
</a>

{/* Persisted navigation keeps its DOM across page swaps, including its old
     scope attributes after a deployment. Stable selectors keep the new page's
     stylesheet matching those links. */}
<style is:global>
  nav[data-astro-transition-persist="navbar"] {
    position: sticky;
    top: 0;
    z-index: 10;
    line-height: 1;
  }

  /* THE BACKDROP IS A LAYER BEHIND THE LINKS, NOT THE NAV'S BACKGROUND
     (2026-09-25: the page shows through while scrolling). It is a
     pseudo-element because a backdrop-filter on the nav itself would make it
     the containing block for any fixed-position descendant. (Until
     2026-10-12 it also reached further down than the nav's own box, stretched
     by a --nav-backdrop-extend that /community measured so one veil ran on
     behind the filter bar docked under the nav; that bar now floats at the
     bottom of the viewport and paints its own paper, so the layer is the
     nav's box again.)
     z-index -1 is inside the nav's own stacking context (sticky + z-index), so
     the veil sits under the links and over whatever scrolls behind.
     Both values are tokens in global.css and currently say "nothing" — the
     header is bare. The layer stays so frosting can come back as a token
     change. */
  nav[data-astro-transition-persist="navbar"]::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--color-bg-veil);
    -webkit-backdrop-filter: var(--veil-filter);
    backdrop-filter: var(--veil-filter);
  }

  .nav-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    /* THREE EQUAL BARS (2026-10-12, Josh: "3 same width bars with a small
       gap in between"): each link fills its third, the gap between them. */
    column-gap: 4px;
    padding: 0px 5px;
    width: 100%;
    /* Shared with the brand ticker and <main> — see --shell-max in
       global.css. 5px here plus the links' own 10px puts the nav text on
       main's 15px content edge at any measure. */
    max-width: var(--shell-max);
    box-sizing: border-box;
    margin: 0 auto;
  }

  .nav-link {
    position: relative;
    /* The link's own stacking context, so the active block's wipe (::before,
       z-index -1) paints over the bar's fill and under the type. */
    isolation: isolate;
    display: block;
    justify-self: stretch;
    text-align: center;
    padding: 10px;
    font-family: "Archivo", sans-serif;
    font-size: var(--fs-100);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-dark);
    white-space: nowrap;
    /* RECTANGLES, NOT AN UNDERLINE (2026-10-12, Josh: "top nav bar should
       have rectangular backgrounds. instead of underline they should get a
       black background when selected"). Each link's padding box IS its
       rectangle: square corners, a faint fill on hover, and the current page
       a solid black block with paper-coloured type. */
    border-radius: 0;
    /* A PERSISTENT GROUND (2026-10-12, Josh: "nav bar needs to have
       persistent bg. bg color when inactive, black when active"): every bar
       carries the page's own colour at rest — opaque, so the page scrolling
       under the sticky nav never shows through a bar ("same colour as the
       bg, not this weird grey", the same day) — a faint tint under the
       pointer, and black for the current page. */
    background: var(--color-bg);
    transition:
      background-color 0.2s ease,
      color 0.25s ease 0.08s;
  }

  /* THE BLACK WIPES IN ("make the animation more flashy!"). The current
     page's block is a layer under the type that sweeps across the bar from
     the left on an overshooting curve, rather than the fill fading in. The
     nav is persisted across page changes, so the class moving from one link
     to the next plays the sweep out of the old bar and into the new one. */
  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-dark);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.28s cubic-bezier(0.5, 0, 0.75, 0);
  }

  /* NO GREY ON HOVER (2026-10-12, Josh: "the grey hover tone I don't like,
     use something else"): the bar draws its own black frame instead — the
     same black as the current page's block, as an outline. */
  .nav-link:hover {
    color: var(--color-dark);
    box-shadow: inset 0 0 0 1px var(--color-dark);
  }

  .nav-link--active,
  .nav-link--active:visited,
  .nav-link--active:hover {
    color: var(--color-bg);
  }
  .nav-link--active::before {
    transform: scaleX(1);
    transform-origin: 0% 50%;
    transition: transform 0.55s cubic-bezier(0.2, 1.25, 0.35, 1) 0.05s;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::before,
    .nav-link--active::before {
      transition: none;
    }
  }

  /* TOP RIGHT, AND SMALLER, ON A DESKTOP (2026-10-12, Josh: "navbar should
     be smaller buttons and on desktop it should be in the top right"). The
     three bars keep one width between them and ride the window's right edge
     at the content's 15px, under the title — and once the title has ridden
     up, in the window's top-right corner. */
  @media (--bp-desktop) {
    .nav-links {
      display: flex;
      justify-content: flex-end;
      gap: 4px;
      max-width: none;
      padding: 6px 15px 0;
    }
    .nav-link {
      flex: none;
      box-sizing: border-box;
      width: 7.5rem;
      padding: 6px 8px;
      font-size: var(--fs-82);
    }
    .nav-right-group {
      flex: none;
      box-sizing: border-box;
      width: 7.5rem;
    }
    .nav-right-group > .nav-link {
      width: auto;
    }
  }

  .nav-link:focus-visible {
    outline: 1.5px solid var(--color-dark);
    outline-offset: 2px;
  }

  .nav-center {
    justify-self: stretch;
  }

  /* LOGIN and PROFILE share the third bar — only one of them is shown at a
     time — and whichever it is fills it. */
  .nav-right-group {
    display: flex;
    gap: 4px;
    justify-self: stretch;
    align-items: stretch;
  }
  .nav-right-group > .nav-link {
    flex: 1 1 0;
  }

  .lang-toggle {
    position: fixed;
    bottom: 20px;
    right: 30px;
    z-index: 20;
    font-family: "Archivo", sans-serif;
    /* Shared with .site-footer, which is the other half of this bar — see
       --font-size-chrome in global.css. Moving one without the other puts the
       bottom-left and bottom-right text on visibly different lines. */
    font-size: var(--font-size-chrome);
    text-decoration: none;
  }

  .lang-toggle .lang-sep {
    color: var(--color-muted);
  }

  .lang-toggle .lang-cur {
    color: var(--color-dark);
    font-weight: 600;
  }

  .lang-toggle .lang-tgt {
    color: var(--color-muted);
    font-weight: 400;
    transition: color 0.15s;
  }

  .lang-toggle:hover .lang-tgt {
    color: var(--color-dark);
  }

  /* On mobile the navbar is the top edge of the page — the giant title rides
     up out of the way on scroll (see Layout.astro) and leaves the links
     standing alone up there.
     THEY SIT CLOSER TO THE EDGE THAN THE CONTENT DOES (2026-09-01, Josh:
     "less border gap for the info and login on mobile"). Two failed extremes
     bracket this number. At 0 the row ran hard against the viewport and
     "LOGIN" fell off the right edge at 375px, because a link ranged against
     the screen has nothing left to give. At 15px — the content edge that
     .brand-name and <main> both hold (see --shell-max in CLAUDE.md) — INFO and
     LOGIN read as two more items in the column of cards rather than as the
     frame around them. 8px keeps the outermost letters clear of the edge while
     letting the row sit outside the content measure, which is what makes it
     read as chrome. Desktop keeps the shared measure, where 5px plus the
     links' own 10px lands on the content edge. */
  @media (--bp-mobile) {
    .nav-links {
      /* The 8px that kept the outermost letters off the screen edge now lives
         INSIDE each link, as the rectangle's side padding — the type stays
         where it was and the black block has room around it. */
      padding: 0;
    }

    .nav-link {
      /* Tighter to the title above it — on a phone the two read as one block,
         so the 10px the desktop row uses to breathe just looks like a gap. */
      padding: 5px 8px 6px;
      font-size: var(--fs-90);
    }

    .nav-links {
      column-gap: 3px;
    }

    /* NOT FLOATING ON A PHONE (2026-09-24, Josh: "the language switch on
       mobile has to be placed underneath, so when you scroll all the way to
       the bottom, above the impressum etc. think from a UX perspective").
       Earlier the same day it went bottom-left to leave the right corner to
       Save — and a fixed switch on a phone still sat over whatever scrolled
       under it. On every page with a footer, the footer's own copy
       (#footer-lang, SiteFooter.astro) replaces it at the end of the page;
       the rule that hides this one lives in Layout.astro, which knows whether
       the page has a footer (`.page-wrap.has-footer`). A `:global(body:has())`
       selector here was dropped from the compiled CSS without a word.
       The fullscreen landing hero renders no footer, so there this one stays
       in its bottom-right corner — hiding it would leave no switch at all.
       If it is ever mirrored to the left again, set `right: auto` too:
       position:fixed blockifies the anchor, and with both offsets set the box
       stretches the full width and eats taps across the bottom strip. */
  }
</style>

<script>
  import { auth } from "../lib/firebase.ts";
  import { onAuthStateChanged } from "firebase/auth";
  import { savePreferredLanguage } from "../lib/firestore.ts";
  import { rememberSessionChoice, type SiteLanguage } from "../lib/siteLanguage.ts";

  // The EN / DE switch is an explicit choice, and nothing may route against it:
  // it wins for this session, and a signed-in member's stored language follows
  // it — the same setting /profile labels "Your language". Registered once, at
  // module level: the toggle is transition:persist, and so is this script.
  // #footer-lang is the same switch in the phone footer (SiteFooter.astro);
  // delegation on document catches it although it is re-rendered every page.
  //
  // ON THE NAVIGATION, NOT THE CLICK (2026-09-29). The profile editor's leave
  // guard (editorDraft.ts) takes a link's click at the document's capture
  // phase and stops it there, so a click listener here never ran while the
  // editor was dirty: Leave landed on the other locale with no session
  // choice, and /profile routed the member straight back to the stored one.
  // `astro:before-preparation` fires for every navigation the router makes —
  // the ClientRouter's own and the guard's navigate() alike — and both pass
  // the link as `sourceElement`. It also fires only when the page is actually
  // left, so Stay records nothing. `documentElement.lang` is still the page
  // being left; the choice is its opposite.
  document.addEventListener("astro:before-preparation", (event) => {
    const toggle = event.sourceElement?.closest?.("#nav-lang, #footer-lang");
    if (!toggle) return;
    const chosen: SiteLanguage = document.documentElement.lang === "de" ? "en" : "de";
    rememberSessionChoice(chosen);
    const user = auth.currentUser;
    if (!user) return;
    savePreferredLanguage(user.uid, chosen).catch((err) => {
      console.warn("[nav] Language preference not saved:", err);
    });
  });

  type Lang = "en" | "de";

  const navLabels: Record<
    Lang,
    { info: string; community: string; login: string; profile: string }
  > = {
    en: { info: "INFO", community: "COMMUNITY", login: "LOGIN", profile: "PROFILE" },
    de: { info: "INFO", community: "COMMUNITY", login: "ANMELDEN", profile: "PROFIL" },
  };

  let unsubscribeAuth: (() => void) | null = null;

  function normalisePath(path: string): string {
    return path.replace(/\/+$/, "") || "/";
  }

  function setActiveLink() {
    const path = normalisePath(window.location.pathname);
    document.querySelectorAll<HTMLAnchorElement>(".nav-link").forEach((link) => {
      if (link.id === "nav-lang") return;
      const isActive = normalisePath(link.pathname) === path;
      link.classList.toggle("nav-link--active", isActive);
      if (isActive) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  // Update nav links and language toggle for the given language + current path.
  // Called both in astro:before-swap (with new page values) and astro:page-load.
  function updateNavLinks(lang: Lang, currentPath: string) {
    const prefix = lang === "de" ? "/de" : "";
    const labels = navLabels[lang];
    const normPath = normalisePath(currentPath);

    const navInfo = document.getElementById("nav-info") as HTMLAnchorElement | null;
    const navCommunity = document.getElementById("nav-community") as HTMLAnchorElement | null;
    const navJoin = document.getElementById("nav-join") as HTMLAnchorElement | null;
    const navProfile = document.getElementById("nav-profile") as HTMLAnchorElement | null;
    const navLang = document.getElementById("nav-lang") as HTMLAnchorElement | null;

    if (navInfo) {
      navInfo.href = `${prefix}/info`;
      navInfo.textContent = labels.info;
    }
    if (navCommunity) {
      navCommunity.href = `${prefix}/community`;
      navCommunity.textContent = labels.community;
    }
    if (navJoin) {
      navJoin.href = `${prefix}/login`;
      navJoin.textContent = labels.login;
    }
    if (navProfile) {
      navProfile.href = `${prefix}/profile`;
      navProfile.textContent = labels.profile;
    }

    if (navLang) {
      if (lang === "de") {
        const enPath = normalisePath(normPath.replace(/^\/de/, "")) || "/";
        navLang.href = enPath;
        navLang.innerHTML =
          '<span class="lang-tgt">EN</span><span class="lang-sep"> / </span><span class="lang-cur">DE</span>';
      } else {
        navLang.href = "/de" + normPath;
        navLang.innerHTML =
          '<span class="lang-cur">EN</span><span class="lang-sep"> / </span><span class="lang-tgt">DE</span>';
      }
    }
  }

  // Pre-update the nav BEFORE the DOM swap so there is no flash of
  // wrong-language links during the View Transition animation.
  document.addEventListener("astro:before-swap", (e) => {
    const event = e as unknown as { newDocument?: Document };
    const newDoc = event.newDocument;
    if (!newDoc) return;
    const newLang = (newDoc.documentElement?.lang ?? "en") as Lang;
    const newPath = newDoc.URL
      ? normalisePath(new URL(newDoc.URL).pathname)
      : normalisePath(window.location.pathname);
    updateNavLinks(newLang === "de" ? "de" : "en", newPath);
  });

  // Handle initial page load and post-navigation cleanup (active link, auth).
  document.addEventListener("astro:page-load", () => {
    const lang = (document.documentElement.lang ?? "en") as Lang;
    updateNavLinks(lang === "de" ? "de" : "en", window.location.pathname);
    setActiveLink();

    const navJoin = document.getElementById("nav-join");
    const navProfile = document.getElementById("nav-profile");
    if (!navJoin || !navProfile) return;

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthStateChanged(auth, (user) => {
      navJoin.style.display = user ? "none" : "block";
      navProfile.style.display = user ? "block" : "none";
      setActiveLink();
    });
  });
</script>
