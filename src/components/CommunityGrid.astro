---
import { hasArtwork, type MemberView } from "../lib/memberView.ts";
import CommunityImageCard from "./community/CommunityImageCard.astro";
import CommunityTextCard from "./community/CommunityTextCard.astro";
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";

// The image-led directory: the prototype's visual language (irregular card
// widths and offsets, scroll-linked growth, image/typographic card split)
// carrying the production page's behaviour (member count, shuffle, empty
// state, signed-out CTA).
//
// The type/openTo filter rows are deliberately absent — the design doc's
// option (c), taken on purpose while the directory is small enough to read
// whole. Their markup, styles and wiring are preserved on the branch
// `feat/community-filters` and are meant to come back once narrowing the
// list is worth a control.
//
// LAYOUT IS DRAWN, NOT DERIVED. The grid below is a hand-authored table of
// slots and cards are dealt into it at random, which replaces the multicol
// layout the design doc chose (conflict 1) and everything that had grown on
// top of it: per-tier width/offset variants, a runtime pass that ranked the
// column leaders, and a sweep that measured every card and nudged the ones
// that started level. All of that existed to approximate a designed page at
// runtime. Now the page IS designed, and the properties it was chasing —
// nothing starts at the same height, the top row steps down — are things you
// can read off the table instead of enforce in JS.

interface Props {
  members: MemberView[];
  lang?: Lang;
}

const { members, lang = "en" } = Astro.props;
const t = useTranslations(lang);
const memberLabel = members.length === 1 ? t("community.member") : t("community.members");

// ── The hand-authored grid ────────────────────────────────────────────────
//
// Three columns on a fine row grid. Every slot names the column it sits in,
// the row it starts on, how many rows it reserves, its width as a fraction of
// the column, and where in its own slack it sits (0 flush left, 1 flush
// right). The tile repeats down the page until the members run out.
//
// Rows are rhythm units (`--cgrid-row`, 2rem = 30px on desktop), NOT card
// heights. `span` is the space a slot reserves: the card sits at the top of it
// and the remainder is the whitespace below. The numbers are sized against the
// real directory measured at 1440px — a full-column image card runs 297–594px
// tall (median ~400) and a typographic card 63–285px (median ~107) — so span
// 24 (720px) leaves a big card 130–420px of air, and span 10 (300px) leaves a
// small one 15–240px.
//
// Three rules when editing this table:
//   1. No two slots share a `row`. That is the whole point of authoring it.
//   2. Within one column, a slot must end (`row + span`) before the next slot
//      in that column starts — including across the tile seam, where the last
//      slot in a column must end before TILE_ROWS + its first slot's row.
//   3. Leave no band where all three columns are empty, or the page has a hole
//      in it. Bands that open because a slot's card ran out are closed
//      automatically; bands you author are not.
type SlotKind = "big" | "small";

interface Slot {
  col: 1 | 2 | 3;
  row: number;
  span: number;
  w: number;
  ax: number;
  kind: SlotKind;
}

const TILE_ROWS = 84;

const TILE: Slot[] = [
  { col: 1, row: 1, span: 24, w: 1.0, ax: 0, kind: "big" },
  { col: 3, row: 7, span: 24, w: 0.86, ax: 1, kind: "big" },
  { col: 2, row: 14, span: 24, w: 0.94, ax: 0.35, kind: "big" },
  // The three small slots sit close together on purpose. They are the only
  // slots a text-only directory can fill, and spreading them down the tile the
  // way the big ones are spread would render prod's 21-typographic-cards state
  // as a single-file ribbon three screens longer than it needs to be. Grouped,
  // they still stagger by 5 rows (150px) but use the page's full width.
  { col: 1, row: 30, span: 10, w: 0.5, ax: 0.15, kind: "small" },
  { col: 3, row: 35, span: 10, w: 0.46, ax: 0.8, kind: "small" },
  { col: 2, row: 40, span: 10, w: 0.56, ax: 1, kind: "small" },
  { col: 1, row: 45, span: 24, w: 0.88, ax: 1, kind: "big" },
  { col: 3, row: 51, span: 24, w: 0.96, ax: 0.1, kind: "big" },
  { col: 2, row: 58, span: 24, w: 0.82, ax: 0.55, kind: "big" },
];

// How much empty vertical band to tolerate before closing it up. Only bands
// where ALL columns are empty count, and only ones the deal created — a slot
// whose stream ran dry leaves its rows behind, and on a directory with no
// artwork at all that is every big slot in every tile.
const MAX_EMPTY_ROWS = 8;

/** Close bands no column occupies, preserving the order and spans of what is left. */
function collapseEmptyBands(slots: Slot[]): Slot[] {
  const ordered = [...slots].sort((a, b) => a.row - b.row);
  // Seed the shift with whatever sits above the first surviving slot, so the
  // band at the TOP closes too. Without this a directory with no artwork opens
  // on 29 empty rows — the big slots the tile starts with, dropped — which is
  // most of a screen of blank page before the first card.
  let shift = (ordered[0]?.row ?? 1) - 1;
  let frontier = -Infinity;
  for (const slot of ordered) {
    let row = slot.row - shift;
    if (frontier > -Infinity && row - frontier > MAX_EMPTY_ROWS) {
      const extra = row - frontier - MAX_EMPTY_ROWS;
      shift += extra;
      row -= extra;
    }
    slot.row = row;
    // The frontier is the lowest point anything reaches, not the last slot's
    // end: slots overlap in row range across columns, and a band is only empty
    // once every column has cleared it.
    frontier = Math.max(frontier, row + slot.span);
  }
  return ordered;
}

/**
 * Tile the table down the page until both kinds of card are used up, skipping
 * any slot whose kind has already run out, then close the bands that leaves.
 */
function layOutSlots(bigCards: number, smallCards: number): Slot[] {
  const perTile = {
    big: TILE.filter((s) => s.kind === "big").length,
    small: TILE.filter((s) => s.kind === "small").length,
  };
  const tiles = Math.max(
    perTile.big ? Math.ceil(bigCards / perTile.big) : 0,
    perTile.small ? Math.ceil(smallCards / perTile.small) : 0
  );

  const placed: Slot[] = [];
  let big = bigCards;
  let small = smallCards;
  for (let tile = 0; tile < tiles; tile++) {
    for (const slot of TILE) {
      if (slot.kind === "big" ? big <= 0 : small <= 0) continue;
      if (slot.kind === "big") big -= 1;
      else small -= 1;
      placed.push({ ...slot, row: slot.row + tile * TILE_ROWS });
    }
  }

  // Insurance, not expected: reachable only if TILE loses every slot of one
  // kind. Stack the leftovers rather than drop members off the directory,
  // which is the kind of failure that hides.
  let overflowRow = placed.reduce((low, s) => Math.max(low, s.row + s.span), 0) + 4;
  for (let i = 0; i < big + small; i++) {
    const kind: SlotKind = i < big ? "big" : "small";
    const span = kind === "big" ? 24 : 10;
    placed.push({ col: ((i % 3) + 1) as 1 | 2 | 3, row: overflowRow, span, w: 0.9, ax: 0, kind });
    overflowRow += span + 4;
  }

  return collapseEmptyBands(placed);
}

// Two streams. `hasArtwork` is the whole test: it is also what makes
// getCardTier return "large", and a big slot is a frame drawn for artwork, so
// a member with nothing to show must never land in one.
const imageMembers = members.filter(hasArtwork);
const textMembers = members.filter((m) => !hasArtwork(m));
const slots = layOutSlots(imageMembers.length, textMembers.length);

// Deal in row order, so the server-rendered DOM already reads top to bottom
// for anyone without JS. The client re-deals at random within each kind.
let nextImage = 0;
let nextText = 0;
const cells = slots.map((slot) => ({
  slot,
  member: slot.kind === "big" ? imageMembers[nextImage++] : textMembers[nextText++],
}));
---

<div class="community-wrapper" data-lang={lang}>
  <div class="page-header">
    <h1 class="page-title">
      <span id="member-count" class="member-count">
        {members.length}
        {memberLabel}
      </span>
    </h1>
  </div>

  <div id="member-grid" class="cgrid">
    {members.length === 0 && <p class="state-msg">{t("community.empty")}</p>}
    {
      cells.map(({ slot, member }) => (
        <div
          class="cgrid__cell"
          data-slot={slot.kind}
          data-row={slot.row}
          style={`--gc:${slot.col};--gr:${slot.row} / span ${slot.span};--cw:${slot.w};--ax:${slot.ax}`}
        >
          {slot.kind === "big" ? (
            <CommunityImageCard member={member} lang={lang} />
          ) : (
            /* No artwork to show. The typographic variant holds a slot drawn
               for it rather than dropping the member from the directory. */
            <CommunityTextCard member={member} lang={lang} />
          )}
        </div>
      ))
    }
  </div>

  <div id="community-signup-cta" class="community-signup-cta" style="display:none;">
    <a href={lang === "de" ? "/de/signup" : "/signup"} class="btn-solid"
      >{t("signup.cta.community")}</a
    >
  </div>
</div>

<style>
  .community-wrapper {
    width: 100%;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-top: 3rem;
  }

  .page-title {
    display: flex;
    align-items: baseline;
    gap: 15px;
    flex-wrap: wrap;
    font-family: "Archivo", sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-dark);
  }

  .member-count {
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .state-msg {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  /* ── The grid ─────────────────────────────────────────── */
  .cgrid {
    /* Horizontal gutter between columns. */
    --pgap-x: 4.5rem;
    /* One rhythm unit. Every `row` and `span` in the slot table is counted in
       these, so this is the single knob that scales the page's whole vertical
       breathing without touching the drawing. */
    --cgrid-row: 2rem;
    /* Ceiling on the artwork itself, independent of how wide the shell goes.
       The artwork carries dense scientific detail, so the cap sits high
       enough to read it — whitespace comes from the slots, not from shrinking
       cards. */
    --card-max: 30rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--pgap-x);
    /* minmax, not a flat --cgrid-row: a card taller than the rows its slot
       reserved has to be able to push the rows below it apart. On a fixed
       track it would overflow its slot and overlap the next card instead.
       This is the one way content moves anything — the table is authoritative
       otherwise, and content can only ever add space, never collide. */
    grid-auto-rows: minmax(var(--cgrid-row), auto);
    padding-block: 4rem 18rem;
  }

  .cgrid__cell {
    min-width: 0;
    grid-column: var(--gc);
    grid-row: var(--gr);
    /* The card sits at the TOP of the rows its slot reserved and the rest of
       the span is the whitespace beneath it. Without this the cell stretches
       to fill the span and takes the card with it. */
    align-self: start;
    /* The basis is the column, or --card-max where the column is wider than
       the artwork should ever be. The card is a fraction OF that, so a wider
       shell buys whitespace rather than bigger images. */
    --cardw: calc(var(--cw) * min(100%, var(--card-max)));
    width: var(--cardw);
    /* Distribute the card's own slack: at --ax 1 the card lands flush on the
       column's right edge whatever the cap did to its width, and it can never
       exceed the column. */
    margin-inline-start: calc(var(--ax) * (100% - var(--cardw)));
    /* Anchor for the debug label below; harmless otherwise. */
    position: relative;
  }

  /* Nothing hides a cell today. Kept because the filters are coming back, and
     on a grid a hidden cell leaves its slot empty rather than repacking —
     worth knowing before wiring them to this layout. */
  .cgrid__cell[hidden] {
    display: none;
  }

  /* ?grid — outline every slot and label it with its kind and row, so the
     table in the frontmatter can be tuned against the real page instead of by
     arithmetic. */
  .cgrid--debug .cgrid__cell {
    outline: 1px dashed color-mix(in srgb, var(--color-dark) 30%, transparent);
    outline-offset: 8px;
  }

  .cgrid--debug .cgrid__cell::after {
    content: attr(data-slot) " @ " attr(data-row);
    position: absolute;
    top: -1.6rem;
    left: 0;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    pointer-events: none;
  }

  @media (--bp-mobile) {
    .cgrid {
      --pgap-x: 2.25rem;
      --pgap-y: 12rem;
      /* The slot table is a desktop drawing — two narrow columns have no room
         for it. Mobile falls back to the multicol stack, which packs by height
         and needs no placement at all; the grid properties go inert. */
      display: block;
      columns: 2;
      column-gap: var(--pgap-x);
      padding-block: 2rem 10rem;
    }
    .cgrid__cell {
      /* Declared here rather than left to the inline style, and that works
         because the inline style sets --gc/--gr, not grid-column/grid-row:
         these are the real properties, so a stylesheet rule can still win. */
      grid-column: auto;
      grid-row: auto;
      /* The column is already narrower than --card-max, so the cap and the
         width fraction are off here. Two narrow columns have no room for
         irregularity — the offset look comes free from varied card heights. */
      width: 100%;
      margin-inline-start: 0;
      margin-bottom: var(--pgap-y);
      break-inside: avoid;
    }
  }

  .community-signup-cta {
    padding-top: 5rem;
    display: flex;
    justify-content: center;
  }
</style>

<script>
  import { auth } from "../lib/firebase.ts";
  import { onAuthStateChanged } from "firebase/auth";

  // ────────────────────────────────────────────────────────────────────────
  // Behaviour layer: re-deal the slots, and the signed-out CTA.
  // Runs synchronously on astro:page-load, BEFORE the async motion layer
  // below measures anything — a deal after ScrollTrigger creation would leave
  // every trigger keyed to a stale position.
  // ────────────────────────────────────────────────────────────────────────

  /**
   * The grid is drawn at build time; this decides who stands where in it.
   *
   * Slot geometry lives in inline custom properties, so re-dealing is just
   * permuting those among the cells of one kind. A card never crosses from the
   * big slots to the small ones — that is what keeps an image card in a frame
   * drawn for artwork and stops a bare profile inheriting one.
   *
   * Permuting the geometry rather than moving the cards means the cards
   * themselves never re-render, but it does decouple DOM order from what you
   * see, so the DOM is re-sorted into the new row order afterwards and reading
   * order still runs down the page.
   */
  interface Geometry {
    gc: string;
    gr: string;
    cw: string;
    ax: string;
    row: string;
  }

  function readGeometry(cell: HTMLElement): Geometry {
    return {
      gc: cell.style.getPropertyValue("--gc"),
      gr: cell.style.getPropertyValue("--gr"),
      cw: cell.style.getPropertyValue("--cw"),
      ax: cell.style.getPropertyValue("--ax"),
      row: cell.dataset.row ?? "0",
    };
  }

  function writeGeometry(cell: HTMLElement, g: Geometry) {
    cell.style.setProperty("--gc", g.gc);
    cell.style.setProperty("--gr", g.gr);
    cell.style.setProperty("--cw", g.cw);
    cell.style.setProperty("--ax", g.ax);
    cell.dataset.row = g.row;
  }

  function dealSlots(grid: HTMLElement) {
    const cells = Array.from(grid.querySelectorAll<HTMLElement>(".cgrid__cell"));
    const kinds: Record<string, HTMLElement[]> = { big: [], small: [] };
    cells.forEach((cell) => kinds[cell.dataset.slot === "big" ? "big" : "small"].push(cell));

    for (const group of [kinds.big, kinds.small]) {
      const geometry = group.map(readGeometry);
      for (let i = geometry.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [geometry[i], geometry[j]] = [geometry[j], geometry[i]];
      }
      group.forEach((cell, i) => writeGeometry(cell, geometry[i]));
    }

    cells
      .sort((a, b) => Number(a.dataset.row) - Number(b.dataset.row))
      .forEach((cell) => grid.appendChild(cell));
  }

  document.addEventListener("astro:page-load", () => {
    const grid = document.getElementById("member-grid");
    if (grid) {
      dealSlots(grid);
      if (new URLSearchParams(window.location.search).has("grid")) {
        grid.classList.add("cgrid--debug");
      }
    }

    const cta = document.getElementById("community-signup-cta");
    if (cta) {
      onAuthStateChanged(auth, (user) => {
        cta.style.display = user ? "none" : "flex";
      });
    }
  });
</script>

<script>
  // ────────────────────────────────────────────────────────────────────────
  // Motion layer: desktop-only scroll effects, two jobs.
  //   1. Cards scale up as they rise toward the top of the scrollport.
  //   2. Cards drift vertically at index-keyed rates — there are no lane
  //      boxes to translate, so the prototype's per-lane parallax becomes
  //      per-card drift. Transform-only, so it cannot disturb the placement
  //      the slot table fixed.
  // Width is checked BEFORE the import, so mobile downloads no GSAP at all
  // (~44 KB gzip). This page is the only importer of gsap in production —
  // a deliberate, recorded cost (design doc, conflict 3).
  // ────────────────────────────────────────────────────────────────────────
  const DESKTOP = "(min-width: 768px)";
  const REDUCED = "(prefers-reduced-motion: reduce)";

  // Mixed signs and unequal magnitudes on purpose — matching speeds would
  // just look like a slow page. Drift is vertical only, so no amount of it
  // can push a card out of its column.
  const DRIFT = [-90, 60, -36, 75, -54, 42];

  // Loose type: gsap's global namespace types are not reliably in scope
  // inside a scoped Astro script, and revert() is all we need off it.
  let mm: { revert: () => void } | null = null;

  // Re-entry guard for the async gap. `mm` alone is not a mutex: it is read
  // before the dynamic import but only assigned after it, so two overlapping
  // build() calls would both pass the `if (mm)` check and the second would
  // orphan the first context's ScrollTriggers. `building` closes that window
  // synchronously, and `epoch` — bumped by every teardown — lets a build that
  // was in flight when a teardown happened detect that its DOM is stale and
  // abandon itself instead of assigning a context over dead nodes.
  let building = false;
  let epoch = 0;

  async function build() {
    if (building || mm) return;
    if (!document.querySelector(".cgrid")) return;
    if (!window.matchMedia(DESKTOP).matches) return;
    if (window.matchMedia(REDUCED).matches) return;

    building = true;
    const startedIn = epoch;

    // Everything from the import onward can reject — a hashed chunk 404ing
    // after a redeploy while ClientRouter keeps the session alive, a flaky
    // network. Without recovery, a rejection would leave `building` latched
    // true with `mm` null: a silently dead motion layer until a full reload.
    try {
      const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
      ]);

      // A teardown ran while the import was in flight: this build's DOM is
      // gone, and teardown already reset `building` so a fresh build for the
      // new page can proceed. Abandon without touching either flag.
      if (epoch !== startedIn) return;

      gsap.registerPlugin(ScrollTrigger);

      // The scroll container is .page-wrap, never the window — body is
      // overflow:hidden (see Layout.astro).
      const scroller = ".page-wrap";

      mm = gsap.matchMedia();
      // Tweens and ScrollTriggers created inside a matchMedia context are
      // reverted and killed automatically on revert().
      mm.add(DESKTOP, () => {
        // 1. Grow on approach: starts when the card's top enters at the
        //    bottom of the scrollport, completes at 38% from the top, so
        //    cards are already full size in the upper region. scrub ties
        //    progress to scroll position instead of elapsed time.
        gsap.utils.toArray<HTMLElement>(".ccard, .ctcard").forEach((card) => {
          gsap.fromTo(
            card,
            { scale: 0.72, opacity: 0.5 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                scroller,
                trigger: card,
                start: "top bottom",
                end: "top 38%",
                scrub: true,
              },
            }
          );
        });

        // 2. Per-card drift, keyed to DOM index. Drives the CELL while the
        //    scale drives the card inside it, so the two transforms cannot
        //    fight over one element's property.
        gsap.utils.toArray<HTMLElement>(".cgrid__cell").forEach((cell, i) => {
          gsap.to(cell, {
            y: DRIFT[i % DRIFT.length],
            ease: "none",
            scrollTrigger: {
              scroller,
              trigger: ".cgrid",
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          });
        });
      });

      // Archivo is self-hosted; if it lands after first paint, card heights
      // change, rows that were sized to fit a card resize with them, and every
      // measured trigger position is stale. Epoch-guarded so a refresh queued
      // by a page that has since been swapped away cannot fire against dead
      // nodes.
      document.fonts?.ready.then(() => {
        if (epoch === startedIn) ScrollTrigger.refresh();
      });

      building = false;
    } catch (err) {
      // Release the latch only if this build still owns it — after a
      // teardown, `building` belongs to whatever comes next.
      if (epoch === startedIn) building = false;
      // Swallow rather than re-throw: the page is fully usable without the
      // motion layer, and the next astro:page-load retries cleanly.
      console.error("[community-grid] scroll motion layer failed to build:", err);
    }
  }

  function teardown() {
    // Bumping the epoch marks any in-flight build as stale; clearing
    // `building` here is what lets the next page's build start immediately.
    epoch++;
    mm?.revert();
    mm = null;
    building = false;
  }

  document.addEventListener("astro:page-load", build);
  document.addEventListener("astro:before-swap", teardown);

  // Crossing the breakpoint on resize starts or stops the whole layer.
  window.matchMedia(DESKTOP).addEventListener("change", () => {
    teardown();
    build();
  });
</script>
