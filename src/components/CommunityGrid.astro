---
import { getCardTier, hasArtwork, type CardTier, type MemberView } from "../lib/memberView.ts";
import CommunityImageCard from "./community/CommunityImageCard.astro";
import CommunityTextCard from "./community/CommunityTextCard.astro";
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";

// The image-led directory: the prototype's visual language (irregular card
// widths and offsets, scroll-linked growth, image/typographic card split)
// carrying the production page's behaviour (member count, shuffle, empty
// state, signed-out CTA).
//
// The type/openTo filter rows are deliberately absent — the design doc's
// option (c), taken on purpose while the directory is small enough to read
// whole. Their markup, styles and wiring are preserved on the branch
// `feat/community-filters` and are meant to come back once narrowing the
// list is worth a control.
//
// Layout is CSS multicol, not the prototype's build-time lanes, and that is a
// decision, not a simplification (documentation/20260824-image-card-directory-
// design.md, conflict 1): DOM order stays reading order, which the lanes
// broke, and the layout needs no JS — mobile was already `columns: 2`, so it
// is proven here. It also keeps filtering-by-hiding available for when the
// filters return, which build-time lanes could never support. The cost is
// per-LANE parallax; a per-card drift keyed to index substitutes below.

interface Props {
  members: MemberView[];
  lang?: Lang;
}

const { members, lang = "en" } = Astro.props;
const t = useTranslations(lang);
const memberLabel = members.length === 1 ? t("community.member") : t("community.members");

// Server order: artwork first, so image cards lead the page even before the
// client-side shuffle runs (and for anyone without JS). The shuffle then
// randomises WITHIN each group — see the script — so ordering stays fair
// inside a group while uploading visibly moves a member up. Revisit to a pure
// shuffle once most members have artwork.
const ordered = [...members.filter(hasArtwork), ...members.filter((m) => !hasArtwork(m))];

// Deterministic irregularity, expressed in LAYOUT rather than transforms.
// `cw` is the card's width as a unitless fraction of an already-capped basis
// (see .cgrid__cell — a plain max-width would collapse every capped variant
// to one width), `ax` distributes the card's own slack across its column
// (0 flush left, 1 flush right), `my` opens real space above. The `my`
// range is deliberately wide — up to 14rem on a large card — so adjacent
// columns visibly refuse to line up; a timid stagger just reads as a grid
// that failed to align. Bucketed by tier so a filled-in profile visibly
// claims more of the column than a bare one, with variety kept inside each
// size class.
const TIER_VARIANTS: Record<CardTier, { cw: number; ax: number; my: string }[]> = {
  large: [
    { cw: 1, ax: 0, my: "0rem" },
    { cw: 0.86, ax: 1, my: "9rem" },
    { cw: 0.92, ax: 0.35, my: "2.5rem" },
    { cw: 0.8, ax: 1, my: "14rem" },
    { cw: 1, ax: 1, my: "5rem" },
    { cw: 0.9, ax: 0.15, my: "0.5rem" },
    { cw: 0.82, ax: 0.62, my: "10.5rem" },
    { cw: 0.96, ax: 0.85, my: "3.5rem" },
  ],
  medium: [
    { cw: 0.66, ax: 0.2, my: "5rem" },
    { cw: 0.6, ax: 1, my: "1rem" },
    { cw: 0.7, ax: 0.55, my: "8rem" },
  ],
  small: [
    { cw: 0.48, ax: 0.5, my: "4rem" },
    { cw: 0.44, ax: 1, my: "0rem" },
    { cw: 0.52, ax: 0, my: "6.5rem" },
  ],
};
---

<div class="community-wrapper" data-lang={lang}>
  <div class="page-header">
    <h1 class="page-title">
      <span id="member-count" class="member-count">
        {members.length}
        {memberLabel}
      </span>
    </h1>
  </div>

  <div id="member-grid" class="cgrid">
    {members.length === 0 && <p class="state-msg">{t("community.empty")}</p>}
    {
      ordered.map((m, i) => {
        const tier = getCardTier(m);
        const variants = TIER_VARIANTS[tier];
        // Stride 5 is coprime with every variant-set length, so consecutive
        // cards never share a variant and every variant still gets used.
        const v = variants[(i * 5) % variants.length];
        return (
          <div
            class="cgrid__cell"
            data-tier={tier}
            data-group={tier === "large" ? "img" : "text"}
            style={`--cw:${v.cw};--ax:${v.ax};--my:${v.my}`}
          >
            {tier === "large" ? (
              <CommunityImageCard member={m} lang={lang} />
            ) : (
              /* No artwork to show. The typographic variant holds the same
                 slot rather than dropping the member from the directory. */
              <CommunityTextCard member={m} lang={lang} />
            )}
          </div>
        );
      })
    }
  </div>

  <div id="community-signup-cta" class="community-signup-cta" style="display:none;">
    <a href={lang === "de" ? "/de/signup" : "/signup"} class="btn-solid"
      >{t("signup.cta.community")}</a
    >
  </div>
</div>

<style>
  .community-wrapper {
    width: 100%;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-top: 3rem;
  }

  .page-title {
    display: flex;
    align-items: baseline;
    gap: 15px;
    flex-wrap: wrap;
    font-family: "Archivo", sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-dark);
  }

  .member-count {
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .state-msg {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  /* ── The grid ─────────────────────────────────────────── */
  .cgrid {
    /* Horizontal gutter between columns, vertical rhythm between cards. */
    --pgap-x: 4.5rem;
    --pgap-y: 28rem;
    /* Ceiling on the artwork itself, independent of how wide the shell goes.
       The artwork carries dense scientific detail, so the cap sits high
       enough to read it — whitespace comes from the gaps, not from shrinking
       cards. */
    --card-max: 30rem;
    columns: 3;
    column-gap: var(--pgap-x);
    padding-block: 4rem 18rem;
  }

  .cgrid__cell {
    min-width: 0;
    /* The basis is the column, or --card-max where the column is wider than
       the artwork should ever be. The card is a fraction OF that, so a wider
       shell buys whitespace rather than bigger images. */
    --cardw: calc(var(--cw) * min(100%, var(--card-max)));
    width: var(--cardw);
    /* Distribute the card's own slack: at --ax 1 the card lands flush on the
       column's right edge whatever the cap did to its width, and it can never
       exceed the column. */
    margin-inline-start: calc(var(--ax) * (100% - var(--cardw)));
    /* The stagger is PADDING, not margin, and that is load-bearing: a
       margin-top here renders as nothing. Against the 20rem margin-bottom of
       the card above it collapses away to max(--pgap-y, --my), and Chrome
       discards a margin-top outright on the first card of columns 2 and 3 —
       so it never reached the top row, the part you see first. Padding is
       part of the box, so it survives both. Measured in Chrome 2026-08-24:
       a uniform 6rem margin-top moved the grid by 30px, the same value as
       padding-top moved it by 746px. */
    padding-top: var(--my);
    margin-bottom: var(--pgap-y);
    break-inside: avoid;
    /* --lead-y is set inline by staggerCardTops() on any card it has to move
       down, and stays 0 on the rest. Relative
       positioning is the mechanism because it is the only vertical offset
       here that nothing else owns: `transform` and `translate` both belong
       to the motion layer (GSAP writes `transform` and explicitly zeroes
       `translate`, `rotate` and `scale` so its matrix cannot be fought
       over), and margin or padding would be layout, which can change which
       card leads a column and so invalidate the measurement that placed it. */
    position: relative;
    top: var(--lead-y, 0);
  }

  /* Nothing hides a cell today, but multicol means a hidden one would leave
     the flow and let the columns repack — the property the filters will need
     when they come back, and the one build-time lanes cannot offer. */
  .cgrid__cell[hidden] {
    display: none;
  }

  @media (--bp-mobile) {
    .cgrid {
      --pgap-x: 2.25rem;
      --pgap-y: 12rem;
      columns: 2;
      padding-block: 2rem 10rem;
    }
    .cgrid__cell {
      /* The column is already narrower than --card-max, so the cap and the
         width fraction are off here. Two narrow columns have no room for
         irregularity — the offset look comes free from varied card heights. */
      width: 100%;
      margin-inline-start: 0;
      padding-top: 0;
    }
  }

  .community-signup-cta {
    padding-top: 5rem;
    display: flex;
    justify-content: center;
  }
</style>

<script>
  import { auth } from "../lib/firebase.ts";
  import { onAuthStateChanged } from "firebase/auth";

  // ────────────────────────────────────────────────────────────────────────
  // Behaviour layer: shuffle-within-groups and the signed-out CTA.
  // Runs synchronously on astro:page-load, BEFORE the async motion layer
  // below measures anything — a shuffle after ScrollTrigger creation would
  // leave every trigger keyed to a stale position.
  // ────────────────────────────────────────────────────────────────────────

  // Two jobs, both of them things `--my` cannot do on its own, and both
  // measured rather than assumed. All distances are px, which is safe because
  // none of this runs below the mobile breakpoint, where the root font size
  // would change from 15px.
  //
  // 1. THE TOP ROW. Which card leads each column is decided by multicol
  //    balancing AFTER the shuffle, so whether those three drew a big `--my`
  //    or a small one is pure luck — often enough all three drew small and the
  //    top of the page, the part you see first, read as a flat row. The step
  //    is applied by RANK, not by column: the leader sitting highest keeps its
  //    place and the ones below it are pushed further down, so the spread can
  //    only widen. A fixed offset per column gets cancelled by whatever `--my`
  //    that column's leader happened to draw.
  const LEAD_STAGGER = [0, 52, 104];
  //
  // 2. NO TWO CARDS START LEVEL. Card heights are content-driven, so tops
  //    across columns land where they land: measured over 10 shuffles of 21
  //    cards, one pair per load started within 10px of each other and 4.5
  //    pairs within 80px, which reads as an accidental row. Cards closer than
  //    MIN_TOP_GAP get nudged down until they clear it.
  //
  //    This is a guarantee about LAYOUT, and the motion layer spends part of
  //    it: the per-card drift shifts cells by up to 90px over the scroll, so
  //    a pair that layout put 60px apart can be brought level somewhere mid
  //    scroll. The gap comfortably absorbs the drift's at-rest share (~15px at
  //    scroll 0, where first impressions are made). Absorbing it at EVERY
  //    scroll position would need the full 165px drift spread on top of the
  //    gap between every pair, which the page has no room for; the alternative
  //    is making the drift monotone in vertical position, which guarantees
  //    separations can only widen but turns the effect from cards passing each
  //    other into a uniform stretch. Not worth it.
  const MIN_TOP_GAP = 180;
  // Ceiling on how far any one card may be moved, TOTAL — the sweep below only
  // ever pushes downward, so without it a dense run cascades and the last card
  // in it ends up hundreds of px from where the layout put it. The budget is
  // the in-column rhythm: cards in the SAME column sit --pgap-y (420px) apart
  // before their own `--my` padding, so a card displaced by the full cap still
  // leaves 160px above the card beneath it in its column. Hitting the cap means
  // accepting a gap short of the target rather than tearing a hole in a column,
  // which is the right trade — a 106px gap still reads as two different
  // heights, and the hole would read as a mistake.
  //
  // These two numbers are a pair, and were picked by measurement over 16
  // shuffles of the seeded dev directory. At 180/260 the median smallest gap on
  // a page is 179px and the worst case is 106px. Pushing the target to 200 or
  // 220 does NOT buy bigger gaps — the median stops improving around 180px
  // because the cap starts binding, and all the higher target does is spend
  // more of the column rhythm. If --pgap-y changes, re-measure: this budget is
  // a fraction of it, and the target is what the page has room to hold.
  const MAX_OFFSET = 260;

  /**
   * Place the cards' vertical offsets: step the column leaders apart, then
   * push any two cards that would start level away from each other.
   *
   * The offset is `top` on a relatively-positioned cell, and the alternatives
   * all fail. Not margin or padding, because those are layout: making a column
   * taller can push its last card into the next column and so change which
   * card leads THAT one, and the measurement would invalidate itself. Not
   * `transform` or `translate` either — the motion layer's GSAP drift animates
   * `transform` on these cells and sets `translate: none` alongside it, so a
   * `translate` offset tested clean against a dev server whose GSAP had failed
   * to load and then silently vanished on the production build. `top` on a
   * relatively-positioned box is paint-only, so it cannot move a card between
   * columns, and nothing else writes it.
   */
  function staggerCardTops(grid: HTMLElement) {
    const cells = Array.from(grid.querySelectorAll<HTMLElement>(".cgrid__cell"));
    // Always clear first: this re-runs on resize, and a stale offset from a
    // three-column layout must not survive into the two-column one. It also
    // means every position measured below is the natural one.
    cells.forEach((cell) => cell.style.removeProperty("--lead-y"));
    // Mobile stacks two narrow columns and switches the stagger off entirely.
    if (!window.matchMedia("(min-width: 768px)").matches) return;

    const cs = getComputedStyle(grid);
    const cols = parseInt(cs.columnCount, 10);
    const gap = parseFloat(cs.columnGap);
    if (!Number.isFinite(cols) || cols < 2 || !Number.isFinite(gap)) return;

    // Multicol exposes no "which column is this box in?", so derive it from the
    // column pitch. `--ax` can slide a card rightward inside its column but
    // never past the column's own edge, so flooring by the pitch is exact —
    // except that subpixel geometry lets a flush-left card measure a hair
    // BELOW its column's start and floor into the previous column, which is
    // what the +1 is for. A card can never legitimately sit within 1px under a
    // column start: the nearest it gets from that side is a full gap away.
    const padLeft = parseFloat(cs.paddingLeft) || 0;
    const contentW = grid.clientWidth - padLeft - (parseFloat(cs.paddingRight) || 0);
    const pitch = (contentW + gap) / cols;
    const originX = grid.getBoundingClientRect().left + padLeft;

    // The card, not the cell: `--my` is padding on the cell, so the cell's top
    // is where the whitespace starts and the card's top is what the eye reads.
    const cardTop = (cell: HTMLElement) =>
      (cell.firstElementChild ?? cell).getBoundingClientRect().top;

    // One measuring pass. Everything after this is arithmetic on `placed`, so
    // no read is interleaved with a write and nothing thrashes layout.
    const placed = cells
      .filter((cell) => !cell.hidden)
      .map((cell) => ({
        cell,
        col: Math.min(
          cols - 1,
          Math.max(0, Math.floor((cell.getBoundingClientRect().left - originX + 1) / pitch))
        ),
        top: cardTop(cell),
        offset: 0,
      }));
    if (placed.length === 0) return;

    // 1. Step the column leaders apart, highest first.
    const leaders = Array.from({ length: cols }, (_, col) =>
      placed
        .filter((p) => p.col === col)
        .reduce<
          (typeof placed)[number] | null
        >((best, p) => (best === null || p.top < best.top ? p : best), null)
    ).filter((p): p is (typeof placed)[number] => p !== null);
    leaders.sort((a, b) => a.top - b.top);
    leaders.forEach((p, rank) => {
      p.offset = LEAD_STAGGER[Math.min(rank, LEAD_STAGGER.length - 1)];
    });

    // 2. Sweep top to bottom keeping every card clear of the one above it.
    //    Downward only: an upward nudge would eat into the gap above, and the
    //    topmost card would climb out of the grid's own top padding. Spreading
    //    each cluster symmetrically about its centroid instead — which would
    //    halve the displacement on paper — was tried and is worse in practice:
    //    re-centring one cluster shoves cards into the next one, and the passes
    //    oscillate instead of converging. This sweep is monotone and settles in
    //    one pass. The clamp is on the card's TOTAL offset, so the leader step
    //    from phase 1 is spent out of the same budget rather than added on top.
    placed.sort((a, b) => a.top + a.offset - (b.top + b.offset));
    let prevTop = -Infinity;
    for (const p of placed) {
      const wanted = Math.max(p.top + p.offset, prevTop + MIN_TOP_GAP);
      p.offset = Math.min(wanted - p.top, MAX_OFFSET);
      prevTop = p.top + p.offset;
    }

    // Ceil, not round: rounding two neighbours down can shave a pixel off a
    // gap the arithmetic above guaranteed, and MIN_TOP_GAP should hold exactly.
    for (const p of placed) {
      if (p.offset > 0) p.cell.style.setProperty("--lead-y", `${Math.ceil(p.offset)}px`);
    }
  }

  /**
   * Shuffle within groups: image cards stay ahead of typographic ones, random
   * inside each group. Artwork-first alone would permanently rank early
   * uploaders above everyone; a pure shuffle would bury the artwork the page
   * is built around. This is the compromise the design doc records.
   */
  function shuffleWithinGroups(grid: HTMLElement) {
    const cells = Array.from(grid.querySelectorAll<HTMLElement>(".cgrid__cell"));
    const groups: Record<string, HTMLElement[]> = { img: [], text: [] };
    cells.forEach((cell) => groups[cell.dataset.group === "img" ? "img" : "text"].push(cell));
    for (const group of [groups.img, groups.text]) {
      for (let i = group.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [group[i], group[j]] = [group[j], group[i]];
      }
      group.forEach((cell) => grid.appendChild(cell));
    }
  }

  document.addEventListener("astro:page-load", () => {
    const grid = document.getElementById("member-grid");
    if (grid) {
      shuffleWithinGroups(grid);
      staggerCardTops(grid);
      // Archivo landing after first paint changes card heights, which can
      // change which card leads a column. Re-pick then. This handler is
      // registered before the motion layer's own fonts.ready refresh, so the
      // refresh sees the new positions.
      document.fonts?.ready.then(() => staggerCardTops(grid));
    }

    const cta = document.getElementById("community-signup-cta");
    if (cta) {
      onAuthStateChanged(auth, (user) => {
        cta.style.display = user ? "none" : "flex";
      });
    }
  });

  // Column widths change on any resize, not only when the mobile breakpoint
  // is crossed, and with them which card leads each column. Debounced, and it
  // re-reads the grid every time because ClientRouter swaps the DOM out.
  let restaggerTimer = 0;
  function restagger() {
    clearTimeout(restaggerTimer);
    restaggerTimer = window.setTimeout(() => {
      const grid = document.getElementById("member-grid");
      if (!grid) return;
      staggerCardTops(grid);
      // Cards just moved under the motion layer's measured trigger positions.
      document.dispatchEvent(new CustomEvent("community:restaggered"));
    }, 150);
  }

  window.addEventListener("resize", restagger);
  // Crossing into mobile has to clear the offsets, and that is too important
  // to hang on a resize event alone — an orientation change or a device-mode
  // switch does not always deliver one. Same guard the motion layer uses.
  window.matchMedia("(min-width: 768px)").addEventListener("change", restagger);
</script>

<script>
  // ────────────────────────────────────────────────────────────────────────
  // Motion layer: desktop-only scroll effects, two jobs.
  //   1. Cards scale up as they rise toward the top of the scrollport.
  //   2. Cards drift vertically at index-keyed rates — the multicol layout
  //      has no lane boxes to translate, so the prototype's per-lane parallax
  //      becomes per-card drift. Transform-only, so it cannot fight the
  //      column layout.
  // Width is checked BEFORE the import, so mobile downloads no GSAP at all
  // (~44 KB gzip). This page is the only importer of gsap in production —
  // a deliberate, recorded cost (design doc, conflict 3).
  // ────────────────────────────────────────────────────────────────────────
  const DESKTOP = "(min-width: 768px)";
  const REDUCED = "(prefers-reduced-motion: reduce)";

  // Mixed signs and unequal magnitudes on purpose — matching speeds would
  // just look like a slow page. Drift is vertical only, so no amount of it
  // can push a card out of its column.
  const DRIFT = [-90, 60, -36, 75, -54, 42];

  // Loose type: gsap's global namespace types are not reliably in scope
  // inside a scoped Astro script, and revert() is all we need off it.
  let mm: { revert: () => void } | null = null;
  let refreshTriggers: (() => void) | null = null;

  // Re-entry guard for the async gap. `mm` alone is not a mutex: it is read
  // before the dynamic import but only assigned after it, so two overlapping
  // build() calls would both pass the `if (mm)` check and the second would
  // orphan the first context's ScrollTriggers. `building` closes that window
  // synchronously, and `epoch` — bumped by every teardown — lets a build that
  // was in flight when a teardown happened detect that its DOM is stale and
  // abandon itself instead of assigning a context over dead nodes.
  let building = false;
  let epoch = 0;

  async function build() {
    if (building || mm) return;
    if (!document.querySelector(".cgrid")) return;
    if (!window.matchMedia(DESKTOP).matches) return;
    if (window.matchMedia(REDUCED).matches) return;

    building = true;
    const startedIn = epoch;

    // Everything from the import onward can reject — a hashed chunk 404ing
    // after a redeploy while ClientRouter keeps the session alive, a flaky
    // network. Without recovery, a rejection would leave `building` latched
    // true with `mm` null: a silently dead motion layer until a full reload.
    try {
      const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
      ]);

      // A teardown ran while the import was in flight: this build's DOM is
      // gone, and teardown already reset `building` so a fresh build for the
      // new page can proceed. Abandon without touching either flag.
      if (epoch !== startedIn) return;

      gsap.registerPlugin(ScrollTrigger);

      // The scroll container is .page-wrap, never the window — body is
      // overflow:hidden (see Layout.astro).
      const scroller = ".page-wrap";

      mm = gsap.matchMedia();
      // Tweens and ScrollTriggers created inside a matchMedia context are
      // reverted and killed automatically on revert().
      mm.add(DESKTOP, () => {
        // 1. Grow on approach: starts when the card's top enters at the
        //    bottom of the scrollport, completes at 38% from the top, so
        //    cards are already full size in the upper region. scrub ties
        //    progress to scroll position instead of elapsed time.
        gsap.utils.toArray<HTMLElement>(".ccard, .ctcard").forEach((card) => {
          gsap.fromTo(
            card,
            { scale: 0.72, opacity: 0.5 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                scroller,
                trigger: card,
                start: "top bottom",
                end: "top 38%",
                scrub: true,
              },
            }
          );
        });

        // 2. Per-card drift, keyed to DOM index. Drives the CELL while the
        //    scale drives the card inside it, so the two transforms cannot
        //    fight over one element's property.
        gsap.utils.toArray<HTMLElement>(".cgrid__cell").forEach((cell, i) => {
          gsap.to(cell, {
            y: DRIFT[i % DRIFT.length],
            ease: "none",
            scrollTrigger: {
              scroller,
              trigger: ".cgrid",
              start: "top bottom",
              end: "bottom top",
              scrub: true,
            },
          });
        });
      });

      // Re-picking the column leaders moves cards, so every measured trigger
      // position is stale. Epoch-guarded like the font refresh below.
      refreshTriggers = () => {
        if (epoch === startedIn) ScrollTrigger.refresh();
      };

      // Archivo is self-hosted; if it lands after first paint, measured
      // trigger positions are stale. Epoch-guarded so a refresh queued by a
      // page that has since been swapped away cannot fire against dead nodes.
      document.fonts?.ready.then(() => {
        if (epoch === startedIn) ScrollTrigger.refresh();
      });

      building = false;
    } catch (err) {
      // Release the latch only if this build still owns it — after a
      // teardown, `building` belongs to whatever comes next.
      if (epoch === startedIn) building = false;
      // Swallow rather than re-throw: the page is fully usable without the
      // motion layer, and the next astro:page-load retries cleanly.
      console.error("[community-grid] scroll motion layer failed to build:", err);
    }
  }

  function teardown() {
    // Bumping the epoch marks any in-flight build as stale; clearing
    // `building` here is what lets the next page's build start immediately.
    epoch++;
    mm?.revert();
    mm = null;
    refreshTriggers = null;
    building = false;
  }

  document.addEventListener("astro:page-load", build);
  document.addEventListener("astro:before-swap", teardown);
  document.addEventListener("community:restaggered", () => refreshTriggers?.());

  // Crossing the breakpoint on resize starts or stops the whole layer.
  window.matchMedia(DESKTOP).addEventListener("change", () => {
    teardown();
    build();
  });
</script>
