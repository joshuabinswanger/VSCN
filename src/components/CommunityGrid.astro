---
import { hasArtwork, stripStorageToken, type MemberView } from "../lib/memberView.ts";
import { DEFAULT_VIEW } from "../lib/communityLayout.ts";
import { dealPagesInto, shuffleBands } from "../lib/communityDeal.ts";
import { memberHref, workCaption } from "../lib/links.ts";
import { workKey, type SearchIndex } from "../lib/communitySearch.ts";
import { looseWorksProjectId, projectTitle } from "../lib/projects.ts";
import CommunityImageCard from "./community/CommunityImageCard.astro";
import CommunityWorkCard from "./community/CommunityWorkCard.astro";
import MemberDetailPanel from "./community/MemberDetailPanel.astro";
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";

// The image-led directory: the prototype's visual language (irregular card
// widths and offsets, scroll-linked growth, image/typographic card split)
// carrying the production page's behaviour (member count, shuffle, empty
// state, signed-out CTA).
//
// The type/openTo filter rows are deliberately absent — the design doc's
// option (c), taken on purpose while the directory is small enough to read
// whole. Their markup, styles and wiring are preserved on the branch
// `feat/community-filters` and are meant to come back once narrowing the
// list is worth a control.
//
// LAYOUT IS DRAWN, NOT DERIVED. The grid below is a hand-authored table of
// slots and cards are dealt into it at random, which replaces the multicol
// layout the design doc chose (conflict 1) and everything that had grown on
// top of it: per-tier width/offset variants, a runtime pass that ranked the
// column leaders, and a sweep that measured every card and nudged the ones
// that started level. All of that existed to approximate a designed page at
// runtime. Now the page IS designed, and the properties it was chasing —
// nothing starts at the same height, the top row steps down — are things you
// can read off the table instead of enforce in JS.

interface Props {
  members: MemberView[];
  lang?: Lang;
}

const { members, lang = "en" } = Astro.props;
const t = useTranslations(lang);

// THE BAR. Every control the page has lives on one sticky line at the
// header's 900px measure: the tags dropdown and the view switcher. Chosen by
// elimination over one long review day: pill chips died ("app chrome"), a
// static band died ("sits awkwardly"), the free search field, the openTo
// words and the member count all died ("remove…") — TAGS is the one filter
// the page keeps, and the panel's own narrowing field is the search that
// remains. The openTo and member-TYPE machinery live on in
// feat/community-filters.
//
// Filtering re-deals the survivors into the pattern's leading slots (see
// applyLayout): on the drawn grid a hidden cell leaves its slot EMPTY rather
// than repacking, so hiding in place is never an option.
//
// Every distinct tag, alphabetical — the dropdown's list. Identity is
// case-insensitive (member-typed tags vary in casing); the first spelling seen
// is the one displayed.
//
// TWO COUNTS PER TAG, because the page has two kinds of view (2026-09-07,
// Josh: "tags stale because you can select them for artists, but there are no
// images in the grid or gallery"). Since 2026-09-03 both galleries show
// artwork and nothing else, so a tag carried only by members with empty
// galleries matches nothing there — offering it made the dropdown a list of
// options that emptied the view. `members` is who carries the tag, which is
// what the INDEX filters by; `works` is how many of THOSE have artwork, which
// is what the GALLERIES can actually show. Both ride on the option as data
// attributes and the client picks by view (reflectTagOptions below): a
// gallery hides the options whose works count is zero, the ledger offers every
// tag. The artwork test is hasArtwork — the same one that decides who is dealt
// into the spread and the wall — so the count cannot disagree with the deal.
//
// NEITHER OF THOSE TWO IS PRINTED. The first cut put the view's count behind
// each tag (members in the ledger, members with artwork in the galleries) and
// it confused more than it told: the same tag read "5" in one view and "4" in
// the next, and on production — two members with artwork — most tags would
// have read "1" (2026-09-07, Josh: "the number displayed is confusing. for
// now dont put a number behind the tags"). The counts stay on the option
// because the hiding needs them; "for now" means a count may come back once
// the galleries are full enough for one to say something.
//
// A THIRD COUNT, for a THIRD kind of "carries the tag" (2026-09-08, step 2 of
// documentation/20260907-works-on-the-record-design.md): `worksByTag` is how
// many WORKS are themselves tagged, which is what the WALL can actually show
// — since 2026-09-08 the wall's tiles filter by the picture's own tags, not
// the member's (see workTagsAttr below), so `works` (members-with-artwork
// carrying a MEMBER tag) is the wrong test for it. `allTags` is the union of
// both vocabularies: a tag nobody put on their own profile but did put on a
// picture must still be offered, or the one dropdown could not reach
// everything the wall can filter by.
const tagIndex = new Map<string, { label: string; members: number; works: number; worksByTag: number }>();
const bump = (label: string, field: "members" | "works" | "worksByTag") => {
  const key = label.toLowerCase();
  const entry = tagIndex.get(key);
  if (entry) entry[field] += 1;
  else tagIndex.set(key, { label, members: 0, works: 0, worksByTag: 0, [field]: 1 });
};
for (const m of members) {
  const withArtwork = hasArtwork(m);
  for (const raw of m.tags) {
    const label = raw.trim();
    if (!label) continue;
    bump(label, "members");
    if (withArtwork) bump(label, "works");
  }
  for (const w of m.works) {
    for (const raw of w.tags) {
      const label = raw.trim();
      if (label) bump(label, "worksByTag");
    }
  }
}
const allTags = [...tagIndex.entries()].sort((a, b) => a[0].localeCompare(b[0]));

// Pipe-delimited lowercase tag keys, same encoding as data-open-to, so the
// dropdown can match a whole tag even when another tag contains it.
const tagsAttr = (m: MemberView) => {
  const keys = [...new Set(m.tags.map((raw) => raw.trim().toLowerCase()).filter(Boolean))];
  return keys.length ? `|${keys.join("|")}|` : "";
};

// THE WALL'S OWN VERSION OF tagsAttr — what is IN the picture, not who made
// it (2026-09-08). Only the wall's tiles use this; the spread's cards and the
// ledger's rows keep tagsAttr(member) above, unchanged.
const workTagsAttr = (w: MemberView["works"][number]) => {
  const keys = [...new Set(w.tags.map((raw) => raw.trim().toLowerCase()).filter(Boolean))];
  return keys.length ? `|${keys.join("|")}|` : "";
};

// THE WALL'S SORT KEYS (2026-10-15, src/lib/communitySort.ts). A work's
// FIELDS are all of its tags: the field sort shows the picture under every
// tag it carries (Josh: "show the image in every tag group it belongs to"),
// cloning the tile for the second and later groups. The key is the lowercase
// identity the filter uses; the label is the first spelling seen, from
// tagIndex, so a section head and the dropdown's chip agree on how a tag is
// written. JSON on one attribute, because a tag label can hold any character
// a pipe encoding would have to escape.
const workFields = (w: MemberView["works"][number]) => {
  const seen = new Set<string>();
  const out: { key: string; label: string }[] = [];
  for (const raw of w.tags.map((t) => t.trim())) {
    if (!raw) continue;
    const key = raw.toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push({ key, label: tagIndex.get(key)?.label ?? raw });
  }
  return out.length ? JSON.stringify(out) : undefined;
};
// A project's head is its title in this page's language; a project with
// no title in either is named by its kind, so its works are still one run.
const projectLabel = (m: MemberView, w: MemberView["works"][number]) => {
  const p = w.projectId ? m.projects?.find((x) => x.id === w.projectId) : undefined;
  return p ? (projectTitle(p, lang) ?? t("community.sort.project")) : undefined;
};

// ── The hand-authored grid ────────────────────────────────────────────────
//
// A 24-column placement grid with NO column gap; every slot is a rectangle in
// a repeating drawn tile. The slot tables, the maths that deals them and the
// build-failing validation all live in src/lib/communityLayout.ts — shared
// with the client script below, which re-runs the same layout when the
// pattern selector switches. The tables are DRAWN, not derived: they
// translate the Affinity document in Design/community-grid (see its README);
// redraw there rather than editing numbers.
//
// NOBODY WITHOUT ARTWORK IS IN EITHER GALLERY (2026-09-03, Josh: "remove
// memebrs from gallery that dont have images"). The wall dropped them on
// 2026-09-01 for being the one thing on a wall of pictures that was not a
// picture; the spread has now followed, and for the same reason — a gallery is
// a place to look at work, and a card that is a rectangle of the member's own
// tags is a directory row promoted into a picture frame. Both galleries are
// therefore ARTWORK AND NOTHING ELSE, which also means the deal has one kind
// of cell to place instead of two, and the "text cards always come last" rule
// that shaped the old spread is gone with the cards.
//
// NOBODY IS DROPPED FROM THE DIRECTORY. Every member — gallery or no gallery —
// is a row in the INDEX, which is the view that is about people and the one
// place the whole membership is reachable. CommunityTextCard.astro — the
// typographic card those members used to be dealt — was DELETED on 2026-09-08:
// it was a finished piece of design, but nothing had asked for it since the
// spread went artwork-only and an unrendered component is a claim about the
// page that is not true. To bring that cell kind back, deal a second kind here
// (see the `data-slot` note below) and rebuild the card; git history has the
// original. `TEXT_TILE` in communityLayout.ts is likewise now unused by both
// galleries, but it SURVIVES because live code still names it: `layOutSlots`
// tiles it (with a count of 0) and the module-load validator checks it.
//
// TWO GALLERIES, ONE SELECTOR: the two-lane editorial spread (the first view
// the selector offers, re-dealt on every load) and the brick grid wall,
// switched by the Gallery/Grid toggle in the header, which syncs ?pattern= so
// a view survives a reload. The two no longer share cells: the spread deals
// MEMBER cards (name, gallery, role) and the wall deals one tile per WORK —
// a single image and NOTHING ELSE, no caption and no carousel — so the toggle
// swaps which set of cells is on screen as well as which drawing they are
// dealt into. Pressing a tile opens the lightbox, which is also the only place
// the wall names anyone. The earlier stagger drawing is
// scrapped; the horizontal strip is SHELVED, not shipped — no UI reaches it,
// but ?pattern=strip still rebuilds the page into it for design review (see
// communityLayout.ts).
//
// WHICH VIEW A BARE /community OPENS ON is DEFAULT_VIEW in communityLayout.ts,
// not the spread by birthright — the Portfolios since 2026-10-13; it was the
// ledger from 2026-09-06 while the galleries were near-empty. That constant
// is also what the server renders visible and what a no-JS visitor is left
// with, so the three cannot drift apart. Mobile
// keeps the full selector and re-lays whichever deal is active into its own
// two drawings: Gallery is a single column of full-width cards that fade in
// on scroll (with the carousels auto-advancing every 5s — the arrows are
// hidden on touch), Grid is the stacked two-column wall. Both are keyed off
// data-pattern in the --bp-mobile block below.

// THE WALL IS EDITED, THE PROFILE IS NOT. Every picture on /community is
// ordered by the priority admins gave it (documentation/20260922-image-
// moderation-ranking-design.md); /members/<slug> keeps the order the member
// arranged. The same pictures therefore appear in two different orders on two
// different pages, which is deliberate: one surface is ours, the other theirs.
// Ordered HERE and not in memberView.ts for exactly that reason — this
// component is the edited surface, and the shared producer must stay neutral.
//
// BOTH NUMBERS ALSO RIDE ONTO THE CELLS as data-score — a work's own on the
// wall's tiles, its member's best on the spread's cards. The client re-deals
// on every load and bands that deal by score (shuffledInBands in the script
// below), so the priority has to be legible from the DOM and not only from
// the order the server emitted.
const byScore = (a: { score: number }, b: { score: number }) => b.score - a.score;

/**
 * A member's place in the spread's deal: their best picture.
 *
 * `Math.max()` of an empty list is -Infinity, and a member whose every work
 * moderation hid arrives here with an empty array (community.astro drops
 * hidden works before the component sees them). -1 rather than -Infinity, and
 * rather than 0: every real score is 0–100, so -1 sorts such a member BELOW
 * everyone with something to show, without being a number arithmetic can
 * propagate into. Which way they sort is nearly academic — hasArtwork() drops
 * them from both galleries a line later — but the guard is what keeps that
 * fact a property of hasArtwork rather than of luck.
 */
const bestScore = (m: MemberView) =>
  m.works.length ? Math.max(...m.works.map((w) => w.score)) : -1;

// EACH CARD'S CAROUSEL LEADS WITH THE MEMBER'S BEST. Sorted before the
// members array is split into the spread's cards and the wall's tiles, so the
// card, its carousel and the lightbox it opens all read in the same order. A
// copy per member: `members` is a prop, and the index below wants it untouched.
const rankedMembers = members.map((m) => ({ ...m, works: [...m.works].sort(byScore) }));

// WHO IS IN THE SPREAD: the members with artwork, and only them. `hasArtwork`
// is the whole test, and it is now the same test the wall uses — see the
// header. Members with an empty gallery are rendered by the INDEX below and
// nowhere else on this page.
//
// THE SPREAD'S MEMBER DEAL is ordered by each member's best work. Only the
// MEMBERS move: `slots` below is authored in ascending rowStart and validated
// at module load in communityLayout.ts, and pairing member i with slot i
// relies on that emission order being row order — so the slot table is never
// reordered, only what is dealt into it. Stable sort, so members whose best
// work ties keep the producer's alphabetical order and the build is
// reproducible.
const imageMembers = rankedMembers
  .filter(hasArtwork)
  .sort((a, b) => bestScore(b) - bestScore(a));
// THE PAGES (2026-10-15): one cell per member with artwork, in rank order,
// which is the no-JS reading order; the client deal re-orders them within
// score bands (communityDirectoryController.ts). No slot table any more.
const cells = imageMembers;

// ── The wall's own cells ──────────────────────────────────────────────────
//
// THE GRID IS NO LONGER THE SPREAD RE-DEALT. It used to be: one cell per
// member, moved from one slot table into the other by the selector, carrying
// the member card and its carousel with it. Now the two views are dealt from
// DIFFERENT CELLS — the spread deals members, the wall deals WORKS. A member
// with six images is one card in the spread and six tiles on the wall, which
// is why the wall is several times taller than it was and why nothing on it
// pages any more: a carousel exists to fit a gallery into one slot, and the
// wall gives every image a slot of its own.
//
// Both sets are server-rendered into the same grid and the deal hides the one
// that is not on screen (see applyLayout). That is what keeps the switch free
// and the no-JS page honest: hidden cells are display:none, so a browser never
// loads the wall's images until the wall is asked for.
//
// The members WITHOUT artwork are unchanged — the same tag cards, closing the
// wall in completeness order, shared with the spread rather than duplicated.
//
// THE WALL'S TILES ARE ORDERED BY THE PICTURE'S OWN PRIORITY, across members —
// one flat wall of work, best first, not a wall of members' galleries laid end
// to end. Sorted AFTER the flatMap, never inside it: within a member the works
// are already in score order (rankedMembers above), and what this adds is the
// interleaving between members. The tag dropdown's counts are computed from
// `members` at the top of this file, not from these cells, so reordering the
// cells cannot desynchronise a count from what the wall shows.
const workCells = imageMembers
  .flatMap((member) => member.works.map((work, i) => ({ member, work, key: `${member.id}-${i}` })))
  .sort((a, b) => byScore(a.work, b.work));

// The third view: a typographic ledger of every member, alphabetical. Unlike
// the two galleries it is not a deal into slots — it is rendered here, whole,
// and the selector simply swaps it in for the grid. Server-rendered so the
// rows carry the scoped-style attribute and the list costs no client work.
// The lightbox's own labels, shared with the member page's gallery — one
// attribute rather than five because the script that reads them is a module
// and cannot take `define:vars`, so the strings have to arrive through the DOM.
// Same keys the profile page uses: there is one lightbox on this site and it
// should not speak differently depending on where it was opened from.
const lightboxStrings = JSON.stringify({
  close: t("member.lightbox.close"),
  zoom: t("member.lightbox.zoom"),
  prev: t("member.lightbox.prev"),
  next: t("member.lightbox.next"),
  error: t("member.lightbox.error"),
  linkTitle: t("member.lightbox.link"),
  siteLinkTitle: t("member.lightbox.siteLink"),
  linkText: t("member.lightbox.linkText"),
  siteLinkText: t("member.lightbox.siteLinkText"),
  play: t("member.lightbox.play"),
  partOf: t("member.project.partOf"),
  with: t("member.project.with"),
  dialog: t("member.lightbox.dialog"),
  hideText: t("member.lightbox.hideText"),
  showText: t("member.lightbox.showText"),
});

const indexMembers = [...members].sort((a, b) =>
  (a.displayName || a.slug).localeCompare(b.displayName || b.slug)
);

// THE SEARCH'S INDEX (2026-10-16, src/lib/communitySearch.ts): everyone in
// the ledger, every titled project, every picture on the wall — printed into
// the page as JSON beside the bar, so a search is a pass over a list already
// here. A project or picture link names it on the member page (?project=,
// ?work=), which opens on it. The picture's thumbnail is NOT in here: the
// wall's own tile already carries a rendered one, found by `key`.
const searchIndex: SearchIndex = {
  people: indexMembers.map((m) => ({
    name: m.displayName || m.slug,
    role: m.role ?? "",
    href: memberHref(lang, m.slug),
    photo: stripStorageToken(m.photoURL ?? ""),
    tags: m.tags,
  })),
  projects: indexMembers.flatMap((m) =>
    (m.projects ?? []).flatMap((p) => {
      // The "Works" every member has for pictures outside a project
      // (adoptLooseWorks) is not a project anyone would search for.
      if (p.id === looseWorksProjectId(m.id)) return [];
      const title = projectTitle(p, lang)?.trim();
      if (!title) return [];
      return [{
        title,
        member: m.displayName || m.slug,
        href: `${memberHref(lang, m.slug)}?project=${encodeURIComponent(p.id)}`,
        tags: p.tags,
      }];
    })
  ),
  images: workCells.map(({ member, work, key }) => ({
    key,
    caption: workCaption(work, lang)?.trim() ?? "",
    member: member.displayName || member.slug,
    project: work.projectId === looseWorksProjectId(member.id) ? "" : (projectLabel(member, work) ?? ""),
    href: `${memberHref(lang, member.slug)}?work=${encodeURIComponent(workKey(work.url))}`,
    tags: work.tags,
  })),
};
---

<div class="community-wrapper" data-lang={lang}>
  {
    /* Visually hidden, not removed: the page keeps an h1 for the outline and
      screen readers (member names are h2s), but the bar is the page's first
      visible element — the brand ticker above it is title enough. */
  }
  <h1 class="sr-title">{t("community.title")}</h1>

  {
    /* THE BAR: a fixed island at the BOTTOM of the viewport (2026-10-12,
      Josh: "the filter and gallery / grid / index in a bar at the bottom to
      reflect modern UI design"). Until then it was sticky under the nav, docked
      6px into its padding so the two read as one header. Now it fills the hole
      in the bottom line of chrome between the footer (bottom-left) and the
      language toggle (bottom-right), see SiteFooter.astro and Navbar.astro.
      Rendered here, inside main, so it is swapped with the page it belongs to;
      position:fixed lifts it out of the flow regardless. Without JS every
      control renders and does nothing — harmless rather than broken, and a
      no-JS visitor gets the full spread. */
  }
  {
    /* ONE BAR FOR THE WHOLE DIRECTORY (2026-10-16, Josh: "make it persistent
      across page changes within community"). Every view, tag and sort is a
      navigation to this same page, and each used to render a fresh bar that
      rose and blurred in with <main>. transition:persist hands the SAME
      element to the next page — its typed search, its scroll and a menu
      still closing included — and liftBar (communityDirectoryController.ts) keeps it a
      child of <body>, out of <main>'s rise. Keyed by language, so a switch
      to German renders the German bar instead of keeping the English one. */
  }
  <div class="community-bar" transition:persist={`community-bar-${lang}`}>
    <div class="community-bar__in">
      {
        /* THE CARDS LIVE INSIDE THE PILL (2026-10-16, Josh: "can the selections
          stay contained in the outer pill so everything smoothly animates with
          expands and contracts"). The three panels sit in one stack above the
          row of triggers, both inside the capsule, so opening a menu GROWS the
          pill upward around it instead of hanging a second card over the page.
          animateBar in communityDirectoryController.ts eases the size change. */
      }
      <div class="community-bar__panels">
        {
          /* THE SEARCH (2026-10-16): a field, and under it the people, projects
            and pictures it matches — drawn by renderSearch in the controller
            from the JSON below. Results are links; nothing here filters the
            view behind it. */
        }
        {
          /* ON A PHONE THE SEARCH IS A FULL-SCREEN SHEET (2026-10-16, Josh:
            "on iphone it does not pop up. i stay hidden behind the keyboard").
            A fixed bar at the bottom sits against the LAYOUT viewport, which
            iOS does not shrink for its keyboard, so a drop-up grew from under
            it. The pill now morphs into a sheet (data-search-sheet on
            .community-bar, set by setBarMenu): the field pinned at the top
            with Cancel beside it, the keyboard owning the bottom, the results
            scrolling between — the one layout every keyboard height leaves
            readable. Desktop keeps the drop-up. */
        }
        <div id="search-panel" class="bar-menu__panel search__panel" hidden>
          <div class="search__head">
            <input
              id="search-input"
              class="tag-filter__search search__input"
              type="search"
              placeholder={t("community.search.placeholder")}
              aria-label={t("community.search.placeholder")}
              autocomplete="off"
              enterkeyhint="search"
            />
            <button type="button" id="search-cancel" class="tag-filter__clear search__cancel">
              {t("community.search.cancel")}
            </button>
          </div>
          <div
            id="search-results"
            class="search__results"
            aria-live="polite"
            data-people={t("community.search.people")}
            data-projects={t("community.search.projects")}
            data-images={t("community.search.images")}
            data-none={t("community.search.none")}
            data-hint={t("community.search.hint")}
          >
            <p class="field-note search__note">{t("community.search.hint")}</p>
          </div>
          <script
            type="application/json"
            id="community-search-index"
            set:html={JSON.stringify(searchIndex).replace(/</g, "\\u003c")}
          />
        </div>
        <div id="tag-filter-panel" class="bar-menu__panel tag-filter__panel" hidden>
          <div class="tag-filter__head">
            <input
              id="tag-filter-search"
              class="tag-filter__search"
              type="search"
              placeholder={t("community.filter.tags.search")}
              aria-label={t("community.filter.tags.search")}
              autocomplete="off"
            />
            {
              /* Clear: one tap empties the search field AND drops the active
                tag. Shown only while there is something to clear (a tag set
                or text in the field) — reflectTagClear in the controller. */
            }
            <button type="button" id="tag-filter-clear" class="tag-filter__clear" hidden>
              {t("community.filter.tags.clear")}
            </button>
          </div>
          <ul class="tag-filter__list">
            <li>
              <button type="button" class="tag-filter__option tagchip" data-tag="">
                {t("community.filter.tags.all")}
              </button>
            </li>
            {
              /* Which options are offered is rendered for the DEFAULT view,
                for the same reason the default view is the one server-rendered
                visible: it is what a no-JS visitor keeps and what the first
                frame shows. reflectTagOptions re-derives it from the data
                attributes for whichever view the URL asks for — Grid reads
                data-count-works-by-tag, Spread/strip read data-count-works,
                the ledger hides nothing. No count is printed behind the
                label — see the tagIndex note above. */
              allTags.map(([key, { label, members, works, worksByTag }]) => (
                <li
                  hidden={
                    DEFAULT_VIEW !== "index" &&
                    (DEFAULT_VIEW === "grid" ? worksByTag : works) === 0
                  }
                >
                  <button
                    type="button"
                    class="tag-filter__option tagchip"
                    data-tag={key}
                    data-label={label}
                    data-count-members={members}
                    data-count-works={works}
                    data-count-works-by-tag={worksByTag}
                    aria-pressed="false"
                  >
                    <span>{label}</span>
                  </button>
                </li>
              ))
            }
          </ul>
          <p class="field-note tag-filter__scope">{t("community.filter.tags.scope")}</p>
        </div>
        <div
          id="sort-menu-panel"
          class="bar-menu__panel sort-menu__panel"
          role="group"
          aria-label={t("community.sort")}
          hidden
        >
          {
            (["date", "member", "project", "field"] as const).map((sort) => (
              <button type="button" class="sort-menu__btn" data-sort={sort} aria-pressed="false">
                {t(`community.sort.${sort}`)}
              </button>
            ))
          }
        </div>
        <div
          id="view-menu-panel"
          class="bar-menu__panel view-menu__panel view-toggle"
          role="group"
          aria-label={t("community.view.label")}
          hidden
        >
          <button
            type="button"
            class="view-toggle__btn"
            data-mode="pages"
            aria-pressed={DEFAULT_VIEW === "pages" ? "true" : "false"}
          >
            {t("community.view.gallery")}
          </button>
          <button type="button" class="view-toggle__btn" data-mode="grid" aria-pressed="false">
            {t("community.view.grid")}
          </button>
          <button
            type="button"
            class="view-toggle__btn"
            data-mode="index"
            aria-pressed={DEFAULT_VIEW === "index" ? "true" : "false"}
            aria-describedby="member-index-note"
          >
            {t("community.view.index")}
          </button>
        </div>
      </div>
      <div class="community-bar__row">
        {
          /* TWO DROP-UPS (2026-10-12, Josh: "floating bar. also restyle tags to
            be more modern. the view version should also be a drop up"). Each is
            a .bar-menu: a chip-shaped trigger and a card that rises from the
            bar. Opening one closes the other; a click outside or Escape closes
            both (communityDirectoryController.ts, closeBarMenus).

            The tags menu: browse every tag as a chip or type to narrow them,
            pick one to filter. Single-select — "All tags" (or re-picking the
            active tag) clears. With a tag set, the trigger shows its name and
            fills dark, so the bar says at a glance that the page is filtered. */
        }
        <div class="bar-menu search-menu">
          <button
            type="button"
            id="search-btn"
            class="bar-menu__trigger"
            aria-expanded="false"
            aria-controls="search-panel"
            aria-label={t("community.search")}
          >
            {
              /* The glass alone (2026-10-16, Josh: "remove 'search' just the
                loope is enough"); the word stays as the button's name. */
            }
            <svg class="search__glass" viewBox="0 0 12 12" aria-hidden="true"
              ><circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.3"
              ></circle><path d="M7.7 7.7L11 11" fill="none" stroke="currentColor" stroke-width="1.3"
              ></path></svg
            >
          </button>
        </div>
        <div class="bar-menu tag-filter">
          <button
            type="button"
            id="tag-filter-btn"
            class="bar-menu__trigger"
            aria-expanded="false"
            aria-controls="tag-filter-panel"
          >
            <span id="tag-filter-label" data-rest={t("community.filter.tags")}>
              {t("community.filter.tags")}
            </span>
            <svg class="bar-menu__chev" viewBox="0 0 10 6" aria-hidden="true"
              ><path d="M1 5l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.2"
              ></path></svg
            >
          </button>
        </div>
        {
          /* THE SORT MENU (2026-10-15, Josh: "we need sort for the images
            page. sort by: date, member, project, field/tags"). Images only —
            hidden in every other view (reflectSort in the controller; the
            server renders it for the default view's state). Date orders the
            wall newest first; the other three group it, with the group's name
            over a hairline between one run of pictures and the next — a
            member's name links to their page. Field runs are in random order,
            as asked. One pick at a time; re-picking the active one clears it.
            Same anatomy as the view menu: a chip trigger naming the current
            sort ("Sort" at rest), a column of rows with a check on the one
            pressed. */
        }
        <div class="bar-menu sort-menu" hidden={DEFAULT_VIEW !== "grid"}>
          <button
            type="button"
            id="sort-menu-btn"
            class="bar-menu__trigger"
            aria-expanded="false"
            aria-controls="sort-menu-panel"
            aria-label={t("community.sort")}
          >
            <span id="sort-menu-label" data-rest={t("community.sort")}>
              {t("community.sort")}
            </span>
            <svg class="bar-menu__chev" viewBox="0 0 10 6" aria-hidden="true"
              ><path d="M1 5l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.2"
              ></path></svg
            >
          </button>
        </div>
        {
          /* The view menu. All three views on every width: on mobile Gallery is
            a single fading column, Grid the stacked two-column wall — see the
            --bp-mobile block on .cgrid. The trigger names the current view
            (reflectMode writes it; the server renders the default's name). In
            strip mode, which is URL-only, no row is pressed and the trigger
            falls back to "View". */
        }
        <div class="bar-menu view-menu">
          <button
            type="button"
            id="view-menu-btn"
            class="bar-menu__trigger"
            aria-expanded="false"
            aria-controls="view-menu-panel"
            aria-label={t("community.view.label")}
          >
            <span id="view-menu-label" data-rest={t("community.view.label")}>
              {t(
                DEFAULT_VIEW === "index"
                  ? "community.view.index"
                  : DEFAULT_VIEW === "grid"
                    ? "community.view.grid"
                    : "community.view.gallery"
              )}
            </span>
            <svg class="bar-menu__chev" viewBox="0 0 10 6" aria-hidden="true"
              ><path d="M1 5l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.2"
              ></path></svg
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  {
    /* Sits ABOVE the grid so it lands right under the chips that caused it —
      below, it would trail 18rem of the empty grid's breathing room. */
  }
  {
    /* TWO WORDINGS, ONE ELEMENT — and the line between them MOVED on
      2026-09-03 with the artwork-only galleries. It used to separate the wall
      (works) from everything else (members). Now BOTH galleries show artwork
      and only artwork, so a tag whose matching members have empty galleries
      empties them both while those members genuinely match — which is the
      thing the wording has to be honest about. Since 2026-09-07 the dropdown
      no longer OFFERS such a tag while a gallery is on screen (see the
      tagIndex note in the frontmatter; Josh: "tags stale because you can
      select them for artists, but there are no images in the grid or
      gallery"), and switching from the ledger into a gallery drops one that
      was picked there. So on this page the works wording is reached only by
      a DEEP LINK — ?tag= typed in, or carried in on a ledger row's tag chip —
      and it stays for that case, because the link is honest about what was
      asked for and an empty view with the reason printed is the right answer
      to it. The ledger is the one view that is a list of members, so it keeps
      the member wording, and it always has rows where the galleries have
      none. Both strings ride on the element and reflectFilterState picks —
      same `data-` carrier the tags trigger uses for its resting label. */
  }
  <p
    id="filter-empty"
    class="state-msg filter-empty"
    data-rest={t("community.filter.none")}
    data-works={t("community.filter.none.works")}
    hidden
  >
    {t("community.filter.none")}
  </p>

  {
    /* WHICH OF THE TWO IS RENDERED VISIBLE is the default view, not a
      constant — both are in the document either way and the selector only
      swaps them (see applyLayout). Server-rendering the wrong one would show
      the reader a gallery for one frame before the script hid it, and would
      start fetching artwork nobody asked for; it is also the whole no-JS
      experience, which has to be the default view like everyone else's. */
  }
  <div
    id="member-grid"
    class="cgrid"
    data-pswp-i18n={lightboxStrings}
    data-sort-no-project={t("community.sort.noProject")}
    data-sort-no-field={t("community.sort.noField")}
    data-rail-label={t("community.rail")}
    data-pattern={DEFAULT_VIEW}
    hidden={DEFAULT_VIEW !== "pages" && DEFAULT_VIEW !== "grid"}
  >
    {members.length === 0 && <p class="state-msg">{t("community.empty")}</p>}

    {
      cells.map((member, i) => (
        <div
          class="cgrid__cell"
          data-slot="image"
          data-rank={i}
          data-score={bestScore(member)}
          data-tags={tagsAttr(member)}
          data-name={member.displayName}
        >
          <CommunityImageCard member={member} lang={lang} index={i} />
        </div>
      ))
    }

    {
      /* THE WALL'S TILES, one per artwork. Rendered hidden and carrying no
        placement: the deal writes --gc/--gr onto these only when the wall is
        asked for. `hidden` is doing real work here beyond tidiness — it is
        display:none (see .cgrid__cell[hidden]), so none of these images is
        fetched or decoded while any other view is on screen.
        data-tags is the WORK's OWN, since 2026-09-08 (step 2 of
        documentation/20260907-works-on-the-record-design.md) — the wall
        narrows by what is IN the picture, not by the person behind it, which
        is why it needed its own count (worksByTag) and its own attribute
        helper (workTagsAttr) alongside the member ones the spread still
        uses. */
      workCells.map(({ member, work, key }, i) => (
        <div
          class="cgrid__cell"
          data-slot="work"
          data-rank={i}
          data-score={work.score}
          data-tags={workTagsAttr(work)}
          data-work={key}
          data-row="0"
          data-col="0-0"
          data-date={work.addedAt}
          data-member={member.slug}
          data-member-name={member.displayName}
          data-member-href={memberHref(lang, member.slug)}
          data-project={work.projectId}
          data-project-name={projectLabel(member, work)}
          data-fields={workFields(work)}
          hidden
        >
          <CommunityWorkCard member={member} work={work} lang={lang} />
        </div>
      ))
    }
  </div>

  {
    /* THE DEAL BEFORE THE FIRST PAINT, on a full load (2026-10-15, Josh: "the
      initial images flutter"). Runs as the parser reaches it, before the
      browser paints the grid, so the first card on screen is already this
      visit's — it used to be the server's rank order, replaced a moment later.
      communityDeal.ts's two functions inlined as text (they are written to
      be self-contained). Leaves the grid alone when an in-site navigation
      already dealt it (data-dealt) or another view is asked for; hands its
      seed to the controller on window so page-load reproduces the order. */
  }
  <script
    is:inline
    set:html={`(function(){try{${shuffleBands.toString()};${dealPagesInto.toString()};var g=document.getElementById("member-grid");if(g&&!matchMedia("(prefers-reduced-motion: reduce)").matches)g.dataset.motion="";if(!g||g.dataset.dealt)return;var p=new URLSearchParams(location.search);var v=p.get("pattern");if(v&&v!=="pages"&&v!=="spread"&&v!=="strip")return;var t=p.get("tag")||"";if(t&&!document.querySelector('.tag-filter__option[data-tag="'+CSS.escape(t)+'"]'))t="";var s=0;try{var i=history.state&&history.state.index;if(typeof i==="number")s=Number(sessionStorage.getItem("vscn:deal:"+i))||0}catch(e){}if(!s)s=(Math.floor(Math.random()*4294967295)||1)>>>0;window.__vscnDeal=s;dealPagesInto(g,s,t)}catch(e){}})()`}
  />

  {
    /* The index: every member as one ledger row — "Name, Role" and a chevron,
      alphabetical by name. (Was four ranged-left columns; the ordinal and the
      member-type badge went first, the role joined the name it describes on
      2026-08-31, and the TAG COLUMN went on 2026-09-02 — see the note in the
      summary.) Hidden until the selector asks for it; the deal
      never touches it, so switching in and out is free. Every row's dropdown
      ends in a link to the member's page, which makes this the one view where
      every member is reachable without hunting the drawing. Search lives in the masthead
      band above, shared by all three views — the ledger just hides rows. */
  }
  <div id="member-index" class="cindex-wrap" hidden={DEFAULT_VIEW !== "index"}>
    <ol class="cindex">
      {
        indexMembers.map((m) => {
          // THE PORTRAIT IS ON THE CARD, NOT IN THE PANEL (2026-10-23, Josh:
          // "on desktop the people section can be a directory of cards with
          // their profile pic"). It was the open panel's lead image; now it
          // heads the summary — the face is what a directory of people shows
          // closed, and the panel has only words left to disclose. Same avatar
          // treatment as MemberCard: the stored URL, token stripped, no build
          // pipeline (avatars are small). A member with no photo gets the same
          // circle holding their initials, so the grid stays one shape and
          // nobody is demoted to a text row.
          const avatarSrc = stripStorageToken(m.photoURL ?? "");
          const initials = (m.displayName || m.slug)
            .split(/[\s-]+/)
            .filter(Boolean)
            .slice(0, 2)
            .map((w) => w[0]!.toUpperCase())
            .join("");
          // WHERE THE "VIEW PROFILE" CONTROL GOES: in the DROPDOWN, on every
          // row, without exception (2026-09-02, Josh: "index view profile in
          // the dropdown content"; 2026-09-03, "when there is no added
          // information the view profile in index shows even when not
          // openend"). Same placement the image cards give it, and the same
          // reason: the panel is what the row had to say about the member, and
          // the way to their page is what you want once you have read it.
          //
          // EVERY ROW IS A DISCLOSURE, which is the 2026-09-03 half. A member
          // with neither a picture nor anything to disclose used to get a
          // STATIC line with the link printed ON it — no panel meant no footer
          // to put it in, and dropping it would have left them the one member
          // in the ledger with no route to their page. But that made the
          // bare rows the loud ones: a control sitting open on the line,
          // permanently, on exactly the members who had least to say, while
          // the full profiles kept theirs folded away. So `forceShow` is
          // unconditional now and the link is always in the footer. The panel
          // of a bare member holds one thing — the way to their page — which
          // is honest: it is all there is to disclose.
          const profileLink = (
            <a class="cindex__profile" href={memberHref(lang, m.slug)}>
              {t("community.card.viewProfile.text")}
            </a>
          );
          return (
            <li class="cindex__row" data-tags={tagsAttr(m)}>
              <div class="cindex__line">
                {/* THE LINE IS THE TOGGLE (2026-09-01, Josh: "in index
                    clicking on the profile expands it"). It used to be a link
                    to the member's page, with a chevron at the far right as
                    the only way to see anything in place — a 1rem target for a
                    whole row of content, and the entire row's click going
                    somewhere else. Now the row opens the row, and the page has
                    a named link inside it (.cindex__profile). Same pairing as
                    the image cards: clicking a thing expands or opens THAT
                    thing, and travel is always a control that says where it
                    goes.
                    A real <summary> rather than a click handler, which is what
                    keeps the keyboard activation and the expanded/collapsed
                    announcement for free — see the summary slot in
                    MemberDetailPanel. */}
                <MemberDetailPanel member={m} lang={lang} forceShow name="people">
                  <Fragment slot="summary">
                    {/* The portrait, or the initials in its place. `alt` is
                        empty and the initials are hidden from readers: the
                        name is printed right after, so the picture names
                        nobody the summary does not already name. */}
                    {avatarSrc ? (
                      <img
                        class="cindex__avatar"
                        src={avatarSrc}
                        alt=""
                        width="72"
                        height="72"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="cindex__avatar cindex__avatar--initials" aria-hidden="true">
                        {initials}
                      </span>
                    )}
                    {/* NAME AND ROLE ARE ONE UNIT — "Jane Doe, Illustrator" —
                        not two columns. The role used to sit in its own track a
                        column and a half away from the person it described,
                        which read as a table of unrelated facts; beside the
                        name it reads as the line a directory would actually
                        print. The wrapper outlived the tag column it was
                        introduced for: it is now what lets a long role wrap
                        under the name instead of pushing the chevron off the
                        end of the row.

                        Rendered only when there IS a role. The comma lives in
                        .cindex__role's ::before, so an absent role takes its
                        separator with it — no stray punctuation, no empty flex
                        item, at any breakpoint. */}
                    <span class="cindex__who">
                      <span class="cindex__name">{m.displayName || m.slug}</span>
                      {/* `role` arrives already trimmed from memberView, so a
                          truthiness test is the whole emptiness check. */}
                      {m.role && <span class="cindex__role">{m.role}</span>}
                    </span>
                    {/* NO TAG COLUMN. The member's tags used to print here,
                        ranged right, as the ledger's second column — gone on
                        2026-09-02 (Josh: "tags index right after name should
                        disappear"). Three uppercase-free fragments of a
                        member's own vocabulary, truncated to fit, said less
                        about them than the name already does, and repeated a
                        list the dropdown prints in full a few pixels below.
                        The line is now the person and nothing else. Nothing
                        was lost with it: the full set is in the panel
                        (.pdisc__vals--tags), and the tag FILTER never read
                        this — it reads data-tags on the row. */}
                  </Fragment>
                  {/* No lead image any more: the portrait is on the summary
                      (above). Every row is still a disclosure (see the note
                      above), so the panel always exists to hold whatever
                      words the member has, and at least the way to their
                      page. */}
                  <Fragment slot="footer">{profileLink}</Fragment>
                </MemberDetailPanel>
              </div>
            </li>
          );
        })
      }
    </ol>
    {/* Why this view is longer than the other two: the galleries are
        artwork-only, so a member who has not uploaded yet is only here.
        Below the list, so the people come first; still the Index button's
        description, so it is heard before the switch. */}
    <p id="member-index-note" class="field-note cindex__note">{t("community.index.note")}</p>
  </div>

  <div id="community-signup-cta" class="community-signup-cta" style="display:none;">
    <a href={lang === "de" ? "/de/signup" : "/signup"} class="btn-solid"
      >{t("signup.cta.community")}</a
    >
  </div>
</div>

<style>
  .community-wrapper {
    width: 100%;
    padding-bottom: 5rem;
  }

  .sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .state-msg {
    color: var(--color-muted);
    font-size: var(--fs-90);
  }

  /* ── The bar ──────────────────────────────────────────── */
  /* A FLOATING PILL AT THE BOTTOM, ON EVERY WIDTH (2026-10-12). On desktop it
     sits on one line of chrome with the footer's links fixed bottom-left at
     20px (SiteFooter.astro) and the EN / DE toggle fixed bottom-right at 20px
     (Navbar.astro). On a phone those corners are empty — the footer is in the
     flow and carries the language switch — so the pill floats on its own,
     lifted off the edge and the home bar. Paper with a hairline and a soft
     shadow, no blur, in keeping with the bare header (--color-bg-veil in
     global.css says "nothing"). z-index 20 matches its two neighbours and
     clears the cells' own stacking contexts (GSAP transforms; an open
     disclosure raises its cell to 3).

     TWO ELEMENTS: the outer is a full-width TRACK that only positions, the
     inner is the pill. A track rather than `left: 50%; translateX(-50%)`
     because of the footer. Centred by the viewport alone, the pill meets the
     footer's "© 2026 VSCN" on any desktop window narrower than ~930px, once
     the footer has faded in at the end of the page. The track is a grid whose
     outer columns are 1fr each — equal, so the pill is centred — with a floor
     of --bar-reserve: when the window is too narrow for both floors and the
     pill, the grid overflows to the RIGHT instead of shrinking the floors, and
     the pill ends up just past the footer rather than on it. The reserve is
     the footer's wider (German) line — 30px in, ~276px of links and ©,
     measured 2026-10-12 — plus a gap; it moves if the footer's words do. The
     track is see-through to clicks and the pill takes them back. */
  /* Registered so the pill's corner radius can TRANSITION; a bare custom
     property only snaps. Global, like every @property. */
  @property --bar-r {
    syntax: "<length>";
    inherits: false;
    initial-value: 999px;
  }

  .community-bar {
    position: fixed;
    /* THE TYPE SITS ON THE CORNERS' LINE, NOT THE BOX. The footer and the
       toggle put their line boxes at 20px from the edge; the pill pads its
       triggers by --bar-pad, the triggers pad their text by --chip-pad-y, and
       the pill has a 1px border — so the box sits that much lower and the
       three texts share one line across the width. */
    --bar-pad: 3px;
    --chip-pad-y: 0.4rem;
    --bar-reserve: 330px;
    bottom: calc(20px - var(--bar-pad) - var(--chip-pad-y) - 1px);
    left: 0;
    right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(var(--bar-reserve), 1fr) auto minmax(var(--bar-reserve), 1fr);
    pointer-events: none;
  }

  .community-bar__in {
    grid-column: 2;
    /* A COLUMN: the open panel on top, the triggers' row at the foot, both
       inside the one outline (10-16, "contained in the outer pill"). Packed
       to the END on purpose: while animateBar holds the box smaller than its
       content, the overflow goes UP and out to both sides — clipped — so the
       row stays put on the bottom line and the panel is uncovered from it. */
    position: relative;
    pointer-events: auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    overflow: clip;
    /* A capsule at rest, and the SAME corners round a tall open box: a 999px
       radius on a tall box is a stadium, and between the two it would bulge.
       animateBar writes the closed half-height here before it grows. */
    border-radius: var(--bar-r, var(--radius-pill)) !important;
    /* The corners ease (the sheet takes them away, closing brings them
       back): --bar-r is registered below, so it interpolates. */
    transition: --bar-r 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    /* ONE PILL, ONE OUTLINE (2026-10-15, Josh: "it is still seperated").
       The triggers sit INSIDE a single paper capsule with the black hairline
       (its curve comes from CONTROLS in global.css), and the capsule grows
       with whatever the labels say. Still one black outline, not two (10-12:
       "only one black outline"): the triggers draw no frame of their own;
       hovered, open or holding a tag, one fills black as a capsule inside the
       capsule, inset by --bar-pad. Padding plus border is what the panels'
       offsets add. */
    padding: var(--bar-pad);
    background: var(--color-bg);
    border: 1px solid var(--color-dark);
    font-size: var(--fs-85);
    /* The pill never outgrows the screen; past this a label wraps inside it. */
    max-width: calc(100vw - 24px);
  }

  .community-bar__row {
    display: flex;
    align-items: center;
    /* 4px between the triggers (10-16, Josh: "a 4px gap between the Tags
       Search and View selection"). */
    gap: 4px;
    max-width: 100%;
  }

  /* While the pill eases its size (data-sizing, set by sizeBar) the row
     keeps its own width and the pill's edges uncover it. Squeezed into
     the starting width instead, the labels wrapped letter by letter
     ("Tag/s", "So/rt") and the pill jumped a line taller for a few frames
     — seen on an iPhone going Portfolios → Images, 2026-10-16. */
  .community-bar__in[data-sizing] .community-bar__row {
    width: max-content;
    max-width: none;
  }

  /* The stack the panels open in. Nothing open, it is nothing. Its width is
     the open panel's; the row's when the row is wider (stretch). */
  .community-bar__panels {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .community-bar__panels:not(:has(> :not([hidden]))) {
    display: none;
  }

  @media (--bp-mobile) {
    /* Floats on a phone too: centred, 12px off the bottom plus the home-bar
       inset. The track is a plain block here — there is no footer to dodge —
       and the pill centres in it. .page-wrap's 72px bottom padding
       (Layout.astro) is what lets the last card and the footer's last line
       scroll out from under it. */
    .community-bar {
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      display: flex;
      justify-content: center;
      /* The sheet sits on the screen's edge; the pill floats 12px off it. */
      transition: bottom 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
  }

  /* HIGHER AND A SIZE UP ON A DESKTOP (2026-10-12, Josh: "make it so that it
     hovers a bit higher and a bit bigger on desktop"). It leaves the corners'
     20px line for 36px of its own; the triggers' padding grows with the type. */
  @media (--bp-desktop) {
    .community-bar {
      --chip-pad-y: 0.55rem;
      bottom: 36px;
    }
    .community-bar__in {
      font-size: var(--fs-95);
    }
  }

  /* ── The two drop-ups ─────────────────────────────────── */

  .bar-menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: var(--chip-pad-y, 0.4rem) 0.9rem;
    border: none;
    border-radius: 0;
    /* PERSISTENT (2026-10-12, Josh: "make the tag and view button
       persistent"): each trigger is a segment of the pill at rest, not a
       word that only gets a ground when it is pointed at. Open, or holding
       a tag, it is black. */
    background: var(--color-bg);
    font: inherit;
    color: var(--color-dark);
    cursor: pointer;
    /* THE PILL GROWS WITH ITS WORDS (2026-10-15, Josh: "make the pills
       expand so it is always contained in a pill"). No width cap and no
       ellipsis: a long sort, view or tag name widens its own box. Only when
       the row would leave the screen (the max-width on .community-bar__in)
       does a label break onto a second line — still inside its frame. */
    min-width: 0;
    text-align: center;
    transition:
      background-color 0.15s,
      color 0.15s;
  }

  .bar-menu__trigger > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* No grey (2026-10-12, "the grey hover tone I don't like"), and no thicker
     line either ("make the outline thinner"): under the pointer the trigger
     takes the black it will have once open. */
  .bar-menu__trigger:hover {
    background: var(--color-dark);
    color: var(--color-bg);
  }
  .bar-menu__trigger[aria-expanded="true"] {
    background: var(--color-dark);
    color: var(--color-bg);
  }

  .bar-menu__trigger:focus-visible {
    outline: 1.5px solid var(--color-dark);
    outline-offset: 1px;
  }

  /* A tag is set: the trigger fills, so the bar says the page is filtered. */
  .bar-menu__trigger.filter-word--set {
    background: var(--color-dark);
    color: var(--color-bg);
  }

  .bar-menu__chev {
    width: 0.7em;
    height: 0.42em;
    flex: none;
    transition: transform 0.2s ease;
  }

  .bar-menu__trigger[aria-expanded="true"] .bar-menu__chev {
    transform: rotate(180deg);
  }

  /* A panel is a room of the pill, not a card of its own (10-16): no
     outline, no shadow, no rise — the pill's outline is its outline and the
     pill's growth is its entrance (animateBar). Above the row by a gap the
     size of the row's own inset. */
  .bar-menu__panel {
    box-sizing: border-box;
    flex: none;
    max-width: 100%;
    margin-bottom: var(--bar-pad);
    padding: 6px;
  }

  .bar-menu__panel[hidden] {
    display: none;
  }

  /* The view and sort menus: a column of rows the pill's width (or 9rem,
     whichever is wider — the pill grows to it). */
  .view-menu__panel,
  .sort-menu__panel {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    min-width: 9rem;
  }

  .sort-menu[hidden] {
    display: none;
  }

  .view-toggle__btn,
  .sort-menu__btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border: none;
    border-radius: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--color-dark);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s;
  }

  .view-toggle__btn:hover,
  .sort-menu__btn:hover,
  .sort-menu__btn:focus-visible,
  .view-toggle__btn:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-dark);
    outline: none;
  }

  /* The current view: a check at the row's end. */
  .view-toggle__btn[aria-pressed="true"]::after,
  .sort-menu__btn[aria-pressed="true"]::after {
    content: "";
    width: 0.8em;
    height: 0.45em;
    margin-top: -0.25em;
    border-left: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
  }

  /* ── The tags menu ────────────────────────────────────── */
  .tag-filter__panel {
    width: 22rem;
    /* The chips ARE the panel's content, so this cap is what decides how
       many read at a glance before scrolling. The vh half keeps the card
       clear of the header; the rem half stops it drawing itself as a full
       column on a tall screen. */
    max-height: min(60vh, 30rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The other two cards' 6px, top excepted — the head below carries it, so
       it can paint over the chips scrolling under it. */
    padding: 0 6px 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  /* On a phone the tags room takes the whole width the pill may have. */
  @media (--bp-mobile) {
    .tag-filter__panel {
      width: calc(100vw - 24px - 2 * var(--bar-pad) - 2px);
    }
  }

  /* Holds the search field in place while the chips scroll under it. The
     panel's top padding lives HERE, so the band paints over every chip
     passing behind it. */
  .tag-filter__head {
    position: sticky;
    top: 0;
    z-index: 1;
    margin-bottom: 6px;
    padding: 6px 0 6px;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* MATCHES THE OTHER TWO CARDS (2026-10-15, Josh: "tags pill and tags
     search needs design adjustment to match the rest"). Clear is a row of
     the Sort and View menus — same type, same padding, no box at rest, the
     inset hairline under the pointer — rather than a square in a grey
     border at a smaller size. */
  .tag-filter__clear {
    flex: none;
    padding: 0.55rem 0.75rem;
    border: none;
    background: none;
    font: inherit;
    color: var(--color-dark);
    cursor: pointer;
    white-space: nowrap;
  }

  .tag-filter__clear:hover,
  .tag-filter__clear:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-dark);
    outline: none;
  }

  .tag-filter__clear[hidden] {
    display: none;
  }

  .tag-filter__search {
    display: block;
    flex: 1;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    /* The bar's own field: a capsule (CONTROLS in global.css) on the paper,
       drawn in the one black hairline the pill, the cards and the triggers
       share, at the bar's type size and a row's padding. It was a grey-filled
       square at a size of its own — the one surface in the bar that was
       neither paper nor black. Focus thickens nothing ("make the outline
       thinner"); it fills the field's ring in, inside. */
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-dark);
    background: var(--color-bg);
    font: inherit;
    color: var(--color-dark);
    transition: box-shadow 0.15s;
  }

  .tag-filter__search::placeholder {
    color: var(--color-muted);
  }

  .tag-filter__search:focus {
    outline: none;
    box-shadow: inset 0 0 0 0.5px var(--color-dark);
  }

  /* The browser's own clear cross on a search field: the Clear row does that
     job, and the cross is a second, differently drawn control beside it. */
  .tag-filter__search::-webkit-search-cancel-button {
    appearance: none;
  }

  @media (--bp-mobile) {
    /* 16px is iOS Safari's threshold: any smaller and focusing the field
       zooms the whole page, which reads as the layout jumping. */
    .tag-filter__search {
      font-size: 16px;
    }
  }

  /* ── The search room (2026-10-16) ─────────────────────────
     The tags room's width and height cap; the field stays put while the
     results scroll under it. The rows are drawn by renderSearch, so every
     rule below the panel reaches them through :global. */
  /* A glyph the height of a capital on its own trigger. 0.7rem of side room
     until 2026-10-20 (Josh: "give the search glass a bit more white space"):
     now 1rem, so the glass sits in a square-ish box instead of a tight one. */
  .search__glass {
    width: 1em;
    height: 1em;
    flex: none;
  }

  .search-menu .bar-menu__trigger {
    padding-inline: 1rem;
  }

  .search__panel {
    width: 22rem;
    max-height: min(60vh, 30rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  @media (--bp-mobile) {
    .search__panel {
      width: calc(100vw - 24px - 2 * var(--bar-pad) - 2px);
    }
  }

  /* The field stays put while the rows scroll under it; the head's paper
     covers them. Cancel is a sheet control (below) and not drawn here. */
  .search__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: -6px 0 6px;
    padding: 6px 0;
    background: var(--color-bg);
  }

  .search__cancel {
    display: none;
  }

  /* ── The sheet (phone only) ───────────────────────────────
     With data-search-sheet on the bar, the pill IS the screen: the bar's
     track spans the viewport, the pill fills it, the triggers' row steps
     out of flow and fades, and the search room becomes a column — head at
     the top, results scrolling under it. setBarMenu eases the pill's box
     from the capsule to the full size and --bar-r (registered, so it
     transitions) takes the corners away. Half a screen of padding under the
     last result lets it scroll out from under the keyboard, which iOS lays
     over the page rather than resizing it. Above the header (z 30). */
  @media (--bp-mobile) {
    .community-bar[data-search-sheet] {
      top: 0;
      bottom: 0;
      z-index: 40;
      align-items: flex-end;
    }

    .community-bar[data-search-sheet] .community-bar__in {
      width: 100%;
      height: 100%;
      max-width: none;
      justify-content: flex-start;
      padding: calc(6px + env(safe-area-inset-top, 0px)) 6px 0;
      border: none;
    }

    .community-bar[data-search-sheet] .community-bar__row {
      position: absolute;
      bottom: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s;
    }

    .community-bar[data-search-sheet] .community-bar__panels {
      flex: 1;
      min-height: 0;
      width: 100%;
    }

    .community-bar[data-search-sheet] .search__panel {
      display: flex;
      flex-direction: column;
      flex: 1;
      width: 100%;
      min-height: 0;
      max-height: none;
      margin: 0;
      padding: 0;
      overflow: hidden;
    }

    .community-bar[data-search-sheet] .search__head {
      position: static;
      flex: none;
      margin: 0;
      padding: 6px 6px 8px;
    }

    .community-bar[data-search-sheet] .search__cancel {
      display: block;
    }

    .community-bar[data-search-sheet] .search__results {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      padding: 0 6px 50vh;
    }
  }

  .search__results :global(.search__note) {
    margin: 0;
    padding: 0.55rem 0.75rem;
    color: var(--color-muted);
  }

  .search__results :global(.search__group) {
    margin: 0 0 6px;
  }

  .search__results :global(.search__group-title) {
    margin: 0;
    padding: 0.5rem 0.75rem 0.3rem;
    color: var(--color-muted);
  }

  .search__results :global(.search__list) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* A row of the Sort and View menus: no box at rest, the inset hairline
     under the pointer or the keyboard. */
  .search__results :global(.search__row) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.75rem;
    color: var(--color-dark);
    text-decoration: none;
    text-align: left;
  }

  .search__results :global(.search__row:visited) {
    color: var(--color-dark);
  }

  .search__results :global(.search__row:hover),
  .search__results :global(.search__row:focus-visible) {
    box-shadow: inset 0 0 0 1px var(--color-dark);
    outline: none;
  }

  .search__results :global(.search__thumb) {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    object-fit: cover;
    background: var(--color-border);
  }

  .search__results :global(.search__thumb--round) {
    border-radius: 50%;
  }

  .search__results :global(.search__words) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .search__results :global(.search__name),
  .search__results :global(.search__sub) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search__results :global(.search__sub) {
    color: var(--color-muted);
  }

  /* The pictures: a grid of squares, each one a link. */
  .search__results :global(.search__grid) {
    list-style: none;
    margin: 0;
    padding: 0 0.75rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }

  .search__results :global(.search__tile) {
    display: block;
    aspect-ratio: 1;
    background: var(--color-border);
  }

  .search__results :global(.search__tile img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .search__results :global(.search__tile:hover),
  .search__results :global(.search__tile:focus-visible) {
    outline: 1px solid var(--color-dark);
    outline-offset: 1px;
  }

  /* The tags as chips: a wrapping cloud rather than a list, so many more
     read at once and each is a clear tap target. */
  .tag-filter__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    /* Tighter between the rows than across (2026-10-12, Josh: "less padding
       between tags vertically"). */
    gap: 3px 6px;
  }

  /* THE SITE'S TAG (2026-10-12, Josh: "the tags use the tag style"). Each
     option is a .tagchip — the box in global.css, the TAG voice in type.css —
     so the filter's tags look exactly like the tags on cards and profiles.
     Only what a BUTTON needs on top is set here; no font-size or case, or
     the voice forks (`font-family: inherit`, not `font: inherit`, for the
     same reason). */
  .tag-filter__option {
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .tag-filter__option:hover,
  .tag-filter__option:focus-visible {
    border-color: var(--color-dark);
    color: var(--color-dark);
    outline: none;
  }

  .tag-filter__option[aria-pressed="true"] {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-bg);
  }

  .tag-filter__scope {
    margin: 10px 2px 0;
    color: var(--color-muted);
  }

  .filter-empty {
    padding-block: 2rem;
  }

  /* ── The grid ─────────────────────────────────────────── */
  .cgrid {
    /* One rhythm unit. Every `rowStart` and `rowSpan` in the slot table counts in
       these, so this is the single knob that scales the page's whole vertical
       breathing without touching the drawing. Was 2rem; tightened to 1.5rem
       over two review rounds — the drawn whitespace read as too much air
       between cards. */
    --cgrid-row: 1.5rem;
    /* Ceiling on the grid, and so on a column: ~83px wherever the viewport
       allows it, which is what makes a colSpan read as a fixed width and keeps
       the artwork from growing without limit on a wide screen. Past this the
       shell buys whitespace rather than bigger images — the job --card-max
       used to do per card, done once here instead.
       Paired with body.content-wide main's cap in global.css, which is this
       plus main's 15px gutters. Raise one and the other stops matching. */
    --grid-max: 2000px;
    /* ONE COLUMN, AS A LENGTH. The same number --grid-max talks about, but
       usable in arithmetic: the grid is min(100%, --grid-max) wide and 100% is
       main's content box, which body.content-wide caps at min(94vw, 2030px)
       and pads by two 15px gutters. So a column is min(94vw - 30px,
       --grid-max) over 24 — verified exact at 1440 (55.15px) and at 2400,
       where the cap binds (83.33px).
       This makes it the third member of the pairing above: the 94vw and the
       30px are global.css's, restated here because the grid wall needs to
       express a VERTICAL gap in the same unit its horizontal gaps are drawn
       in. Change main's cap and this changes with it. (No percentage is used
       — a % inside a custom property resolves against whichever property
       consumes it, which for a gap or a padding is the wrong axis.) */
    --cgrid-col: calc(min(94vw - 30px, var(--grid-max)) / 24);
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    /* No gap: gutters are columns the table leaves empty, so they can vary
       down the page. See the slot table's rule 4. */
    column-gap: 0;
    /* MORE AIR AT THE SIDES (2026-10-12, Josh: "the gallery should get more
       padding on the left and right"): 3vw a side inside main's own margin.
       The wall and the phone set their own width and never read this. */
    --cgrid-pad: 3vw;
    width: min(100% - 2 * var(--cgrid-pad), var(--grid-max));
    /* Once <main> is wider than the cap — above a ~2160px viewport, where
       94vw minus main's padding clears 2000px — the leftover has to be split,
       or the whole drawing sits flush left and reads as off-centre against a
       header that is centred. The whitespace the cap buys belongs on both
       sides. */
    margin-inline: auto;
    /* minmax, not a flat --cgrid-row: a card taller than the rows its slot
       reserved has to be able to push the rows below it apart. On a fixed
       track it would overflow its slot and overlap the next card instead.
       This is the one way content moves anything — the table is authoritative
       otherwise, and content can only ever add space, never collide. */
    grid-auto-rows: minmax(var(--cgrid-row), auto);
    padding-block: 4rem 18rem;
  }

  .cgrid__cell {
    min-width: 0;
    /* The slot IS the placement: a column range and a row range, nothing else.
       Width used to be a fraction of a lane plus an offset within it, which is
       what three fixed lanes forced — a span says it directly. */
    grid-column: var(--gc);
    grid-row: var(--gr);
    /* The cell fills the rows its slot reserved, and the card inside is taken
       OUT OF FLOW (below). Together those two make the drawing unconditional:
       with nothing in flow anywhere, every row stays at --cgrid-row, so the
       grid's geometry is exactly the table and nothing a card does — opening
       its disclosure, a late font, an image taller than expected — can feed
       back into it. The card simply overflows into the whitespace its slot
       already reserved.

       This replaces `grid-auto-rows: minmax(row, auto)` as the safety valve.
       That valve worked by letting a card push every row beneath it apart,
       which is the failure it was supposed to prevent. */
    align-self: stretch;
    /* Anchor for the debug label below; harmless otherwise. */
    position: relative;
  }

  /* Out of flow, so the card's height is its own business. Written global
     because the card roots belong to other components. */
  :global(.cgrid__cell > .ccard),
  :global(.cgrid__cell > .cwork) {
    position: absolute;
    top: 0;
    /* Bounded on BOTH inline edges so a card narrower than its slot centres in
       it rather than hanging off the left edge — the image card narrows with
       tall artwork (see .ccard width), and left-aligned it read as a card that
       had failed to fill its column. Auto margins, not a transform: GSAP owns
       the transform on these elements (the scale-on-approach) and would
       overwrite anything written here. */
    inset-inline: 0;
    margin-inline: auto;
  }

  /* ── THE PAGES (2026-10-15) ────────────────────────────────
     One member a screen (documentation/20261015-portfolio-pages-view.md).
     The frame is the viewport minus the header row the card sits under and
     the bar's band at the bottom; each cell is a snap stop of the page's
     own scroller (.page-wrap[data-snap], global.css). The card inside is in
     flow and fills the frame — the spread kept it absolute and GSAP-scaled,
     which the rule above still says for the wall's tiles. */
  .cgrid[data-pattern="pages"] {
    --cpage-h: calc(var(--shell-h, 100dvh) - var(--header-h));
    /* The bar floats at the bottom of the viewport (.community-bar); this
       keeps the card's last line above it. Tunable. */
    --cpage-chrome-b: 5.5rem;
    /* A LITTLE HIGHER (2026-10-16, Josh: "padding at the bottom of the
       gallery card so they sit a bit higher on mobile and desktop"): extra
       room under the card, so the centred card rises by half of it. */
    --cpage-lift: 2.5rem;
    /* MORE WHITE SPACE (2026-10-15, Josh): the picture is the frame less
       an air band above and below, and the pair sits centred in it. */
    --cpage-pic-h: calc(var(--cpage-h) - var(--cpage-chrome-b) - 22vh);
    display: block;
    width: min(100% - 2 * var(--cgrid-pad), var(--grid-max));
    margin-inline: auto;
    padding-block: 0;
  }
  .cgrid[data-pattern="pages"] > .cgrid__cell:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    min-height: var(--cpage-h);
    padding-bottom: calc(var(--cpage-chrome-b) + var(--cpage-lift));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    container-type: inline-size;
  }
  :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard) {
    position: static;
    margin: 0;
  }
  /* EVERY NAME ON THE SAME SPOT (2026-10-16, Josh: "put the Names always in
     the same spott"). The card was as tall as its picture and the words hung
     off the picture's edge, so a picture's shape moved the name both ways.
     Now every card is the same box: the picture's column is the widest a
     picture may be (--ccard-pic-room) and its row the tallest
     (--cpage-pic-h), the picture centred in them; the words are a fixed
     width against that column, their top a fixed drop into the row. The
     count stays centred under the column, on the row's foot. */
  @media (--bp-desktop) {
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard) {
      grid-template-columns:
        minmax(0, 1fr) var(--ccard-air) var(--ccard-pic-room) var(--ccard-air)
        minmax(0, 1fr);
      grid-template-rows: var(--cpage-pic-h) auto;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard > .ccard__body) {
      align-self: center;
      justify-self: center;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard > .ccard__words) {
      align-self: start;
      width: min(var(--ccard-words-min), 100%);
      /* The name's top a little above the row's middle — where a centred
         two-line name and role used to start. -3px undoes the focus
         padding's pull (.ccard__words). */
      margin-top: calc(var(--cpage-pic-h) / 2 - 5rem - 3px);
      max-height: calc(var(--cpage-pic-h) / 2 + 5rem);
    }
  }
  /* THE PICTURE'S SWIPE IS THE CAROUSEL'S (2026-10-16, Josh: "the vertical
     scroll is so sensitive that it is hard to swipe the gallery cards"):
     with both axes the browser's, a sideways swipe a few degrees off level
     locked onto the page and, under mandatory snap, jumped a whole member.
     On the picture the browser now pans only sideways, so every swipe that
     is not clearly vertical pages the works; a clearly vertical one is
     turned into one card by pagesPager.ts. */
  :global(.cgrid[data-pattern="pages"] .ccard__frame) {
    touch-action: pan-x pinch-zoom;
  }
  @media (--bp-mobile) {
    /* A STABLE HEIGHT ON A PHONE (2026-10-15, Josh: "without this part
       where the card moves a bit further than it needs to and then drops
       down"). --shell-h follows the visual viewport, which grows as Safari
       retracts its toolbar mid-scroll: every card resized under the finger
       and the snap re-aligned with a visible drop. svh never moves. */
    .cgrid[data-pattern="pages"] {
      --cpage-h: calc(100svh - var(--header-h));
      --cpage-chrome-b: 4.5rem;
      /* THE WORDS ARE A FIXED BLOCK ON THE PILLS (2026-10-15, Josh: "the
         info for the member should be fix size and always just above the
         pills. so it does not shift from portfolio to portfolio"): the name
         and role get room for a two-line role whatever this member's is, the
         links one line, and the block stands --cpage-words-air above the
         bar. The picture has what is left above them, centred in it. */
      --cpage-head-h: 4.4rem;
      --cpage-links-h: 1.7rem;
      --cpage-words-air: 1rem;
      --cpage-row-gap: 0.75rem;
      --cpage-card-h: calc(var(--cpage-h) - var(--cpage-chrome-b) - var(--cpage-words-air) - var(--cpage-lift));
      /* What the picture may be, the words kept above the bar... */
      --cpage-pic-fit: calc(
        var(--cpage-card-h) - var(--cpage-head-h) - var(--cpage-links-h) - 2 * var(--cpage-row-gap)
      );
      /* ...and inside the top 70svh band, under the header (2026-10-16, Josh:
         "on mobile make the gallery be centered in the top 70vh"). */
      --cpage-band-mid: calc(35svh - var(--header-h));
      --cpage-pic-h: min(var(--cpage-pic-fit), 2 * var(--cpage-band-mid));
      width: 100%;
    }
    /* THE PICTURE TAKES THE PHONE'S WIDTH (2026-10-15, Josh: "on mobile the
       image should take up more width"): no inset of its own inside main's
       gutter — the spread's 24px cell padding was for its framed cards. */
    .cgrid[data-pattern="pages"] > .cgrid__cell:not([hidden]) {
      padding-inline: 0;
      align-items: flex-start;
    }
    /* THE CARD IS THE FRAME LESS THE BAR, its rows fixed: the picture's
       band, the name and role, the links. Every member's name, links and
       PROFILE stand on the same lines, and the picture is centred in its
       band (2026-10-15, Josh: "the image should be centered in the top
       part"). The count hangs under the band's foot, on the name's line. */
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard) {
      width: 100%;
      height: var(--cpage-card-h);
      /* THE PICTURE'S ROW AND THE WORDS' ROW APART (2026-10-19, Josh: "on
         mobile the Image and Text Row should be seperated as well. so text
         always stays at the same place"): the picture has a band of its own,
         the tallest it may be (--cpage-pic-h, so its middle is the top 70svh's,
         2026-10-16 "centered in the top 70vh"), and is centred in it; the
         dots have a fixed row under the band, kept even by a gallery of one;
         the name starts on the same line on every card. Until then the words
         hung directly under the picture (2026-10-15, "the text doesn't sit
         under the images directly"), so a short picture lifted them. */
      grid-template-rows: var(--cpage-pic-h) 0.5rem auto auto;
      align-content: start;
      row-gap: var(--cpage-row-gap);
      /* BETWEEN THE TWO TOOLBAR STATES (2026-10-15, Josh: "move it down half
         of the vh of the collapsible bar so it sits in between"): the card is
         sized for the toolbar SHOWN (svh) and set half the toolbar's height
         lower, so it sits midway whether the bar is up or collapsed. A fixed
         offset, never re-measured — following the toolbar live was tried
         twice and was not smooth (reverted). `top`, not a transform: the
         card's transform is the cpage-out exit. */
      position: relative;
      top: calc((100lvh - 100svh) / 2);
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard > .ccard__body) {
      grid-area: 1 / 1 / 2 / 2;
      align-self: center;
      justify-content: center;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard > .ccard__foot) {
      grid-area: 2 / 1 / 3 / 2;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard .ccard__head) {
      grid-area: 3 / 1 / 4 / 2;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard .ccard__more) {
      grid-area: 4 / 1 / 5 / 2;
    }
    :global(.cgrid[data-pattern="pages"] > .cgrid__cell > .ccard .ccard__head) {
      overflow: hidden;
    }
    /* Two lines at most, so the room kept for it is never outrun. */
    :global(.cgrid[data-pattern="pages"] .ccard__role) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }
  }
  /* What follows the last card must be reachable under mandatory snap. */
  :global(.page-wrap:has(#member-grid[data-pattern="pages"]:not([hidden])) .community-signup-cta),
  :global(.page-wrap:has(#member-grid[data-pattern="pages"]:not([hidden])) > .site-footer) {
    scroll-snap-align: end;
  }

  /* ── THE FLOURISH (2026-10-15, Josh: entry 2 + exit 1 of the brainstorm)
     The card leaving shrinks and dims, linked to the scroll. (Its arrival
     was scroll-linked too until the timed ENTRANCE below replaced it.) View timelines against .page-wrap (the nearest
     scrollport); the CELL — the snap stop — is never transformed, so the
     snap geometry is layout's alone. LONGHANDS ONLY: the minifier folds a
     following animation-timeline INTO an `animation` shorthand, which no
     browser accepts, so the whole animation silently drops (memory note
     minifier-folds-animation-timeline; checked in the built CSS). A browser without view() gets the plain
     snap, which is the complete experience; reduced motion gets it too.
     Amounts are the brainstorm demo's — tunable. The body's own crossing
     is the timeline for the picture: on a desktop it is the card's height,
     on a phone 60% of it, so the picture finishes arriving a little sooner
     there, which reads fine. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(.cgrid[data-pattern="pages"] .ccard) {
        animation-name: cpage-out;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
        transform-origin: 50% 50%;
      }
    }
  }

  /* ── THE ENTRANCE (2026-10-15, Josh: "a smooth animation where it moves in
     satisfyingly. motion design style") ─────────────────────────────────
     Timed, not scroll-linked: pagesEntrance.ts puts .is-in on a cell once it
     is over half in view, and takes it off once it has fully left. The
     starting state applies only under [data-motion] (set before the first
     paint by the deal, never under reduced motion), and the transitions live
     on the .is-in state alone, so leaving resets instantly, off screen.
     One curve for everything — a long expo-out, fast off the mark and a
     slow, soft landing — and a stagger: picture, then the name and role word
     by word (so longer words take longer), then the count and the links.
     Not while <html> carries data-arrive-hold (Layout.astro holds an arriving
     page invisible until it is ready): a card counted as in view behind the
     hold would otherwise play its entrance unseen, or half of it. */
  @media (prefers-reduced-motion: no-preference) {
    .cgrid[data-pattern="pages"][data-motion] {
      --cpage-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }
    /* The picture opens out of an inset and settles from a slight zoom.
       Until then it is not there at all (2026-10-15, Josh: "the next
       portfolio element should either be super faded in on the bottom edge
       always or never"): NEVER — a card that is not the one on screen shows
       nothing, so no edge of the next one ever peeks in at the bottom. */
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell .ccard__frame) {
      opacity: 0;
    }
    /* The inset is on the TRACK (2026-10-23): the prev/next arrows stand
       outside the frame's box now (communityCard.css), and a clip-path on
       the frame would cut them off. */
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell .ccard__track) {
      clip-path: inset(9% 9% 9% 9%);
    }
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell .ccard__img) {
      transform: scale(1.16);
    }
    /* The name and the role rise word by word, each word out of its own
       mask (pagesEntrance.ts splits them and stamps each word's --d). Until
       the split has happened the words are held invisible, so the plain
       text never shows and then vanishes. */
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell:not([data-words]) .ccard__name-link),
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell:not([data-words]) .ccard__role) {
      opacity: 0;
    }
    :global(.cgrid[data-pattern="pages"][data-motion] .cw) {
      display: inline-block;
      overflow: clip;
      overflow-clip-margin: 2px;
      /* Room for descenders inside the mask, given back to the line. */
      padding-bottom: 0.12em;
      margin-bottom: -0.12em;
      vertical-align: top;
    }
    :global(.cgrid[data-pattern="pages"][data-motion] .cw__i) {
      display: inline-block;
      transform: translateY(105%);
    }
    /* The count and PROFILE drift up into place. (.ccard__more since
       2026-10-19, Josh: "animate the profile button as well" — the rule
       named the panel the links lived in, gone with them, so PROFILE stood
       there plainly from the first frame.) */
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell .ccard__foot),
    :global(.cgrid[data-pattern="pages"][data-motion] .cgrid__cell .ccard__more) {
      opacity: 0;
      translate: 0 0.6rem;
    }

    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__frame) {
      opacity: 1;
      transition: opacity 0.6s var(--cpage-ease);
    }
    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__track) {
      clip-path: inset(0 0 0 0);
      transition: clip-path 1.15s var(--cpage-ease);
    }
    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__img) {
      transform: none;
      transition: transform 1.5s var(--cpage-ease);
    }
    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .cw__i) {
      transform: none;
      transition: transform 0.85s var(--cpage-ease) var(--d, 0.2s);
    }
    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__foot) {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.7s var(--cpage-ease) var(--t-rest, 0.48s),
        translate 0.9s var(--cpage-ease) var(--t-rest, 0.48s);
    }
    :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__more) {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 0.7s var(--cpage-ease) calc(var(--t-rest, 0.48s) + 0.08s),
        translate 0.9s var(--cpage-ease) calc(var(--t-rest, 0.48s) + 0.08s);
    }
    /* On a desktop the count comes in last, after the words. */
    @media (--bp-desktop) {
      :global(:root:not([data-arrive-hold]) .cgrid[data-pattern="pages"][data-motion] .cgrid__cell.is-in .ccard__foot) {
        transition:
          opacity 0.7s var(--cpage-ease) calc(var(--t-rest, 0.48s) + 0.16s),
          translate 0.9s var(--cpage-ease) calc(var(--t-rest, 0.48s) + 0.16s);
      }
    }
  }
  @keyframes cpage-out {
    0% {
      transform: none;
      opacity: 1;
    }
    100% {
      transform: scale(0.96);
      opacity: 0.35;
    }
  }

  /* THE SLOT IS MEASURED, AND THE PICTURE HOLDS ITS PLACE (2026-10-12,
     gallery card v2). An open card is its folded picture plus a column of
     words hung off the inner side (communityCard.css), so it is wider than
     its slot. The cell is an inline-size container so the card can read the
     slot's width as 100cqw, and the card is pinned by the margin on its
     OUTER side to exactly where the folded card would centre its picture
     and rail: the words then grow inward, into the gutter, and folding or
     unfolding never moves the picture. Not in the strip, whose cells are
     sized by their cards. */
  .cgrid > .cgrid__cell[data-slot="image"] {
    container-type: inline-size;
  }

  /* ── The grid wall ────────────────────────────────────── */
  /* THE WALL IS NOT DRAWN, IT IS MEASURED. The spread places cards in a
     24-column table where a card's width is a FRACTION of the measure; the
     wall places them in tracks of a FIXED width and fits as many as the window
     has room for. DIFFERENT CELLS since the wall became a wall of works rather
     than of members (see the wall's cells in the frontmatter) — a different
     question asked of the window, and the fourth round of "less white space in
     grid view"
     (2026-08-31), the one the drawn table could not answer:

       Under the table a card was 3 of 24 columns, so it grew with the viewport
       up to --grid-max (2000px) and then stopped — and every pixel past a
       ~2160px window became margin. Five cards on a 3440 screen with a third
       of the glass unused. Under fixed tracks that screen fits eleven, and the
       answer to a wider window is always more members, never more air.

     THE THREE KNOBS ARE HERE AND NOWHERE ELSE. --wall-card, --wall-gap and
     --wall-edge are read back by the client script (getComputedStyle on this
     rule) to work out how many tracks fit, so this rule is the single source
     of the drawing: change a number here and the script re-counts. They are
     literal px on purpose — a calc() comes back to JS as an unresolved token
     stream, not a number.
       card 200px — the fixed width, at every viewport
       gap   80px — the FLOOR on the air between two cards, not the air itself
       edge 100px — half a card, the air at the window's two edges

     THE ROWS SPREAD TO BOTH EDGES, and the gutters take the leftover. This
     reverses the round before it, at Josh's ask ("they should always spread to
     the edge so there is a big enough gap between them, the gap needs to be at
     least double"): the wall had been centring N fixed tracks at a fixed 40px
     gutter and letting the remainder pile up at the two edges, which put cards
     a fifth of their own width apart inside a page with margins to spare. Now
     the count is taken against the FLOOR — as many cards as fit at 80px or
     better — and the gutter that actually renders is whatever divides the rest
     of the measure between them. It can only ever be wider than the floor, and
     the first and last card in a row always sit on the wall's two edges.

     The script resolves it and writes it back as --wall-gap, which is the one
     number the tracks and the brick's half step are both drawn from. Measured
     in the browser: 3 cards at 1280 (gutter at its 160 ceiling), 4 at 1440
     (127), 6 at 1920 (92), 8 at 2560, 11 at 3440 — the count steps, the gutter
     breathes between the steps, and the row sits on both edges at every width
     but the capped one.

     THE BRICK SURVIVES, generalised: rows alternate N and N−1 cards with the
     short rows stepped half a pitch right, which is the old five-and-four no
     longer pinned to one screen width. layOutWall emits the parity (odd
     rowStart flush, even offset) and the script turns it into the `left`
     below — see communityLayout.ts for why the offset row is a card shorter.

     THE LEFTOVER GOES TO THE EDGES, never into the gutters. Fixed tracks plus
     justify-content:center means one gutter looks like every other gutter at
     every window width, and the edges — already at least half a card — absorb
     whatever does not divide. Distributing it instead (space-between) would
     give the gutter a different size on every screen, which is the one thing a
     fixed-width wall cannot afford.

     WHAT THIS COSTS. The geometry now depends on the window, so a resize can
     change the drawing: the script re-deals when the track count actually
     moves and fires community:layout-changed, the same recovery the view
     toggle uses. And the wall no longer sits inside the page's measure —
     body.wall-bleed, set by the script for this view alone, lifts main's cap
     so the tracks can reach the window. The page's chrome keeps its own
     narrower measure; that break-out is the one global.css already documents
     for wide content.

     WHAT CAN STILL MOVE IT, and why the motion layer survives. A row sizes to
     its own tallest card, so content can resize a row after the motion layer
     has measured it. An image cannot — the frame carries an inline
     aspect-ratio and the <img> its intrinsic size, so a card's height is known
     before a byte of artwork lands. A late font can, and that is the case the
     layer already handles by refreshing every ScrollTrigger on
     document.fonts.ready. The disclosure, the other thing that grows a card,
     is display:none on this pattern.

     Desktop only: the mobile block below replaces the wall with a two-column
     multicol flow that owns its own gaps, and none of these knobs exist
     there. */
  @media (--bp-desktop) {
    .cgrid[data-pattern="grid"] {
      /* STATIC AND CENTRED (2026-10-12, Josh: "Images should be centered in a
         static grid … and vertically centered!"): square cells, each artwork
         centred in its cell on both axes, no brick step and no parallax
         (communityDirectoryController and communityMotionController). Two
         wide for an hour, then ("on desktop the images can be wider, maybe
         300px per image and then dynamic depending on viewport width") 300px
         cells, as many as the window fits — wallMetrics measures the count
         from this, so it stays a plain length. */
      --wall-card: 300px;
      --wall-gap-min: 80px;
      /* AND A CEILING, because a spread with only a floor has one bad width.
         Just under a step the row is a card short and the whole of that card's
         room goes into two or three gutters: 3 cards 210px apart at a 1280
         window, a gutter wider than the card, which reads as three strays
         rather than a wall. Past this the leftover goes back to the edges and
         the row stops touching them — the one case where it cannot both
         spread and stay a wall, and the wall wins. Twice the floor: the band
         where it bites is roughly 1200–1300, and nowhere else. */
      --wall-gap-max: 160px;
      --wall-edge: 100px;
      /* THE TALLEST A FRAME MAY BE, and so the height of every row
         (2026-09-24, Josh: "grid images should get a maximum height, so all
         rows are the same height always"). One card width — a square. It was
         1.5 × the card, which nothing seeded reached, so it bounded nothing:
         each row took the height of its tallest tile and the wall's rows ran
         anywhere from 200 to 283px. At 1 × the card, square and portrait work
         all stops at the same line (and narrows, by the tile's own width
         formula), and grid-auto-rows below fixes the row at exactly this plus
         the author line, so a row of landscapes is as tall as any other. */
      --wall-frame: var(--wall-card);
      /* The gutter the row actually uses. Declared as the floor so the rule
         stands on its own, and overwritten inline by the script with the
         width that spreads the row across the measure — always ≥ the floor.
         Everything downstream (the tracks' gap, the brick's step) reads this
         one, so the drawing follows the window without any of them knowing. */
      --wall-gap: var(--wall-gap-min);
      /* CSS-only, so a calc is fine here: the brick's step is half of this. */
      --wall-pitch: calc(var(--wall-card) + var(--wall-gap));

      /* Out of the page's measure and out of the spread's 24 fluid columns: N
         fixed tracks, centred. --wall-cols is written by the script; the
         fallback is what a script-failed page renders, and 4 is the count at
         1440. */
      width: auto;
      max-width: none;
      grid-template-columns: repeat(var(--wall-cols, 4), var(--wall-card));
      justify-content: center;
      column-gap: var(--wall-gap);
      /* Three quarters of the gutter's FLOOR — deliberately the floor and not
         the resolved gutter, which stretches: tying the vertical rhythm to it
         would make the page taller on exactly the widths where the horizontal
         air is already generous, and the wall's whole subject is how much
         vertical air it spends. 60px, the same at every width. A REAL row-gap:
         a row of the wall is one grid row here, where the drawn table made it
         19 placement rows and forced the gap to be reserved inside each cell.
         THREE QUARTERS, NOT THE WHOLE GUTTER (the round before this one,
         "even a bit less"): meshed at exactly the gutter the two axes did not
         read equal, because a card's caption block sat inside the vertical
         interval and the horizontal one holds nothing. THE WORK TILES HAVE NO
         CAPTION any more, so on those rows this 60px is the whole of the air —
         which is why the wall reads tighter vertically than it did, and the
         number is left where the earlier "less white space" rounds put it. It is also the
         floor the parallax sets: a row can close on the one below it as it
         travels, and 30px absorbs that with the wall's damped amplitude (see
         flowScale, which scales it to a third of the spread's). */
      /* 1.1 × the floor since 2026-10-12 (Josh: "more white space in grid
         view"), from three quarters: 88px. */
      row-gap: calc(1.1 * var(--wall-gap-min));
      /* EVERY ROW THE SAME HEIGHT: the frame cap plus the work tile's author
         line (1.2rem, --cwork-chrome in CommunityWorkCard — the third place
         that figure is stated, with the work-cell rule below). It was
         `minmax(0, auto)`, the tallest tile in the row, which made the row
         depth a property of whichever pictures the deal happened to put
         together. A tile shorter than the row sits at its top, as before. */
      grid-auto-rows: var(--wall-frame);
      /* The 18rem tail is the SPREAD's — its cards are out of flow, so its
         last beat needs drawn whitespace under it where every earlier beat
         borrows the next one's. The wall's cards are in flow and its last row
         already carries the row-gap, which left that tail as ~288px of nothing
         between the final row and the signup CTA. 6rem still leaves the
         scale-on-approach tween room to finish on the last row: it ends at
         `top 60%`, so it needs 40vh of document below that row's top, and the
         row's own height plus the CTA and the footer clear it with room
         over. */
      padding-block: 4rem 6rem;
    }

    /* Back into flow, so a card's height reaches the tracks at all. The
       absolute rule above exists to keep content out of the SPREAD's drawn
       geometry; here the geometry is asking to be told. Auto margins survive
       from that rule and still centre a card narrower than its track. */
    :global(.cgrid[data-pattern="grid"] .cgrid__cell > .ccard),
    :global(.cgrid[data-pattern="grid"] .cgrid__cell > .cwork) {
      position: static;
      margin-inline: auto;
    }

    .cgrid[data-pattern="grid"] .cgrid__cell {
      /* The brick's half step, on the offset rows only — the script writes
         --row-offset from the row parity, and writes 0 where there is only one
         track to step in. `left`, not a margin and not a transform: a margin
         would eat into a fixed-width track and shrink the card inside it, and
         GSAP owns the transform on every cell (the parallax). The cells are
         already position:relative, for the ?grid labels. */
      left: 0;
      /* The row-gap carries the vertical air now. */
      padding-bottom: 0;
      /* THE CELL IS THE SQUARE, the tile sits in its middle. */
      align-self: stretch;
      align-items: center;
      justify-content: center;
    }
    /* Visible cells only: a bare `display` here outranked the [hidden] rule
       and put the gallery's hidden cells back into the grid. */
    .cgrid[data-pattern="grid"] .cgrid__cell:not([hidden]) {
      display: flex;
      /* The frame cap, stated directly instead of in rhythm units.
         CommunityImageCard computes --frame-cap as --slot-rows × --cgrid-row
         minus the card's chrome (5.4rem, mirrored here), and the wall's slots
         are one row tall, so shadowing the row unit on the CELL sets the cap
         to --wall-frame (one card width since 2026-09-24; 1.5 × before), at
         every window width, where the drawn version drifted between 1.38× and
         2.1×. */
      --cgrid-row: calc((var(--wall-frame) + 5.4rem) / var(--slot-rows, 1));
    }

    /* Same cap, the work tile's own chrome. The line above bakes in the member
       card's 5.4rem of name-and-caption; a work tile now carries ONLY an author
       line under its frame and declares 1.2rem for it (--cwork-chrome in
       CommunityWorkCard) — it was 3.3rem while the tile also printed the
       image's caption as a title, which it stopped doing on 2026-09-06.
       Stated separately rather than made a variable, because the two cards'
       anatomies are genuinely different numbers and a shared one would hide
       that. THE PRICE of stating it twice is that this line and --cwork-chrome
       have to be changed together; the tile reserves its own room from the
       variable, the row takes its height from here, and a mismatch shows up as
       tiles rattling inside rows that are the wrong depth rather than as an
       error. The extra specificity wins wherever this sits in the file. */
    .cgrid[data-pattern="grid"] .cgrid__cell[data-slot="work"] {
      --cgrid-row: calc(var(--wall-frame) / var(--slot-rows, 1));
    }
  }

  /* ── The wall's section heads ─────────────────────────── */
  /* One per run when the sort groups the wall (2026-10-15, Josh: "the name
     of the member and a horizontal line separating the different images
     from member to member"). Created by the deal (communityDirectoryController,
     the grid branch), so they exist only on the wall — the rule below is
     scoped to it all the same, because a view switch hides the grid rather
     than emptying it. The wall is a MULTICOL flow (the masonry block at the
     end of this sheet), so a head is a SPANNER: `column-span: all` ends the
     columns above it, draws the head across the whole measure, and starts
     fresh, rebalanced columns under it — one run of pictures per head, which
     is the whole point. THE NAME AND THE LINE SHARE ONE LINE (2026-10-15,
     Josh: "text and bar in one line"): the head is a flex row, the name
     first and the rule a flex-grown pseudo-element running from after it to
     the right edge. It was a border over the top of the name. The air ABOVE
     the head is its own margin-top on top of the last tile's margin-bottom
     ("more vertical spacing between bars"), zeroed on the first head, which
     has no run above it; the margin below holds the name close over its
     pictures. The voice is NAME (type.css); this rule is layout and colour.
     :global because the heads are made by the script, which cannot give
     them this block's scope attribute — the same reason the card roots
     above are written global. */
  .cgrid :global(.cgrid__head) {
    display: none;
  }

  .cgrid[data-pattern="grid"] :global(.cgrid__head) {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    /* (Was a multicol spanner until the script took over the columns.) */
    /* 10rem ≈ 130px over the last tile's edge on a desktop and 3.5rem under
       the head (2026-10-15, "more white space after and before the break",
       from 7rem / 1.5rem the same afternoon) — twice the 60px the tiles keep
       between themselves, so a run's end reads as an end. (The tile's own
       margin-bottom does not add to this: the spanner's margin and the
       column's trailing margin meet, they do not stack.) */
    margin: 10rem 0 3.5rem;
    color: var(--color-dark);
  }

  .cgrid[data-pattern="grid"] :global(.cgrid__head:first-of-type) {
    margin-top: 0;
  }

  .cgrid[data-pattern="grid"] :global(.cgrid__head::after) {
    content: "";
    flex: 1 1 auto;
    /* THINNER (2026-10-15, "thinner line"): half a device pixel where the
       screen has one to give, and faded to the muted grey everywhere — a 1x
       screen rounds 0.5px back up to one, so the colour is what makes it
       read lighter there. */
    border-top: 0.5px solid var(--color-muted);
  }

  @media (--bp-mobile) {
    .cgrid[data-pattern="grid"] :global(.cgrid__head) {
      margin: 7rem 0 2.5rem;
    }
  }

  .cgrid :global(.cgrid__head a) {
    color: inherit;
    text-decoration: none;
  }

  .cgrid :global(.cgrid__head a:hover),
  .cgrid :global(.cgrid__head a:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }


  /* The grid wall reads as a wall — aligned rows of equal cells — and a
     card growing a disclosure panel out of one of them breaks that row.
     The gallery spread keeps it. Written global because the `details`
     belongs to another component (MemberDetailPanel). The open state is
     also cleared on the way in (see applyLayout), so returning to the
     spread does not reveal a panel left open before the switch. */
  :global(.cgrid[data-pattern="grid"] .pdisc) {
    display: none;
  }

  /* An open disclosure paints over whatever is beneath it, so the cell
     holding it has to rise above its neighbours — every cell carries a GSAP
     transform and therefore its own stacking context, which otherwise lets a
     later cell paint straight over the open panel. Written global because the
     `details` it tests for belongs to another component. */
  :global(.cgrid__cell:has(details[open])) {
    z-index: 3;
  }

  /* Nothing hides a cell today. Kept because the filters are coming back, and
     on a grid a hidden cell leaves its slot empty rather than repacking —
     worth knowing before wiring them to this layout. */
  .cgrid__cell[hidden] {
    display: none;
  }

  /* The index view swaps the whole grid out; display:grid above (and
     display:block on mobile) would beat the [hidden] presentational hint,
     same story as the strip. */
  .cgrid[hidden] {
    display: none;
  }

  /* ── The index ────────────────────────────────────────── */
  /* A ledger on a phone, a directory of portrait cards on a desktop (the
     --bp-desktop block at the end of this section, 2026-10-23). One markup
     for both: a round portrait, then "Name, Role", then the chevron, all of
     it the disclosure's summary. The ledger lays that out as a line with
     hairlines between rows and a fixed reading measure centred in the wide
     shell; the desktop stacks it into a column and tiles the columns. The
     one view whose geometry is the browser's business, so it needs no slot
     table, no deal, no motion. */
  .cindex-wrap {
    margin: 0 auto;
    padding: 4rem 0 10rem;
    max-width: 72rem;
  }

  .cindex-wrap[hidden] {
    display: none;
  }

  .cindex__note {
    margin: 1rem 0 0;
  }

  .cindex {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cindex__row {
    border-top: 1px solid var(--color-border);
  }

  .cindex__row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /* Row line. NOT a grid with a display:contents <details> -- that made the
     page unopenable on an iPhone (see MemberDetailPanel). The open panel is
     full-width because .pdisc is an ordinary block in flow. */
  .cindex__line {
    position: relative;
  }

  .cindex__line :global(.pdisc) {
    display: block;
  }

  /* ── THE ROW IS THE SUMMARY ────────────────────────────
     What used to be .cindex__link's rules, moved onto the disclosure's own
     summary (2026-09-01) — the whole ledger line is the toggle now, so the
     line's geometry has to belong to the element that is clickable. The
     chevron is that summary's ::after and therefore its last child.

     WHO · chevron, AND NOT A GRID ANY MORE (2026-09-02). It was four tracks
     for who · field · profile · chevron; the tag field is gone and the profile
     link moved into the dropdown, which leaves two items — and a fixed track
     list is the wrong tool for two, because the ONE row that still prints a
     profile link on the line (a member with nothing to disclose, see the
     summary's note) then has three. On a grid that row would have had to
     place its link by hand, and every disclosure row would have paid a
     1.5rem gap for an empty track it could not collapse. Flex only puts gaps
     between items that exist, so both shapes lay out correctly with no
     per-row placement.
     `display: flex` is not restated: .pdisc__toggle is already flex in line
     mode (see MemberDetailPanel) — the grid was the override, so removing it
     restores the component's own box. */
  .cindex__line :global(.pdisc__toggle) {
    /* Portrait · who · chevron on one line. The portrait is the summary's
       first item since 2026-10-23 (it was the open panel's lead), so the
       line is a contact list's: a small round face, then the name. */
    align-items: center;
    gap: 0 0.85rem;
    /* No 2rem right reserve: the chevron is the last flex item and nothing
       runs under it. This was a live bug for a while — see the note in git
       history about a padding-right silently reset by a later shorthand. */
    padding: 0.6rem 0.25rem;
    box-sizing: border-box;
    transition: background-color 0.15s;
  }

  .cindex__line :global(.pdisc__toggle:hover),
  .cindex__line :global(.pdisc__toggle:focus-visible) {
    background-color: color-mix(in srgb, var(--color-dark) 4%, transparent);
  }

  /* The chevron sits on the row's own centre line rather than on the type's
     baseline: at 0.36rem it is a mark, not a letter, and a baseline-aligned
     mark at the end of the row reads as having slipped. `flex: 0 0 auto` so
     the row's flexible first item cannot squeeze it. */
  .cindex__line :global(.pdisc__toggle::after) {
    align-self: center;
    flex: 0 0 auto;
  }

  /* The un-clickable twin keeps the geometry and loses the response — a row
     with nothing to disclose must not offer a hover state that leads nowhere.
     Specificity: this pair is (0,4,0)-ish against the hover rule's (0,4,0)
     plus Astro's scope attribute on both, so source order decides and this
     block has to stay BELOW the hover rules above. */
  .cindex__line :global(.pdisc--static .pdisc__toggle:hover) {
    background-color: transparent;
  }

  /* The member's profile picture, a circle as on their page (2026-10-14,
     Josh: "make the index avatar round too"; the shape is the PORTRAITS rule
     in global.css). On the ledger line it is small, a contact list's; the
     desktop card sizes it up (see the --bp-desktop block). The hairline ring
     is what a member without a photo still has: their initials sit inside
     the same circle, so the ring is the shape and the picture is optional. */
  .cindex__avatar {
    display: block;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    border: 1.5px solid var(--color-border);
    background: var(--color-bg);
    box-sizing: border-box;
    transition: border-color 0.15s;
  }

  .cindex__avatar--initials {
    display: grid;
    place-items: center;
    color: var(--color-muted);
    /* No voice of its own: a monogram, not a word. Sized to the circle. */
    font-size: calc(var(--fs-100) * 1.05);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    user-select: none;
  }

  .cindex__line :global(.pdisc__toggle:hover) .cindex__avatar,
  .cindex__line :global(.pdisc__toggle:focus-visible) .cindex__avatar {
    border-color: var(--color-dark);
  }

  /* The open panel reads as a profile fragment, not a full-measure spread:
     capped to a reading width, breathing room above and below. One plain
     column — bio, links, tags, the way to the page — since the portrait
     moved up onto the summary (2026-10-23) and the two-column picture-left
     drawing went with it. Scoped here so the cards' panels keep their own
     compact stack. */
  .cindex__line :global(.pdisc__body) {
    padding: 0.6rem 0.25rem 1.4rem;
  }

  .cindex__line :global(.pdisc__body-inner) {
    max-width: 44rem;
    gap: 1rem;
  }

  .cindex__line :global(.pdisc__vals--tags) {
    margin-top: 0.35rem;
  }

  /* THE NAMED WAY TO THE MEMBER'S PAGE — at the foot of the open dropdown,
     and nowhere else since 2026-09-03, when every row became a disclosure (see
     the row's note). Underlined at rest: it is the one control whose
     job is to be findable, and the row it belongs to expands instead of
     travelling, so nothing else announces that the page exists. Muted so it
     does not outrank the name. Sized and voiced exactly like the image card's
     .ccard__profile, because it is the same control in the same place. */
  .cindex__profile {
    white-space: nowrap;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    transition: color 0.15s;
  }

  .cindex__profile:hover,
  .cindex__profile:focus-visible {
    color: var(--color-dark);
  }

  /* In the panel it is the last line and it is its OWN line, ranged left
     under everything the panel said, which is where MemberDetailPanel's
     footer slot is meant to read from. `align-self` so the column's stretch
     does not make the whole line clickable. */
  .cindex__line :global(.pdisc__body-inner) .cindex__profile {
    align-self: flex-start;
  }

  /* The name and its role as ONE unit. Flex, not plain inline flow, for one
     reason: flex drops the whitespace-only text node between the two spans, so
     the separator can be generated entirely inside .cindex__role and vanish
     with it. column-gap is 0 for the same reason — the space after the comma
     is part of that generated content, so nothing is left behind when there is
     no role to separate.
     ONE LINE WHILE COLLAPSED (2026-09-26, Josh: "truncate the role description
     for the collapsed index entry? so we always only have 1 line"). The role
     used to wrap under the name when the pair ran out of room, so the ledger's
     rows came in two heights. Now a closed row is always one line and the role
     ends in an ellipsis; opening the row lets it wrap again, because the panel
     does not repeat the role and the open row is the only place its ending can
     be read. */
  .cindex__who {
    /* Takes every pixel the chevron does not — this is what holds the chevron
       against the row's right edge now that there is no track to pin it to
       (see the summary's flex note above). */
    flex: 1 1 auto;
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    column-gap: 0;
    row-gap: 0.15rem;
    min-width: 0;
  }

  .cindex__line :global(.pdisc[open]) .cindex__who {
    flex-wrap: wrap;
  }

  .cindex__name {
    /* The name does not give way to its role: the role is what truncates. Only
       a name longer than the whole row shrinks, and it gets the same ellipsis. */
    flex: 0 0 auto;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Voice: NAME in type.css (joined 2026-10-23; it was 600 here). */
    color: var(--color-dark);
  }

  .cindex__line :global(.pdisc__toggle:hover) .cindex__name {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  /* Beside the name, in the name's own box — the same muted voice it had as a
     column, so the eye still reads one bold name and one quiet qualifier. A
     flex item is blockified, so it CAN carry an ellipsis once min-width: 0 lets
     it shrink below its text. */
  .cindex__role {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Voice: META in type.css (joined 2026-10-23; it was --fs-85 here). */
    color: var(--color-muted);
  }

  .cindex__line :global(.pdisc[open]) .cindex__name,
  .cindex__line :global(.pdisc[open]) .cindex__role {
    white-space: normal;
  }

  /* The separator, generated rather than typed, so it can only ever exist when
     a role does. The frontmatter already omits the span for an empty role;
     this is the second half of that guarantee — there is no comma anywhere in
     the markup to be orphaned. NBSP, not a plain space: a leading space at the
     start of an inline box collapses away. */
  .cindex__role::before {
    content: ",\00a0";
  }

  /* Belt and braces for a role element that is present but empty — display:none
     takes its ::before comma with it. Not mobile-only any more: with the role
     inside the name's box a stray separator would show at every breakpoint. */
  .cindex__role:empty {
    display: none;
  }

  @media (--bp-mobile) {
    /* Desktop's air is a desktop measure. */
    .cindex-wrap {
      padding: 1.5rem 0 6rem;
    }

    /* The phone keeps the ledger: portrait, "Name, Role" ending in an
       ellipsis, chevron — the line the base rules draw. It used to stack the
       who under nothing and pin the chevron to the corner, from the days of
       four tracks; with the portrait on the line a row is a contact list's
       and the flex line is the right drawing again. Open, the role wraps
       under the name (see .cindex__who). */
  }

  /* ── THE DIRECTORY OF CARDS (2026-10-23) ───────────────────
     Josh: "on desktop the people section can be a directory of cards with
     their profile pic" — and card-sized when open, not a full-width band.
     The same summary, stood up: portrait over name over role over chevron,
     centred, on paper with no box; the hairlines between rows go. The
     columns auto-fill at 13rem, which is wide enough for the open panel's
     bio to have a reading measure. An open card grows DOWN inside its own
     column: its row grows with it and the neighbours stay top-aligned
     (align-items: start) with paper below them. One open at a time — the
     <details> share a name (see MemberDetailPanel). */
  @media (--bp-desktop) {
    .cindex {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
      gap: 2.5rem 1.5rem;
      align-items: start;
    }

    .cindex__row,
    .cindex__row:last-child {
      border: 0;
      min-width: 0;
    }

    .cindex__line :global(.pdisc__toggle) {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem 0;
      padding: 0.5rem 0.5rem 0.35rem;
      text-align: center;
    }

    /* No hover tint: a card has no box to tint, and a tinted rectangle
       behind a round portrait would draw one. The hover is the ring and
       the name's underline (base rules). */
    .cindex__line :global(.pdisc__toggle:hover),
    .cindex__line :global(.pdisc__toggle:focus-visible) {
      background-color: transparent;
    }

    .cindex__avatar {
      width: 7rem;
      height: 7rem;
    }

    .cindex__avatar--initials {
      font-size: var(--fs-160);
    }

    /* Name over role, each on its own centred line; the comma that joined
       them on the ledger line goes, and the role gets back the gap the
       comma's NBSP supplied. */
    .cindex__who {
      flex: 0 1 auto;
      flex-direction: column;
      align-items: center;
      align-self: stretch;
      row-gap: 0.3rem;
    }

    .cindex__role::before {
      content: none;
    }

    .cindex__name,
    .cindex__role {
      max-width: 100%;
    }

    /* The chevron under the role, a small centred mark: the one thing on a
       closed card that says it opens. */
    .cindex__line :global(.pdisc__toggle::after) {
      margin-top: 0.1rem;
    }

    /* The panel, inside the card's column: ranged left under the centred
       head, with the card's own side padding. */
    .cindex__line :global(.pdisc__body) {
      padding: 0.4rem 0.5rem 0.6rem;
      text-align: left;
    }

    .cindex__line :global(.pdisc__body-inner) {
      gap: 0.85rem;
    }

    .cindex__line :global(.pdisc__bio) {
      font-size: var(--fs-85);
    }
  }

  @media (--bp-mobile) {

    .cgrid {
      /* The slot table is a desktop drawing — a phone has no room for it.
         Mobile draws the two views its own way, keyed off the same
         data-pattern the deal stamps: Gallery (the default, and the no-JS
         state, which carries no data-pattern at all) is a single column of
         full-width artwork; Grid is the stacked two-column wall. */
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      /* 112, from 72 (2026-10-12, Josh: "space the cards vertically more"):
         a card now ends in its name and foot, and at 72 the next picture
         read as part of it. */
      row-gap: 112px;
      align-items: start;
      width: auto;
      padding-block: 1.5rem 7rem;
    }

    /* Grid view: a continuous two-lane masonry flow (the cosmos.so look) —
       multicol packs each card directly under the one before it at one tight
       uniform gap, so varied card heights never leave row-aligned holes.
       :not([hidden]) keeps this from tying with the `.cgrid[hidden]`
       display:none above, which an emptied filter depends on. */
    /* Two wide and static on a phone too (2026-10-12, "a static grid 2 wide
       and vertically centered"): square cells in two equal columns, each
       artwork centred in its cell — it was a two-lane masonry flow. */
    .cgrid[data-pattern="grid"]:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 40px;
    }

    .cgrid[data-pattern="grid"] .cgrid__cell:not([hidden]) {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* THE DESKTOP CAP, ON THE PHONE'S COLUMNS (2026-09-08, Josh: "very tall
       images should get a max height in grid view"). The wall above bounds a
       tile at 1.5 × its width by shadowing --cgrid-row on the cell; down here
       the multicol had no row unit at all, so CommunityWorkCard's --frame-cap
       fell through to its no-cap fallback and a 1:3 upload ran the full
       column width and three columns tall. The cell becomes an inline-size
       container so the tile can measure it: 100cqw is the column, and the
       same 1.5 × width + 1.2rem of author line that the desktop rule states.
       The tile's own width formula (min(100%, cap × aspect)) then narrows
       tall work, and the static/auto-margin rule below centres it. The deal
       writes --slot-rows: 1 inline for every wall cell at every breakpoint;
       the fallback here only agrees with it. */
    .cgrid[data-pattern="grid"] .cgrid__cell[data-slot="work"] {
      container-type: inline-size;
      --slot-rows: 1;
      --cgrid-row: calc(100cqw / var(--slot-rows, 1));
    }

    .cgrid__cell {
      /* Declared here rather than left to the inline style, and that works
         because the inline style sets --gc/--gr, not grid-column/grid-row:
         these are the real properties, so a stylesheet rule can still win. */
      grid-column: auto;
      grid-row: auto;
      align-self: start;
    }

    /* Back into flow. The desktop grid takes the card out of flow because
       its rows are DRAWN and nothing may feed back into them; the phone's
       rows ARE the cards, so the absolute rule above would leave every cell
       zero-height with the cards piled at the top. */
    :global(.cgrid__cell > .cwork) {
      position: static;
      margin-inline: auto;
    }
    /* Relative, not static: the card's fold toggle is positioned against it
       (MemberDetailPanel's mobile column rules), and the cell's padding below
       would otherwise put the toggle outside the card. */
    :global(.cgrid__cell > .ccard) {
      position: relative;
      margin-inline: auto;
    }

    /* AIR AT THE SIDES of the gallery's cards (2026-10-12, Josh: "it is too
       wide, it can benefit from a bit of white space"): main's 15px gutter
       made each card the screen's width less a hairline, so the picture
       ran all but edge to edge. The wall's two lanes keep
       their width. */
    .cgrid__cell[data-slot="image"] {
      padding-inline: 24px;
    }
  }


  .community-signup-cta {
    padding-top: 5rem;
    display: flex;
    justify-content: center;
  }

  /* ── IMAGES AS A MASONRY (2026-10-12) ─────────────────────────
     Josh, with illustratoren-schweiz.ch's grid as the reference: "the grid
     view like this". Columns about 300px wide — as many as the window fits on
     a desktop, two on a phone — each work at its own aspect, full column
     width, one straight under the next (multicol packs the columns, so no
     row leaves holes and the columns start out of step, as the reference's
     do). Static: no brick, no parallax. The deal still writes its slots;
     multicol ignores them. Stated last in this block so it outranks the
     square-cell grid above at equal specificity on every width.
     PICTURES ONLY, WITH MORE AIR (2026-10-13, Josh: "remove the names that
     still appear under the pictures", "give the grid a bit more space"): the
     tile lost its name line (CommunityWorkCard), so the gaps below carry the
     whole distance between two works — wider than the day before on both
     axes, so the wall reads as pictures on paper rather than a contact
     sheet.
     PLACED BY THE SCRIPT, NOT BY MULTICOL (2026-10-15, Josh: "there is a
     weird stagger for the right column if sorted"). Multicol BALANCES: it
     cuts the run at half its height and a tile that will not break goes
     over to the next column, so a group of three stood as one tile on the
     left and two on the right with a hole under the first — invisible in
     one wall of forty tiles, plain in a sorted run of three. The deal now
     builds each run as a flex row of N columns (`.cgrid__run` > `.cgrid__col`)
     and drops every tile into the SHORTEST column, heights known from the
     picture's own aspect (communityDirectoryController, the grid branch).
     The three knobs the script reads are here: the column it aims for, the
     gutter, and the air under a tile — the same 300 / 60 / 60 the multicol
     drew (32 / 44 on a phone, two columns fixed). */
  .cgrid[data-pattern="grid"]:not([hidden]) {
    display: block;
    --masonry-col: 220px;
    --masonry-gap: 60px;
    --masonry-tile-gap: 60px;
    /* 0 = as many 220px columns as the measure holds; a phone fixes 2.
       220 (2026-10-16, Josh): six columns on a 16" MacBook (1728px). */
    --masonry-cols: 0;
  }
  .cgrid[data-pattern="grid"] :global(.cgrid__run) {
    display: flex;
    align-items: flex-start;
    gap: var(--masonry-gap);
  }
  .cgrid[data-pattern="grid"] :global(.cgrid__col) {
    flex: 1 1 0;
    min-width: 0;
  }
  .cgrid[data-pattern="grid"] .cgrid__cell:not([hidden]) {
    display: block;
    aspect-ratio: auto;
    left: 0;
    margin-bottom: var(--masonry-tile-gap);
  }
  /* The tallest a work may stand: one and a half times its column. */
  .cgrid[data-pattern="grid"] .cgrid__cell[data-slot="work"] {
    container-type: inline-size;
    --slot-rows: 1;
    --cgrid-row: calc(1.5 * 100cqw / var(--slot-rows, 1));
  }
  @media (--bp-mobile) {
    .cgrid[data-pattern="grid"]:not([hidden]) {
      --masonry-cols: 2;
      --masonry-gap: 32px;
      --masonry-tile-gap: 44px;
    }
  }
</style>

