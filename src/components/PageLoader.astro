---
const WORDS = ["Visual", "Science", "Communication", "Network"];
---

<div id="page-loader" aria-hidden="true">
  <div class="pl-stage">
    <div class="pl-words" aria-label="Visual Science Communication Network">
      {
        WORDS.map((word) => (
          <span class="pl-word">
            <span class="pl-initial">{word[0]}</span><span class="pl-rest">{word.slice(1)}</span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #f7f6f5;
    display: flex;
    align-items: center;
    pointer-events: none;
    animation: pl-fade 0.35s ease-in 2.4s forwards;
  }

  @keyframes pl-fade {
    to {
      opacity: 0;
    }
  }

  .pl-stage {
    width: 70vw;
    margin: 0 auto;
    padding: 0 15px;
    box-sizing: border-box;
  }

  @media (--bp-desktop) {
    .pl-stage {
      width: 600px;
    }
  }

  .pl-words {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pl-word {
    /* min() keeps "Communication" inside the viewport on narrow phones —
       a fixed 36px gets cut off below ~420px. Sized for the system fallback
       font (wider than Archivo), since font-display: swap can show it while
       the webfont downloads. */
    font-size: min(36px, 6.5vw);
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-dark);
    white-space: nowrap;
  }

  @media (--bp-desktop) {
    .pl-word {
      font-size: 64px;
    }
  }

  /* Phase 1: the four initials (VSCN) slide in with a quick stagger. */
  .pl-initial {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: pl-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes pl-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pl-word:nth-child(1) .pl-initial {
    animation-delay: 0.1s;
  }
  .pl-word:nth-child(2) .pl-initial {
    animation-delay: 0.18s;
  }
  .pl-word:nth-child(3) .pl-initial {
    animation-delay: 0.26s;
  }
  .pl-word:nth-child(4) .pl-initial {
    animation-delay: 0.34s;
  }

  /* Phase 2: each initial completes into its word, one after the other. */
  .pl-rest {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    transform: translateX(-0.15em);
    animation: pl-wipe 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes pl-wipe {
    to {
      clip-path: inset(0 -0.1em 0 0);
      transform: translateX(0);
    }
  }

  .pl-word:nth-child(1) .pl-rest {
    animation-delay: 0.75s;
  }
  .pl-word:nth-child(2) .pl-rest {
    animation-delay: 1.05s;
  }
  .pl-word:nth-child(3) .pl-rest {
    animation-delay: 1.35s;
  }
  .pl-word:nth-child(4) .pl-rest {
    animation-delay: 1.65s;
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-initial,
    .pl-rest {
      animation: none;
      opacity: 1;
      clip-path: none;
      transform: none;
    }
    #page-loader {
      animation: pl-fade 0.3s ease-out 0.9s forwards;
    }
  }
</style>

<script>
  // The choreography lives entirely in CSS (clock-driven, so it can never
  // stall waiting for animation frames). This script only removes the
  // overlay once the fade finishes and unlocks the hero entrance.
  const loader = document.getElementById("page-loader");
  if (loader) {
    const finish = () => {
      if (!loader.isConnected) return;
      loader.remove();
      document.body.classList.add("page-loaded");
    };
    loader.addEventListener("animationend", (event) => {
      if (event.target === loader) finish();
    });
    // Safety net for environments that never deliver animation events
    // (hidden tabs, some webviews): slightly past the fade's end time.
    setTimeout(finish, 3400);
  }
</script>
