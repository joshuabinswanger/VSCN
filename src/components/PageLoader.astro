---
const WORDS = ["Visual", "Science", "Communication", "Network"];
---

<div id="page-loader" aria-hidden="true">
  <div class="pl-stage">
    <div class="pl-words" aria-label="Visual Science Communication Network">
      {
        WORDS.map((word) => (
          <span class="pl-word">
            <span class="pl-initial">{word[0]}</span><span class="pl-rest">{word.slice(1)}</span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* THE INTRO IS THE TITLE (2026-10-12, Josh: "the intro animation should
     just be the VSCN that is written out then collapses"). One line: the four
     initials arrive, each writes out its word — Visual Science Communication
     Network — the line holds, then the words fold back into VSCN, and the
     paper lifts away. Clock-driven CSS throughout (see the script). */
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    animation: pl-fade 0.35s ease-in 2.75s forwards;
  }

  @keyframes pl-fade {
    to {
      opacity: 0;
    }
  }

  .pl-stage {
    padding: 0 15px;
    box-sizing: border-box;
  }

  .pl-words {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* The space between the words while they are written out; it closes with
       them, so the folded line is VSCN with nothing between its letters. */
    column-gap: 0.28em;
    animation: pl-close 0.4s cubic-bezier(0.65, 0, 0.35, 1) 2.15s forwards;
  }

  @keyframes pl-close {
    to {
      column-gap: 0;
    }
  }

  .pl-word {
    /* Sized so the whole name fits one line on a desktop and wraps on a
       phone; folded, it is one short word either way. */
    font-size: clamp(22px, 4.2vw, 56px);
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-dark);
    white-space: nowrap;
  }

  /* The four initials arrive with a quick stagger. */
  .pl-initial {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: pl-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes pl-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pl-word:nth-child(1) .pl-initial { animation-delay: 0.1s; }
  .pl-word:nth-child(2) .pl-initial { animation-delay: 0.18s; }
  .pl-word:nth-child(3) .pl-initial { animation-delay: 0.26s; }
  .pl-word:nth-child(4) .pl-initial { animation-delay: 0.34s; }

  /* Each initial writes out its word, one after the other, then all four
     fold back at once. The width is what travels, so the line closes up as
     the words go; 8em is wider than "ommunication" at this weight. */
  .pl-rest {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    max-width: 0;
    animation:
      pl-write 0.32s cubic-bezier(0.22, 1, 0.36, 1) forwards,
      pl-fold 0.4s cubic-bezier(0.65, 0, 0.35, 1) 2.15s forwards;
  }

  @keyframes pl-write {
    to {
      max-width: 8em;
    }
  }
  @keyframes pl-fold {
    from {
      max-width: 8em;
    }
    to {
      max-width: 0;
    }
  }

  .pl-word:nth-child(1) .pl-rest { animation-delay: 0.6s, 2.15s; }
  .pl-word:nth-child(2) .pl-rest { animation-delay: 0.85s, 2.15s; }
  .pl-word:nth-child(3) .pl-rest { animation-delay: 1.1s, 2.15s; }
  .pl-word:nth-child(4) .pl-rest { animation-delay: 1.35s, 2.15s; }

  @media (prefers-reduced-motion: reduce) {
    .pl-initial,
    .pl-rest,
    .pl-words {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .pl-rest {
      max-width: 0;
    }
    .pl-words {
      column-gap: 0;
    }
    #page-loader {
      animation: pl-fade 0.3s ease-out 0.6s forwards;
    }
  }
</style>

<script>
  // The choreography lives entirely in CSS (clock-driven, so it can never
  // stall waiting for animation frames). This script only removes the
  // overlay once the fade finishes and unlocks the hero entrance.
  const loader = document.getElementById("page-loader");
  if (loader) {
    const finish = () => {
      if (!loader.isConnected) return;
      loader.remove();
      document.body.classList.add("page-loaded");
    };
    loader.addEventListener("animationend", (event) => {
      if (event.target === loader) finish();
    });
    // Safety net for environments that never deliver animation events
    // (hidden tabs, some webviews): slightly past the fade's end time.
    setTimeout(finish, 3700);
  }
</script>
