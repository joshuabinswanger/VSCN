---
import { INTRO_WORDS } from "../lib/introCascade";

// One row per word, one flap slot per glyph position of the longest word.
const SLOT_COUNT = Math.max(...INTRO_WORDS.map((w) => w.length));
---

<div id="page-loader" aria-hidden="true">
  <div class="pl-stack" id="pl-stack" aria-label="Visual Science Communication Network">
    {
      INTRO_WORDS.map(() => (
        <span class="pl-row">
          {Array.from({ length: SLOT_COUNT }, () => (
            <span class="pl-slot">
              <span class="pl-face" />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  /* THE INTRO IS THE HEADER'S FLAP, STACKED (2026-10-15, Josh: "i like the
     vertical alignment ... make the animation vertical again but then
     smoothly transition into the bar on the top left"). The header writes a
     word over the letters after its initial, one split-flap turn per glyph
     (Layout.astro, .brand-slot). This is four rows of the same slots at
     display size, the initials aligned in a column: V S C N drop in top to
     bottom, each row writes its word, the whole name holds, and then the words
     fade out where they stand, tails folding away, while the paper lifts and
     the header's VSCN fades in underneath (2026-11-08, Josh: "the animation
     that move the vscn to the top left replace with fade instead of
     translation"; until then each row flew onto its own header slot).
     The choreography is data in src/lib/introCascade.ts; the script below
     turns it into Web Animations on one clock. */
  #page-loader {
    /* The column's measure: the old intro's stage, 70vw up to 600px. */
    --pl-measure: min(600px, 70vw);
    /* Fallback before the script measures: "Communication" is about 7.9em
       at this weight. */
    --pl-size: min(64px, calc(var(--pl-measure) / 7.9));
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* The header's own VSCN is simply under the paper: the loader fading away
     uncovers it, so the two cross-fade on the compositor with no timer to
     arrive late. (It was hidden while the rows flew onto it.) */

  .pl-stack {
    width: var(--pl-measure);
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    /* Same typography as .brand-name in Layout.astro. */
    font-size: var(--pl-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
  }

  /* A row is a flex line: the whitespace between slots draws nothing. */
  .pl-row {
    display: flex;
    height: 1em;
  }

  /* One slot per glyph position. Each slot shows one letter in the whole
     intro (it drops in on the write, tips away on the fold), so one face is
     enough. NO WIDTH IS EVER SET OR ANIMATED (2026-11-02, Josh: "try one
     last time to find a definitive solution to the problem that the words
     on initial load overlap"): every cell is as wide as its own letter in
     whatever face the browser is drawing, the moment it draws it. Four fixes
     measured the glyphs and fixed each cell's px width (and closed the cells
     on the fold); each still overlapped on some iPhone load where the face
     the cells were measured in was not the face that was painted. With the
     browser laying the letters out there is nothing to get wrong: a font
     that lands late reflows the letters into place like any text. */
  .pl-slot {
    display: block;
    flex: none;
    perspective: 12ch;
  }

  /* A face waits edge-on above the line (-90), drops in to 0, tips away to
     +90: always forward, as a real board falls. Hidden until its animation
     says otherwise. */
  .pl-face {
    display: block;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    opacity: 0;
    transform: rotateX(-90deg);
  }
</style>

<script>
  import { INTRO_WORDS, planStack } from "../lib/introCascade";

  // The whole rhythm, in one place. Rows write with a short offset rather
  // than one after the other: they are separate lines, so nothing overlays.
  // Tightened 2026-10-15 twice (Josh: "start sooner and be a bit quicker",
  // then "transition from full words directly into the top VSCN"): the
  // fold and the travel are one move now, ~4.4 s -> ~2.9 s; then "shorten
  // the hold on the full name too", ~2.75 s. Then all of it at 0.75
  // (2026-11-02, Josh: "it can be also a bit faster 0.75"), ~2.1 s.
  const SPEED = 0.75;
  const TIMING = {
    beat: 0.17 * SPEED,
    stagger: 0.02 * SPEED,
    lead: 0.2 * SPEED,
    arriveStagger: 0.07 * SPEED,
    hold: 0.1 * SPEED,
    rowOffset: 0.18 * SPEED,
    holdName: 0.15 * SPEED,
    foldStagger: 0.04 * SPEED,
    travelLag: 0.08 * SPEED,
  };
  // The fade: the stacked words and the paper go, the header's VSCN is
  // uncovered. Long enough for the tails to tip away inside it.
  const FADE_S = 0.6 * SPEED;
  const LONGEST = INTRO_WORDS.reduce((a, b) => (b.length > a.length ? b : a));
  const CURVE = "cubic-bezier(0.65, 0, 0.35, 1)";

  const loader = document.getElementById("page-loader");
  const stack = document.getElementById("pl-stack");
  // NOT BEFORE ANYONE IS LOOKING (2026-10-20, Josh: "sometimes the initial
  // VSCN animation on page load does not work"). The intro ran on a clock
  // from the moment this script ran, visible or not — and a page can load
  // out of sight: Safari preloads the address bar's top hit while you are
  // still typing, a link can open in a background tab, Chrome prerenders
  // likely navigations. There the letters wrote and flew unseen, and the
  // visitor arrived on the full stacked name or on an empty paper. Now the
  // intro waits for the page to be shown, and plays from its first beat.
  if (loader && stack) {
    const font = fontLoad(stack);
    void whenShown()
      .then(() => fontIn(font))
      .then(() => play(loader, stack, font));
  }

  // NOT BEFORE THE FONT (2026-10-28), so the letters write in Archivo and
  // not in a fallback that swaps mid-word. Never longer than 1.5 s: a font
  // that does not come must not hold the page behind the loader. One that
  // comes later only refits the stack (play(), size); the letters reflow by
  // themselves, since no cell has a width of its own.
  function fontLoad(stack: HTMLElement): Promise<void> {
    if (!document.fonts) return Promise.resolve();
    const cs = getComputedStyle(stack);
    const face = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    return document.fonts
      .load(face, INTRO_WORDS.join(""))
      .then(() => undefined)
      .catch(() => undefined);
  }

  function fontIn(font: Promise<void>): Promise<void> {
    return Promise.race([font, new Promise<void>((resolve) => setTimeout(resolve, 1500))]);
  }

  function whenShown(): Promise<void> {
    const doc = document as Document & { prerendering?: boolean };
    if (doc.prerendering) {
      return new Promise<void>((resolve) =>
        document.addEventListener("prerenderingchange", () => resolve(), { once: true })
      ).then(whenShown);
    }
    if (document.visibilityState === "visible") return Promise.resolve();
    return new Promise<void>((resolve) => {
      const onChange = () => {
        if (document.visibilityState !== "visible") return;
        document.removeEventListener("visibilitychange", onChange);
        resolve();
      };
      document.addEventListener("visibilitychange", onChange);
    });
  }

  // ONE CLOCK, BOOKED UP FRONT (2026-10-29, Josh: "the inital loading
  // animation is still not working when reloading the page from new"). The
  // plan used to be played by a dozen setTimeouts, one per row and phase,
  // each starting CSS transitions when it fired. A first load keeps the main
  // thread busy (the site's own scripts parse and run under the intro), so
  // the timers fired late and in clumps: at 6x CPU the initials, the words
  // and the fold all landed within a few frames of each other. Now every
  // letter's turn, every cell's width and every row's flight is a Web
  // Animation created at once, with its moment as its delay, all on the
  // document timeline. The flips and the flight are transform and opacity,
  // which the compositor runs even while the main thread is busy; the widths
  // and the paper are time-based too, so a late frame skips ahead instead of
  // pushing everything after it back.
  function play(loader: HTMLElement, stack: HTMLElement, font: Promise<void>) {
    const rowEls = Array.from(stack.querySelectorAll<HTMLElement>(".pl-row"));
    const rows = rowEls.map((row) => Array.from(row.querySelectorAll<HTMLElement>(".pl-slot")));
    let done = false;

    const finish = () => {
      if (done) return;
      done = true;
      loader.remove();
      document.body.classList.add("page-loaded");
    };

    const plan = planStack(INTRO_WORDS, TIMING);
    const beat = TIMING.beat * 1000;

    // Each slot shows exactly one glyph in the whole intro: the initial from
    // its arrival, a tail letter from its write until its fold. Every cell
    // holds its letter, unseen, from the first frame, so the row is laid out
    // once at its full width and no letter that shows moves another.
    rows.forEach((slots, r) => {
      const word = INTRO_WORDS[r];
      slots.forEach((slot, i) => {
        const face = slot.querySelector<HTMLElement>(".pl-face");
        if (face) face.textContent = word[i] ?? "";
      });
    });
    size();

    // THE FONT THAT CAME LATE (2026-10-30): the 1.5 s wait above is a
    // ceiling, and a cold phone load can need more. The letters reflow into
    // the new face on their own; the stack refits to the column.
    void font.then(() => {
      if (!done) size();
    });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Reduced motion: the column of initials appears in place, the paper fades.
      rows.forEach((slots) => {
        const face = slots[0]?.querySelector<HTMLElement>(".pl-face");
        if (face) face.style.cssText = "opacity:1;transform:none";
      });
      loader
        .animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 300,
          delay: 600,
          easing: "ease-out",
          fill: "forwards",
        })
        .finished.then(finish, finish);
      return;
    }

    plan.events.forEach((event) => {
      event.changes.forEach((change) => {
        const slot = rows[event.row]?.[change.index];
        const face = slot?.querySelector<HTMLElement>(".pl-face");
        if (!slot || !face) return;
        const at = (event.at + change.delay) * 1000;
        if (change.char) {
          // Drops in on the second beat of its turn. Opacity switches while
          // the face is edge-on, at the very start.
          face.animate(
            [
              { opacity: 0, transform: "rotateX(-90deg)" },
              { opacity: 1, transform: "rotateX(-90deg)", offset: 0.001, easing: CURVE },
              { opacity: 1, transform: "rotateX(0deg)" },
            ],
            { duration: beat, delay: at + beat, fill: "both" }
          );
        } else {
          // The fold: the letter tips away on the first beat, the last
          // letter first, while the stack is already fading. The cell keeps
          // its width, so nothing slides over a letter still turning.
          face.animate(
            [
              { opacity: 1, transform: "rotateX(0deg)", easing: CURVE },
              { opacity: 1, transform: "rotateX(90deg)", offset: 0.999 },
              { opacity: 0, transform: "rotateX(90deg)" },
            ],
            { duration: beat, delay: at, fill: "forwards" }
          );
        }
      });
    });

    // The fade, booked now too: the words where they stand and the paper go
    // together, uncovering the header's VSCN.
    const fadeAt = plan.travelAt * 1000;
    const fade = loader.animate([{ opacity: 1 }, { opacity: 0 }], {
      duration: FADE_S * 1000,
      delay: fadeAt,
      easing: "ease-in-out",
      fill: "forwards",
    });
    fade.finished.then(finish, finish);
    // Safety net for environments whose animations never finish (frozen
    // timelines in some webviews): past the fade's end.
    setTimeout(finish, fadeAt + FADE_S * 1000 + 1500);

    // Fit the stack to the column in whatever face is drawing now.
    function size() {
      stack.style.fontSize = "";
      fitStack(stack);
    }
  }

  // Fit the longest word to the column's measure, never larger than the
  // stylesheet's size. Runs before any letter shows, so nothing is seen to jump.
  function fitStack(stack: HTMLElement) {
    const current = parseFloat(getComputedStyle(stack).fontSize);
    const available = stack.clientWidth;
    const mirror = document.createElement("span");
    mirror.textContent = LONGEST;
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:nowrap;left:0;top:0";
    stack.appendChild(mirror);
    const width = mirror.getBoundingClientRect().width;
    mirror.remove();
    if (available > 0 && width > available) {
      stack.style.fontSize = `${(current * available) / width}px`;
    }
  }
</script>
