---
import { INTRO_WORDS } from "../lib/introCascade";

// One row per word, one flap slot per glyph position of the longest word.
const SLOT_COUNT = Math.max(...INTRO_WORDS.map((w) => w.length));
---

<div id="page-loader" aria-hidden="true">
  <div class="pl-stack" id="pl-stack" aria-label="Visual Science Communication Network">
    {
      INTRO_WORDS.map(() => (
        <span class="pl-row">
          {Array.from({ length: SLOT_COUNT }, () => (
            <span class="pl-slot">
              <span class="pl-face" />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  /* THE INTRO IS THE HEADER'S FLAP, STACKED (2026-10-15, Josh: "i like the
     vertical alignment ... make the animation vertical again but then
     smoothly transition into the bar on the top left"). The header writes a
     word over the letters after its initial, one split-flap turn per glyph
     (Layout.astro, .brand-slot). This is four rows of the same slots at
     display size, the initials aligned in a column: V S C N drop in top to
     bottom, each row writes its word, the whole name holds, and then the words
     fly straight into the header, each row folding to its initial in flight
     and landing on its own slot of the header's VSCN while the paper lifts.
     The choreography is data in src/lib/introCascade.ts; the script below
     turns it into Web Animations on one clock. */
  #page-loader {
    /* The column's measure: the old intro's stage, 70vw up to 600px. */
    --pl-measure: min(600px, 70vw);
    /* Fallback before the script measures: "Communication" is about 7.9em
       at this weight. */
    --pl-size: min(64px, calc(var(--pl-measure) / 7.9));
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  /* The header's own VSCN stays out of sight until the travellers land on
     it: the intro's last frame is the site's first. The loader is removed in
     the same frame the swap happens, so nothing is ever drawn twice. */
  :global(body:has(#page-loader) #brand-name) {
    visibility: hidden;
  }

  .pl-stack {
    width: var(--pl-measure);
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    /* Same typography as .brand-name in Layout.astro, so that a transform
       scale lands the glyphs exactly on the header's. */
    font-size: var(--pl-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
  }

  .pl-row {
    display: block;
    height: 1em;
    transform-origin: 0 0;
  }

  /* One slot per glyph position. Each slot shows one letter in the whole
     intro (it drops in on the write, tips away on the fold), so one face is
     enough. The cell's px width is set by the script, per glyph. */
  .pl-slot {
    display: inline-grid;
    justify-items: start;
    width: 0;
    vertical-align: top;
    perspective: 12ch;
  }

  /* A face waits edge-on above the line (-90), drops in to 0, tips away to
     +90: always forward, as a real board falls. Hidden until its animation
     says otherwise. */
  .pl-face {
    grid-area: 1 / 1;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    opacity: 0;
    transform: rotateX(-90deg);
  }
</style>

<script>
  import { INTRO_WORDS, planStack } from "../lib/introCascade";

  // The whole rhythm, in one place. Rows write with a short offset rather
  // than one after the other: they are separate lines, so nothing overlays.
  // Tightened 2026-10-15 twice (Josh: "start sooner and be a bit quicker",
  // then "transition from full words directly into the top VSCN"): the
  // fold and the travel are one move now, ~4.4 s -> ~2.9 s; then "shorten
  // the hold on the full name too", ~2.75 s.
  const TIMING = {
    beat: 0.17,
    stagger: 0.02,
    lead: 0.2,
    arriveStagger: 0.07,
    hold: 0.1,
    rowOffset: 0.18,
    holdName: 0.15,
    foldStagger: 0.04,
    travelLag: 0.08,
  };
  // Long enough for the longest tail ("ommunication") to finish folding in
  // flight, so every row lands as a single letter.
  const TRAVEL_S = 0.5;
  // Between one row setting off and the next, top to bottom: the column
  // peels into the line rather than snapping to it.
  const TRAVEL_STAGGER_S = 0.03;
  const LONGEST = INTRO_WORDS.reduce((a, b) => (b.length > a.length ? b : a));
  const CURVE = "cubic-bezier(0.65, 0, 0.35, 1)";

  const loader = document.getElementById("page-loader");
  const stack = document.getElementById("pl-stack");
  // NOT BEFORE ANYONE IS LOOKING (2026-10-20, Josh: "sometimes the initial
  // VSCN animation on page load does not work"). The intro ran on a clock
  // from the moment this script ran, visible or not — and a page can load
  // out of sight: Safari preloads the address bar's top hit while you are
  // still typing, a link can open in a background tab, Chrome prerenders
  // likely navigations. There the letters wrote and flew unseen, and the
  // visitor arrived on the full stacked name or on an empty paper. Now the
  // intro waits for the page to be shown, and plays from its first beat.
  if (loader && stack) {
    const font = fontLoad(stack);
    void whenShown()
      .then(() => fontIn(font))
      .then(() => play(loader, stack, font));
  }

  // NOT BEFORE THE FONT (2026-10-28, Josh: "the intro animation doesnt work
  // when first visiting the site the letters overlap each other"). play()
  // measures every glyph's advance and sizes the cells to it; on a first
  // visit Archivo was still downloading, so the cells took the fallback
  // face's widths and the real letters, arriving a moment later, ran over
  // each other. Wait for the face the stack draws in, but never longer than
  // 1.5 s: a font that does not come must not hold the page behind the
  // loader. A font that comes LATER than that is caught in play() (size).
  function fontLoad(stack: HTMLElement): Promise<void> {
    if (!document.fonts) return Promise.resolve();
    const cs = getComputedStyle(stack);
    const face = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    return document.fonts
      .load(face, INTRO_WORDS.join(""))
      .then(() => undefined)
      .catch(() => undefined);
  }

  function fontIn(font: Promise<void>): Promise<void> {
    return Promise.race([font, new Promise<void>((resolve) => setTimeout(resolve, 1500))]);
  }

  function whenShown(): Promise<void> {
    const doc = document as Document & { prerendering?: boolean };
    if (doc.prerendering) {
      return new Promise<void>((resolve) =>
        document.addEventListener("prerenderingchange", () => resolve(), { once: true })
      ).then(whenShown);
    }
    if (document.visibilityState === "visible") return Promise.resolve();
    return new Promise<void>((resolve) => {
      const onChange = () => {
        if (document.visibilityState !== "visible") return;
        document.removeEventListener("visibilitychange", onChange);
        resolve();
      };
      document.addEventListener("visibilitychange", onChange);
    });
  }

  // ONE CLOCK, BOOKED UP FRONT (2026-10-29, Josh: "the inital loading
  // animation is still not working when reloading the page from new"). The
  // plan used to be played by a dozen setTimeouts, one per row and phase,
  // each starting CSS transitions when it fired. A first load keeps the main
  // thread busy (the site's own scripts parse and run under the intro), so
  // the timers fired late and in clumps: at 6x CPU the initials, the words
  // and the fold all landed within a few frames of each other. Now every
  // letter's turn, every cell's width and every row's flight is a Web
  // Animation created at once, with its moment as its delay, all on the
  // document timeline. The flips and the flight are transform and opacity,
  // which the compositor runs even while the main thread is busy; the widths
  // and the paper are time-based too, so a late frame skips ahead instead of
  // pushing everything after it back.
  function play(loader: HTMLElement, stack: HTMLElement, font: Promise<void>) {
    const rowEls = Array.from(stack.querySelectorAll<HTMLElement>(".pl-row"));
    const rows = rowEls.map((row) => Array.from(row.querySelectorAll<HTMLElement>(".pl-slot")));
    // Each folding cell's width animation, so a late font can re-aim it.
    const folds = new Map<HTMLElement, Animation>();
    let done = false;

    const finish = () => {
      if (done) return;
      done = true;
      loader.remove();
      document.body.classList.add("page-loaded");
    };

    const plan = planStack(INTRO_WORDS, TIMING);
    const beat = TIMING.beat * 1000;

    // Each slot shows exactly one glyph in the whole intro: the initial from
    // its arrival, a tail letter from its write until its fold. Give every
    // cell its letter and its full width before the first frame. While a
    // word writes, the cells to its right are still empty, so their being
    // open already moves nothing that can be seen — and there is no width
    // to catch up with when the letter shows.
    rows.forEach((slots, r) => {
      const word = INTRO_WORDS[r];
      slots.forEach((slot, i) => {
        const face = slot.querySelector<HTMLElement>(".pl-face");
        if (face) face.textContent = word[i] ?? "";
      });
    });
    size();

    // THE FONT THAT CAME LATE (2026-10-30, Josh: "fix the loading screen
    // animation so it does not overlap letters when opening on an iOS").
    // The 1.5 s wait above is a ceiling, and a cold phone load can need more:
    // the intro then started in the fallback face, every cell took that
    // face's widths, and when Archivo landed mid-intro its letters changed
    // width inside cells sized for the other font (a frame sheet in WebKit
    // with the font held back 2.5 s shows it) — on an iPhone, where Archivo
    // at this weight is the wider face, they ran over each other. Now the
    // arrival re-measures: the stack refits, every cell takes the real
    // advance, and every fold already booked starts from the new width. The
    // flights are re-aimed by retarget below if they have not left yet.
    void font.then(() => {
      if (!done) size();
    });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Reduced motion: the column of initials appears in place, the paper fades.
      rows.forEach((slots) => {
        const face = slots[0]?.querySelector<HTMLElement>(".pl-face");
        if (face) face.style.cssText = "opacity:1;transform:none";
        slots.slice(1).forEach((slot) => (slot.style.width = "0px"));
      });
      loader
        .animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 300,
          delay: 600,
          easing: "ease-out",
          fill: "forwards",
        })
        .finished.then(finish, finish);
      return;
    }

    plan.events.forEach((event) => {
      event.changes.forEach((change) => {
        const slot = rows[event.row]?.[change.index];
        const face = slot?.querySelector<HTMLElement>(".pl-face");
        if (!slot || !face) return;
        const at = (event.at + change.delay) * 1000;
        if (change.char) {
          // Drops in on the second beat of its turn. Opacity switches while
          // the face is edge-on, at the very start.
          face.animate(
            [
              { opacity: 0, transform: "rotateX(-90deg)" },
              { opacity: 1, transform: "rotateX(-90deg)", offset: 0.001, easing: CURVE },
              { opacity: 1, transform: "rotateX(0deg)" },
            ],
            { duration: beat, delay: at + beat, fill: "both" }
          );
        } else {
          // The fold: the letter tips away on the first beat...
          face.animate(
            [
              { opacity: 1, transform: "rotateX(0deg)", easing: CURVE },
              { opacity: 1, transform: "rotateX(90deg)", offset: 0.999 },
              { opacity: 0, transform: "rotateX(90deg)" },
            ],
            { duration: beat, delay: at, fill: "forwards" }
          );
          // ...while its cell closes from the same moment over a beat and a
          // half, so the word contracts into its initial in flight.
          folds.set(
            slot,
            slot.animate(foldFrames(slot.style.width), {
              duration: beat * 1.5,
              delay: at,
              fill: "forwards",
            })
          );
        }
      });
    });

    // The travel and the paper, booked now too. The header's slots are
    // measured now and again just before take-off, in case the header
    // re-fitted itself in between.
    const travelAt = plan.travelAt * 1000;
    const flights = travel(loader, rowEls, travelAt);
    if (!flights) {
      setTimeout(() => {
        loader
          .animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300, fill: "forwards" })
          .finished.then(finish, finish);
      }, travelAt);
      return;
    }
    setTimeout(() => retarget(rowEls, flights), Math.max(0, travelAt - 120));
    Promise.all(flights.map((f) => f.finished)).then(finish, finish);
    // Safety net for environments whose animations never finish (frozen
    // timelines in some webviews): past the travel's end.
    const travelEnds = travelAt + (TRAVEL_S + (rowEls.length - 1) * TRAVEL_STAGGER_S) * 1000;
    setTimeout(finish, travelEnds + 1500);

    // Fit the stack and give every cell its glyph's advance in whatever face
    // is drawing now; a fold already booked starts from the new width.
    function size() {
      stack.style.fontSize = "";
      fitStack(stack);
      const widths = measureGlyphs(stack);
      rows.forEach((slots, r) => {
        const word = INTRO_WORDS[r];
        slots.forEach((slot, i) => {
          const width = `${widths.get(word[i] ?? "") ?? 0}px`;
          slot.style.width = width;
          (folds.get(slot)?.effect as KeyframeEffect | null)?.setKeyframes(foldFrames(width));
        });
      });
    }
  }

  // A fold's cell closes from its full width to nothing, and cuts its own
  // letter (2026-10-15, Josh: "on mobile ... the letters overlap"):
  // unclipped, a glyph still tipping away spilled over the letters the
  // closing cells pulled in from the right. Sideways only: the flap's turn
  // may overshoot the line.
  function foldFrames(width: string): Keyframe[] {
    return [
      { width, clipPath: "inset(-1em 0)", easing: CURVE },
      { width: "0px", clipPath: "inset(-1em 0)" },
    ];
  }

  // Fit the longest word to the column's measure, never larger than the
  // stylesheet's size. Runs before any letter shows, so nothing is seen to jump.
  function fitStack(stack: HTMLElement) {
    const current = parseFloat(getComputedStyle(stack).fontSize);
    const available = stack.clientWidth;
    const mirror = document.createElement("span");
    mirror.textContent = LONGEST;
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:nowrap;left:0;top:0";
    stack.appendChild(mirror);
    const width = mirror.getBoundingClientRect().width;
    mirror.remove();
    if (available > 0 && width > available) {
      stack.style.fontSize = `${(current * available) / width}px`;
    }
  }

  // Advance width of every glyph the words can show, at the fitted size.
  function measureGlyphs(stack: HTMLElement): Map<string, number> {
    const mirror = document.createElement("span");
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:pre;left:0;top:0";
    stack.appendChild(mirror);
    const widths = new Map<string, number>();
    for (const char of new Set(INTRO_WORDS.join(""))) {
      mirror.textContent = char;
      widths.set(char, mirror.getBoundingClientRect().width);
    }
    mirror.remove();
    return widths;
  }

  // The header's VSCN, letter by letter: the resting slots that show a glyph,
  // in order. Hidden by visibility while the loader is up, so their boxes
  // are real.
  function headerLetterRects(count: number): DOMRect[] | null {
    const brand = document.getElementById("brand-name");
    if (!brand) return null;
    const rects = Array.from(brand.querySelectorAll<HTMLElement>(".brand-slot"))
      .filter((slot) => slot.offsetParent !== null)
      .filter((slot) => (slot.querySelector(".brand-slot__rest")?.textContent ?? "") !== "")
      .slice(0, count)
      .map((slot) => slot.getBoundingClientRect());
    return rects.length === count ? rects : null;
  }

  // Where each row must go: scaled about its initial's top-left corner, from
  // where that initial stands onto its own slot of the header's VSCN.
  function flightTransforms(rows: HTMLElement[]): string[] | null {
    const targets = headerLetterRects(rows.length);
    const brand = document.getElementById("brand-name");
    const stack = rows[0]?.closest<HTMLElement>(".pl-stack");
    if (!targets || !brand || !stack) return null;
    const scale =
      parseFloat(getComputedStyle(brand).fontSize) / parseFloat(getComputedStyle(stack).fontSize);
    return rows.map((row, i) => {
      const initial = row.querySelector<HTMLElement>(".pl-slot");
      const to = targets[i];
      if (!initial || !to) return "none";
      const from = initial.getBoundingClientRect();
      return `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${scale})`;
    });
  }

  // Full words straight into the header: each ROW flies top to bottom while
  // the paper lifts. The tails are folding inside the moving row at the same
  // time, so a word shrinks to its initial on the way. The header's copy
  // shows the instant the loader goes.
  function travel(loader: HTMLElement, rows: HTMLElement[], at: number): Animation[] | null {
    const ends = flightTransforms(rows);
    if (!ends) return null;
    loader.animate(
      [
        { backgroundColor: getComputedStyle(loader).backgroundColor },
        { backgroundColor: "transparent" },
      ],
      {
        duration: TRAVEL_S * 1000,
        delay: at,
        easing: "ease-in",
        fill: "forwards",
      }
    );
    return rows.map((row, i) =>
      row.animate([{ transform: "none" }, { transform: ends[i] }], {
        duration: TRAVEL_S * 1000,
        delay: at + i * TRAVEL_STAGGER_S * 1000,
        easing: CURVE,
        fill: "forwards",
      })
    );
  }

  // Just before take-off: if the header moved since the flights were booked,
  // point them at where it is now. Only while every row still stands: a
  // moving row's own box is no longer where it took off from.
  function retarget(rows: HTMLElement[], flights: Animation[]) {
    if (flights.some((flight) => flight.effect?.getComputedTiming().progress !== null)) return;
    const ends = flightTransforms(rows);
    if (!ends) return;
    flights.forEach((flight, i) => {
      (flight.effect as KeyframeEffect | null)?.setKeyframes([
        { transform: "none" },
        { transform: ends[i] },
      ]);
    });
  }
</script>
