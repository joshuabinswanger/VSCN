---
import { INTRO_WORDS } from "../lib/introCascade";

// One row per word, one flap slot per glyph position of the longest word.
const SLOT_COUNT = Math.max(...INTRO_WORDS.map((w) => w.length));
---

<div id="page-loader" aria-hidden="true">
  <div class="pl-stack" id="pl-stack" aria-label="Visual Science Communication Network">
    {
      INTRO_WORDS.map(() => (
        <span class="pl-row">
          {Array.from({ length: SLOT_COUNT }, () => (
            <span class="pl-slot">
              <span class="pl-face" />
              <span class="pl-face" />
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  /* THE INTRO IS THE HEADER'S FLAP, STACKED (2026-10-15, Josh: "i like the
     vertical alignment ... make the animation vertical again but then
     smoothly transition into the bar on the top left"). The header writes a
     word over the letters after its initial, one split-flap turn per glyph
     (Layout.astro, .brand-slot). This is four rows of the same slots at
     display size, the initials aligned in a column: V S C N drop in top to
     bottom, each row writes its word, the whole name holds, the words fold
     back into the column, and then each initial travels on its own path onto
     its own slot in the header's VSCN while the paper lifts. The choreography
     is data in src/lib/introCascade.ts; the script below only plays it. */
  #page-loader {
    --pl-beat: 0.17s;
    --pl-travel: 0.4s;
    /* The column's measure: the old intro's stage, 70vw up to 600px. */
    --pl-measure: min(600px, 70vw);
    /* Fallback before the script measures: "Communication" is about 7.9em
       at this weight. */
    --pl-size: min(64px, calc(var(--pl-measure) / 7.9));
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: background-color var(--pl-travel) ease-in;
  }

  /* The paper lifts while the letters travel; they stay solid ink. */
  #page-loader.pl--leaving {
    background-color: transparent;
  }

  /* The header's own VSCN stays out of sight until the travellers land on
     it: the intro's last frame is the site's first. The loader is removed in
     the same frame the swap happens, so nothing is ever drawn twice. */
  :global(body:has(#page-loader) #brand-name) {
    visibility: hidden;
  }

  .pl-stack {
    width: var(--pl-measure);
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    /* Same typography as .brand-name in Layout.astro, so that a transform
       scale lands the glyphs exactly on the header's. */
    font-size: var(--pl-size);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-dark);
    white-space: nowrap;
  }

  .pl-row {
    display: block;
    height: 1em;
  }

  /* One slot per glyph position, two faces stacked in one grid cell. The
     cell's width is what the script animates (px, measured per glyph: a
     transition cannot interpolate from auto), and it resizes on the second
     beat only, as the incoming letter drops in. Mirrors .brand-slot. */
  .pl-slot {
    display: inline-grid;
    justify-items: start;
    width: 0;
    vertical-align: top;
    perspective: 12ch;
    --pl-delay: 0s;
    --pl-early: var(--pl-delay);
    --pl-late: calc(var(--pl-delay) + var(--pl-beat));
    transition-property: width;
    transition-duration: var(--pl-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: var(--pl-late);
    transform-origin: 0 0;
  }

  /* A face waits edge-on above the line (-90), drops in to 0 when it is
     the front, tips away to +90 when it leaves: always forward, as a real
     board falls. Opacity switches in zero time at the changeover, when both
     faces are edge-on and invisible anyway. */
  .pl-face {
    grid-area: 1 / 1;
    transform-origin: 50% 50%;
    backface-visibility: hidden;
    opacity: 0;
    transform: rotateX(-90deg);
    transition-property: opacity, transform;
    transition-duration: 0s, var(--pl-beat);
    transition-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: var(--pl-late), var(--pl-late);
  }

  .pl-face.is-front {
    opacity: 1;
    transform: rotateX(0deg);
  }

  .pl-face.is-out {
    opacity: 0;
    transform: rotateX(90deg);
    transition-delay: var(--pl-late), var(--pl-early);
  }

  /* Resetting a spent face to its waiting position must not be seen. */
  .pl-face.pl-face--snap {
    transition: none;
  }

  /* Reduced motion: the column appears in place and the paper fades. */
  #page-loader.pl--still,
  #page-loader.pl--still .pl-slot,
  #page-loader.pl--still .pl-face {
    transition: none;
  }
  #page-loader.pl--still {
    transition: opacity 0.3s ease-out;
  }
  #page-loader.pl--still.pl--leaving {
    opacity: 0;
    background-color: var(--color-bg);
  }
</style>

<script>
  import { INTRO_WORDS, planStack, type StackEvent } from "../lib/introCascade";

  // The whole rhythm, in one place. Rows write with a short offset rather
  // than one after the other: they are separate lines, so nothing overlays.
  // Tightened 2026-10-15 (Josh: "the transition into the [header] should
  // start sooner and be a bit quicker in general"): ~4.4 s -> ~3.4 s.
  const TIMING = {
    beat: 0.17,
    stagger: 0.02,
    lead: 0.2,
    arriveStagger: 0.07,
    hold: 0.1,
    rowOffset: 0.18,
    holdName: 0.35,
    foldStagger: 0.04,
    rest: 0.05,
  };
  const TRAVEL_S = 0.4;
  // Between one initial setting off and the next, top to bottom: the column
  // peels into the line rather than snapping to it.
  const TRAVEL_STAGGER_S = 0.03;
  const LONGEST = INTRO_WORDS.reduce((a, b) => (b.length > a.length ? b : a));
  const CURVE = "cubic-bezier(0.65, 0, 0.35, 1)";

  const loader = document.getElementById("page-loader");
  const stack = document.getElementById("pl-stack");
  if (loader && stack) play(loader, stack);

  function play(loader: HTMLElement, stack: HTMLElement) {
    const rows = Array.from(stack.querySelectorAll<HTMLElement>(".pl-row")).map((row) =>
      Array.from(row.querySelectorAll<HTMLElement>(".pl-slot")),
    );
    const timers: ReturnType<typeof setTimeout>[] = [];
    let done = false;

    const finish = () => {
      if (done) return;
      done = true;
      timers.forEach(clearTimeout);
      loader.remove();
      document.body.classList.add("page-loaded");
    };

    fitStack(stack);
    const widths = measureGlyphs(stack);
    const applyEvent = (event: StackEvent) => {
      event.changes.forEach((change) => {
        const slot = rows[event.row]?.[change.index];
        if (slot) flipSlot(slot, change.char, change.delay, widths.get(change.char) ?? 0);
      });
    };

    const plan = planStack(INTRO_WORDS, TIMING);

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      loader.classList.add("pl--still");
      plan.events.filter((e) => e.phase === "arrive").forEach(applyEvent);
      timers.push(setTimeout(() => loader.classList.add("pl--leaving"), 600));
      timers.push(setTimeout(finish, 950));
      return;
    }

    loader.style.setProperty("--pl-beat", `${TIMING.beat}s`);
    loader.style.setProperty("--pl-travel", `${TRAVEL_S}s`);
    plan.events.forEach((event) => {
      timers.push(setTimeout(() => applyEvent(event), event.at * 1000));
    });
    const initials = rows.map((row) => row[0]).filter((s): s is HTMLElement => !!s);
    timers.push(setTimeout(() => travel(loader, initials, finish), plan.travelAt * 1000));
    // Safety net for environments that never deliver transition events
    // (hidden tabs, some webviews): past the travel's end.
    const travelEnds = plan.travelAt + TRAVEL_S + (initials.length - 1) * TRAVEL_STAGGER_S;
    timers.push(setTimeout(finish, travelEnds * 1000 + 1500));
  }

  // Fit the longest word to the column's measure, never larger than the
  // stylesheet's size. Runs before any letter shows, so nothing is seen to jump.
  function fitStack(stack: HTMLElement) {
    const current = parseFloat(getComputedStyle(stack).fontSize);
    const available = stack.clientWidth;
    const mirror = document.createElement("span");
    mirror.textContent = LONGEST;
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:nowrap;left:0;top:0";
    stack.appendChild(mirror);
    const width = mirror.getBoundingClientRect().width;
    mirror.remove();
    if (available > 0 && width > available) {
      stack.style.fontSize = `${(current * available) / width}px`;
    }
  }

  // Advance width of every glyph the words can show, at the fitted size.
  function measureGlyphs(stack: HTMLElement): Map<string, number> {
    const mirror = document.createElement("span");
    mirror.style.cssText =
      "position:absolute;visibility:hidden;pointer-events:none;white-space:pre;left:0;top:0";
    stack.appendChild(mirror);
    const widths = new Map<string, number>();
    for (const char of new Set(INTRO_WORDS.join(""))) {
      mirror.textContent = char;
      widths.set(char, mirror.getBoundingClientRect().width);
    }
    mirror.remove();
    return widths;
  }

  // Turn one slot to a new glyph: the showing face tips away on the first
  // beat, the other face, reset edge-on without a transition and carrying the
  // new glyph, drops in on the second, and the cell takes the new width with
  // it. An empty glyph only tips the old one away and closes the cell.
  function flipSlot(slot: HTMLElement, char: string, delay: number, width: number) {
    const faces = Array.from(slot.querySelectorAll<HTMLElement>(".pl-face"));
    const frontIndex = Number(slot.dataset.front ?? "1");
    const incoming = faces[1 - frontIndex];
    const outgoing = faces[frontIndex];
    if (!incoming || !outgoing) return;

    incoming.classList.add("pl-face--snap");
    incoming.classList.remove("is-out", "is-front");
    incoming.textContent = char;
    void incoming.offsetWidth;
    incoming.classList.remove("pl-face--snap");

    slot.style.setProperty("--pl-delay", `${delay.toFixed(3)}s`);
    if (outgoing.classList.contains("is-front")) {
      outgoing.classList.remove("is-front");
      outgoing.classList.add("is-out");
    }
    if (char) incoming.classList.add("is-front");
    slot.style.width = `${width}px`;
    slot.dataset.front = String(1 - frontIndex);
  }

  // The header's VSCN, letter by letter: the resting slots that show a glyph,
  // in order. Hidden by visibility while the loader is up, so their boxes
  // are real.
  function headerLetterRects(count: number): DOMRect[] | null {
    const brand = document.getElementById("brand-name");
    if (!brand) return null;
    const rects = Array.from(brand.querySelectorAll<HTMLElement>(".brand-slot"))
      .filter((slot) => slot.offsetParent !== null)
      .filter((slot) => (slot.querySelector(".brand-slot__rest")?.textContent ?? "") !== "")
      .slice(0, count)
      .map((slot) => slot.getBoundingClientRect());
    return rects.length === count ? rects : null;
  }

  // The folded column peels into the header's line: each initial shrinks and
  // moves onto its own header slot, top to bottom, while the paper lifts.
  // The header's copy shows the instant the loader goes.
  function travel(loader: HTMLElement, initials: HTMLElement[], finish: () => void) {
    const targets = headerLetterRects(initials.length);
    const brand = document.getElementById("brand-name");
    const stack = initials[0]?.closest<HTMLElement>(".pl-stack");
    if (!targets || !brand || !stack) {
      loader.classList.add("pl--still", "pl--leaving");
      setTimeout(finish, 350);
      return;
    }
    const scale =
      parseFloat(getComputedStyle(brand).fontSize) / parseFloat(getComputedStyle(stack).fontSize);
    const last = initials[initials.length - 1];
    initials.forEach((slot, i) => {
      const from = slot.getBoundingClientRect();
      const to = targets[i];
      if (!to) return;
      slot.style.transition = `transform ${TRAVEL_S}s ${CURVE} ${(i * TRAVEL_STAGGER_S).toFixed(3)}s`;
      slot.style.willChange = "transform";
      slot.style.transform = `translate(${to.left - from.left}px, ${to.top - from.top}px) scale(${scale})`;
    });
    loader.classList.add("pl--leaving");
    last?.addEventListener("transitionend", (event) => {
      if (event.target === last && event.propertyName === "transform") finish();
    });
  }
</script>
