---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
  maxTags?: number;
  /**
   * Only for a selector that has a visible <label for>. Since 2026-09-08 the
   * profile editor clones one selector per gallery row, so a default id here
   * would be stamped onto every row — and a duplicate id is worse than none:
   * `for` and getElementById both silently pick the first. Leave it unset and
   * Astro omits the attribute.
   */
  inputId?: string;
}

const { lang = "en", maxTags = 7, inputId } = Astro.props;
const t = useTranslations(lang);
---

<tag-selector data-lang={lang} data-max-tags={maxTags}>
  <div class="tag-list ts-selected" aria-live="polite"></div>
  {
    /* TWO FIELDS, TWO INTENTS (2026-09-09, Josh: "can it be that the tag
      creator is actually a search? this is confusing"). Until today one box
      filtered the groups, inline-autocompleted to a registry tag AND created a
      new one on Enter — so typing "sci" to add your own tag got you
      "Scientific illustration" instead. This field only narrows the lists
      below; nothing is ever created from it. The add row at the bottom only
      creates. */
  }
  <input
    type="text"
    class="input ts-filter"
    placeholder={t("profile.ph.tagFilter")}
    aria-label={t("profile.tag.filterLabel")}
    maxlength="50"
    autocomplete="off"
  />
  <div class="tag-groups">
    <details class="tag-group" data-group-key="disciplines">
      <summary class="tag-group-summary">
        <span class="tag-group-title">{t("onboarding.tags.group.disciplines")}</span>
        <span class="tag-group-count" data-tag-group-count="disciplines"></span>
        <span class="tag-group-chevron" aria-hidden="true"></span>
      </summary>
      <div class="tag-suggestion-list" data-tag-group="disciplines"></div>
    </details>
    <details class="tag-group" data-group-key="topics">
      <summary class="tag-group-summary">
        <span class="tag-group-title">{t("onboarding.tags.group.topics")}</span>
        <span class="tag-group-count" data-tag-group-count="topics"></span>
        <span class="tag-group-chevron" aria-hidden="true"></span>
      </summary>
      <div class="tag-suggestion-list" data-tag-group="topics"></div>
    </details>
    <details class="tag-group" data-group-key="other">
      <summary class="tag-group-summary">
        <span class="tag-group-title">{t("onboarding.tags.group.other")}</span>
        <span class="tag-group-count" data-tag-group-count="other"></span>
        <span class="tag-group-chevron" aria-hidden="true"></span>
      </summary>
      <div class="tag-suggestion-list" data-tag-group="other"></div>
    </details>
  </div>
  <div class="addrow ts-input-row">
    <input
      id={inputId}
      type="text"
      class="input ts-input"
      placeholder={t("profile.ph.tags")}
      maxlength="50"
      autocomplete="off"
    />
    <button type="button" class="addbtn ts-add-btn" aria-label={t("profile.tag.add")}>+</button>
  </div>
  {
    /* NO CAP NOTE HERE ANY MORE (2026-09-08, Josh: "there is also a mistake
      where it still says Up to 7 in the tag selector, drop it, as there is an
      explanation underneath it"). The component printed "Up to 7 tags." as a
      literal, while `maxTags` is a prop — so the per-image selectors, capped
      at 5, stated a limit that was simply wrong, directly above a note saying
      5. A component cannot say how many of itself are allowed; the field that
      places it can, and the two member-tag fields do. */
  }
  <p class="ts-error msg-err" hidden></p>
</tag-selector>

<style is:global>
  tag-selector {
    display: block;
  }

  tag-selector .ts-error {
    margin-top: 0.5rem;
  }

  tag-selector .ts-error[hidden] {
    display: none;
  }

  tag-selector .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  tag-selector .tag-list:not(:empty) {
    margin-bottom: 0.5rem;
  }

  /* Shape, size, border and fill come from `.optchip` (the drawing shared by
     every multi-select control in this form) and `.tagchip` (the drawing shared
     by every tag on the site, public pages included), both in global.css. Do
     not restate them here; what is left below is only what is true of tag chips
     in this editor alone. */

  /* A picked tag is an .optchip--on that also carries a remove control, so the
     × needs its own size: at the chip's 0.72rem it reads as a speck rather
     than something to press.
     THE NUDGE IS MEASURED, NOT EYEBALLED. Centring the span's BOX leaves the
     glyph off — `×` is drawn on the maths axis, which is not where the ink
     centre of a row of capitals sits, and the two also occupy line boxes of
     different heights. Comparing the two ink centres in Archivo put the × one
     pixel low at this size; -0.084em of the span's own type is that pixel,
     expressed so it holds at any size. Re-measure if the chip's type changes. */
  tag-selector .tag-chip span {
    color: inherit;
    opacity: 0.65;
    font-size: 0.85rem;
    line-height: 1;
    letter-spacing: 0;
    transform: translateY(-0.084em);
  }

  /* The heading rows are NOT on the white — the box belongs to the tags. It is
     drawn on .tag-suggestion-list below, so DISCIPLINES / TOPICS / OTHER stay
     on the page and only the chips an open group reveals sit on a field. */
  /* Drawn exactly like the add row's field below it (.addrow .input in
     global.css): the two are the same kind of thing in the same control, and
     the filter at .input's full size read as a heavier, different field
     (2026-09-09, Josh: "make the find bar the same style as the add tag"). */
  tag-selector .ts-filter {
    margin-top: 0.9rem;
    padding: 4px 10px;
    font-size: 0.82rem;
  }

  tag-selector .tag-groups {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 0.75rem;
  }

  /* NO BOX OF ITS OWN. The heading and its rule are the whole frame for a
     group; the groups are told apart by the space between them, inside the
     panel they share. */
  tag-selector .tag-group {
    background: transparent;
  }

  tag-selector .tag-group-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0 0.45rem;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.15s;
  }

  tag-selector .tag-group-summary::-webkit-details-marker {
    display: none;
  }

  tag-selector .tag-group-summary:hover .tag-group-title {
    color: var(--color-dark);
  }

  tag-selector .tag-group-title {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  tag-selector .tag-group-count {
    font-size: 0.68rem;
    color: var(--color-muted);
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  tag-selector .tag-group-count:empty {
    display: none;
  }

  tag-selector .tag-group-chevron {
    margin-left: auto;
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--color-muted);
    border-bottom: 1px solid var(--color-muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
    transform-origin: 60% 60%;
  }

  tag-selector .tag-group[open] .tag-group-chevron {
    transform: rotate(225deg);
  }

  /* Flow, not grid. A fixed three-column grid gave "3D" the same width as
     "Science Communication" and padded the difference with nothing; wrapping
     at the words' own width is what makes the list short. No media query is
     needed for narrow screens — wrapping already is the narrow-screen
     behaviour. */
  /* THE WHITE BOX IS HERE, AROUND THE TAGS ONLY. `.input`'s surface exactly —
     white, 1.5px border, --radius-sm — because this field sits among the
     form's text inputs and any other white would read as a third kind of
     field. It is on the list rather than on .tag-groups so the group headings
     stay on the page: the box is what the chips sit on, not a frame around the
     whole control. It therefore appears only where an open group has tags to
     show, which is also the only place it means anything. */
  tag-selector .tag-group .tag-suggestion-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0.55rem;
    padding: 0.8rem 0.9rem;
    background: white;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  tag-selector .tag-group .tag-suggestion-list:empty::after {
    content: "—";
    color: var(--color-muted);
    opacity: 0.4;
    font-size: 0.75rem;
  }
</style>

<script>
  import { auth } from "../lib/firebase.ts";
  import { getTags, getOrCreateTag } from "../lib/firestore.ts";
  import type { TagDoc } from "../lib/firestore.ts";
  import { ui } from "../i18n/translations.ts";

  type GroupKey = "disciplines" | "topics" | "other";

  function normalizeTag(value: string): string {
    return value.trim().replace(/^#+/, "").replace(/\s+/g, " ");
  }

  // ONE read of the registry per page, shared by every selector on it. Until
  // 2026-09-08 a page held exactly one selector, so each instance reading the
  // whole `tags` collection for itself cost nothing extra; now the profile
  // editor clones one per gallery row AND rebuilds every row on each upload,
  // reorder and remove (renderGallery in ProfileForm.astro), which made that
  // "one read per instance" into one read per row per edit. The promise is
  // module state, so it also outlives ClientRouter navigations — the registry
  // is curated and slow-moving, and a tag this member creates is pushed onto
  // the shared array below, so every selector on the page sees it at once.
  // A failed read is forgotten, so the next selector to connect retries.
  let registryPromise: Promise<TagDoc[]> | null = null;
  function loadRegistryOnce(): Promise<TagDoc[]> {
    registryPromise ??= getTags().catch((err) => {
      registryPromise = null;
      throw err;
    });
    return registryPromise;
  }

  class TagSelectorElement extends HTMLElement {
    private _tags: string[] = [];
    private registryTags: TagDoc[] = [];
    private maxTags = 7;
    /** Open state of each group as the member left it, taken when a filter
     *  starts forcing groups open and put back when the filter empties. */
    private openBeforeFilter: Map<string, boolean> | null = null;
    private lang: "en" | "de" = "en";
    private inputEl!: HTMLInputElement;
    private filterEl!: HTMLInputElement;
    private selectedEl!: HTMLElement;
    private errorEl!: HTMLElement;
    private bound = false;

    connectedCallback() {
      if (this.bound) return;
      this.bound = true;

      this.maxTags = Number(this.dataset.maxTags ?? 7) || 7;
      this.lang = (this.dataset.lang === "de" ? "de" : "en") as "en" | "de";

      this.inputEl = this.querySelector<HTMLInputElement>(".ts-input")!;
      this.filterEl = this.querySelector<HTMLInputElement>(".ts-filter")!;
      this.selectedEl = this.querySelector<HTMLElement>(".ts-selected")!;
      this.errorEl = this.querySelector<HTMLElement>(".ts-error")!;

      // Promote any pre-upgrade property assignments through the setters
      // so consumers that set `.value` before the element upgraded don't
      // get their assignment shadowed by the prototype's getter/setter.
      for (const key of ["value", "inputValue"] as const) {
        if (Object.prototype.hasOwnProperty.call(this, key)) {
          const captured = (this as unknown as Record<string, unknown>)[key];
          delete (this as unknown as Record<string, unknown>)[key];
          (this as unknown as Record<string, unknown>)[key] = captured;
        }
      }

      this.attachListeners();
      this.render();
      void this.loadRegistry();
    }

    get value(): string[] {
      return [...this._tags];
    }

    set value(arr: string[]) {
      this._tags = Array.isArray(arr) ? arr.filter(Boolean).slice(0, this.maxTags) : [];
      this.render();
    }

    /** Current text in the input box (for state save/restore). */
    get inputValue(): string {
      return this.inputEl?.value ?? "";
    }

    set inputValue(v: string) {
      if (this.inputEl) this.inputEl.value = v;
    }

    private get filterText(): string {
      return this.filterEl?.value ?? "";
    }

    private emitChange() {
      this.dispatchEvent(
        new CustomEvent("change", { detail: { tags: this.value }, bubbles: true })
      );
    }

    private setError(msg: string) {
      if (!this.errorEl) return;
      if (msg) {
        this.errorEl.textContent = msg;
        this.errorEl.hidden = false;
      } else {
        this.errorEl.hidden = true;
      }
    }

    private async loadRegistry() {
      try {
        this.registryTags = await loadRegistryOnce();
        this.renderSuggestions(this.filterText);
      } catch (err) {
        console.warn("[tag-selector] Failed to load tag registry", err);
      }
    }

    private render() {
      this.renderSelected();
      this.renderSuggestions(this.filterText);
    }

    private renderSelected() {
      this.selectedEl.innerHTML = "";
      this._tags.forEach((tag) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "optchip tagchip optchip--on tag-chip";
        btn.dataset.tag = tag;
        btn.textContent = tag;
        const x = document.createElement("span");
        x.setAttribute("aria-hidden", "true");
        x.textContent = "×";
        btn.appendChild(x);
        this.selectedEl.appendChild(btn);
      });
    }

    private tagIsSelected(tag: string): boolean {
      return this._tags.some((s) => s.toLowerCase() === tag.toLowerCase());
    }

    private tagMatches(tag: string, filter: string): boolean {
      if (!filter) return true;
      return tag.toLowerCase().includes(filter.toLowerCase());
    }

    private makeSuggestionChip(tag: string): HTMLButtonElement {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "optchip tagchip tag-suggestion-chip";
      btn.dataset.tag = tag;
      btn.textContent = tag;
      return btn;
    }

    private renderGroup(groupKey: string, items: string[], filter: string) {
      const container = this.querySelector<HTMLElement>(`[data-tag-group="${groupKey}"]`);
      const countEl = this.querySelector<HTMLElement>(`[data-tag-group-count="${groupKey}"]`);
      if (!container) return;
      container.innerHTML = "";
      const visible = items
        .filter((t) => !this.tagIsSelected(t))
        .filter((t) => this.tagMatches(t, filter));
      visible.forEach((tag) => container.appendChild(this.makeSuggestionChip(tag)));
      if (countEl) countEl.textContent = visible.length ? `(${visible.length})` : "";
      // A filter with results in a closed group would show nothing at all, so
      // a group opens while its matches exist and closes while they do not.
      if (filter) {
        const details = container.closest<HTMLDetailsElement>("details.tag-group");
        if (details) details.open = visible.length > 0;
      }
    }

    private renderSuggestions(filter = "") {
      const groupEls = Array.from(this.querySelectorAll<HTMLDetailsElement>("details.tag-group"));
      if (filter && !this.openBeforeFilter) {
        this.openBeforeFilter = new Map(groupEls.map((d) => [d.dataset.groupKey ?? "", d.open]));
      } else if (!filter && this.openBeforeFilter) {
        groupEls.forEach((d) => {
          d.open = this.openBeforeFilter!.get(d.dataset.groupKey ?? "") ?? false;
        });
        this.openBeforeFilter = null;
      }
      const groups: Record<GroupKey, string[]> = {
        disciplines: [],
        topics: [],
        other: [],
      };

      this.registryTags.forEach((tag) => {
        const key = (tag.group as GroupKey) || "other";
        if (groups[key]) {
          groups[key].push(tag.label);
        } else {
          groups["other"].push(tag.label);
        }
      });

      (Object.keys(groups) as GroupKey[]).forEach((key) =>
        this.renderGroup(key, groups[key], filter)
      );
    }

    /** The registry's own spelling of a tag, if it already has one. Typing
     *  "3d" when the registry holds "3D" must pick "3D", not add a twin. */
    private canonical(norm: string): string {
      const hit = this.registryTags.find((t) => t.label.toLowerCase() === norm.toLowerCase());
      return hit ? hit.label : norm;
    }

    /** All suggestion chips currently on screen, across the three groups. */
    private visibleSuggestions(): string[] {
      return Array.from(this.querySelectorAll<HTMLButtonElement>("button.tag-suggestion-chip"))
        .map((b) => b.dataset.tag ?? "")
        .filter(Boolean);
    }

    private addTag(value: string): boolean {
      const norm = this.canonical(normalizeTag(value));
      if (!norm) return false;
      if (norm.length > 50) {
        this.setError(ui[this.lang]["profile.tag.error"]);
        return false;
      }
      if (this._tags.length >= this.maxTags) {
        this.setError(ui[this.lang]["profile.tag.error"]);
        return false;
      }
      if (this._tags.some((t) => t.toLowerCase() === norm.toLowerCase())) {
        return false;
      }

      // THE CHIP APPEARS NOW. Until 2026-09-09 this awaited the registry write
      // below first, so a tag "took a second to land" — the round trip to
      // Firestore, plus the App Check token on a phone — and the member was
      // left wondering whether Enter had done anything. The write was always
      // best-effort (an unverified address is refused by the rules and the tag
      // still lands on the profile through the parent's save), so nothing
      // about it needs to be waited for.
      this._tags = [...this._tags, norm];
      this.setError("");
      this.renderSelected();
      this.renderSuggestions(this.filterText);
      this.emitChange();

      const user = auth.currentUser;
      const known = this.registryTags.some((t) => t.label.toLowerCase() === norm.toLowerCase());
      if (user && !known) {
        this.registryTags.push({
          label: norm,
          active: true,
          group: "other",
          createdAt: new Date(),
          createdBy: user.uid,
        });
        this.renderSuggestions(this.filterText);
        getOrCreateTag(norm, user.uid).catch((err) => {
          console.warn("[tag-selector] Registry write skipped:", err);
        });
      }
      return true;
    }

    private removeTag(tag: string) {
      this._tags = this._tags.filter((t) => t !== tag);
      this.renderSelected();
      this.renderSuggestions(this.filterText);
      this.emitChange();
    }

    private submitInput() {
      const val = this.inputEl.value;
      if (!val.trim()) return;
      if (this.addTag(val)) this.inputEl.value = "";
      this.inputEl.focus();
    }

    private attachListeners() {
      // The add row: Enter or + creates. No autocomplete — canonical() picks
      // the registry's spelling when the typed tag already exists, silently.
      this.inputEl.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        e.preventDefault();
        this.submitInput();
      });

      const addBtn = this.querySelector<HTMLButtonElement>(".ts-add-btn");
      if (addBtn) {
        addBtn.addEventListener("click", () => this.submitInput());
      }

      // The filter: narrows the groups as you type. Enter picks the one chip
      // left when the filter has narrowed the lists to a single tag; with more
      // than one it does nothing, and it never creates.
      this.filterEl.addEventListener("input", () => {
        this.renderSuggestions(this.filterEl.value);
      });
      this.filterEl.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          this.filterEl.value = "";
          this.renderSuggestions("");
          return;
        }
        if (e.key !== "Enter") return;
        e.preventDefault();
        const visible = this.visibleSuggestions();
        if (visible.length === 1 && this.addTag(visible[0])) {
          this.filterEl.value = "";
          this.renderSuggestions("");
        }
      });

      this.selectedEl.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(
          "button.tag-chip"
        ) as HTMLButtonElement | null;
        if (!btn?.dataset.tag) return;
        this.removeTag(btn.dataset.tag);
      });

      // A picked suggestion leaves the filter as it is: the member may be
      // picking several from the same narrowed list.
      this.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(
          "button.tag-suggestion-chip"
        ) as HTMLButtonElement | null;
        if (!btn?.dataset.tag) return;
        this.addTag(btn.dataset.tag);
      });
    }
  }

  if (!customElements.get("tag-selector")) {
    customElements.define("tag-selector", TagSelectorElement);
  }

  // Expose the type so consumers can cast their element references.
  declare global {
    interface HTMLElementTagNameMap {
      "tag-selector": TagSelectorElement;
    }
  }
</script>
