    display: none;
  }

  /* The save/error message floats next to the button, so it carries its own
     surface to stay legible over whatever it happens to hover above. */
  .form-footer .msg-ok,
  .form-footer .msg-err {
    margin: 0;
    padding: 0.45rem 0.9rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .profile-save-button {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  /*
   * SAVING HAS TO LOOK LIKE SAVING.
   *
   * The button did nothing at all while a save was in flight, and a save is not
   * one round trip: both profile documents, then the image records, then the
   * active flag, then the rebuild dispatch. On anything slower than an office
   * connection the member pressed a button that then sat there unchanged for
   * several seconds, which reads as "nothing happened" and gets pressed again.
   *
   * It stays BLACK rather than taking .btn-solid:disabled's grey. Grey says
   * "you cannot press this" — true, and not the news. The news is that it is
   * working, and the ring is what says so.
   */
  .profile-save-button.is-saving:disabled {
    background: var(--color-dark);
    cursor: progress;
  }

  .profile-save-button.is-saving::before {
    content: "";
    width: 0.9em;
    height: 0.9em;
    margin-right: 0.6em;
    border: 2px solid rgb(255 255 255 / 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    /* Named for this component on purpose: @keyframes are GLOBAL in Astro, so
       a bare `spin` would collide with the next one anybody writes. */
    animation: profile-save-spin 0.7s linear infinite;
  }

  @keyframes profile-save-spin {
    to {
      transform: rotate(1turn);
    }
  }

  /* Slowed rather than stopped: this is a progress indicator, and a frozen one
     would take back the very thing it was added to say. */
  @media (prefers-reduced-motion: reduce) {
    .profile-save-button.is-saving::before {
      animation-duration: 2.4s;
    }
  }

  /*
