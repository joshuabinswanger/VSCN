   * The weight is all that survives of 2026-09-03's promotion: the button was
   * also moved to the head of the tab then and moved back to its foot on
   * 2026-09-04. See the markup for why the two decisions are not in conflict.
   */
  .btn-logout-strong {
    align-self: start;
    padding: 0.75rem 1.75rem;
    background: var(--color-bg);
    color: var(--color-dark);
    border: 1.5px solid var(--color-dark);
    border-radius: var(--radius-sm);
    font-family: "Archivo", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .btn-logout-strong:hover {
    background: var(--color-dark);
    color: var(--color-bg);
  }

  /* A door to somewhere else rather than an account action, so it keeps the
     quiet outline even though it now leads the tab — see the markup. Shrunk to
     its own width, or a grid item would stretch it across the column and make
     the quietest thing on the tab the widest. */
  .account-quiet {
    align-self: start;
    margin-bottom: 2rem;
  }

  .account-disclosure {
    display: grid;
    gap: 0.5rem;
  }

  .account-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .deletion-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--color-dark);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  /* The pair — see the markup. `display: contents` is deliberately NOT used:
     the two blocks have to be siblings in a box that can carry a gap, and the
     tab is a grid whose gap is sized for fields, not for two adjacent links. */
  .account-doors {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .account-block {
    display: grid;
    gap: 0.5rem;
  }

  .danger-text {
    font-size: 0.88rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .danger-label {
    display: block;
    font-size: 0.88rem;
    color: var(--color-muted);
    margin: 0 0 0.35rem;
  }

  /* The address is quoted back so it can be read off rather than recalled.
    Set apart from the prose around it and selectable, because getting it
    exactly right is the whole point and copying it is a legitimate way to. */
  .danger-target {
    display: inline-block;
    max-width: 100%;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-dark);
    margin: 0 0 0.5rem;
    word-break: break-all;
  }

  .danger-text-spaced {
    margin-top: 1.5rem;
  }

  /* SMALLER, AND ON ONE LINE WITH THE CANCEL LINK (2026-09-04, Josh: "smaller
     aligned"). The pair used to be a 1.5rem-apart Cancel and a button padded
     like a primary action, which made the red the largest object on the tab —
     shouting at a member who has already typed their own address out to be
     let through. It is the same shape as .account-actions above it now (the
     email change's Cancel/Save pair), which is the point: the two forms do the
     same kind of work and should not look like different rooms.
     Centre, not baseline: the button's own padding is what sets its height,
     and a baseline would hang the bare link off the button's text rather than
     lining the two controls up. */
  .danger-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  /* The red, kept exactly where it is worth something: on the one control
     that actually destroys the account. What shrank is its SIZE, not its
