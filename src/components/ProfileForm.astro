---
import CommunityCardPreview from "./community/CommunityCardPreview.astro";
import MemberTypeSelector from "./MemberTypeSelector.astro";
import ProfileViewPreview from "./ProfileViewPreview.astro";
import OpenToSelector from "./OpenToSelector.astro";
import VisualNeedsSelector from "./VisualNeedsSelector.astro";
import TagSelector from "./TagSelector.astro";
import { LANGUAGES } from "../lib/firestore.ts";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<div id="loading" class="loading-state">{t("profile.loading")}</div>

{
  /* Above the form, not inside a section: an unverified address matters on
    every tab. */
}
<div id="verify-banner" class="verify-banner" style="display:none;">
  <p class="verify-banner-text">
    {t("profile.verifyBanner")}
    <button id="btn-resend-verify" type="button" class="btn-resend-verify"
      >{t("profile.verifyResend")}</button
    >
  </p>
  <p id="verify-banner-sent" class="verify-banner-sent" style="display:none;">
    {t("profile.verifySent")}
  </p>
</div>

<form id="profile-form" class="profile-form" data-lang={lang}>
  {
    /* One form, four sections. A tab switch only toggles visibility, so the
      single Save still collects every field. Preview is the last tab rather
      than a separate mode: it needs no save and no rebuild, which matters
      because the real profile page is a build-time snapshot — saving alone
      would not show the member their own change for minutes. */
  }
  <div class="section-tabs" role="group" id="section-tabs">
    <button type="button" class="section-tab is-active" data-section="profile" aria-pressed="true">
      {t("profile.tab.profile")}
    </button>
    <button type="button" class="section-tab" data-section="work" aria-pressed="false">
      {t("profile.tab.work")}
    </button>
    <button type="button" class="section-tab" data-section="account" aria-pressed="false">
      {t("profile.tab.account")}
    </button>
    <button type="button" class="section-tab" data-section="preview" aria-pressed="false">
      {t("profile.tab.preview")}
    </button>
  </div>

  <div class="form-section is-active" data-section="profile">
    <div class="avatar-wrap">
      <div class="avatar-image">
        <img id="avatar-preview" src="" alt="" class="avatar-img" />
        <div id="avatar-placeholder" class="avatar-placeholder">?</div>
      </div>
      <label class="btn-outline choose-img" for="avatar">
        {t("profile.chooseImage")}
        <input
          id="avatar"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif"
          style="display:none;"
        />
      </label>
      <p id="upload-status" class="upload-status" style="display:none;"></p>
    </div>

    <MemberTypeSelector lang={lang} />

    <div class="field">
      <label class="label" for="name">{t("profile.label.name")}</label>
      <input id="name" type="text" class="input" placeholder={t("profile.ph.name")} />
    </div>

    <div class="field">
      <label class="label" for="role">{t("profile.label.role")}</label>
      <input id="role" type="text" class="input" placeholder={t("profile.ph.role")} />
      <p class="field-note">{t("profile.note.role")}</p>
    </div>

    <div class="field">
      <label class="label" for="affiliation">{t("profile.label.affiliation")}</label>
      <input
        id="affiliation"
        type="text"
        class="input"
        placeholder={t("profile.ph.affiliation")}
      />
    </div>

    <div class="field">
      <label class="label" for="location">{t("profile.label.location")}</label>
      <input id="location" type="text" class="input" placeholder={t("profile.ph.location")} />
    </div>

    <fieldset class="target-audience-field">
      <legend class="label">{t("profile.label.languages")}</legend>
      <div class="target-audience-options">
        {
          LANGUAGES.map((code) => (
            <label class="target-audience-option">
              <input type="checkbox" name="language" value={code} />
              <span>{t(`profile.lang.${code}`)}</span>
            </label>
          ))
        }
      </div>
      <p class="field-note">{t("profile.note.languages")}</p>
    </fieldset>

    <div class="field">
      <label class="label" for="bio">{t("profile.label.bio")}</label>
      <textarea id="bio" rows="4" class="input textarea" placeholder={t("profile.ph.bio")}
      ></textarea>
      <p class="field-note">{t("profile.note.bio")}</p>
    </div>

    <div class="field">
      <label id="portfolio-label" class="label" for="portfolio"
        >{t("profile.label.portfolio")}</label
      >
      <div class="input-prefix-wrap">
        <span class="input-prefix">https://</span>
        <input
          id="portfolio"
          type="text"
          class="input input-prefixed"
          placeholder={t("profile.ph.portfolio")}
        />
      </div>
    </div>

    {
      /* One row per link, not one box for all of them. The STORED shape is
      unchanged — the rows are joined back into the single comma-separated
      `socialMedia` string by joinSocial() — so old profiles, the build-time
      directory snapshot and firestore.rules all keep working untouched. A <p>
      rather than a <label>: there is no single control left to point at, the
      same reason #projects-label is a <p>. */
    }
    <div class="field">
      <p id="social-label" class="label">{t("profile.label.social")}</p>
      <div id="social-editor" class="social-editor"></div>
      <button type="button" id="social-add" class="btn-outline choose-img">
        {t("profile.social.add")}
      </button>
      <p id="social-status" class="field-note" style="display:none;"></p>
      <p class="field-note">{t("profile.note.social")}</p>
      {
        /* Cloned by renderSocial(). Rendered here rather than built in JS so
        each clone carries Astro's data-astro-cid-* attribute and matches the
        scoped rules below — a node built with document.createElement() would
        match none of them. */
      }
      <template data-social-tpl="row">
        <div class="social-row">
          <div class="input-prefix-wrap">
            <span class="input-prefix">https://</span>
            <input type="text" class="input input-prefixed" data-social-input />
          </div>
          <button type="button" class="social-row-remove" data-social-remove>✕</button>
        </div>
      </template>
    </div>

    <OpenToSelector lang={lang} />

    <VisualNeedsSelector lang={lang} />

    <fieldset class="target-audience-field">
      <legend class="label">{t("profile.primaryAudience.legend")}</legend>
      <div class="target-audience-options">
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="science" />
          <span>{t("profile.primaryAudience.science")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="public" />
          <span>{t("profile.primaryAudience.public")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="policy-makers" />
          <span>{t("profile.primaryAudience.policyMakers")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="education" />
          <span>{t("profile.primaryAudience.education")}</span>
        </label>
      </div>
    </fieldset>

    <div class="field">
      <label class="label" for="tag-input">{t("profile.label.tags")}</label>
      <TagSelector lang={lang} maxTags={7} inputId="tag-input" />
    </div>
  </div>

  <div class="form-section" data-section="work">
    {
      /* Before the gallery on purpose: an image can only be tagged to a project
      that already exists, so the field that creates them comes first. */
    }
    <div class="field">
      <p id="projects-label" class="label">{t("profile.label.projects")}</p>
      <div id="projects-editor" class="projects-editor"></div>
      <button type="button" id="projects-add" class="btn-outline choose-img">
        {t("profile.projects.add")}
      </button>
      <p id="projects-status" class="field-note" style="display:none;"></p>
      <p class="field-note">{t("profile.note.projects")}</p>
      {
        /* Cloned by renderProjects(). Astro scopes this component's CSS by
        appending data-astro-cid-* to EVERY compound selector, so a row built
        with document.createElement() matches `.project-row[data-astro-cid-…]`
        never — which is exactly why these rows used to render with no border
        at all. A clone of a rendered template already carries the attribute. */
      }
      <template data-projects-tpl="row">
        <div class="project-row">
          <input type="text" class="input" data-project-field="title" />
          <input type="url" class="input" data-project-field="url" />
          <textarea class="input textarea" rows="2" data-project-field="description"></textarea>
          <button type="button" class="project-row-remove" data-project-remove>✕</button>
        </div>
      </template>
    </div>

    <div class="field">
      <p class="label">{t("profile.label.gallery")}</p>
      <div id="gallery-editor" class="gallery-editor"></div>
      <label class="btn-outline choose-img" for="gallery-files">
        {t("profile.gallery.add")}
        <input
          id="gallery-files"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif"
          multiple
          style="display:none;"
        />
      </label>
      <p id="gallery-status" class="field-note" style="display:none;"></p>
      <p class="field-note">{t("profile.note.gallery")}</p>
      {
        /* The directory is image-led: a member without a gallery holds a
        typographic card. Saying so here is the standing mechanism that fills
        the directory — hidden the moment the first image lands. */
      }
      <p id="gallery-nudge" class="field-note gallery-nudge" hidden>{t("profile.gallery.nudge")}</p>
      {
        /* Cloned by renderGallery(), for the same reason as the projects
        template above: .gallery-item, .gallery-thumb and .gallery-thumb-remove
        are scoped rules, so createElement() rows got none of them — the thumbs
        rendered at their natural size with an untreated remove button. */
      }
      <template data-gallery-tpl="item">
        <div class="gallery-item">
          <div class="gallery-thumb">
            <img alt="" loading="lazy" data-gallery-img />
            <button type="button" class="gallery-thumb-remove" data-gallery-remove>✕</button>
          </div>
          <div class="gallery-fields">
            <input type="text" class="input" data-gallery-field="caption" />
            <textarea class="input textarea" rows="3" data-gallery-field="description"></textarea>
            <select class="input" data-gallery-project></select>
          </div>
        </div>
      </template>
    </div>
  </div>

  <div class="form-section" data-section="account">
    <div class="field">
      <label class="checkbox-label" for="profile-active">
        <input id="profile-active" type="checkbox" />
        <span>{t("profile.active.label")}</span>
      </label>
      <p class="field-note">{t("profile.active.note")}</p>
    </div>

    <div class="field">
      <label class="checkbox-label" for="wants-to-contribute">
        <input id="wants-to-contribute" type="checkbox" />
        <span>{t("profile.wantsToContribute")}</span>
      </label>
      <p class="field-note">{t("profile.wantsToContribute.note")}</p>
    </div>

    <div class="field">
      <label class="label" for="phone">{t("profile.label.phone")}</label>
      <input
        id="phone"
        type="tel"
        class="input"
        placeholder="+41 79 123 45 67"
        autocomplete="tel"
      />
      <p class="field-note">
        {t("profile.note.phone")}
      </p>
    </div>

    <button id="btn-logout" type="button" class="btn-outline logout-button">
      {t("profile.logout")}
    </button>

    <div class="danger-zone">
      <div id="delete-idle">
        <button type="button" id="btn-delete-start" class="btn-danger-link"
          >{t("profile.delete.idle")}</button
        >
      </div>

      <div id="delete-confirm" style="display:none;">
        <p class="danger-text">
          {t("profile.delete.text")}
        </p>
        <div class="danger-actions">
          <button type="button" id="btn-delete-cancel" class="btn-link"
            >{t("profile.delete.cancel")}</button
          >
          <button type="button" id="btn-delete-confirm" class="btn-danger"
            >{t("profile.delete.confirm")}</button
          >
        </div>
      </div>

      <div id="delete-reauth" style="display:none;">
        <p class="danger-text">{t("profile.reauth.text")}</p>
        <input
          id="reauth-password"
          type="password"
          class="input"
          placeholder="••••••••"
          autocomplete="current-password"
        />
        <p id="reauth-error" class="msg-err" style="display:none;"></p>
        <div class="danger-actions">
          <button type="button" id="btn-reauth-cancel" class="btn-link"
            >{t("profile.reauth.cancel")}</button
          >
          <button type="button" id="btn-reauth-confirm" class="btn-danger"
            >{t("profile.reauth.confirm")}</button
          >
        </div>
      </div>
    </div>
  </div>

  <div class="form-section" data-section="preview">
    {
      /* The Preview tab. Both representations sit here together so
      they are comparable, and so the form itself stays a form.

      The profile page comes first: it is the artefact the member is actually
      building. The directory card is the smaller, secondary view of the same
      data — the image card's face, bound by renderCardPreview(), which is
      what /community renders since the directory switched over. */
    }
    <div class="preview-section">
      <div class="preview-block">
        <p class="label">{t("profile.view.heading")}</p>
        {
          /* The note that used to sit here has moved inside ProfileViewPreview,
          where it belongs to the threshold it explains — and where the no-auth
          harness at /proto/profile-preview shows it too. */
        }
        <ProfileViewPreview lang={lang} />
      </div>

      <div class="preview-block">
        <p class="label">{t("profile.view.directoryHeading")}</p>
        <CommunityCardPreview />
      </div>
    </div>
  </div>

  {/* Floating Save: reachable from every editing tab, hidden on Preview. */}
  <div class="form-footer">
    <p id="save-msg" class="msg-ok" style="display:none;">
      {t("profile.saveMsg")}
    </p>
    <p id="save-error" class="msg-err" style="display:none;"></p>
    <button type="submit" class="btn-solid profile-save-button">{t("profile.save")}</button>
  </div>
</form>

<style>
  .loading-state {
    margin-top: 3rem;
    color: #999;
    font-size: 0.9rem;
  }

  .verify-banner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto clamp(1.5rem, 3vw, 2.5rem);
    padding: 0.75rem 1rem;
    background: #fffbeb;
    border: 1.5px solid #f59e0b;
    border-radius: var(--radius-sm);
    box-sizing: border-box;

    @media (--bp-desktop) {
      padding: 0.75rem 1rem;
    }
  }

  .verify-banner-text {
    margin: 0;
    font-size: 0.88rem;
    color: #92400e;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-resend-verify {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: #92400e;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .btn-resend-verify:hover {
    color: #78350f;
  }

  .verify-banner-sent {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: #65a30d;
  }

  .profile-form {
    display: none;
    grid-auto-rows: min-content;
    gap: 2rem;
    width: 100%;
    max-width: 560px;
    margin: clamp(2rem, 4vw, 4rem) auto;
    padding: 0 15px;
    box-sizing: border-box;
    /* clip, not hidden: hidden makes the form a scroll container, and the
       sticky footer would stick to that instead of the page. */
    overflow-x: clip;

    @media (--bp-desktop) {
      padding: 0;
      gap: 2.5rem;
    }
  }

  .profile-form.is-loaded {
    display: grid;
  }

  /* display: contents keeps every field a direct grid item of the form, so
     the section wrappers add tab navigation without changing the layout. */
  .form-section {
    display: none;
  }

  .form-section.is-active {
    display: contents;
  }

  .avatar-wrap {
    position: relative;
    display: grid;
    grid-template-columns: min-content 1fr 1fr;
    justify-items: start;
    align-items: center;
    gap: 25px;
    flex-shrink: 0;
  }

  .avatar-img,
  .avatar-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* default: show placeholder, hide image */
  .avatar-img {
    display: none;
  }

  /* has-image: show image, hide placeholder */
  .avatar-wrap.has-image .avatar-img {
    display: block;
  }
  .avatar-wrap.has-image .avatar-placeholder {
    display: none;
  }

  .avatar-placeholder {
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: #bbb;
    border: 1.5px solid #e5e5e5;
  }
  .choose-img {
    width: fit-content;
  }

  .field-note {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .input-prefix-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color 0.15s;
    min-width: 0;
  }
  .input-prefix-wrap:focus-within {
    border-color: #111;
  }

  .input-prefix {
    padding: 8px 10px;
    background: #f5f5f5;
    color: var(--color-muted);
    font-size: 0.88rem;
    border-right: 1.5px solid var(--color-border);
    white-space: nowrap;
  }

  .input-prefixed {
    border: none;
    border-radius: 0;
    flex: 1;
    min-width: 0;
  }
  .input-prefixed:focus {
    border-color: transparent;
  }

  /* ── Social links ─────────────────────────────────────── */
  /* A stack of the same prefixed input the single field used, each with its
     own remove control. No border around a row and no per-row label: a link is
     one value, so the bordered block the projects editor needs would be a box
     drawn around a single input. */
  .social-editor {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  .social-editor:empty {
    display: none;
  }

  .social-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    min-width: 0;
  }

  .social-row .input-prefix-wrap {
    flex: 1 1 auto;
  }

  /* Same outline circle as .project-row-remove, but in the flow rather than
     pinned to a corner — there is no block here for it to sit in. */
  .social-row-remove {
    flex: 0 0 auto;
    align-self: center;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    color: var(--color-muted);
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
  }

  .social-row-remove:hover {
    color: #fff;
    background: var(--color-error);
    border-color: var(--color-error);
  }

  /* Was a grid of bare 90px thumbs. Each image now carries a caption, a
     description and a project, which no square that small can hold — so an
     entry is a row: thumb on the left, its words on the right. */
  .gallery-editor {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 0.5rem;
  }

  .gallery-editor:empty {
    display: none;
  }

  .gallery-item {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .gallery-fields {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  /* Compact by design: these sit three-deep inside a field that already has
     its own label, so full-size inputs would read as the form restarting. */
  .gallery-fields .input {
    font-size: 0.85rem;
  }

  .gallery-fields .textarea {
    min-height: 56px;
  }

  .gallery-thumb {
    position: relative;
    aspect-ratio: 1;
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    box-sizing: border-box;
  }

  .gallery-thumb-remove {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 50%;
    font-size: 0.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .gallery-thumb-remove:hover {
    background: var(--color-error);
  }

  @media (--bp-mobile) {
    .gallery-item {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery-thumb {
      max-width: 140px;
    }
  }

  /* ── Projects ─────────────────────────────────────────── */
  .projects-editor {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 0.5rem;
  }

  .projects-editor:empty {
    display: none;
  }

  /* A bordered block per project, because a bare stack of inputs gives no
     clue where one project ends and the next begins. */
  .project-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 42px 12px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    min-width: 0;
  }

  .project-row .input {
    font-size: 0.85rem;
  }

  .project-row .textarea {
    min-height: 56px;
  }

  .project-row-remove {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    color: var(--color-muted);
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    font-size: 0.7rem;
    line-height: 1;
    cursor: pointer;
  }

  .project-row-remove:hover {
    color: #fff;
    background: var(--color-error);
    border-color: var(--color-error);
  }

  /* ── Section tabs ─────────────────────────────────────── */
  /* Text tabs on a hairline, in the same uppercase voice as .label — the
     boxed segmented control read as one more form control among many. */
  .section-tabs {
    display: flex;
    gap: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-tab {
    padding: 0 0 0.6rem;
    margin-bottom: -1px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .section-tab:hover {
    color: var(--color-dark);
  }

  .section-tab.is-active {
    color: var(--color-dark);
    border-bottom-color: var(--color-dark);
  }

  @media (--bp-mobile) {
    .section-tabs {
      justify-content: space-between;
      gap: 1rem;
    }
  }

  /* The preview tab is the one place in this form where air is the point: the
     two renderings have to read as things being LOOKED at, not fields being
     filled in. Hence the room above the first threshold and the long gap
     between the profile sheet and the directory card. */
  .preview-section {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .preview-section .label {
    display: block;
    margin-bottom: 1.5rem;
  }

  /* Floats above the bottom of .page-wrap (the page's real scroll container),
     so Save is reachable from every editing tab without scrolling; at the end
     of the form it settles into the flow. No bar behind it — just the button,
     so the container must not eat clicks on the content it hovers over. */
  .form-footer {
    position: sticky;
    /* 0, not a lift: .page-wrap's own 80px bottom padding already keeps the
       pinned button floating well clear of the pane edge. */
    bottom: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
    pointer-events: none;
  }

  .form-footer > * {
    pointer-events: auto;
  }

  /* Preview needs no Save: nothing on that tab can be edited. */
  .profile-form.is-previewing .form-footer {
    display: none;
  }

  /* The save/error message floats next to the button, so it carries its own
     surface to stay legible over whatever it happens to hover above. */
  .form-footer .msg-ok,
  .form-footer .msg-err {
    margin: 0;
    padding: 0.45rem 0.9rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .profile-save-button {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  .logout-button {
    align-self: start;
  }

  .danger-zone {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .danger-text {
    font-size: 0.88rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .danger-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .btn-danger-link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.88rem;
    color: #bbb;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .btn-danger-link:hover {
    color: var(--color-error);
    border-bottom-color: var(--color-error);
  }

  .btn-danger {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    background: var(--color-error);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-danger:hover {
    background: #b91c1c;
  }

  .btn-danger:disabled {
    background: #999;
    cursor: not-allowed;
  }

  .field-open-to {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .field-open-to legend {
    margin-bottom: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: #333;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--color-dark);
    cursor: pointer;
    flex-shrink: 0;
  }

  .target-audience-field {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .target-audience-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .target-audience-option {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: #333;
    font-size: 0.9rem;
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .target-audience-option:hover {
    border-color: #999;
    background: #f5f5f5;
  }

  .target-audience-option:has(input:checked) {
    border-color: var(--color-dark);
    background: var(--color-dark);
    color: #fff;
  }

  .target-audience-option input {
    width: 14px;
    height: 14px;
    accent-color: var(--color-dark);
    cursor: pointer;
  }

  @media (max-width: 520px) {
    .avatar-wrap {
      grid-template-columns: min-content 1fr;
    }

    .upload-status {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { auth } from "../lib/firebase.ts";
  import {
    signOut,
    reauthenticateWithCredential,
    EmailAuthProvider,
    sendEmailVerification,
  } from "firebase/auth";
  import { requireAuth } from "../lib/auth.ts";
  import { deleteAvatar } from "../lib/storage.ts";
  import {
    getUser,
    deleteUserData,
    getPublicProfileActive,
    setProfileActive,
  } from "../lib/firestore.ts";
  import { validateAvatar, resizeAvatar } from "../lib/validation.ts";
  import { handleProfileUpdate, triggerRebuild } from "../lib/profile.ts";
  import { isMemberType, MEMBER_TYPES } from "../lib/firestore.ts";
  import { memberTypeFieldCopy, needsVisuals } from "../lib/memberType.ts";
  import {
    MAX_GALLERY_IMAGES,
    MAX_GALLERY_CAPTION,
    MAX_GALLERY_DESCRIPTION,
    validateGalleryFile,
    compressGalleryImage,
    uploadGalleryImage,
    deleteGalleryImages,
    type GalleryItem,
  } from "../lib/gallery.ts";
  import {
    MAX_PROJECTS,
    MAX_PROJECT_TITLE,
    MAX_PROJECT_URL,
    MAX_PROJECT_DESCRIPTION,
    newProjectId,
    normalizeProjects,
    type ProjectItem,
  } from "../lib/projects.ts";
  import { updateUserProfile } from "../lib/firestore.ts";
  import { openImageEditor } from "../lib/imageEditor.ts";
  import { renderCardPreview, renderProfilePreview } from "../lib/profilePreview.ts";
  import {
    splitSocial,
    joinSocial,
    MAX_SOCIAL_LINKS,
    MAX_SOCIAL_MEDIA,
  } from "../lib/links.ts";
  import { ui } from "../i18n/translations.ts";

  let unsubscribeAuth: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    const loadingEl = document.getElementById("loading");
    const form = document.getElementById("profile-form") as HTMLFormElement;
    if (!form) return;

    const lang = (form.dataset.lang ?? "en") as keyof typeof ui;
    const s = ui[lang] ?? ui.en;
    const prefix = lang === "de" ? "/de" : "";
    const editorLabels = {
      rotate: s["profile.edit.rotate"],
      apply: s["profile.edit.apply"],
      cancel: s["profile.edit.cancel"],
    };
    // The translated member-type labels the directory card's typographic face
    // falls back to when a member has no tags — same strings the real card
    // resolves at build time.
    const memberTypeLabels = Object.fromEntries(
      MEMBER_TYPES.map((type) => [type, s[`profile.memberType.${type}`]])
    );

    const nameInput = document.getElementById("name") as HTMLInputElement;
    const roleInput = document.getElementById("role") as HTMLInputElement;
    const activeInput = document.getElementById("profile-active") as HTMLInputElement;
    const wantsToContributeInput = document.getElementById(
      "wants-to-contribute"
    ) as HTMLInputElement;
    const bioInput = document.getElementById("bio") as HTMLTextAreaElement;
    const portfolioInput = document.getElementById("portfolio") as HTMLInputElement;
    const socialEditor = document.getElementById("social-editor")!;
    const socialAdd = document.getElementById("social-add") as HTMLButtonElement;
    const socialStatus = document.getElementById("social-status")!;
    const socialRowTpl = document.querySelector<HTMLTemplateElement>('[data-social-tpl="row"]');
    const phoneInput = document.getElementById("phone") as HTMLInputElement;
    const primaryAudienceInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="primary-audience"]')
    );
    const avatarInput = document.getElementById("avatar") as HTMLInputElement;
    const avatarImg = document.getElementById("avatar-preview") as HTMLImageElement;
    const uploadStatus = document.getElementById("upload-status")!;
    const saveMsg = document.getElementById("save-msg")!;
    const saveError = document.getElementById("save-error")!;

    const avatarWrap = avatarImg.closest<HTMLElement>(".avatar-wrap")!;

    // Tag selection is handled by the <tag-selector> custom element.
    const tagSelector = document.querySelector<
      HTMLElement & {
        value: string[];
        inputValue: string;
      }
    >("tag-selector");
    const openToSelector = document.querySelector<
      HTMLElement & {
        value: string[];
      }
    >("open-to-selector");
    const memberTypeSelector = document.querySelector<
      HTMLElement & {
        value: string;
      }
    >("member-type-selector");
    const portfolioLabel = document.getElementById("portfolio-label");
    const socialLabel = document.getElementById("social-label");
    const projectsLabel = document.getElementById("projects-label");
    const affiliationInput = document.getElementById("affiliation") as HTMLInputElement;
    const locationInput = document.getElementById("location") as HTMLInputElement;
    const languageInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="language"]')
    );
    const visualNeedsSelector = document.querySelector<
      HTMLElement & {
        value: string[];
      }
    >("visual-needs-selector");

    function getSelectedLanguages() {
      // Emitted in LANGUAGES order, not click order, so the stored list is
      // stable and the rules' unrolled enum check sees a predictable shape.
      return languageInputs.filter((input) => input.checked).map((input) => input.value);
    }

    function setSelectedLanguages(value: unknown) {
      const selected = Array.isArray(value) ? value.filter(Boolean).map(String) : [];
      languageInputs.forEach((input) => {
        input.checked = selected.includes(input.value);
      });
    }

    // The profile-page preview shell and the section tabs.
    const profileViewRoot = document.querySelector<HTMLElement>(".ppv");
    const sectionTabs = Array.from(
      document.querySelectorAll<HTMLButtonElement>("#section-tabs .section-tab")
    );
    const formSections = Array.from(form.querySelectorAll<HTMLElement>(".form-section"));

    let resizedAvatarBlob: Blob | null = null;
    let avatarColor = "";
    let gallery: GalleryItem[] = [];
    let projects: ProjectItem[] = [];

    const galleryInput = document.getElementById("gallery-files") as HTMLInputElement;
    const galleryEditor = document.getElementById("gallery-editor")!;
    const galleryStatus = document.getElementById("gallery-status")!;
    const projectsEditor = document.getElementById("projects-editor")!;
    const projectsStatus = document.getElementById("projects-status")!;
    const projectsAdd = document.getElementById("projects-add") as HTMLButtonElement;
    // Row shells for the two list editors. Cloned rather than built: see the
    // comment on each <template> above — Astro's scope attribute is on the
    // selectors, so a createElement() row matches none of the scoped rules.
    const projectRowTpl = document.querySelector<HTMLTemplateElement>('[data-projects-tpl="row"]');
    const galleryItemTpl = document.querySelector<HTMLTemplateElement>('[data-gallery-tpl="item"]');

    function setGalleryStatus(text: string) {
      galleryStatus.textContent = text;
      galleryStatus.style.display = text ? "block" : "none";
    }

    function setProjectsStatus(text: string) {
      projectsStatus.textContent = text;
      projectsStatus.style.display = text ? "block" : "none";
    }

    /**
     * These controls have no visible label — the field's own label covers the
     * group, and a per-row caption would triple the form's text. The name goes
     * on the control itself, as this file already does for the remove buttons,
     * so it is announced without being drawn.
     */
    function named<T extends HTMLElement>(control: T, label: string): T {
      control.setAttribute("aria-label", label);
      return control;
    }

    // ── Social links ──────────────────────────────────────
    // One row per link on screen; ONE comma-joined string in Firestore. The
    // stored shape is deliberately unchanged: every profile saved before today
    // holds that string, and the public directory is a build-time snapshot, so
    // a second shape would have to be understood by pages that will not be
    // rebuilt for it. splitSocial()/joinSocial() in links.ts are the whole
    // translation, and the same links.ts cleaner shapes them for display.
    //
    // Order is row order, and it survives: new rows append, removing one
    // splices, and joinSocial() preserves what it is given.
    let socialValues: string[] = [""];
    let socialPlaceholder = s["profile.ph.social"];

    function setSocialStatus(text: string) {
      socialStatus.textContent = text;
      socialStatus.style.display = text ? "block" : "none";
    }

    /** The single stored value the rows add up to. */
    function socialStored(): string {
      return joinSocial(socialValues);
    }

    function refreshSocialStatus() {
      socialAdd.disabled = socialValues.length >= MAX_SOCIAL_LINKS;
      // Length, not count, is the real limit — firestore.rules caps the joined
      // field at MAX_SOCIAL_MEDIA and rejects the WHOLE write over it, so the
      // member has to hear about it here rather than as a permission error.
      if (socialStored().length > MAX_SOCIAL_MEDIA) {
        setSocialStatus(s["profile.social.tooLong"]);
      } else if (socialValues.length >= MAX_SOCIAL_LINKS) {
        setSocialStatus(s["profile.social.full"]);
      } else {
        setSocialStatus("");
      }
    }

    /**
     * Full rebuild of the rows. Called on load, add and remove only — never
     * while typing, which would take the caret with it. Keystrokes write
     * straight into socialValues[index], the way the projects editor does.
     */
    function renderSocial() {
      if (!socialRowTpl) return;
      socialEditor.replaceChildren(
        ...socialValues.map((value, index) => {
          const row = socialRowTpl.content.firstElementChild?.cloneNode(true);
          if (!(row instanceof HTMLElement)) return null;
          const input = row.querySelector<HTMLInputElement>("[data-social-input]");
          const remove = row.querySelector<HTMLButtonElement>("[data-social-remove]");
          if (!input || !remove) return null;

          input.value = value;
          input.placeholder = socialPlaceholder;
          // Rows share one field label, so the position is what tells them
          // apart to anyone who cannot see the stack.
          named(input, `${socialLabel?.textContent ?? ""} ${index + 1}`.trim());
          input.addEventListener("input", () => {
            socialValues[index] = input.value;
            refreshSocialStatus();
            syncPreview();
          });

          remove.setAttribute("aria-label", s["profile.social.remove"]);
          remove.addEventListener("click", () => removeSocialRow(index));
          return row;
        })
          .filter((n): n is HTMLElement => n !== null)
      );
      refreshSocialStatus();
    }

    function setSocialValues(values: string[]) {
      // Always at least one row: this field was a text box until today, and an
      // empty stack with only a button reads as a missing field rather than an
      // empty one. The blank row costs nothing — joinSocial() drops it.
      socialValues = values.length > 0 ? values : [""];
      renderSocial();
    }

    function addSocialRow() {
      if (socialValues.length >= MAX_SOCIAL_LINKS) {
        setSocialStatus(s["profile.social.full"]);
        return;
      }
      socialValues.push("");
      renderSocial();
      socialEditor
        .querySelector<HTMLInputElement>(".social-row:last-of-type [data-social-input]")
        ?.focus();
    }

    /** Removing the only row empties it rather than leaving no field at all. */
    function removeSocialRow(index: number) {
      if (socialValues.length <= 1) socialValues = [""];
      else socialValues.splice(index, 1);
      renderSocial();
      syncPreview();
    }

    socialAdd.addEventListener("click", addSocialRow);

    // ── Projects ──────────────────────────────────────────
    // Rows are re-read from the DOM on every keystroke rather than
    // re-rendered: rebuilding the list would blow away the caret of whoever
    // is typing in it.
    function renderProjects() {
      if (!projectRowTpl) return;
      projectsEditor.replaceChildren(
        ...projects
          .map((project, index) => {
            const row = projectRowTpl.content.firstElementChild?.cloneNode(true);
            if (!(row instanceof HTMLElement)) return null;
            const field = <T extends HTMLElement>(name: string) =>
              row.querySelector<T>(`[data-project-field="${name}"]`);
            const title = field<HTMLInputElement>("title");
            const url = field<HTMLInputElement>("url");
            const description = field<HTMLTextAreaElement>("description");
            const remove = row.querySelector<HTMLButtonElement>("[data-project-remove]");
            if (!title || !url || !description || !remove) return null;

            title.value = project.title;
            title.maxLength = MAX_PROJECT_TITLE;
            title.placeholder = s["profile.projects.title"];
            named(title, s["profile.projects.title"]);
            title.addEventListener("input", () => {
              projects[index].title = title.value;
              onProjectsEdited();
            });

            url.value = project.url;
            url.maxLength = MAX_PROJECT_URL;
            url.placeholder = s["profile.projects.url"];
            named(url, s["profile.projects.url"]);
            url.addEventListener("input", () => {
              projects[index].url = url.value;
              onProjectsEdited();
            });

            description.value = project.description ?? "";
            description.maxLength = MAX_PROJECT_DESCRIPTION;
            description.placeholder = s["profile.projects.description"];
            named(description, s["profile.projects.description"]);
            description.addEventListener("input", () => {
              projects[index].description = description.value;
              onProjectsEdited();
            });

            remove.setAttribute("aria-label", s["profile.projects.remove"]);
            remove.addEventListener("click", () => removeProject(index));
            return row;
          })
          .filter((n): n is HTMLElement => n !== null)
      );

      projectsAdd.disabled = projects.length >= MAX_PROJECTS;
      // A row that is missing its title or its link will not be stored, and
      // saying so while it is being typed is kinder than dropping it silently
      // on save.
      const incomplete = projects.some((p) => !p.title.trim() || !p.url.trim());
      setProjectsStatus(incomplete ? s["profile.projects.incomplete"] : "");
    }

    /**
     * A project edit reaches the gallery too: the per-image project selects
     * are labelled with project titles, so a renamed project has to relabel
     * them. Only the selects are rebuilt, never the project rows themselves.
     */
    function onProjectsEdited() {
      renderGalleryProjectSelects();
      const incomplete = projects.some((p) => !p.title.trim() || !p.url.trim());
      setProjectsStatus(incomplete ? s["profile.projects.incomplete"] : "");
      projectsAdd.disabled = projects.length >= MAX_PROJECTS;
      syncPreview();
    }

    function addProject() {
      if (projects.length >= MAX_PROJECTS) {
        setProjectsStatus(s["profile.projects.full"]);
        return;
      }
      projects.push({ id: newProjectId(), title: "", url: "", description: "" });
      renderProjects();
      syncPreview();
      projectsEditor.querySelector<HTMLElement>(".project-row:last-of-type .input")?.focus();
    }

    /**
     * Removing a project also clears the tag from every image that pointed at
     * it. Firestore rules cannot check that a projectId still resolves, so
     * this is the write half of that guarantee — without it the member would
     * be left with images silently tagged to nothing.
     */
    function removeProject(index: number) {
      const [removed] = projects.splice(index, 1);
      if (removed) {
        for (const item of gallery) {
          if (item.projectId === removed.id) delete item.projectId;
        }
      }
      renderProjects();
      renderGallery();
    }

    projectsAdd.addEventListener("click", addProject);

    /**
     * Options for one image's project select: every project that would
     * actually survive a save, plus the "no project" choice.
     *
     * Rebuilt on its own (rather than by re-rendering the gallery) so that
     * renaming a project relabels the selects without disturbing the caption
     * or description someone is mid-sentence in.
     */
    function fillProjectSelect(select: HTMLSelectElement, selectedId: string | undefined) {
      const none = document.createElement("option");
      none.value = "";
      none.textContent = s["profile.gallery.projectNone"];
      const options = projects
        .filter((p) => p.title.trim() && p.url.trim())
        .map((p) => {
          const option = document.createElement("option");
          option.value = p.id;
          option.textContent = p.title.trim();
          return option;
        });
      select.replaceChildren(none, ...options);
      // An id whose project has since been emptied out has no option to
      // select; falling back to "" keeps the control honest about what is
      // going to be saved.
      select.value = options.some((o) => o.value === selectedId) ? (selectedId ?? "") : "";
    }

    function renderGalleryProjectSelects() {
      galleryEditor
        .querySelectorAll<HTMLSelectElement>("[data-gallery-project]")
        .forEach((select) => {
          const index = Number(select.dataset.galleryProject);
          const item = gallery[index];
          if (!item) return;
          fillProjectSelect(select, item.projectId);
          // fillProjectSelect may have had to drop the tag; keep the stored
          // item in step with what the control now shows.
          if (!select.value) delete item.projectId;
        });
    }

    function renderGallery() {
      if (!galleryItemTpl) return;
      galleryEditor.replaceChildren(
        ...gallery
          .map((item, index) => {
            const row = galleryItemTpl.content.firstElementChild?.cloneNode(true);
            if (!(row instanceof HTMLElement)) return null;
            const field = <T extends HTMLElement>(name: string) =>
              row.querySelector<T>(`[data-gallery-field="${name}"]`);
            const img = row.querySelector<HTMLImageElement>("[data-gallery-img]");
            const remove = row.querySelector<HTMLButtonElement>("[data-gallery-remove]");
            const caption = field<HTMLInputElement>("caption");
            const description = field<HTMLTextAreaElement>("description");
            const project = row.querySelector<HTMLSelectElement>("[data-gallery-project]");
            if (!img || !remove || !caption || !description || !project) return null;

            img.src = item.url;
            remove.setAttribute("aria-label", s["profile.gallery.remove"]);
            remove.addEventListener("click", () => removeGalleryImage(index));

            caption.value = item.caption ?? "";
            caption.maxLength = MAX_GALLERY_CAPTION;
            caption.placeholder = s["profile.gallery.caption"];
            named(caption, s["profile.gallery.caption"]);
            caption.addEventListener("input", () => {
              gallery[index].caption = caption.value;
              syncPreview();
            });

            description.value = item.description ?? "";
            description.maxLength = MAX_GALLERY_DESCRIPTION;
            description.placeholder = s["profile.gallery.description"];
            named(description, s["profile.gallery.description"]);
            description.addEventListener("input", () => {
              gallery[index].description = description.value;
              syncPreview();
            });

            // The index rides on the element: renderGalleryProjectSelects()
            // reads it back to relabel one select without touching the caption
            // someone is mid-sentence in.
            project.dataset.galleryProject = String(index);
            fillProjectSelect(project, item.projectId);
            named(project, s["profile.gallery.project"]);
            project.addEventListener("change", () => {
              if (project.value) gallery[index].projectId = project.value;
              else delete gallery[index].projectId;
              syncPreview();
            });

            return row;
          })
          .filter((n): n is HTMLElement => n !== null)
      );
      // The image-led directory renders a typographic card for an empty
      // gallery; the nudge says so, and disappears with the first image.
      const nudge = document.getElementById("gallery-nudge");
      if (nudge) nudge.hidden = gallery.length > 0;
      // The gallery IS the profile page's content AND the card's artwork, so
      // every add, removal and reorder has to reach both previews. This is
      // the one place the gallery re-renders, which makes it the one place
      // that needs to say so.
      syncPreview();
    }

    /**
     * Uploads and removals persist immediately, because they own files in
     * Storage — the Firestore array is what says which of those files still
     * belong to the member.
     *
     * `projects` rides along so the stored pair is never inconsistent: an
     * image tagged to a project that Firestore has not heard of yet would
     * render as no credit at all. Typed text (captions, descriptions,
     * half-filled project rows) is NOT pushed by itself — that waits for
     * Save, since writing on every keystroke is not what a form is.
     */
    async function persistGallery() {
      const user = auth.currentUser;
      if (!user) return;
      await updateUserProfile(user.uid, {
        gallery,
        projects: normalizeProjects(projects),
        updatedAt: new Date(),
      });
    }

    async function removeGalleryImage(index: number) {
      const [removed] = gallery.splice(index, 1);
      renderGallery();
      try {
        await persistGallery();
        if (removed) await deleteGalleryImages([removed.url]);
        setGalleryStatus("");
      } catch {
        setGalleryStatus(s["profile.gallery.error"]);
      }
    }

    galleryInput.addEventListener("change", async () => {
      const user = auth.currentUser;
      if (!user) return;
      const files = Array.from(galleryInput.files ?? []);
      galleryInput.value = "";
      if (files.length === 0) return;

      let uploaded = false;
      for (const file of files) {
        if (gallery.length >= MAX_GALLERY_IMAGES) {
          setGalleryStatus(s["profile.gallery.full"]);
          break;
        }
        const validation = validateGalleryFile(file);
        if (!validation.ok) {
          setGalleryStatus(validation.error!);
          continue;
        }
        try {
          const edited = await openImageEditor(file, editorLabels);
          setGalleryStatus(s["profile.upload.processing"]);
          const { blob, width, height, color } = await compressGalleryImage(edited ?? file);
          const url = await uploadGalleryImage(user.uid, blob, (pct) => {
            setGalleryStatus(`${s["profile.upload.uploading"]} ${pct}%`);
          });
          gallery.push({ url, caption: "", width, height, color });
          uploaded = true;
          renderGallery();
        } catch {
          setGalleryStatus(s["profile.gallery.error"]);
        }
      }

      if (uploaded) {
        try {
          await persistGallery();
          setGalleryStatus(s["profile.upload.complete"]);
        } catch {
          setGalleryStatus(s["profile.gallery.error"]);
        }
      }
    });

    function getSelectedPrimaryAudiences() {
      return primaryAudienceInputs.filter((input) => input.checked).map((input) => input.value);
    }

    function setSelectedPrimaryAudiences(value: unknown) {
      const selected = Array.isArray(value) ? value.filter(Boolean).map(String) : [];
      primaryAudienceInputs.forEach((input) => {
        input.checked = selected.includes(input.value);
      });
    }

    function showPreview(url: string) {
      avatarImg.src = url;
      avatarWrap.classList.toggle("has-image", !!url);
      avatarImg.onerror = () => {
        avatarWrap.classList.remove("has-image");
      };
      syncPreview();
    }

    function syncPreview() {
      const cardRoot = document.querySelector<HTMLElement>("[data-ccpv-root]");
      if (cardRoot) {
        renderCardPreview(cardRoot, currentViewModel(), {
          defaultName: s["profile.preview.defaultName"],
          memberTypeLabels,
        });
      }
      syncProfileView();
    }

    /** Live form state as the one view model every preview consumes. */
    function currentViewModel() {
      // Same resolution the build-time producer does (memberView.works): the
      // renderers are handed a project, never an id to look up.
      const storable = normalizeProjects(projects);
      const byId = new Map(storable.map((p) => [p.id, p]));
      return {
        displayName: nameInput.value.trim(),
        role: roleInput.value.trim(),
        memberType: memberTypeSelector?.value ?? "",
        bio: bioInput.value.trim(),
        tags: tagSelector?.value ?? [],
        openTo: openToSelector?.value ?? [],
        affiliation: affiliationInput.value.trim(),
        location: locationInput.value.trim(),
        languages: getSelectedLanguages(),
        visualNeeds: needsVisuals(memberTypeSelector?.value ?? "")
          ? (visualNeedsSelector?.value ?? [])
          : [],
        portfolio: portfolioInput.value.trim(),
        socialMedia: socialStored(),
        projects: storable,
        works: gallery.map((g) => {
          const project = g.projectId ? byId.get(g.projectId) : undefined;
          return {
            url: g.url,
            width: g.width,
            height: g.height,
            caption: g.caption,
            color: g.color,
            description: (g.description ?? "").trim() || undefined,
            ...(project ? { project: { title: project.title, url: project.url } } : {}),
          };
        }),
      };
    }

    /**
     * The profile-page preview. Skipped entirely while the form is in edit
     * mode — it is off-screen there, so re-rendering it on every keystroke
     * would be work nobody can see.
     */
    function syncProfileView() {
      if (!profileViewRoot || !form.classList.contains("is-previewing")) return;
      renderProfilePreview(profileViewRoot, currentViewModel(), {
        defaultName: s["profile.view.defaultName"],
        tags: s["profile.view.tags"],
        elsewhere: s["profile.view.elsewhere"],
        openTo: s["profile.view.openTo"],
        noWorks: s["profile.view.noWorks"],
        projects: s["profile.view.projects"],
        needs: s["profile.view.needs"],
        partOf: s["profile.view.partOf"],
      });
    }

    function setSection(section: string) {
      formSections.forEach((el) => {
        el.classList.toggle("is-active", el.dataset.section === section);
      });
      sectionTabs.forEach((btn) => {
        const active = btn.dataset.section === section;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", String(active));
      });
      // The preview renders on tab entry, not on every keystroke behind the
      // scenes — syncProfileView's early return keys off this class.
      form.classList.toggle("is-previewing", section === "preview");
      if (section === "preview") syncProfileView();
    }

    /** Scientists and research groups get lab-facing field wording. */
    function syncMemberTypeCopy() {
      const type = memberTypeSelector?.value ?? "";
      const copy = memberTypeFieldCopy(type, (key) => s[key] ?? key);
      nameInput.placeholder = copy.namePlaceholder;
      roleInput.placeholder = copy.rolePlaceholder;
      portfolioInput.placeholder = copy.portfolioPlaceholder;
      if (portfolioLabel) portfolioLabel.textContent = copy.portfolioLabel;
      affiliationInput.placeholder = copy.affiliationPlaceholder;
      socialPlaceholder = copy.socialPlaceholder;
      if (socialLabel) socialLabel.textContent = copy.socialLabel;
      // Reach into the live rows rather than re-rendering them: a member can
      // change their type with a half-typed link on screen.
      socialEditor.querySelectorAll<HTMLInputElement>("[data-social-input]").forEach((input, i) => {
        input.placeholder = socialPlaceholder;
        input.setAttribute("aria-label", `${copy.socialLabel} ${i + 1}`);
      });
      if (projectsLabel) projectsLabel.textContent = copy.projectsLabel;
      // A creator makes visuals rather than needing them, so the question
      // is hidden for them — and its stored value is dropped on save, so a
      // member who switches type cannot leave orphaned needs behind.
      if (visualNeedsSelector) visualNeedsSelector.hidden = !needsVisuals(type);
    }

    memberTypeSelector?.addEventListener("member-type-change", () => {
      syncMemberTypeCopy();
      // The member type is the typographic card face's tag-line fallback.
      syncPreview();
    });

    sectionTabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        setSection(btn.dataset.section ?? "profile");
      });
    });

    // Tags fill the directory card's typographic face as well as the profile
    // view, so they sync both; openTo reaches only the profile view.
    // <tag-selector> dispatches a bubbling `change`; <open-to-selector> has no
    // event of its own, but the native `change` from its checkboxes bubbles to
    // the form just the same.
    tagSelector?.addEventListener("change", syncPreview);
    openToSelector?.addEventListener("change", syncProfileView);

    nameInput.addEventListener("input", syncPreview);
    roleInput.addEventListener("input", syncPreview);
    bioInput.addEventListener("input", syncPreview);
    portfolioInput.addEventListener("input", syncPreview);
    affiliationInput.addEventListener("input", syncProfileView);
    locationInput.addEventListener("input", syncProfileView);
    languageInputs.forEach((input) => input.addEventListener("change", syncProfileView));
    visualNeedsSelector?.addEventListener("visual-needs-change", syncProfileView);

    avatarInput.addEventListener("change", async () => {
      const file = avatarInput.files?.[0];
      if (!file) return;

      const validation = validateAvatar(file);
      if (!validation.ok) {
        uploadStatus.textContent = validation.error!;
        uploadStatus.style.display = "block";
        resizedAvatarBlob = null;
        avatarInput.value = "";
        return;
      }

      uploadStatus.textContent = s["profile.upload.processing"];
      uploadStatus.style.display = "block";
      try {
        const edited = await openImageEditor(file, editorLabels);
        const source = edited ? new File([edited], "edited.png", { type: "image/png" }) : file;
        ({ blob: resizedAvatarBlob, color: avatarColor } = await resizeAvatar(source));
        const previewUrl = URL.createObjectURL(resizedAvatarBlob);
        showPreview(previewUrl);
        uploadStatus.textContent = `${s["profile.upload.selected"]}${file.name}`;
      } catch {
        uploadStatus.textContent = s["profile.upload.error"];
        resizedAvatarBlob = null;
      }
    });

    unsubscribeAuth?.();
    unsubscribeAuth = requireAuth(async (user) => {
      const verifyBanner = document.getElementById("verify-banner")!;
      const btnResendVerify = document.getElementById("btn-resend-verify") as HTMLButtonElement;
      const verifyBannerSent = document.getElementById("verify-banner-sent")!;

      if (!user.emailVerified) {
        verifyBanner.style.display = "block";
        let resendCooldown = false;
        btnResendVerify.addEventListener("click", async () => {
          if (resendCooldown) return;
          resendCooldown = true;
          btnResendVerify.disabled = true;
          try {
            await sendEmailVerification(user);
            verifyBannerSent.style.display = "block";
          } catch {
            // silently fail — user can try again after cooldown
          }
          setTimeout(() => {
            resendCooldown = false;
            btnResendVerify.disabled = false;
          }, 30000);
        });
      }

      const data = await getUser(user.uid);

      nameInput.value = data.displayName ?? user.displayName ?? "";
      roleInput.value = data.role ?? "";
      bioInput.value = data.bio ?? "";
      portfolioInput.value = data.portfolio ?? "";
      // The stored string IS the row list — an old single-value profile simply
      // arrives as one row, with nothing to migrate.
      setSocialValues(splitSocial(data.socialMedia ?? ""));
      affiliationInput.value = data.affiliation ?? "";
      locationInput.value = data.location ?? "";
      setSelectedLanguages(data.languages ?? []);
      if (visualNeedsSelector) {
        visualNeedsSelector.value = Array.isArray(data.visualNeeds)
          ? data.visualNeeds.filter(Boolean)
          : [];
      }
      if (memberTypeSelector) {
        memberTypeSelector.value = data.memberType ?? "";
        syncMemberTypeCopy();
      }
      if (openToSelector) {
        openToSelector.value = Array.isArray(data.openTo) ? data.openTo.filter(Boolean) : [];
      }
      if (tagSelector) {
        tagSelector.value = Array.isArray(data.tags) ? data.tags.filter(Boolean).slice(0, 7) : [];
      }
      setSelectedPrimaryAudiences(data.primaryAudiences ?? []);
      gallery = Array.isArray(data.gallery) ? data.gallery.slice(0, MAX_GALLERY_IMAGES) : [];
      // Projects before the gallery: the per-image selects are built from this
      // list, so an empty one would render every tagged image as untagged.
      projects = normalizeProjects(data.projects);
      renderProjects();
      renderGallery();
      phoneInput.value = data.phone ?? "";
      wantsToContributeInput.checked = data.wantsToContribute ?? false;
      activeInput.checked = await getPublicProfileActive(user.uid);
      showPreview(data.photoURL ?? user.photoURL ?? "");

      if (loadingEl) loadingEl.style.display = "none";
      form.classList.add("is-loaded");
    });

    document.getElementById("btn-logout")!.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = prefix || "/";
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      saveMsg.style.display = "none";
      saveError.style.display = "none";

      const user = auth.currentUser;
      if (!user) return;

      const memberType = memberTypeSelector?.value ?? "";

      try {
        await handleProfileUpdate(
          user,
          {
            displayName: nameInput.value.trim(),
            // Omit rather than write "" — the field is absent until chosen.
            ...(isMemberType(memberType) ? { memberType } : {}),
            role: roleInput.value.trim(),
            bio: bioInput.value.trim(),
            portfolio: portfolioInput.value.trim(),
            socialMedia: socialStored(),
            affiliation: affiliationInput.value.trim(),
            location: locationInput.value.trim(),
            languages: getSelectedLanguages(),
            // Cleared for creators: the question is hidden for them, so keeping
            // a previous answer would publish something they cannot see or edit.
            visualNeeds: needsVisuals(memberType) ? (visualNeedsSelector?.value ?? []) : [],
            openTo: openToSelector?.value ?? [],
            primaryAudiences: getSelectedPrimaryAudiences(),
            tags: tagSelector?.value ?? [],
            // The gallery persists on its own when images are added or
            // removed, but the words attached to them — captions,
            // descriptions, project tags — are typed, and typed text belongs
            // to the Save button like every other field here.
            gallery,
            projects: normalizeProjects(projects),
            wantsToContribute: wantsToContributeInput.checked,
            phone: phoneInput.value.trim(),
            email: user.email!,
            resizedAvatarBlob,
            ...(resizedAvatarBlob && avatarColor ? { photoColor: avatarColor } : {}),
          },
          (pct) => {
            uploadStatus.textContent = `${s["profile.upload.uploading"]} ${pct}%`;
            uploadStatus.style.display = "block";
          }
        );

        if (resizedAvatarBlob) {
          uploadStatus.textContent = s["profile.upload.complete"];
        }

        await setProfileActive(user.uid, activeInput.checked);
        await triggerRebuild();
        saveMsg.style.display = "block";
      } catch (err: unknown) {
        saveError.textContent = err instanceof Error ? err.message : s["profile.save.error"];
        saveError.style.display = "block";
      }
    });

    // ── Delete account ──────────────────────────────────────────────
    const deleteIdle = document.getElementById("delete-idle")!;
    const deleteConfirm = document.getElementById("delete-confirm")!;
    const deleteReauth = document.getElementById("delete-reauth")!;
    const reauthInput = document.getElementById("reauth-password") as HTMLInputElement;
    const reauthError = document.getElementById("reauth-error")!;

    function showDeleteView(view: "idle" | "confirm" | "reauth") {
      deleteIdle.style.display = view === "idle" ? "block" : "none";
      deleteConfirm.style.display = view === "confirm" ? "block" : "none";
      deleteReauth.style.display = view === "reauth" ? "block" : "none";
    }

    async function performDelete() {
      const user = auth.currentUser;
      if (!user) return;
      const photoURL = user.photoURL ?? "";
      await deleteUserData(user.uid);
      await deleteAvatar(photoURL);
      await deleteGalleryImages(gallery.map((item) => item.url));
      await user.delete();
      window.location.href = prefix || "/";
    }

    document.getElementById("btn-delete-start")!.addEventListener("click", () => {
      showDeleteView("confirm");
    });

    document.getElementById("btn-delete-cancel")!.addEventListener("click", () => {
      showDeleteView("idle");
    });

    document.getElementById("btn-delete-confirm")!.addEventListener("click", async () => {
      const btn = document.getElementById("btn-delete-confirm") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = s["profile.delete.deleting"];
      try {
        await performDelete();
      } catch (err: unknown) {
        const code =
          typeof err === "object" && err !== null && "code" in err
            ? String((err as { code: unknown }).code)
            : "";
        if (code === "auth/requires-recent-login") {
          showDeleteView("reauth");
        } else {
          btn.disabled = false;
          btn.textContent = s["profile.delete.confirm"];
        }
      }
    });

    document.getElementById("btn-reauth-cancel")!.addEventListener("click", () => {
      reauthInput.value = "";
      reauthError.style.display = "none";
      showDeleteView("idle");
    });

    document.getElementById("btn-reauth-confirm")!.addEventListener("click", async () => {
      const user = auth.currentUser;
      if (!user || !user.email) return;
      const btn = document.getElementById("btn-reauth-confirm") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = s["profile.reauth.confirming"];
      reauthError.style.display = "none";
      try {
        const credential = EmailAuthProvider.credential(user.email, reauthInput.value);
        await reauthenticateWithCredential(user, credential);
        await performDelete();
      } catch {
        reauthError.textContent = s["profile.reauth.error"];
        reauthError.style.display = "block";
        btn.disabled = false;
        btn.textContent = s["profile.reauth.confirm"];
      }
    });
  });
</script>
