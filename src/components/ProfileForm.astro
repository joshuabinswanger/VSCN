---
import CommunityCardPreview from "./community/CommunityCardPreview.astro";
import MemberTypeSelector from "./MemberTypeSelector.astro";
import ProfileViewPreview from "./ProfileViewPreview.astro";
import OpenToSelector from "./OpenToSelector.astro";
import VisualNeedsSelector from "./VisualNeedsSelector.astro";
import TagSelector from "./TagSelector.astro";
import { LANGUAGES } from "../lib/firestore.ts";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

<div id="loading" class="loading-state">{t("profile.loading")}</div>

{
  /* Above the form, not inside a section: an unverified address matters on
    every tab. */
}
<div id="verify-banner" class="verify-banner" style="display:none;">
  <p class="verify-banner-text">
    {t("profile.verifyBanner")}
    <button id="btn-resend-verify" type="button" class="btn-resend-verify"
      >{t("profile.verifyResend")}</button
    >
  </p>
  <p id="verify-banner-sent" class="verify-banner-sent" style="display:none;">
    {t("profile.verifySent")}
  </p>
</div>

<form id="profile-form" class="profile-form" data-lang={lang}>
  {
    /* Shown on every tab while a deletion is pending: the way back out of it
      must not be hidden behind the tab that scheduled it. */
  }
  <div id="deletion-banner" class="deletion-banner" style="display:none;" role="status">
    <p id="deletion-banner-text"></p>
    <button type="button" id="btn-keep-account" class="btn-solid"
      >{t("profile.delete.keep")}</button
    >
  </div>

  {
    /* One form, four sections. A tab switch only toggles visibility, so the
      single Save still collects every field. Preview is the last tab rather
      than a separate mode: it needs no save and no rebuild, which matters
      because the real profile page is a build-time snapshot — saving alone
      would not show the member their own change for minutes. */
  }
  <div class="section-tabs" role="group" id="section-tabs">
    <button type="button" class="section-tab is-active" data-section="profile" aria-pressed="true">
      {t("profile.tab.profile")}
    </button>
    <button type="button" class="section-tab" data-section="work" aria-pressed="false">
      {t("profile.tab.work")}
    </button>
    <button type="button" class="section-tab" data-section="account" aria-pressed="false">
      {t("profile.tab.account")}
    </button>
    <button type="button" class="section-tab" data-section="preview" aria-pressed="false">
      {t("profile.tab.preview")}
    </button>
  </div>

  <div class="form-section is-active" data-section="profile">
    <div class="avatar-wrap">
      <div class="avatar-image">
        <img id="avatar-preview" src="" alt="" class="avatar-img" />
        <div id="avatar-placeholder" class="avatar-placeholder">?</div>
      </div>
      <label class="btn-outline choose-img" for="avatar">
        {t("profile.chooseImage")}
        <input
          id="avatar"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/avif"
          style="display:none;"
        />
      </label>
      <p id="upload-status" class="upload-status" style="display:none;"></p>
    </div>

    <MemberTypeSelector lang={lang} />

    <div class="field">
      <label class="label" for="name">{t("profile.label.name")}</label>
      <input id="name" type="text" class="input" placeholder={t("profile.ph.name")} />
    </div>

    <div class="field">
      <label class="label" for="role">{t("profile.label.role")}</label>
      <input id="role" type="text" class="input" placeholder={t("profile.ph.role")} />
      <p class="field-note">{t("profile.note.role")}</p>
    </div>

    <div class="field">
      <label class="label" for="affiliation">{t("profile.label.affiliation")}</label>
      <input
        id="affiliation"
        type="text"
        class="input"
        placeholder={t("profile.ph.affiliation")}
      />
    </div>

    <div class="field">
      <label class="label" for="location">{t("profile.label.location")}</label>
      <input id="location" type="text" class="input" placeholder={t("profile.ph.location")} />
    </div>

    <fieldset class="target-audience-field">
      <legend class="label">{t("profile.label.languages")}</legend>
      <div class="target-audience-options">
        {
          LANGUAGES.map((code) => (
            <label class="target-audience-option">
              <input type="checkbox" name="language" value={code} />
              <span>{t(`profile.lang.${code}`)}</span>
            </label>
          ))
        }
      </div>
      <p class="field-note">{t("profile.note.languages")}</p>
    </fieldset>

    <div class="field">
      <label class="label" for="bio">{t("profile.label.bio")}</label>
      <textarea id="bio" rows="4" class="input textarea" placeholder={t("profile.ph.bio")}
      ></textarea>
      <p class="field-note">{t("profile.note.bio")}</p>
    </div>

    <div class="field">
      <label id="portfolio-label" class="label" for="portfolio"
        >{t("profile.label.portfolio")}</label
      >
      <div class="input-prefix-wrap">
        <span class="input-prefix">https://</span>
        <input
          id="portfolio"
          type="text"
          class="input input-prefixed"
          placeholder={t("profile.ph.portfolio")}
        />
      </div>
    </div>

    {
      /* One row per link, not one box for all of them. The STORED shape is
      unchanged — the rows are joined back into the single comma-separated
      `socialMedia` string by joinSocial() — so old profiles, the build-time
      directory snapshot and firestore.rules all keep working untouched. A <p>
      rather than a <label>: there is no single control left to point at. */
    }
    <div class="field">
      <p id="social-label" class="label">{t("profile.label.social")}</p>
      <div id="social-editor" class="social-editor"></div>
      <button type="button" id="social-add" class="btn-outline choose-img">
        {t("profile.social.add")}
      </button>
      <p id="social-status" class="field-note" style="display:none;"></p>
      <p class="field-note">{t("profile.note.social")}</p>
      {
        /* Cloned by renderSocial(). Rendered here rather than built in JS so
        each clone carries Astro's data-astro-cid-* attribute and matches the
        scoped rules below — a node built with document.createElement() would
        match none of them. */
      }
      <template data-social-tpl="row">
        <div class="social-row">
          <div class="input-prefix-wrap">
            <span class="input-prefix">https://</span>
            <input type="text" class="input input-prefixed" data-social-input />
          </div>
          <button type="button" class="social-row-remove" data-social-remove>✕</button>
        </div>
      </template>
    </div>

    <OpenToSelector lang={lang} />

    <VisualNeedsSelector lang={lang} />

    <fieldset class="target-audience-field">
      <legend class="label">{t("profile.primaryAudience.legend")}</legend>
      <div class="target-audience-options">
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="science" />
          <span>{t("profile.primaryAudience.science")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="public" />
          <span>{t("profile.primaryAudience.public")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="policy-makers" />
          <span>{t("profile.primaryAudience.policyMakers")}</span>
        </label>
        <label class="target-audience-option">
          <input type="checkbox" name="primary-audience" value="education" />
          <span>{t("profile.primaryAudience.education")}</span>
        </label>
      </div>
    </fieldset>

    <div class="field">
      <label class="label" for="tag-input">{t("profile.label.tags")}</label>
      <TagSelector lang={lang} maxTags={7} inputId="tag-input" />
    </div>
  </div>

  <div class="form-section" data-section="work">
    <div class="field">
      <p class="label">{t("profile.label.gallery")}</p>
      {
        /* The drop target is this wrapper, not the list: an empty gallery has a
        list of zero height, so a member with no images yet — the one most
        likely to be dragging a folder of work at the screen — would have had
        nothing to drag onto. Wrapping the Add button in it too means the whole
        block is the target, which is also what it looks like. */
      }
      <div id="gallery-drop" class="gallery-drop">
        <div id="gallery-editor" class="gallery-editor"></div>
        {
          /* Pending uploads live in their own list BELOW the committed images,
          because that is where a finished upload lands — a row does not jump
          when it completes, it just stops being a queue row. */
        }
        {
          /* NOT aria-live. The obvious choice here is wrong: the state text
          inside carries a percentage that updates several times a second per
          upload, and a polite live region would read all of it aloud, three
          uploads at a time. Progress is exposed as a progressbar instead —
          available on demand, silent until asked — and only a FAILURE is
          announced, by paintTaskRow promoting that one row to role="alert". */
        }
        <div id="gallery-queue" class="gallery-queue"></div>
        <label class="btn-outline choose-img" for="gallery-files">
          {t("profile.gallery.add")}
          <input
            id="gallery-files"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            multiple
            style="display:none;"
          />
        </label>
        <span class="gallery-drop-hint" aria-hidden="true">{t("profile.gallery.drop")}</span>
      </div>
      <p id="gallery-status" class="field-note" style="display:none;"></p>
      {
        /* Two notes, one shown. The verify banner used to carry "until then
          you can add only one image" and no longer does — a strip about email
          is the wrong place for the gallery's ceiling, and it left this line
          saying "up to 8" to a member who could upload exactly one. The limit
          belongs next to the uploader. Defaults to the verified copy so the
          swap, like the banner's, is a single act with nothing to undo. */
      }
      <p id="gallery-note" class="field-note">{t("profile.note.gallery")}</p>
      <p id="gallery-note-unverified" class="field-note" hidden>
        {t("profile.note.galleryUnverified")}
      </p>
      {
        /* Order is not a preference, it is the card's geometry: works[0]'s
        width/height become the aspect box in CommunityImageCard. Nothing used
        to say so, so members had no way to know the first image was doing
        anything at all. */
      }
      <p class="field-note">{t("profile.gallery.coverNote")}</p>
      {
        /* The directory is image-led: a member without a gallery holds a
        typographic card. Saying so here is the standing mechanism that fills
        the directory — hidden the moment the first image lands. */
      }
      <p id="gallery-nudge" class="field-note gallery-nudge" hidden>{t("profile.gallery.nudge")}</p>
      {
        /* Cloned by renderGallery(). Astro scopes this component's CSS by
        appending data-astro-cid-* to EVERY compound selector, so .gallery-item, .gallery-thumb and .gallery-thumb-remove
        are scoped rules, so createElement() rows got none of them — the thumbs
        rendered at their natural size with an untreated remove button. */
      }
      <template data-gallery-tpl="item">
        <div class="gallery-item">
          <div class="gallery-thumb">
            <img alt="" loading="lazy" data-gallery-img />
            <span class="gallery-cover" data-gallery-cover hidden></span>
            <button type="button" class="gallery-thumb-remove" data-gallery-remove>✕</button>
          </div>
          <div class="gallery-fields">
            <input type="text" class="input" data-gallery-field="caption" />
            {
              /* TWO TEXTS PER IMAGE, NOT THREE (2026-09-04, Josh: "we only
                need one description field for the image"). A 240-character
                short version sat here for a day, between the caption and this
                one, on the theory that the lightbox wanted a summary and the
                portfolio page wanted the essay. In the editor it read as being
                asked to write the same thing twice at two lengths, with no way
                to tell which surface would show which — so it mostly went
                unfilled, and the lightbox showed nothing where the member had
                plainly written something. The caption names the picture and is
                what screen readers say; this describes it, and now goes
                wherever there is room for it. */
            }
            <textarea class="input textarea" rows="3" data-gallery-field="description"></textarea>
            {
              /* WHERE THIS IMAGE APPEARED. Same fixed-prefix treatment as
                Portfolio and the social rows, because the value is stored the
                same way: without a scheme. A bare text input would collect a
                mix of "nature.com/…" and "https://nature.com/…" in one field. */
            }
            <div class="input-prefix-wrap">
              <span class="input-prefix">https://</span>
              <input type="text" class="input input-prefixed" data-gallery-field="link" />
            </div>
            <div class="gallery-tools">
              <button type="button" class="gallery-tool" data-gallery-move="up">↑</button>
              <button type="button" class="gallery-tool" data-gallery-move="down">↓</button>
            </div>
          </div>
        </div>
      </template>
      {
        /* One pending upload, cloned by renderQueue(). Deliberately the same
        .gallery-item geometry as a committed row: the thumb is in the same
        place at the same size, so a completed upload reads as the row settling
        rather than as one row vanishing and a different one appearing. */
      }
      <template data-gallery-tpl="task">
        <div class="gallery-item gallery-task">
          <div class="gallery-thumb">
            <img alt="" data-task-img />
            <button type="button" class="gallery-thumb-remove" data-task-cancel>✕</button>
          </div>
          <div class="gallery-fields">
            <p class="gallery-task-name" data-task-name></p>
            <div
              class="gallery-bar"
              data-task-track
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <span data-task-bar></span>
            </div>
            <p class="gallery-task-state" data-task-state></p>
            <div class="gallery-tools" data-task-tools hidden>
              <button type="button" class="gallery-tool" data-task-retry></button>
              <button type="button" class="gallery-tool" data-task-dismiss></button>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <div class="form-section" data-section="account">
    {
      /* THE WAY INTO /admin, AT THE TOP OF THE TAB (2026-09-04, Josh: "at top
        or seperate tab"). It arrived on 2026-09-03 (Josh: "i cant see the
        admin console ... cant it be on the normal profile page?") wedged
        between the logout and the danger zone, which is where the ACCOUNT
        things are — but it is not an account thing. It is a door out of this
        page entirely, and buried among the account's own controls it read as
        one more of them. A separate tab would be the other answer; a tab
        holding one link, for one person, is more furniture than the link
        earns, so it leads the tab instead.

        Not locale-prefixed: /admin is a single page outside src/pages/[...lang]
        (there is no /de/admin), so a `${prefix}` here would 404 in German.

        `hidden` until the claim is confirmed, and the claim is read the same
        way the console itself reads it (see AdminConsole): a forced token
        refresh, because Firebase serves a CACHED ID token for up to an hour
        and a claim granted by set-admin.mjs after the browser last signed in
        is not in it. Without that refresh this link would stay invisible to a
        brand-new admin for an hour, which is the same bug the console's own
        gate had. A non-admin never sees it — see the `[hidden]` rule in the
        styles below for why that sentence was false until 2026-09-03. It is a
        link, not a permission: /admin and every admin callable gate
        themselves. Which is also why leading the tab costs nothing: for
        everyone who is not an admin there is nothing here at all. */
    }
    <a id="admin-link" class="btn-outline account-quiet" href="/admin" hidden>
      {t("profile.adminConsole")}
    </a>

    <div class="field">
      <label class="checkbox-label" for="profile-active">
        <input id="profile-active" type="checkbox" />
        <span>{t("profile.active.label")}</span>
      </label>
      <p class="field-note">{t("profile.active.note")}</p>
    </div>

    <div class="field">
      <label class="checkbox-label" for="wants-to-contribute">
        <input id="wants-to-contribute" type="checkbox" />
        <span>{t("profile.wantsToContribute")}</span>
      </label>
      <p class="field-note">{t("profile.wantsToContribute.note")}</p>
    </div>

    <div class="field">
      <label class="label" for="phone">{t("profile.label.phone")}</label>
      <input
        id="phone"
        type="tel"
        class="input"
        placeholder="+41 79 123 45 67"
        autocomplete="tel"
      />
      <p class="field-note">
        {t("profile.note.phone")}
      </p>
    </div>

    {
      /* ── THE TWO DOORS ────────────────────────────────────────────────
        Change email address and Delete account, as a pair. They are the same
        kind of thing — a quiet link that opens a form asking you to prove who
        you are before an irreversible change to your account — and since
        2026-09-04 they are drawn the same way, so they have to be SPACED the
        same way too. Left as two independent blocks they sat 2rem apart, far
        enough that the second read as a lone control at the bottom of the tab
        rather than as the twin of the one above it. The group carries the 2rem
        now; inside it the gap is a line. */
    }
    <div class="account-doors">
    {
      /* Auth owns the change: the confirmation link goes to the NEW address
        and the swap happens only when it is clicked. users/{uid}.email is a
        server-written mirror that catches up on the next load.

        BEHIND ITS OWN TRIGGER (2026-09-03, Josh: "email change behind
        seperate mask"). Standing open, an empty "new email address" beside an
        empty password box reads as a field the Account tab is asking you to
        fill in — and it sat directly under the phone number, which IS one.
        Changing an email is a deliberate errand; it should take a deliberate
        click to start. */
    }
    <div class="account-block">
      <div id="email-idle">
        <button type="button" id="btn-email-start" class="btn-link"
          >{t("profile.email.title")}</button
        >
      </div>

      <div id="email-form" class="account-disclosure" hidden>
        <label class="label" for="email-new">{t("profile.email.new")}</label>
        <input id="email-new" type="email" class="input" autocomplete="email" />
        <label class="label" for="email-password">{t("profile.reauth.text")}</label>
        <input id="email-password" type="password" class="input" autocomplete="current-password" />
        <p id="email-msg" class="msg-ok" style="display:none;"></p>
        <p id="email-error" class="msg-err" style="display:none;"></p>
        <div class="account-actions">
          <button type="button" id="btn-email-cancel" class="btn-link"
            >{t("profile.reauth.cancel")}</button
          >
          <button type="button" id="btn-email-change" class="btn-solid"
            >{t("profile.email.submit")}</button
          >
        </div>
      </div>
    </div>

    {
      /* THE SAME WEIGHT AS "CHANGE EMAIL ADDRESS", AND DIRECTLY UNDER IT
        (2026-09-04, Josh: "here in the same weight the delete Account"). It
        was a pale red link under a 2rem rule in its own "danger zone", which
        is the received wisdom for a destructive control and was wrong here for
        two reasons.

        The rule and the red made a whole region out of one link, so the tab
        ended in a warning rather than in a control — and a member who has to
        delete their account (the last thing anybody wants to do while being
        talked out of it) had to cross a boundary drawn to discourage them.

        And it is the SAME KIND OF THING as the email change: two doors that
        open a form asking you to prove who you are before an irreversible
        change to your account. Drawing them differently claimed a distinction
        that does not survive the click.

        The red survives where it is worth something — on the confirm button
        inside the opened form, where there is something to confirm. What
        guards this door is not its colour: the form behind it asks for the
        account's own address AND its password, and requestAccountDeletion
        refuses a token older than five minutes. */
    }
    <div class="account-block">
      <div id="delete-idle">
        <button type="button" id="btn-delete-start" class="btn-link"
          >{t("profile.delete.idle")}</button
        >
      </div>

      {
        /* TWO THINGS TO GET WRONG, ON PURPOSE (2026-09-04, Josh: "a typed
          confirmation would be good!").

          The one-step design used to be justified right here: the password
          prompt WAS the confirmation, because requestAccountDeletion refuses a
          token whose auth_time is older than five minutes, so an "are you
          sure" screen in front of it added a click and no safety. That
          reasoning rested on the 30-day grace period. The grace period is gone
          — the callable now destroys documents, files and the Auth user before
          it returns — and the argument went with it.

          A password is the one string a member types on this site often enough
          to type without reading it, and a password manager will fill it
          unasked. The address is the opposite: nothing autofills it into a
          bare text field, and it names WHICH account is about to go, which a
          password never does.

          The address rather than the word DELETE because this form is
          bilingual. A magic word needs translating, and a member who switches
          language halfway through would find the word they had just typed no
          longer matches. An address means the same thing in both. */
      }
      <div id="delete-reauth" style="display:none;">
        <p class="danger-text">{t("profile.delete.text")}</p>

        <label class="danger-label" for="delete-confirm-email"
          >{t("profile.delete.typePrompt")}</label
        >
        <p id="delete-confirm-target" class="danger-target"></p>
        <input
          id="delete-confirm-email"
          type="text"
          class="input"
          autocomplete="off"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          inputmode="email"
        />
        <p id="delete-confirm-error" class="msg-err" style="display:none;"></p>

        <p class="danger-text danger-text-spaced">{t("profile.reauth.text")}</p>
        <input
          id="reauth-password"
          type="password"
          class="input"
          placeholder="••••••••"
          autocomplete="current-password"
        />
        <p id="reauth-error" class="msg-err" style="display:none;"></p>
        <div class="danger-actions">
          <button type="button" id="btn-reauth-cancel" class="btn-link"
            >{t("profile.reauth.cancel")}</button
          >
          <button type="button" id="btn-reauth-confirm" class="btn-danger" disabled
            >{t("profile.delete.confirm")}</button
          >
        </div>
      </div>

      <div id="delete-scheduled" style="display:none;">
        <p id="delete-scheduled-text" class="danger-text"></p>
      </div>
    </div>
    </div>

    {
      /* LAST (2026-09-04, Josh: "bottom"). It led the tab from 2026-09-03,
        when it was promoted out of a pair of grey ghosts on the grounds that
        signing out is what a member opens this tab to DO. That was true of the
        tab as it stood — the only other things on it were a link most members
        cannot follow and a danger zone. It is not true of the tab now: the
        settings above are things a member came to CHANGE, and a button that
        ends the session, sitting above them, is a trapdoor in front of the
        work. Bottom of the tab is where you reach it after doing what you came
        for, which is also when you want it.

        It keeps the full-strength outline it was given, so the demotion is in
        the position only. Still an outline and not filled black: that is
        Save's, and two black buttons on one screen is two primary actions. */
    }
    <button id="btn-logout" type="button" class="btn-logout-strong">
      {t("profile.logout")}
    </button>
  </div>

  <div class="form-section" data-section="preview">
    {
      /* The Preview tab. Both representations sit here together so
      they are comparable, and so the form itself stays a form.

      The profile page comes first: it is the artefact the member is actually
      building. The directory card is the smaller, secondary view of the same
      data — the image card itself, carousel and all, bound by
      renderCardPreview(), which is what /community renders since the directory
      switched over.

      NOTHING BETWEEN THEM BUT A RULE (2026-09-02, Josh: "make the preview be
      exactly the profile page seperated only by horizontal bars"). The two
      "YOUR PROFILE PAGE" / "YOUR DIRECTORY CARD" headings are gone with the
      preview's sheet and note. They were the editor naming its own contents
      over renderings that name themselves — a page with the member's name at
      the top of it, and a card with their name on it — and a label above a
      preview is one more thing between the member and the thing they are
      looking at. ProfileViewPreview draws the rule above and below itself;
      this section closes the last one under the card. */
    }
    <div class="preview-section">
      <ProfileViewPreview lang={lang} />
      <CommunityCardPreview />
      <hr class="preview-rule" />
    </div>
  </div>

  {/* Floating Save: reachable from every editing tab, hidden on Preview. */}
  <div class="form-footer">
    <p id="save-msg" class="msg-ok" style="display:none;">
      {t("profile.saveMsg")}
    </p>
    <p id="save-error" class="msg-err" style="display:none;"></p>
    <button id="save-button" type="submit" class="btn-solid profile-save-button"
      >{t("profile.save")}</button
    >
  </div>
</form>

