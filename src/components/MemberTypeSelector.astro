---
import { MEMBER_TYPES } from "../lib/firestore.ts";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
  name?: string;
  /** False drops the note: /profile, where it only repeated the obvious
   *  (2026-09-25). The wizard keeps it written out. */
  note?: boolean;
}

const { lang = "en", name = "member-type", note = true } = Astro.props;
const t = useTranslations(lang);
---

<member-type-selector class="member-type-selector" data-lang={lang}>
  <fieldset class="memberType-field" aria-describedby={note ? "note-member-type" : undefined}>
    <legend class="label">{t("profile.memberType.legend")}</legend>
    <div class="memberType-options">
      {
        MEMBER_TYPES.map((type) => (
          <label class="memberType-option">
            <input type="radio" name={name} value={type} />
            <span>{t(`profile.memberType.${type}`)}</span>
          </label>
        ))
      }
    </div>
    {note && <p id="note-member-type" class="field-note">{t("profile.memberType.note")}</p>}
  </fieldset>
</member-type-selector>

<style>
  .memberType-field {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .memberType-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* THE CHIP MASTER (2026-10-28, vscn-design.af boards 06 and 17): an option
     is a 28px pill like every other chip, its radio a 6px dot at the left,
     paper on the ink of the chosen one. */
  .memberType-option {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    min-height: 28px;
    padding: 0.3rem 13px 0.3rem 11px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill) !important;
    background: var(--color-bg);
    color: var(--color-dark);
    font-size: var(--fs-74);
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .memberType-option:hover {
    border-color: var(--color-dark);
  }

  .memberType-option:has(input:checked) {
    border-color: var(--color-dark);
    background: var(--color-dark);
    color: var(--color-bg);
  }

  .memberType-option:has(input:focus-visible) {
    outline: 2px solid var(--color-dark);
    outline-offset: 2px;
  }

  .memberType-option input {
    appearance: none;
    width: 6px;
    height: 6px;
    margin: 0;
    border-radius: 50% !important;
    background: var(--color-border);
    cursor: pointer;
    flex-shrink: 0;
  }

  .memberType-option input:checked {
    background: var(--color-bg);
  }

  .memberType-option input:focus-visible {
    outline: none;
  }

</style>

<script>
  class MemberTypeSelectorElement extends HTMLElement {
    private initialized = false;

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;

      this.radios().forEach((radio) => {
        radio.addEventListener("change", () => {
          this.dispatchEvent(
            new CustomEvent("member-type-change", { detail: this.value, bubbles: true })
          );
        });
      });
    }

    private radios(): HTMLInputElement[] {
      return Array.from(this.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    }

    /** Selected member type, or "" when the member has not chosen one. */
    get value(): string {
      return this.radios().find((radio) => radio.checked)?.value ?? "";
    }

    set value(next: string) {
      this.radios().forEach((radio) => {
        radio.checked = radio.value === next;
      });
    }
  }

  if (!customElements.get("member-type-selector")) {
    customElements.define("member-type-selector", MemberTypeSelectorElement);
  }
</script>
