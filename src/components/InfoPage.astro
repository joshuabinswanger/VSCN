---
import { getImage } from "astro:assets";
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";
import { fetchMemberViews } from "../lib/membersBuild.ts";
import { workCaption, memberHref } from "../lib/links.ts";
import { projectTitle, looseWorksProjectId } from "../lib/projects.ts";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const portfoliosHref = lang === "de" ? "/de/community" : "/community";

// THE INFO PAGE TELLS A STORY AS IT SCROLLS (2026-11-02, Josh: "like a
// storytelling with smooth scroll and animations"; 2026-11-04: "it should
// snap as well", then "moving between sections needs to be smooth and also
// more scroll"). Every chapter is one screen, and when a scroll ends the
// script glides to a chapter: back to the one left after a nudge, on to the
// next after a real scroll (settle(); CSS snapping either jumped at the
// first wheel tick or, as proximity, left the page between two chapters).
// A chapter plays its entrance the
// first time it is reached and the page is shown: its data-in parts rise
// and fade in, each after its own --d delay, so a list arrives point by
// point.
//
//   1. HERO. "Visuals create knowledge." on arrival, then the second
//      sentence (the big size), then the third at reading size.
//   2. WORKS. One picture at a time, the artist and the project under it:
//      a plain carousel the visitor swipes (phone) or drags (desktop), with
//      a moving hint beneath until they do. No fades on the pictures.
//   3. ABOUT. Our mission, How we do that, What we plan side by side (one
//      overview, Josh 11-04), each column's points arriving one by one.
//   4. PORTFOLIOS. One line and the button, the moment that sends people on.
//   5. CONTACT. The closing sentence, as the page runs out.
//
// A visitor who asks for reduced motion, or a browser without the script,
// gets every part shown at once (the snap stays: it is not motion).
//
// The carousel's guest list is the wall's (hidden works stay off, as on
// /community): each member's best picture, the best members first, twelve at
// most.
const WALL_MAX = 12;
const picks = (await fetchMemberViews())
  .flatMap((m) => {
    const work = m.works.filter((w) => !w.hidden).sort((a, b) => b.score - a.score)[0];
    if (!work) return [];
    // Under the name: the work's project, or its own title when it is in
    // none (the derived "Works" project is a shelf, not a project name).
    const project = m.projects?.find((p) => p.id === work.projectId && p.id !== looseWorksProjectId(m.id));
    const line = (project && projectTitle(project, lang)) || workCaption(work, lang);
    return [{ name: m.displayName, href: memberHref(lang, m.slug), project: line, work }];
  })
  .sort((a, b) => b.work.score - a.work.score)
  .slice(0, WALL_MAX);
const wall = await Promise.all(
  picks.map(async ({ name, href, project, work }) => ({
    name,
    href,
    project,
    width: work.width,
    height: work.height,
    alt: workCaption(work, lang) || name,
    rendered: await getImage({
      src: work.url,
      width: work.width,
      height: work.height,
      widths: [600, 1200],
      format: "webp",
    }),
  }))
);
---

<div class="info-page story" data-story-root>
  {/* Story on before the first paint, so the parts never show and then
      hide again while the module loads (they did, then replayed). */}
  <script is:inline>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.querySelector("[data-story-root]")?.setAttribute("data-story-on", "");
  </script>
  <!-- 1. HERO -->
  <section class="story-ch story-ch--hero" data-story-ch>
    <div class="story-frame">
      <div class="info-hero">
        <h1 class="info-hero__title">{t("info.hero.title")}</h1>
        {/* The belief at the big size, the reasons under it at reading size. */}
        <div class="info-hero__text">
          <p class="info-hero__sub" data-in style="--d: 0.45s">{t("info.hero.lead")}</p>
          <p class="info-hero__body" data-in style="--d: 1s">{t("info.hero.body")}</p>
        </div>
      </div>
      <span class="story-cue" aria-hidden="true">{t("info.story.cue")}<span class="story-cue__line"></span></span>
    </div>
  </section>

  <!-- 2. WORKS -->
  {
    wall.length > 0 && (
      <section class="story-ch story-ch--works" data-story-ch>
        <div class="story-frame story-frame--center">
          <div class="info-wall" aria-roledescription="carousel" aria-label={t("info.wall.heading")} data-info-wall>
            <div class="info-wall__stage">
              {wall.length > 1 && (
                <button type="button" class="info-wall__arrow info-wall__arrow--prev" data-wall-prev aria-label={t("info.wall.prev")}>
                  <span aria-hidden="true" />
                </button>
              )}
              <ul class="info-wall__slides" data-wall-track>
                {wall.map((tile, i) => (
                  <li class="info-wall__slide" data-wall-slide aria-hidden={i === 0 ? undefined : "true"} data-current={i === 0 ? "" : undefined}>
                    <a href={tile.href} class="info-wall__tile" tabindex={i === 0 ? undefined : -1} draggable="false">
                      <img
                        src={tile.rendered.src}
                        srcset={tile.rendered.srcSet.attribute}
                        sizes="(max-width: 767px) 92vw, 600px"
                        width={tile.width}
                        height={tile.height}
                        style={`--ar: ${tile.width / tile.height}`}
                        alt={tile.alt}
                        loading={i < 2 ? "eager" : "lazy"}
                        decoding="async"
                        draggable="false"
                      />
                      <span class="info-wall__name">{tile.name}</span>
                      {tile.project && <span class="info-wall__project t-caption">{tile.project}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {wall.length > 1 && (
                <button type="button" class="info-wall__arrow info-wall__arrow--next" data-wall-next aria-label={t("info.wall.next")}>
                  <span aria-hidden="true" />
                </button>
              )}
            </div>
            {wall.length > 1 && (
              <p class="info-wall__hint" aria-hidden="true">
                <span class="info-wall__nudge" />
                <span class="info-wall__hint-touch">{t("info.wall.hint.swipe")}</span>
                <span class="info-wall__hint-drag">{t("info.wall.hint.drag")}</span>
              </p>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- 3. ABOUT: mission, how, plan in one overview, point by point. -->
  <section class="story-ch story-ch--about" data-story-ch>
    <div class="story-frame">
      <div class="info-about">
      <div class="info-col">
        <h2 class="info-heading" data-in>{t("info.h2.mission")}</h2>
        <ul class="info-list">
          <li data-in style="--d: 0.15s">{t("info.mission.1")}</li>
          <li data-in style="--d: 0.27s">{t("info.mission.2")}</li>
          <li data-in style="--d: 0.39s">{t("info.mission.3")}</li>
        </ul>
      </div>
      <div class="info-col">
        <h2 class="info-heading" data-in style="--d: 0.25s">{t("info.h2.how")}</h2>
        <ul class="info-list">
          <li data-in style="--d: 0.40s">{t("info.how.1")}</li>
          <li data-in style="--d: 0.52s">{t("info.how.2")}</li>
          <li data-in style="--d: 0.64s">{t("info.how.3")}</li>
        </ul>
      </div>
      <div class="info-col">
        <h2 class="info-heading" data-in style="--d: 0.50s">{t("info.h2.plan")}</h2>
        <ul class="info-list">
          <li data-in style="--d: 0.65s">{t("info.plan.1")}</li>
          <li data-in style="--d: 0.77s">{t("info.plan.2")}</li>
          <li data-in style="--d: 0.89s">{t("info.plan.3")}</li>
        </ul>
      </div>
      </div>
    </div>
  </section>

  <!-- 4. PORTFOLIOS -->
  <section class="story-ch story-ch--portfolios" data-story-ch>
    <div class="story-frame story-frame--center">
      <p class="info-people" data-in>{t("info.story.people")}</p>
      <div class="info-cta__row" data-in style="--d: 0.25s">
        <a href={portfoliosHref} class="btn-solid info-cta__btn">{t("info.cta.portfolios")}<span aria-hidden="true">→</span></a>
        <a href={lang === "de" ? "/de/signup" : "/signup"} class="btn-outline" id="info-signup-cta" style="display:none;"
          >{t("signup.cta.info")}</a
        >
      </div>
    </div>
  </section>

  <!-- 5. CONTACT: the page's last line, a short last stop. -->
  <section class="story-ch story-ch--contact" data-story-ch>
    <p class="info-contact" data-in>
      {t("info.contact.ask")}{" "}
      <!--email_off--><a href="mailto:info@vscn.ch">info@vscn.ch</a><!--/email_off-->
    </p>
  </section>
</div>

<style>
  @keyframes info-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .info-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    /* A chapter's height: the scroller's height under the header row. A
       desktop scrolls .page-wrap, as tall as the shell; a phone scrolls the
       document, so the small viewport height keeps a chapter from jumping
       as the toolbars come and go. */
    --story-vh: calc(var(--shell-h, 100dvh) - var(--header-h));

    @media (--bp-mobile) {
      --story-vh: calc(100svh - var(--header-h));
    }
  }

  /* ── CHAPTERS: ONE SCREEN EACH, SNAPPED ─────────────────────────────── */
  .story-ch {
    position: relative;
  }
  .story-frame {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    min-height: var(--story-vh);
    box-sizing: border-box;
    padding: 2rem 0;
  }
  .story-frame--center {
    align-items: center;
    text-align: center;
  }

  /* A part waiting for its chapter: hidden until the chapter is reached
     (data-seen, set once by the script) AND the page is shown (page-loaded:
     on a first visit the loader covers the page, and the hero played out
     unseen under it), then rising in after its --d. */
  .story[data-story-on] [data-in] {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease-out var(--d, 0s),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s);
  }
  :global(body.page-loaded) .story[data-story-on] [data-seen] [data-in] {
    opacity: 1;
    transform: none;
  }

  /* ── 1. HERO ─────────────────────────────────────────────────────────── */
  .info-hero {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;

    @media (--bp-desktop) {
      gap: 3.25rem;
    }
  }
  .info-hero__title {
    margin: 0;
    color: var(--color-dark);
    font-family: "Archivo", sans-serif;
    animation: info-rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-play-state: paused;
  }
  :global(.page-loaded) .info-hero__title {
    animation-play-state: running;
  }
  .info-hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 58rem;
  }
  .info-hero__sub {
    margin: 0;
    color: var(--color-dark);
  }
  /* The reasons read as the page's body copy (.info-text below). */
  .info-hero__body,
  .info-text {
    max-width: 46rem;
    margin: 0;
    font-size: clamp(var(--fs-100), 1.2vw, 1.08rem);
    color: #333;
    line-height: 1.85;
  }
  /* The cue at the foot of the first screen: a word and a line that grows
     down. Only with the story on. */
  .story-cue {
    display: none;
  }
  .story[data-story-on] .story-cue {
    transition: opacity 0.4s ease;
    position: absolute;
    bottom: 2rem;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    translate: -50% 0;
    color: var(--color-muted);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Gone once the next chapter is reached, so its foot never shows under
     the header there. */
  .story[data-story-on]:has(.story-ch--works[data-seen], .story-ch--about[data-seen]) .story-cue {
    opacity: 0;
  }
  .story-cue__line {
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    transform-origin: top;
    animation: story-cue 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes story-cue {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* ── 3. ABOUT: THREE COLUMNS, ONE OVERVIEW ───────────────────────────── */
  .info-about {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem;

    @media (--bp-mobile) {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .info-heading {
    margin: 0;
    font-family: "Archivo", sans-serif;
    color: var(--color-dark);
  }
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.25rem;
  }
  /* A step up from body copy (Josh 11-04: "a bit bigger"). */
  .info-list li {
    font-size: clamp(1.25rem, 1.45vw, 1.45rem);
    color: #333;
    line-height: 1.45;
  }
  /* Point by point: each line slides in from the left as well as rising. */
  .story[data-story-on] .info-list li {
    transform: translateX(-24px);
  }

  /* ── 6. PORTFOLIOS ───────────────────────────────────────────────────── */
  .info-people {
    max-width: 40rem;
    margin: 0;
    color: var(--color-dark);
  }
  .info-cta__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
  }
  .info-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .info-cta__btn span {
    transition: translate 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .info-cta__btn:hover span {
    translate: 4px 0;
  }
  .story[data-story-on] .info-cta__row {
    transform: scale(0.92);
  }

  /* ── 7. CONTACT ──────────────────────────────────────────────────────── */
  .story-ch--contact {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(var(--story-vh) * 0.4);
    padding: 2rem 0 4rem;
    text-align: center;
  }
  .info-contact {
    margin: 0;
    color: var(--color-muted);
  }
  .info-contact a {
    color: var(--color-dark);
    border-bottom: 0;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .info-contact a:hover,
  .info-contact a:focus-visible {
    opacity: 0.5;
  }

  /* ── 2. WORKS: ONE PICTURE AT A TIME ────────────────────────────────
     A row the visitor scrolls sideways, one slide its full width, snapped
     to the middle. The picture keeps its own shape at one height (the
     screen's, less the words under it), the artist and the project under
     it. No fades: the picture is simply there (Josh 11-04). */
  .info-wall {
    --pic-h: min(calc(var(--story-vh) - 15rem), 640px);
    width: 100%;
  }
  .info-wall__stage {
    position: relative;
    width: min(100%, 760px);
    margin: 0 auto;
  }
  .info-wall__slides {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .info-wall__slides::-webkit-scrollbar {
    display: none;
  }
  .info-wall__slides[data-dragging] {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  /* Pictures differ in shape, so each slide stands on its bottom edge: the
     words under it keep their place as the row moves. */
  .info-wall__slide {
    display: flex;
    flex: 0 0 100%;
    justify-content: center;
    align-items: flex-end;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .info-wall__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    color: var(--color-dark);
    text-decoration: none;
    -webkit-user-drag: none;
  }
  .info-wall__tile img {
    display: block;
    /* As wide as its shape allows at --pic-h, never past the slide; the
       height follows from the width attributes' ratio. */
    width: min(100%, calc(var(--pic-h) * var(--ar, 0.8)));
    height: auto;
    border-radius: var(--radius-sm);
    transition: opacity 0.2s ease;
    user-select: none;
  }
  .info-wall__slide[data-current] .info-wall__tile:hover img,
  .info-wall__slide[data-current] .info-wall__tile:focus-visible img {
    opacity: 0.85;
  }
  .info-wall__name {
    margin-top: 14px;
    color: var(--color-dark);
  }
  .info-wall__project {
    margin-top: 4px;
    color: var(--color-muted);
  }
  /* The card's arrows (communityCard.css): a stroked chevron beside each
     edge of the stage, muted until pointed at. */
  .info-wall__arrow {
    position: absolute;
    top: calc(var(--pic-h) / 2);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 4rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-dark);
    opacity: 0.35;
    cursor: pointer;
    translate: 0 -50%;
    transition: opacity 150ms ease;
  }
  .info-wall__arrow:hover,
  .info-wall__arrow:focus-visible {
    opacity: 1;
  }
  .info-wall__arrow--prev {
    right: 100%;
  }
  .info-wall__arrow--next {
    left: 100%;
  }
  .info-wall__arrow span {
    display: block;
    width: var(--chevron-size);
    height: var(--chevron-size);
    border-top: var(--chevron-stroke) solid currentColor;
    border-right: var(--chevron-stroke) solid currentColor;
  }
  .info-wall__arrow--prev span {
    transform: translate(0.05rem, 0) rotate(-135deg);
  }
  .info-wall__arrow--next span {
    transform: translate(-0.05rem, 0) rotate(45deg);
  }

  /* THE HINT under the picture: a dot sliding from side to side and the
     word for the gesture (swipe on a touch screen, drag with a mouse). It
     goes once the visitor has moved the row. */
  .info-wall__hint {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.7rem;
    margin: 1.4rem 0 0;
    color: var(--color-muted);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.5s ease;
  }
  .info-wall[data-moved] .info-wall__hint {
    opacity: 0;
  }
  .info-wall__nudge {
    position: relative;
    width: 2.25rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .info-wall__nudge::after {
    content: "";
    position: absolute;
    top: -3px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    animation: info-nudge 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
  }
  @keyframes info-nudge {
    to {
      translate: calc(2.25rem - 7px) 0;
    }
  }
  .info-wall__hint-drag {
    display: none;
  }
  @media (pointer: fine) {
    .info-wall__hint-touch {
      display: none;
    }
    .info-wall__hint-drag {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-hero__title,
    .story-cue__line,
    .info-wall__nudge::after {
      animation: none;
    }
    .info-wall__tile img {
      transition: none;
    }
  }

  /* PHONE: the row runs edge to edge, the picture at the screen's width
     less the gutters, and the arrows give way to the finger. */
  @media (--bp-mobile) {
    .info-wall {
      --pic-h: min(calc(var(--story-vh) - 11rem), 125vw);
    }
    .info-wall__stage {
      width: 100vw;
      margin: 0 0 0 calc(50% - 50vw);
    }
    .info-wall__slide {
      box-sizing: border-box;
      padding: 0 16px;
    }
    .info-wall__arrow {
      display: none;
    }
  }
</style>

<script>
  import { watchAuth } from "../lib/auth.ts";
  import { pageLifetime } from "../lib/pageLifecycle.ts";

  document.addEventListener("astro:page-load", () => {
    const cta = document.getElementById("info-signup-cta");
    if (!cta) return;

    // One observer per visit, dropped on the way out (see pageLifecycle.ts).
    watchAuth(pageLifetime(), (user) => {
      cta.style.display = user ? "none" : "flex";
    });
  });

  // ── THE CAROUSEL ──────────────────────────────────────────────────────
  // A native sideways scroll does the work (touch, trackpad, shift-wheel);
  // the script marks the picture in the middle, lets a mouse drag the row,
  // and pages it from the chevrons, round from the last back to the first.
  function carousel(wall: HTMLElement, track: HTMLElement, slides: HTMLElement[], signal: AbortSignal) {
    const n = slides.length;
    let at = -1;
    const nearest = () => Math.min(n - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
    const mark = () => {
      const k = nearest();
      if (k === at) return;
      at = k;
      slides.forEach((slide, i) => {
        const on = i === k;
        slide.toggleAttribute("data-current", on);
        const link = slide.querySelector("a");
        if (on) {
          slide.removeAttribute("aria-hidden");
          link?.removeAttribute("tabindex");
        } else {
          slide.setAttribute("aria-hidden", "true");
          link?.setAttribute("tabindex", "-1");
        }
      });
    };
    const go = (i: number) => {
      wall.setAttribute("data-moved", "");
      track.scrollTo({ left: (((i % n) + n) % n) * track.clientWidth, behavior: "smooth" });
    };
    let frame = 0;
    track.addEventListener(
      "scroll",
      () => {
        if (!frame)
          frame = requestAnimationFrame(() => {
            frame = 0;
            mark();
          });
      },
      { passive: true, signal }
    );
    // Any hand on the row retires the hint.
    for (const type of ["touchstart", "wheel", "pointerdown"]) {
      track.addEventListener(type, () => wall.setAttribute("data-moved", ""), { passive: true, signal });
    }
    wall.querySelector("[data-wall-prev]")?.addEventListener("click", () => go(at - 1), { signal });
    wall.querySelector("[data-wall-next]")?.addEventListener("click", () => go(at + 1), { signal });

    // A mouse drags the row; a drag of more than a few pixels is not a
    // click, and lands on the next picture in its direction.
    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    let moved = false;
    track.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        dragging = true;
        moved = false;
        startX = e.clientX;
        startLeft = track.scrollLeft;
      },
      { signal }
    );
    window.addEventListener(
      "pointermove",
      (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (!moved && Math.abs(dx) > 5) {
          moved = true;
          track.setAttribute("data-dragging", "");
        }
        if (moved) track.scrollLeft = startLeft - dx;
      },
      { signal }
    );
    const drop = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (!moved) return;
      track.removeAttribute("data-dragging");
      const dx = e.clientX - startX;
      const from = Math.round(startLeft / track.clientWidth);
      const to = Math.abs(dx) > track.clientWidth * 0.12 ? from - Math.sign(dx) : from;
      track.scrollTo({ left: Math.min(n - 1, Math.max(0, to)) * track.clientWidth, behavior: "smooth" });
    };
    window.addEventListener("pointerup", drop, { signal });
    window.addEventListener("pointercancel", drop, { signal });
    // The click that ends a drag does not open the member.
    track.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
        }
      },
      { capture: true, signal }
    );
    window.addEventListener(
      "resize",
      () => track.scrollTo({ left: Math.max(0, at) * track.clientWidth, behavior: "instant" as ScrollBehavior }),
      { passive: true, signal }
    );
    signal.addEventListener("abort", () => cancelAnimationFrame(frame), { once: true });
    mark();
  }

  // ── THE STORY ─────────────────────────────────────────────────────────
  // A chapter plays its entrance once, the first time a good part of it is
  // on screen. The observer's root is the viewport, which clips .page-wrap
  // on a desktop and is the scroller itself on a phone.
  function story(root: HTMLElement, signal: AbortSignal) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute("data-seen", "");
          seen.unobserve(entry.target);
        }
      },
      { threshold: 0.35 }
    );
    root.querySelectorAll("[data-story-ch]").forEach((ch) => seen.observe(ch));
    signal.addEventListener("abort", () => seen.disconnect(), { once: true });
  }

  // ── THE SETTLE ────────────────────────────────────────────────────────
  // When a scroll has ended (no scroll event for a moment, no finger on the
  // glass) the scroller glides to a chapter's top, under the header. Moved
  // less than a fifth of a screen from the chapter it last rested on: back
  // to it. More: on to the chapter nearest in that direction. A chapter
  // taller than the screen lets the visitor read through it, and the page's
  // end (contact, the phone footer) is left alone.
  const SETTLE_MS = 160;
  const NUDGE = 0.2;

  function settle(root: HTMLElement, signal: AbortSignal) {
    const phone = () => matchMedia(PHONE).matches;
    const scroller = () => (phone() ? document.scrollingElement : document.querySelector(".page-wrap")) as HTMLElement | null;
    const chapters = Array.from(root.querySelectorAll<HTMLElement>("[data-story-ch]")).filter((c) => !c.classList.contains("story-ch--contact"));
    let rest = 0;
    let gliding = false;
    let touching = false;
    let timer = 0;
    const header = () => parseFloat(getComputedStyle(root).getPropertyValue("--header-h")) || (phone() ? 48 : 56);
    // A chapter's resting scroll offset: its top just under the header.
    const tops = (s: HTMLElement) => {
      const base = s === document.scrollingElement ? 0 : s.getBoundingClientRect().top;
      return chapters.map((c) => Math.max(0, c.getBoundingClientRect().top - base + s.scrollTop - header()));
    };
    const run = () => {
      const s = scroller();
      if (!s || touching) return;
      const y = s.scrollTop;
      const at = tops(s);
      const vh = s.clientHeight;
      if (gliding) {
        gliding = false;
        rest = at.reduce((best, top, i) => (Math.abs(top - y) < Math.abs(at[best] - y) ? i : best), 0);
        return;
      }
      const max = s.scrollHeight - vh;
      const last = at.length - 1;
      if (y > at[last] + 4 || y >= max - 2) return;
      const inside = at.findIndex((top, i) => y >= top - 2 && y <= (i < last ? at[i + 1] : max) - vh + 2 && chapters[i].offsetHeight > vh * 1.05);
      if (inside >= 0) {
        rest = inside;
        return;
      }
      const delta = y - at[rest];
      let to = rest;
      if (Math.abs(delta) >= vh * NUDGE) {
        const ahead = at.map((top, i) => i).filter((i) => (delta > 0 ? at[i] > at[rest] : at[i] < at[rest]));
        if (ahead.length) to = ahead.reduce((best, i) => (Math.abs(at[i] - y) < Math.abs(at[best] - y) ? i : best), ahead[0]);
      }
      if (Math.abs(at[to] - y) < 2) {
        rest = to;
        return;
      }
      rest = to;
      gliding = true;
      s.scrollTo({ top: at[to], behavior: "smooth" });
    };
    const onScroll = () => {
      clearTimeout(timer);
      timer = window.setTimeout(run, SETTLE_MS);
    };
    document.querySelector(".page-wrap")?.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("touchstart", () => (touching = true), { passive: true, signal });
    const lift = () => {
      touching = false;
      onScroll();
    };
    window.addEventListener("touchend", lift, { passive: true, signal });
    window.addEventListener("touchcancel", lift, { passive: true, signal });
    signal.addEventListener("abort", () => clearTimeout(timer), { once: true });
  }

  // The site's phone breakpoint, spelled out (custom-media.css, --bp-mobile).
  const PHONE = "(width <= 767px), (pointer: coarse) and (height <= 500px)";

  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-story-root]");
    if (!root) return;
    const signal = pageLifetime();

    const wall = root.querySelector<HTMLElement>("[data-info-wall]");
    const track = wall?.querySelector<HTMLElement>("[data-wall-track]");
    const slides = wall ? Array.from(wall.querySelectorAll<HTMLElement>("[data-wall-slide]")) : [];
    if (wall && track && slides.length > 1) carousel(wall, track, slides, signal);

    // The settle is not motion the visitor did not ask for: it only ends
    // their own scroll, so it runs with reduced motion too.
    settle(root, signal);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    // Normally already on (the inline script above the chapters).
    root.setAttribute("data-story-on", "");
    story(root, signal);
  });
</script>
