---
import { getImage } from "astro:assets";
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";
import { fetchMemberViews } from "../lib/membersBuild.ts";
import { workCaption } from "../lib/links.ts";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const portfoliosHref = lang === "de" ? "/de/community" : "/community";

// INFO LEADS INTO THE PORTFOLIOS (2026-10-31, Josh: "update that page so
// people naturally flow into opening the portfolio page"). The way in is
// said three times: a button under the opening lines, a strip of the
// network's own pictures that all open the Portfolios, and the button again
// once the reading is done. The strip is the wall's guest list (hidden works
// stay off, as on /community), best first, one picture a member before any
// member gets a second, six at most.
const WALL_MAX = 6;
const ranked = (await fetchMemberViews())
  .map((m) => ({
    name: m.displayName,
    works: m.works.filter((w) => !w.hidden).sort((a, b) => b.score - a.score),
  }))
  .filter((m) => m.works.length > 0)
  .sort((a, b) => b.works[0].score - a.works[0].score);
const picks: { name: string; work: (typeof ranked)[number]["works"][number] }[] = [];
for (let round = 0; picks.length < WALL_MAX && ranked.some((m) => m.works[round]); round++) {
  for (const m of ranked) {
    if (picks.length >= WALL_MAX) break;
    if (m.works[round]) picks.push({ name: m.name, work: m.works[round] });
  }
}
const wall = await Promise.all(
  picks.map(async ({ name, work }) => ({
    name,
    alt: workCaption(work, lang) || name,
    rendered: await getImage({
      src: work.url,
      width: work.width,
      height: work.height,
      widths: [400, 800],
      format: "webp",
    }),
  }))
);
---

<div class="info-page">
  <section class="info-section">
    <p>{t("info.intro")}</p>
    <p>{t("info.p2")}</p>
    <div class="info-cta">
      <a href={portfoliosHref} class="btn-solid info-cta__btn">{t("info.cta.portfolios")}<span aria-hidden="true">→</span></a>
    </div>
  </section>

  {
    wall.length > 0 && (
      <section class="info-section info-wall" aria-labelledby="info-wall-heading">
        <h2 class="info-heading" id="info-wall-heading">{t("info.wall.heading")}</h2>
        <ul class="info-wall__grid">
          {wall.map((tile) => (
            <li>
              <a href={portfoliosHref} class="info-wall__tile">
                <img
                  src={tile.rendered.src}
                  srcset={tile.rendered.srcSet.attribute}
                  sizes="(max-width: 767px) 50vw, 300px"
                  alt={tile.alt}
                  loading="lazy"
                  decoding="async"
                />
                <span class="t-meta info-wall__name">{tile.name}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href={portfoliosHref} class="profile-link info-wall__all">{t("info.wall.all")} →</a>
      </section>
    )
  }

  <section class="info-section">
    <h2 class="info-heading">{t("info.h2.building")}</h2>
    <ul class="info-list">
      <li>{t("info.li.1")}</li>
      <li>{t("info.li.2")}</li>
      <li>{t("info.li.3")}</li>
      <li>{t("info.li.4")}</li>
    </ul>
  </section>

  <section class="info-section">
    <h2 class="info-heading">{t("info.h2.scientists")}</h2>
    <p>{t("info.p.scientists")}</p>
    <ul class="info-list">
      <li>{t("info.li.sci.1")}</li>
      <li>{t("info.li.sci.2")}</li>
      <li>{t("info.li.sci.3")}</li>
    </ul>
  </section>

  <section class="info-section">
    <h2 class="info-heading">{t("info.h2.started")}</h2>
    <p class="info-contact">
      {t("info.p4")}
      <!--email_off--><a href="mailto:info@vscn.ch">info@vscn.ch</a><!--/email_off-->
    </p>
  </section>

  <section class="info-cta info-cta--end">
    <a href={portfoliosHref} class="btn-solid info-cta__btn">{t("info.cta.portfolios")}<span aria-hidden="true">→</span></a>
    <a href={lang === "de" ? "/de/signup" : "/signup"} class="btn-outline" id="info-signup-cta" style="display:none;"
      >{t("signup.cta.info")}</a
    >
  </section>
</div>

<style>
  .info-page {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
    padding-bottom: 8rem;
    margin: 0 auto;

    @media (--bp-desktop) {
      padding-top: 4rem;
    }
  }

  .info-section {
    display: flex;
    flex-direction: column;
    padding-bottom: 1rem;
  }

  .info-heading {
    font-family: "Archivo", sans-serif;
    color: var(--color-dark);
  }

  .info-section p {
    font-size: clamp(var(--fs-100), 1.2vw, 1.08rem);
    color: #333;
    line-height: 1.85;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.25rem;
  }

  .info-list li {
    font-size: clamp(var(--fs-100), 1.2vw, 1.08rem);
    color: #333;
    line-height: 1.6;
  }

  .info-contact {
    display: block;
  }

  .info-contact a {
    color: var(--color-dark);
    border-bottom: 0;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .info-contact a:hover,
  .info-contact a:focus-visible {
    opacity: 0.5;
  }

  .info-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 1.5rem;
  }
  .info-cta--end {
    padding-top: 2rem;
  }
  .info-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .info-cta__btn span {
    transition: translate 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .info-cta__btn:hover span {
    translate: 4px 0;
  }

  .info-wall__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;

    @media (--bp-mobile) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
  .info-wall__tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--color-dark);
    text-decoration: none;
  }
  .info-wall__tile img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--color-border);
    transition: opacity 0.2s ease;
  }
  .info-wall__tile:hover img,
  .info-wall__tile:focus-visible img {
    opacity: 0.85;
  }
  .info-wall__name {
    color: var(--color-muted);
  }
  .info-wall__all {
    align-self: flex-start;
    margin-top: 1rem;
    color: var(--color-dark);
    text-decoration: none;
  }
</style>

<script>
  import { watchAuth } from "../lib/auth.ts";
  import { pageLifetime } from "../lib/pageLifecycle.ts";

  document.addEventListener("astro:page-load", () => {
    const cta = document.getElementById("info-signup-cta");
    if (!cta) return;

    // One observer per visit, dropped on the way out (see pageLifecycle.ts).
    watchAuth(pageLifetime(), (user) => {
      cta.style.display = user ? "none" : "flex";
    });
  });
</script>
