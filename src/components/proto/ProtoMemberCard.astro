---
import type { ProtoCardMember } from "../../lib/proto-data.ts";
import ProtoDetailPanel from "./ProtoDetailPanel.astro";

interface Props {
  member: ProtoCardMember;
  index?: number;
}

const { member } = Astro.props;

const frame = member.images[0];
const slots = member.images.length;

// Clicking the member opens their profile page. Only the real dataset has
// pages generated for it (see src/pages/proto/profile/[id].astro); mock
// members would 404, and no live page renders mocks any more.
const profileHref = `/proto/profile/${member.id}`;

// How many tags the vertical rail can carry. Real profiles hold up to seven,
// and their tags are far longer than the mock's ("Scientific Illustration" vs
// "molecular"), so the rail has to be cut somewhere; three is the shape the
// layout was designed around. Cutting here rather than in the data is what lets
// the disclosure panel still show the full set, so no tag is actually lost.
//
// NOTE: this does not fix the rail clipping. The rail is `max-height: 100%;
// overflow: hidden` against a frame whose height comes from the image's aspect
// ratio, so on landscape artwork even three real tags overrun the frame and get
// clipped mid-glyph. That is a live design decision, not something this slice
// settles.
---

<article class="pcard" data-slots={slots}>
  <a class="pcard__name" href={profileHref} transition:name={`pname-${member.id}`}>{member.name}</a>

  <div class="pcard__body">
    <div
      class="pcard__frame"
      style={`aspect-ratio:${frame.width} / ${frame.height}`}
      transition:name={`pimg-${member.id}`}
      data-carousel
    >
      {
        member.images.map((img, i) => (
          <img
            class="pcard__img"
            class:list={{ "pcard__img--active": i === 0 }}
            style={`--i:${i}`}
            src={img.src}
            width={img.width}
            height={img.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ))
      }
      {/* Whole-artwork click target. A sibling of the arrows rather than a
          wrapper, so no interactive element nests inside another; the arrows
          sit above it on z-index and keep working. */}
      <a class="pcard__frame-link" href={profileHref} aria-label={`View profile: ${member.name}`}></a>
      {slots > 1 && (
        <>
          <button class="pcard__arrow pcard__arrow--prev" type="button" data-carousel-prev aria-label="Previous image">
            <span aria-hidden="true">&#8592;</span>
          </button>
          <button class="pcard__arrow pcard__arrow--next" type="button" data-carousel-next aria-label="Next image">
            <span aria-hidden="true">&#8594;</span>
          </button>
        </>
      )}
    </div>

  </div>

  <div class="pcard__caption">
    <div class="pcard__caption-row">
      <span class="pcard__role">{member.role}</span>
      <ProtoDetailPanel member={member} />
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    /* Pivot for the GSAP scale in ProtoGrid. Declared here so the effect is
       identical whoever drives the transform. Anchored at the top edge, not
       centre: the ScrollTrigger itself is keyed to the card's top ("top
       bottom" / "top 38%"), and a centre origin recomputes with every height
       change — opening the profile disclosure grows the card and, at any
       scale short of 1, visibly shifts its top on screen. A top origin keeps
       that edge fixed regardless of how tall the card becomes. */
    transform-origin: 50% 0%;
  }

  /* ── Name ─────────────────────────────────────────────── */
  .pcard__name {
    display: block;
    margin: 0;
    font-family: "Archivo", sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-dark);
    text-decoration: none;
  }
  .pcard__name:hover,
  .pcard__name:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  /* ── Image + tag rail ─────────────────────────────────── */
  .pcard__body {
    position: relative;
    display: flex;
    align-items: flex-start;
    /* The rail strip. A vertical tag box is line-height (0.62rem) plus 3px
       padding and 1px border per side wide; reserve that plus the 1.1rem
       gutter, and pin the rail into the strip absolutely. The frame is then the
       only in-flow child, so the IMAGE alone sets the body height — a long
       rail can no longer push the caption away from the image. */
    padding-inline-end: 0;
  }

  .pcard__frame {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    border: 1.5px solid var(--color-border);
    /* Square corners throughout the card — no --radius-* token here. */
    border-radius: 0;
    background: var(--color-bg);
  }

  .pcard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .pcard__img--active {
    opacity: 1;
  }

  .pcard__frame-link {
    position: absolute;
    inset: 0;
  }

  .pcard__arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-dark);
    opacity: 0;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 180ms ease;
  }
  .pcard__frame:hover .pcard__arrow,
  .pcard__arrow:focus-visible {
    opacity: 1;
  }
  .pcard__arrow:hover,
  .pcard__arrow:focus-visible {
    color: var(--color-muted);
  }
  .pcard__arrow--prev {
    left: 0.75rem;
  }
  .pcard__arrow--next {
    right: 0.75rem;
  }

  /* ── Member caption — static, does not flip ───────────── */
  .pcard__caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.15rem;
    font-family: "Archivo", sans-serif;
  }

  .pcard__caption-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.35rem;
  }

  .pcard__caption-row :global(.pdisc) {
    display: contents;
  }

  .pcard__caption-row :global(.pdisc__toggle) {
    grid-column: 2;
    grid-row: 1;
  }

  .pcard__caption-row :global(.pdisc__body) {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .pcard__role {
    min-width: 0;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
  }

  /* Availability marker. A dot plus a word rather than a coloured pill: the
     page has no accent colour, and a bare dot would carry no meaning for anyone
     who cannot see it. */
  .pcard__open {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-inline-start: 0.45rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    vertical-align: baseline;
  }
  .pcard__open::before {
    content: "";
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    /* The only round thing on the card, and deliberately so — it reads as a
       status light rather than as another tag box. */
    border-radius: 50%;
  }

  .pcard__desc {
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--color-muted);
    /* Two lines then ellipsis, so varying description lengths cannot make the
       grid rhythm ragged. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Each slot is visible for 1/N of the cycle, then fades out over the last
     40% of its own window. Slot i is offset by -cycle/N * i, which lines its
     fade-out up exactly with slot i+1's fade-in — that overlap IS the
     crossfade, and it guarantees exactly one slot at full opacity at any
     instant. The stop percentages are the only thing that cannot be
     parameterised, hence one block per count.

     The fade is a large share of each window on purpose: the handover should
     read as a dissolve between two images, not as a swap.

     N=2 → window 50%, fade 20% (3.2s of the 16s cycle).
     N=3 → window 33.333%, fade 13.333% (2.13s). */
  /* ── Grow on approach to the top ──────────────────────── */
  /* Deliberately NOT here. The scale is driven by GSAP ScrollTrigger in
     ProtoGrid.astro, which needs the scroller and the per-column context.
     This component only declares the pivot, so the scale is predictable no
     matter what writes the transform. Cards render at full size with no JS —
     that is the correct mobile and no-JS state, not a broken one. */

  /* ── Mobile: tags below the image, not beside it ──────── */
  /* Two narrow columns have no width to spare for a vertical rail, so the tags
     become a horizontal row under the frame. `display: block` retires the
     rail strip entirely: with the frame and the list both in normal flow, the
     frame takes the full card width and the tags sit directly beneath it, so
     the --rail-w reservation must go too or it would leave phantom padding. */
  @media (--bp-mobile) {
    .pcard__body {
      display: block;
      padding-inline-end: 0;
    }

    .pcard__arrow {
      width: 3rem;
      height: 3rem;
      opacity: 1;
      color: var(--color-dark);
    }

    .pcard__arrow--prev {
      left: 0.5rem;
    }

    .pcard__arrow--next {
      right: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard__img {
      transition: none;
    }
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
      if (carousel.dataset.ready) return;
      carousel.dataset.ready = "true";
      const images = Array.from(carousel.querySelectorAll<HTMLImageElement>(".pcard__img"));
      let current = 0;

      const show = (next: number) => {
        current = (next + images.length) % images.length;
        images.forEach((image, index) => image.classList.toggle("pcard__img--active", index === current));
      };

      carousel.querySelector("[data-carousel-prev]")?.addEventListener("click", () => show(current - 1));
      carousel.querySelector("[data-carousel-next]")?.addEventListener("click", () => show(current + 1));
    });
  }

  document.addEventListener("astro:page-load", initCarousels);
  initCarousels();
</script>
