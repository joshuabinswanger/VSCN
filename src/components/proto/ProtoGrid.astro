---
import { getCardTier, type ProtoCardMember, type ProtoCardTier } from "../../lib/proto-data.ts";
import ProtoMemberCard from "./ProtoMemberCard.astro";
import ProtoTextCard from "./ProtoTextCard.astro";

interface Props {
  members: ProtoCardMember[];
  cols?: number;
}

const { members, cols = 3 } = Astro.props;

// Round-robin into fixed lanes. Lanes (rather than grid auto-flow) are what
// give the layout its masonry-like vertical packing: a short card does not
// leave a hole under it the way a row-aligned grid item would, and each lane
// can carry its own vertical offset and parallax while every card stays a
// single transformable box.
//
// Caveat: DOM order then runs down each lane, so visual reading order and DOM
// order diverge on desktop. Acceptable for a visual prototype; the real page
// wants either a masonry grid or an ordered single column. Noted in the plan's
// out-of-scope list.
const columns: ProtoCardMember[][] = Array.from({ length: cols }, () => []);
const orderedMembers = [...members].sort(
  (a, b) => Number(b.images.length > 0) - Number(a.images.length > 0),
);
orderedMembers.forEach((m, i) => columns[i % cols].push(m));

// The grid underneath is a fine 24-column base, and each lane SPANS an unequal
// number of those columns. That is what makes the lanes off-square without any
// hand-written fr soup, and it is why lane widths are now whole numbers that
// must sum to the base.
const LANE_SPANS: Record<number, number[]> = {
  1: [24],
  2: [13, 11],
  3: [9, 7, 8],
  4: [7, 5, 6, 6],
};
const spans = LANE_SPANS[cols] ?? Array.from({ length: cols }, () => 1);
// The base is derived, never assumed, so an off-table `cols` still tiles.
const base = spans.reduce((a, b) => a + b, 0);

// Lane head starts. Deliberately not a linear multiple, so the rhythm reads as
// irregular rather than mechanical.
const LANE_TOPS = ["0rem", "22rem", "10rem", "30rem"];

// Deterministic irregularity, expressed entirely in LAYOUT rather than in
// transforms. `cw` is the card's width as a fraction of its lane's card basis,
// `ax` is where it sits across the lane, `my` opens space above it.
//
// `cw` is a UNITLESS fraction rather than a percentage, and that is what lets
// --card-max cap the artwork without flattening the design. A plain
// `max-width` would clamp every card at or above the cap to exactly the cap —
// the 100%, 94% and 90% variants would all collapse into one width. Multiplying
// the fraction by an already-capped basis keeps the full spread of widths and
// only lowers the ceiling. See .pgrid__cell.
//
// `ax` is a fraction of the card's own SLACK, not of the lane: 0 puts the card
// flush against the lane's left edge, 1 flush against its right, 0.5 centres
// it. That is what gets cards onto the grid's outer edges — with a start margin
// expressed as a share of the lane, a capped card could never reach the right
// edge at all, and the cap's leftover slack read as a dead margin down the
// whole right side of the page. Several variants sit at 1 on purpose, so the
// last lane meets the content edge as often as the first lane does.
//
// It also turns the overlap invariant structural: margin + width resolves to
// ax * (lane - card) + card, which is <= lane for ANY ax in [0, 1] and any
// cw <= 1. There is no table arithmetic left to get wrong. `my` is real
// vertical space rather than a translate, so it can never close the gap to the
// card above. Nothing here needs clipping, nor mirroring at the grid's outer
// edges, nor a gutter to lean into.
//
// `cw` is no longer a free irregularity knob — it is bucketed by the member's
// tier (see getCardTier), so a filled-in profile visibly claims more of the
// lane than a bare one. Each tier keeps its own small set of (cw, ax, my)
// combinations so the composition variety survives within a size class.
const TIER_VARIANTS: Record<ProtoCardTier, { cw: number; ax: number; my: string }[]> = {
  large: [
    { cw: 1, ax: 0, my: "0rem" },
    { cw: 0.86, ax: 1, my: "3.5rem" },
    { cw: 0.92, ax: 0.35, my: "1rem" },
    { cw: 0.8, ax: 1, my: "5.5rem" },
    { cw: 1, ax: 1, my: "2rem" },
    { cw: 0.9, ax: 0.15, my: "0rem" },
    { cw: 0.82, ax: 0.62, my: "4rem" },
    { cw: 0.96, ax: 0.85, my: "1.5rem" },
  ],
  medium: [
    { cw: 0.66, ax: 0.2, my: "2rem" },
    { cw: 0.6, ax: 1, my: "0.5rem" },
    { cw: 0.7, ax: 0.55, my: "3rem" },
  ],
  small: [
    { cw: 0.48, ax: 0.5, my: "1.5rem" },
    { cw: 0.44, ax: 1, my: "0rem" },
    { cw: 0.52, ax: 0, my: "2.5rem" },
  ],
};
---

<div class="pgrid" style={`--base:${base}`}>
  {
    columns.map((col, ci) => (
      <div class="pgrid__col" style={`--span:${spans[ci]};--lane-top:${LANE_TOPS[ci % LANE_TOPS.length]}`}>
        {
          col.map((m, ri) => {
            const tier = getCardTier(m);
            const variants = TIER_VARIANTS[tier];
            const v = variants[(ci * 3 + ri * 5) % variants.length];
            return (
              <div
                class="pgrid__cell"
                data-tier={tier}
                style={`--cw:${v.cw};--ax:${v.ax};--my:${v.my}`}
              >
                {/* ri * cols + ci is unique across the whole grid for any
                    cols, so no two cards ever share a crossfade phase — and,
                    for the text card, no two neighbours share a box ratio. */}
                {
                  tier === "large" ? (
                    <ProtoMemberCard member={m} index={ri * cols + ci} />
                  ) : (
                    /* No artwork to show. The typographic variant holds the
                       same slot rather than dropping the member from the
                       directory — see ProtoTextCard. */
                    <ProtoTextCard member={m} index={ri * cols + ci} />
                  )
                }
              </div>
            );
          })
        }
      </div>
    ))
  }
</div>

<style>
  .pgrid {
    /* Horizontal gutter between lanes, and the vertical rhythm inside one. */
    --pgap-x: 4.5rem;
    --pgap-y: 20rem;
    /* Ceiling on the artwork itself, independent of how wide the shell goes.
       The artwork carries dense scientific detail, so the cap sits high enough
       to read it — whitespace comes from the gaps, not from shrinking cards. */
    --card-max: 30rem;
    display: grid;
    /* The base grid carries NO column-gap. With 24 tracks a 4.5rem gap would
       spend more of the page on gutters than on cards. The gutter is a lane's
       own trailing padding instead, which also keeps every card percentage
       resolving against a box that already excludes it. */
    grid-template-columns: repeat(var(--base), minmax(0, 1fr));
    column-gap: 0;
    align-items: start;
    padding-block: 7rem 18rem;
  }

  .pgrid__col {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    gap: var(--pgap-y);
    min-width: 0;
    box-sizing: border-box;
    padding-inline-end: var(--pgap-x);
    margin-top: var(--lane-top);
  }

  /* The last lane has nothing to its right to be separated from, so it keeps
     the whole track and the grid's right edge stays flush with the content. */
  .pgrid__col:last-child {
    padding-inline-end: 0;
  }

  .pgrid__cell {
    min-width: 0;
    /* The basis is the lane, or --card-max where the lane is wider than the
       artwork should ever be. The card is then a fraction OF that, so widening
       the shell past the cap buys whitespace rather than bigger images, and
       narrow lanes still scale down normally. */
    --cardw: calc(var(--cw) * min(100%, var(--card-max)));
    width: var(--cardw);
    /* Distribute the card's own slack rather than offsetting by a share of the
       lane: at --ax 1 the card lands flush on the lane's right edge whatever
       the cap did to its width, and it can never exceed the lane. Both
       percentages resolve against the lane's content box. */
    margin-inline-start: calc(var(--ax) * (100% - var(--cardw)));
    margin-top: var(--my);
  }

  /* Mobile: two offset columns. `display: contents` lifts every cell out of
     its lane into a single multicol flow, so all members appear in a 2-up
     arrangement with no member dropped and no DOM change. Cards remain single
     boxes, so the scroll animation is unaffected. */
  @media (--bp-mobile) {
    .pgrid {
      --pgap-x: 2.25rem;
      --pgap-y: 8.5rem;
      display: block;
      columns: 2;
      column-gap: var(--pgap-x);
      padding-block: 4rem 10rem;
    }
    .pgrid__col {
      display: contents;
    }
    .pgrid__cell {
      /* The multicol column is already narrower than --card-max, so both the
         cap and the width fraction are off here. */
      width: 100%;
      /* Irregularity off on mobile — two narrow columns have no room for it.
         The offset look comes for free from cards of differing height in the
         multicol flow, which is what the sketch's mobile half shows. */
      margin-inline-start: 0;
      margin-top: 0;
      break-inside: avoid;
      margin-bottom: var(--pgap-y);
    }
  }
</style>

<script>
  // Desktop-only scroll motion, two jobs:
  //   1. Cards scale up as they rise toward the top of the scrollport.
  //   2. Lanes drift at different rates — the parallax is what actually
  //      destroys the grid feel; static irregularity alone still reads as
  //      columns.
  //
  // Width is checked BEFORE the import, so mobile downloads no GSAP at all
  // (~44 KB gzip saved). gsap and ScrollTrigger are already dependencies.
  const DESKTOP = "(min-width: 768px)";
  const REDUCED = "(prefers-reduced-motion: reduce)";

  // Per-lane drift in px across the whole scroll. Mixed signs and unequal
  // magnitudes on purpose — matching speeds would just look like a slow page.
  // Drift is vertical only and cards never leave their lane horizontally, so
  // no amount of drift can make two cards overlap.
  const DRIFT = [-90, 60, -36, 75];

  // Loose type: gsap's global namespace types are not reliably in scope inside
  // a scoped Astro script, and revert() is all we need off it.
  let mm: { revert: () => void } | null = null;

  // Re-entry guard for the async gap. `mm` alone is not a mutex: it is read
  // before the dynamic import but only assigned after it, so two overlapping
  // build() calls (page-load + breakpoint change, or a swap completing while
  // the import is in flight) would both pass the `if (mm)` check and the
  // second would orphan the first context's ScrollTriggers. `building` closes
  // that window synchronously, and `epoch` — bumped by every teardown — lets a
  // build that was in flight when a teardown happened detect that its DOM is
  // stale and abandon itself instead of assigning a context over dead nodes.
  let building = false;
  let epoch = 0;

  async function build() {
    if (building || mm) return;
    if (!document.querySelector(".pgrid")) return;
    if (!window.matchMedia(DESKTOP).matches) return;
    if (window.matchMedia(REDUCED).matches) return;

    building = true;
    const startedIn = epoch;

    // Everything from the import onward can reject or throw — a hashed chunk
    // 404ing after a redeploy while ClientRouter keeps the session alive, a
    // flaky network, a plugin error. Without recovery, a rejection here would
    // leave `building` latched true with `mm` null, and every later build()
    // would bounce off the re-entry gate: a silently dead motion layer until
    // a full reload.
    try {
      const [{ default: gsap }, { ScrollTrigger }] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
      ]);

      // A teardown ran while the import was in flight: this build's DOM is
      // gone (or going), and teardown already reset `building` so a fresh
      // build for the new page can proceed — which may be mid-import right
      // now. Abandon without touching either flag, or we would clobber that
      // newer build.
      if (epoch !== startedIn) return;

      gsap.registerPlugin(ScrollTrigger);

      // The scroll container is .page-wrap, never the window — body is
      // overflow:hidden. Telling ScrollTrigger explicitly is the whole reason
      // this is more robust than a CSS view() timeline.
      const scroller = ".page-wrap";

      mm = gsap.matchMedia();
      // Tweens and ScrollTriggers created inside a matchMedia context are
      // reverted and killed automatically, so no manual cleanup is needed
      // here.
      mm.add(DESKTOP, () => {
        // 1. Grow on approach. Starts when the card's top enters at the
        //    bottom of the scrollport, completes when its top reaches 38%
        //    from the top, so cards are already full size in the upper region
        //    rather than still swelling as they leave. The small state sits a
        //    long way below full size on purpose — the travel IS the effect.
        //    scrub ties progress to scroll position instead of elapsed time.
        gsap.utils.toArray<HTMLElement>(".pcard, .ptcard").forEach((card) => {
          gsap.fromTo(
            card,
            { scale: 0.72, opacity: 0.5 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: { scroller, trigger: card, start: "top bottom", end: "top 38%", scrub: true },
            },
          );
        });

        // 2. Lane parallax. Drives .pgrid__col, while the per-card offsets are
        //    plain margins on .pgrid__cell — layout, not transform, so the two
        //    cannot fight over a property.
        gsap.utils.toArray<HTMLElement>(".pgrid__col").forEach((col, i) => {
          gsap.to(col, {
            y: DRIFT[i % DRIFT.length],
            ease: "none",
            scrollTrigger: { scroller, trigger: ".pgrid", start: "top bottom", end: "bottom top", scrub: true },
          });
        });
      });

      // Archivo is a self-hosted variable font; if it lands after first
      // paint, every measured trigger position is stale. Epoch-guarded: if a
      // teardown has run since this build, the context is reverted and must
      // not be refreshed — the owning build registers its own callback.
      document.fonts?.ready.then(() => {
        if (epoch === startedIn) ScrollTrigger.refresh();
      });

      building = false;
    } catch (err) {
      // Release the latch only if this build still owns it. After a teardown,
      // `building` belongs to whatever comes next — possibly a build already
      // mid-import — so a bare `finally { building = false }` would reopen
      // the clobber the epoch design exists to prevent.
      if (epoch === startedIn) building = false;
      // Swallow rather than re-throw: nothing awaits build() — it runs as an
      // event listener, so a re-throw could only surface as unhandled-
      // rejection noise. The page is fully usable without the motion layer;
      // log for diagnosability, and the next astro:page-load retries cleanly.
      console.error("[proto-grid] scroll motion layer failed to build:", err);
    }
  }

  function teardown() {
    // Bumping the epoch marks any in-flight build as stale; clearing
    // `building` here (rather than in the stale build) is what lets the next
    // page's build start immediately instead of waiting on the orphan.
    epoch++;
    mm?.revert();
    mm = null;
    building = false;
  }

  document.addEventListener("astro:page-load", build);
  document.addEventListener("astro:before-swap", teardown);

  // Crossing the breakpoint on resize starts or stops the whole layer.
  window.matchMedia(DESKTOP).addEventListener("change", () => {
    teardown();
    build();
  });
</script>
