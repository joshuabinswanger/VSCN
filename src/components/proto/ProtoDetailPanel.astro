---
import { hasDisclosableDetail, type ProtoCardMember } from "../../lib/proto-data.ts";

interface Props {
  member: ProtoCardMember;
}

const { member } = Astro.props;

// Native <details> on purpose. ClientRouter is active site-wide, so any script
// here would need an astro:page-load / astro:before-swap pair and would leak
// state across navigations if it got that wrong (see MemberCard.astro for the
// precedent). A disclosure element needs none of that, and comes with keyboard
// and screen-reader behaviour already correct.

/**
 * Real `portfolio` values are stored without a scheme ("quaint.ch",
 * "www.ikonaut.ch"), so they need one to be a usable href. Anything that
 * already has a scheme is left exactly as stored — including the one malformed
 * value in the data ("https://.instagram.com/…"), which should visibly fail
 * here rather than be silently repaired in the view layer.
 */
function href(raw: string): string {
  return /^https?:\/\//i.test(raw) ? raw : `https://${raw}`;
}

/**
 * `socialMedia` is free text, not a URL field: it holds bare handles
 * ("compostdiv4"), comma-joined pairs, and full URLs. Only linkify what
 * actually looks like a single link.
 */
function isLinkable(raw: string): boolean {
  return !raw.includes(",") && !raw.includes(" ") && /\./.test(raw) && !raw.startsWith("@");
}

/**
 * `socialMedia` is Instagram for every real profile so far, and the raw
 * value is a full URL (often with a tracking query string) that's noisy
 * next to the plain-text `portfolio` link. Label it, don't display it.
 */
function linkLabel(raw: string): string {
  return /(^|\.)instagram\.com/i.test(raw) ? "instagram" : raw;
}

const bio = member.bio?.trim() ?? "";
const portfolio = member.portfolio?.trim() ?? "";
const social = member.socialMedia?.trim() ?? "";
const tags = member.tags ?? [];

// Nothing to disclose — mock members, and real profiles that are name + role
// only. Rendering an empty toggle would promise content that isn't there.
const hasDetail = hasDisclosableDetail(member);
---

{
  hasDetail && (
    <details class="pdisc">
      <summary class="pdisc__toggle">
        <span class="pdisc__label">Profile</span>
      </summary>

      <div class="pdisc__body">
        {bio && <p class="pdisc__bio">{bio}</p>}

        {tags.length > 0 && (
          <div class="pdisc__row">
            <span class="pdisc__key">Tags</span>
            <ul class="pdisc__vals">
              {tags.map((t) => (
                <li class="pdisc__val">{t}</li>
              ))}
            </ul>
          </div>
        )}

        {(portfolio || social) && (
          <div class="pdisc__row">
            <span class="pdisc__key">Elsewhere</span>
            <ul class="pdisc__vals pdisc__vals--links">
              {portfolio && (
                <li>
                  <a class="pdisc__link" href={href(portfolio)} target="_blank" rel="noopener noreferrer">
                    {portfolio}
                  </a>
                </li>
              )}
              {social &&
                (isLinkable(social) ? (
                  <li>
                    <a class="pdisc__link" href={href(social)} target="_blank" rel="noopener noreferrer">
                      {linkLabel(social)}
                    </a>
                  </li>
                ) : (
                  <li class="pdisc__val">{social}</li>
                ))}
            </ul>
          </div>
        )}
      </div>
    </details>
  )
}

<style>
  .pdisc {
    font-family: "Archivo", sans-serif;
  }

  .pdisc__toggle {
    /* Kill the native marker in both engines; the +/− is drawn below so it can
       sit on the correct side and use the type scale. */
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0;
    color: var(--color-muted);
  }
  .pdisc__toggle::-webkit-details-marker {
    display: none;
  }

  .pdisc__label {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Drawn marker. Square, to match the card's no-radius rule. */
  .pdisc__label::before {
    content: "+";
    display: inline-block;
    width: 0.75rem;
    font-weight: 600;
  }
  .pdisc[open] .pdisc__label::before {
    content: "–";
  }

  .pdisc__toggle:hover .pdisc__label,
  .pdisc__toggle:focus-visible .pdisc__label {
    color: var(--color-dark);
  }

  .pdisc__body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    /* A rule rather than a box: the card is a set of stacked bands, and a
       filled panel would read as a different component. */
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .pdisc__bio {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-dark);
  }

  .pdisc__row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pdisc__key {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pdisc__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdisc__val {
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 5px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    /* `socialMedia` is free text and one real value is a comma-joined handle
       plus a full LinkedIn URL. Without this it overruns the card's lane on
       mobile, since there is no space in the URL to break at. */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .pdisc__vals--links {
    flex-direction: column;
    gap: 0.3rem;
  }

  .pdisc__link {
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Long URLs must not widen the card's lane. */
    overflow-wrap: anywhere;
  }
  .pdisc__link:hover {
    color: var(--color-muted);
  }
</style>
