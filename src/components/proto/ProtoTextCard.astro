---
import { hasDisclosableDetail, type ProtoCardMember } from "../../lib/proto-data.ts";
import ProtoDetailPanel from "./ProtoDetailPanel.astro";

interface Props {
  member: ProtoCardMember;
  index?: number;
}

const { member } = Astro.props;
const hasCaption = hasDisclosableDetail(member, 0);

// Same click-through as the image card: the name opens the profile page.
const profileHref = `/proto/profile/${member.id}`;
---

<article class="ptcard">
  {
    hasCaption && (
      <div class="ptcard__caption">
        <div class="ptcard__name-row">
          <div class="ptcard__identity">
            <a class="ptcard__name" href={profileHref} transition:name={`pname-${member.id}`}>
              {member.name}
            </a>
            <span class="ptcard__role">{member.role}</span>
          </div>
          <ProtoDetailPanel member={member} />
        </div>
      </div>
    )
  }
  {!hasCaption && (
    <a class="ptcard__name" href={profileHref} transition:name={`pname-${member.id}`}>
      {member.name}
    </a>
  )}
</article>

<style>
  .ptcard {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    /* Matches ProtoMemberCard so the GSAP scale in ProtoGrid pivots identically
       whichever card type a lane happens to hold — see that file for why the
       origin is top, not centre. */
    transform-origin: 50% 0%;
  }

  /* Name band — identical to the image card's, on purpose. */
  .ptcard__name {
    display: block;
    margin: 0;
    font-family: "Archivo", sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-dark);
    text-decoration: none;
  }
  .ptcard__name:hover,
  .ptcard__name:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .ptcard__frame {
    position: relative;
    display: flex;
    overflow: hidden;
    padding: 1.1rem;
    border: 1.5px solid var(--color-border);
    /* Square corners throughout, as everywhere else on the card. */
    border-radius: 0;
    background: var(--color-bg);
    font-family: "Archivo", sans-serif;
  }

  /* ── tags mode: the subject list becomes the artwork ──── */
  .ptcard__tagset {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1em;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .ptcard__tagline {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-dark);
    /* Long labels set tight rather than wrapping into a ragged column. */
    overflow-wrap: anywhere;
  }
  /* Fade down the list so the box reads as a composition with a top-left
     entry point rather than as seven equal rows. */
  .ptcard__tagline:nth-child(n + 4) {
    color: var(--color-muted);
  }
  .ptcard__tagline:nth-child(n + 6) {
    font-weight: 500;
  }

  /* ── bio mode ─────────────────────────────────────────── */
  .ptcard__quote {
    margin: 0;
    align-self: center;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--color-dark);
  }

  /* ── role mode: the leanest profile still gets a face ─── */
  .ptcard__bigrole {
    margin: 0;
    align-self: flex-end;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    /* The small tier can put this frame under 100px wide, narrower than a
       single long word at this size — same treatment as .ptcard__tagline. */
    overflow-wrap: anywhere;
  }

  /* ── caption ──────────────────────────────────────────── */
  .ptcard__caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: "Archivo", sans-serif;
  }

  .ptcard__name-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.35rem;
  }

  .ptcard__identity {
    min-width: 0;
  }

  .ptcard__name-row :global(.pdisc) {
    display: contents;
  }

  .ptcard__name-row :global(.pdisc__toggle) {
    grid-column: 2;
    grid-row: 1;
  }

  .ptcard__name-row :global(.pdisc__body) {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .ptcard__role {
    display: block;
    margin-top: 0.2rem;
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-dark);
  }

  .ptcard__role {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
  }

  .ptcard__open {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-inline-start: 0.45rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ptcard__open::before {
    content: "";
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    border-radius: 50%;
  }

  @media (--bp-mobile) {
    .ptcard__tagline {
      font-size: 0.9rem;
    }
    .ptcard__bigrole {
      font-size: 1.2rem;
    }
    .ptcard__quote {
      font-size: 0.86rem;
    }
  }
</style>
