---
import { hasDisclosableDetail, type ProtoCardMember } from "../../lib/proto-data.ts";
import ProtoDetailPanel from "./ProtoDetailPanel.astro";

interface Props {
  member: ProtoCardMember;
  index?: number;
}

const { member, index = 0 } = Astro.props;

// Same anatomy as ProtoMemberCard — name band, framed box, caption, disclosure —
// so a member with no artwork holds the identical slot in the grid rather than
// being demoted to a list. What changes is only what fills the frame.

// With no image there is no intrinsic ratio to inherit, and a grid of uniform
// squares among varied photographs reads as a rendering fault. Cycling a small
// set keeps these boxes as irregular as their neighbours.
const RATIOS = ["4 / 5", "1 / 1", "5 / 4", "3 / 4"];
const ratio = RATIOS[index % RATIOS.length];

// Compose from whatever the profile actually holds, richest first. Every one of
// the five real text-only members lands in exactly one of these, and the
// fallback is a role — which every member has.
const tags = member.tags ?? [];
const bio = member.bio?.trim() ?? "";
const mode = tags.length > 0 ? "tags" : bio ? "bio" : "role";

// A long bio would overflow the box at display size; the panel below carries the
// full text, so the frame can show an opening without losing anything.
const MAX_FRAME_BIO = 150;
const framedBio =
  bio.length > MAX_FRAME_BIO ? `${bio.slice(0, bio.lastIndexOf(" ", MAX_FRAME_BIO))}…` : bio;

const isOpen = (member.openTo?.length ?? 0) > 0;

// In role mode the frame already carries the role at display size. Repeating it
// verbatim in the caption directly underneath reads as a duplication bug, so the
// caption band is dropped entirely unless it has something else to say.
const showCaptionRole = mode !== "role";
const hasCaption = showCaptionRole || isOpen || hasDisclosableDetail(member);
---

<article class="ptcard" data-mode={mode}>
  <p class="ptcard__name">{member.name}</p>

  <div class="ptcard__frame" style={`aspect-ratio:${ratio}`}>
    {
      mode === "tags" && (
        <ul class="ptcard__tagset">
          {tags.map((t) => (
            <li class="ptcard__tagline">{t}</li>
          ))}
        </ul>
      )
    }

    {mode === "bio" && <p class="ptcard__quote">{framedBio}</p>}

    {mode === "role" && <p class="ptcard__bigrole">{member.role}</p>}
  </div>

  {
    hasCaption && (
      <div class="ptcard__caption">
        {(showCaptionRole || isOpen) && (
          <span class="ptcard__role">
            {showCaptionRole && member.role}
            {isOpen && <span class="ptcard__open">open</span>}
          </span>
        )}
        <ProtoDetailPanel member={member} />
      </div>
    )
  }
</article>

<style>
  .ptcard {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    /* Matches ProtoMemberCard so the GSAP scale in ProtoGrid pivots identically
       whichever card type a lane happens to hold — see that file for why the
       origin is top, not centre. */
    transform-origin: 50% 0%;
  }

  /* Name band — identical to the image card's, on purpose. */
  .ptcard__name {
    margin: 0;
    font-family: "Archivo", sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-dark);
  }

  .ptcard__frame {
    position: relative;
    display: flex;
    overflow: hidden;
    padding: 1.1rem;
    border: 1.5px solid var(--color-border);
    /* Square corners throughout, as everywhere else on the card. */
    border-radius: 0;
    background: var(--color-bg);
    font-family: "Archivo", sans-serif;
  }

  /* ── tags mode: the subject list becomes the artwork ──── */
  .ptcard__tagset {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1em;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .ptcard__tagline {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-dark);
    /* Long labels set tight rather than wrapping into a ragged column. */
    overflow-wrap: anywhere;
  }
  /* Fade down the list so the box reads as a composition with a top-left
     entry point rather than as seven equal rows. */
  .ptcard__tagline:nth-child(n + 4) {
    color: var(--color-muted);
  }
  .ptcard__tagline:nth-child(n + 6) {
    font-weight: 500;
  }

  /* ── bio mode ─────────────────────────────────────────── */
  .ptcard__quote {
    margin: 0;
    align-self: center;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--color-dark);
  }

  /* ── role mode: the leanest profile still gets a face ─── */
  .ptcard__bigrole {
    margin: 0;
    align-self: flex-end;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    /* The small tier can put this frame under 100px wide, narrower than a
       single long word at this size — same treatment as .ptcard__tagline. */
    overflow-wrap: anywhere;
  }

  /* ── caption ──────────────────────────────────────────── */
  .ptcard__caption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: "Archivo", sans-serif;
  }

  .ptcard__role {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
  }

  .ptcard__open {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-inline-start: 0.45rem;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ptcard__open::before {
    content: "";
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    border-radius: 50%;
  }

  @media (--bp-mobile) {
    .ptcard__tagline {
      font-size: 0.9rem;
    }
    .ptcard__bigrole {
      font-size: 1.2rem;
    }
    .ptcard__quote {
      font-size: 0.86rem;
    }
  }
</style>
