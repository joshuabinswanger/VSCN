---
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const networkName = "Visual Science Communication Network";
const connectStatement = t("hero.statement.connect");
const networkNameIndex = connectStatement.indexOf(networkName);
const connectBefore = networkNameIndex >= 0 ? connectStatement.slice(0, networkNameIndex) : "";
const connectAfter =
  networkNameIndex >= 0 ? connectStatement.slice(networkNameIndex + networkName.length) : "";
---

<div class="landing-hero" data-landing-hero data-lang={lang}>
  <section class="landing-hero__content" aria-labelledby="landing-title">
    <h1 id="landing-title" class="landing-hero__statement landing-hero__statement--primary">
      {
        networkNameIndex >= 0 ? (
          <span>
            {connectBefore}
            <strong class="landing-hero__network-name">{networkName}</strong>
            {connectAfter}
          </span>
        ) : (
          <span>{connectStatement}</span>
        )
      }
    </h1>

    <p class="landing-hero__statement landing-hero__statement--purpose">
      {t("hero.statement.purpose")}
    </p>

    <div class="landing-hero__join">
      <a id="hero-cta" href={lang === "de" ? "/de/signup" : "/signup"} class="btn-solid btn-join">
        {t("hero.cta.join")}
      </a>
    </div>
  </section>
</div>

<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .landing-hero {
    display: grid;
    justify-items: center;
    align-items: center;
    box-sizing: border-box;
    padding: clamp(3rem, 6vw, 6rem) 15px clamp(5rem, 9vw, 8rem);
  }

  .landing-hero__content {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: clamp(1.3rem, 3vw, 2.4rem);
  }

  .landing-hero__statement {
    margin: 0;
    color: var(--color-dark);
    font-size: clamp(1.2rem, 5vw, 2.8rem);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .landing-hero__network-name {
    font-weight: 700;
  }

  .landing-hero__statement--primary {
    animation: hero-fade-up 0.78s ease-out both;
    animation-play-state: paused;
  }

  .landing-hero__statement--purpose {
    animation: hero-fade-up 0.5s ease-out 0.25s both;
    animation-play-state: paused;
  }

  .landing-hero__join {
    display: flex;
    align-items: flex-start;
    padding-top: 1.5rem;
    animation: hero-fade-up 0.5s ease-out 0.5s both;
    animation-play-state: paused;
  }

  :global(.page-loaded) .landing-hero__statement--primary,
  :global(.page-loaded) .landing-hero__statement--purpose,
  :global(.page-loaded) .landing-hero__join {
    animation-play-state: running;
  }

  .btn-join {
    align-self: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-hero__statement--primary,
    .landing-hero__statement--purpose,
    .landing-hero__join,
    :global(.page-loaded) .landing-hero__statement--primary,
    :global(.page-loaded) .landing-hero__statement--purpose,
    :global(.page-loaded) .landing-hero__join {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .landing-hero {
      align-items: start;
      padding: clamp(3rem, 12vw, 5rem) 24px clamp(5rem, 14vw, 7rem);
    }

    .landing-hero__content {
      gap: 2rem;
    }

    .landing-hero__join {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  import { onAuthStateChanged } from "firebase/auth";
  import { auth } from "../lib/firebase.ts";
  import { ui } from "../i18n/translations.ts";

  let unsubscribeAuth: (() => void) | null = null;

  document.addEventListener("astro:page-load", () => {
    const cta = document.getElementById("hero-cta") as HTMLAnchorElement | null;
    const wrapper = document.querySelector<HTMLElement>("[data-landing-hero][data-lang]");
    if (!cta || !wrapper) return;

    const lang = (wrapper.dataset.lang ?? "en") as "en" | "de";
    const prefix = lang === "de" ? "/de" : "";
    const strings = ui[lang];

    unsubscribeAuth?.();
    unsubscribeAuth = onAuthStateChanged(auth, (user) => {
      cta.href = user ? `${prefix}/community` : `${prefix}/signup`;
      cta.textContent = user ? strings["hero.cta.community"] : strings["hero.cta.join"];
    });
  });

  document.addEventListener("astro:before-swap", () => {
    unsubscribeAuth?.();
    unsubscribeAuth = null;
  });
</script>
