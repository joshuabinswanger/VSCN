---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'button'> { variant?: 'solid' | 'outline' }
const { variant = 'solid', class: className, type = 'button', ...rest } = Astro.props;
---
<button type={type} class:list={[`btn-${variant}`, className]} {...rest}><slot /></button>
