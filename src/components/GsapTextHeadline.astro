---
interface Props {
  holdDuration?: number;
  replaceDuration?: number;
  collapseDuration?: number;
  ease?: string;
}

const words = ["Visual", "Science", "Communication", "Network", "VSCNVSCNVSCNVSCN"];
const {
  holdDuration = 0.3,
  replaceDuration = 0.3,
  collapseDuration = 0.3,
  ease = "power3.inOut",
} = Astro.props;
---

<div
  class="gsap-text-headline"
  data-gsap-text-headline
  data-hold-duration={holdDuration}
  data-replace-duration={replaceDuration}
  data-collapse-duration={collapseDuration}
  data-ease={ease}
  data-headline-ready="false"
  aria-label="Visual Science Communication Network"
>
  <span class="gsap-text-headline__stage" aria-hidden="true">
    {
      words.map((word, wordIndex) => (
        <span
          class:list={[
            "gsap-text-headline__word",
            wordIndex === 0 && "gsap-text-headline__word--active",
          ]}
          data-headline-word
          data-final-word={wordIndex === words.length - 1 ? "true" : "false"}
        >
          {Array.from(word).map((char) => (
            <span class="gsap-text-headline__char">{char}</span>
          ))}
        </span>
      ))
    }
  </span>
</div>

<style>
  .gsap-text-headline {
    display: flex;
    justify-content: flex-start;
    width: var(--gsap-text-headline-width, 100%);
    overflow: hidden;
    color: var(--color-dark);
    font-size: var(--gsap-text-headline-fit-size, var(--gsap-text-headline-size, 8rem));
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .gsap-text-headline__stage {
    display: grid;
    justify-items: start;
    height: 1em;
    overflow: hidden;
    perspective: 12ch;
    transform-style: preserve-3d;
    opacity: 0;
  }

  .gsap-text-headline[data-headline-ready="true"] .gsap-text-headline__stage {
    opacity: 1;
  }

  .gsap-text-headline__word {
    display: inline-flex;
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform-style: preserve-3d;
  }

  .gsap-text-headline__word--active {
    opacity: 1;
    visibility: visible;
  }

  .gsap-text-headline__char {
    display: inline-block;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .gsap-text-headline__word:first-child {
      opacity: 1;
      visibility: visible;
    }

    .gsap-text-headline__char {
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from "gsap";

  declare global {
    interface Window {
      _gsapHeadlineDone?: boolean;
    }
  }

  const timelines = new WeakMap<HTMLElement, gsap.core.Timeline>();
  const resizeObservers = new WeakMap<HTMLElement, ResizeObserver>();

  const STAGGER = 0.035;
  let didInitHeadlines = false;

  function getChars(word: HTMLElement) {
    return Array.from(word.querySelectorAll<HTMLElement>(".gsap-text-headline__char"));
  }

  function fitHeadlineToFinalWord(root: HTMLElement, finalWord: HTMLElement) {
    const availableWidth = root.clientWidth;
    const finalWordWidth = finalWord.offsetWidth;
    const currentFontSize = Number.parseFloat(getComputedStyle(root).fontSize);

    if (availableWidth <= 0 || finalWordWidth <= 0 || currentFontSize <= 0) return;

    const nextFontSize = (currentFontSize * availableWidth) / finalWordWidth;
    root.style.setProperty("--gsap-text-headline-fit-size", `${nextFontSize}px`);
  }

  function observeHeadlineFit(root: HTMLElement, finalWord: HTMLElement) {
    root.style.removeProperty("--gsap-text-headline-fit-size");
    fitHeadlineToFinalWord(root, finalWord);

    const resizeObserver = new ResizeObserver(() => {
      fitHeadlineToFinalWord(root, finalWord);
    });

    resizeObserver.observe(root);
    resizeObservers.set(root, resizeObserver);
  }

  function resetWords(words: HTMLElement[]) {
    words.forEach((word) => {
      gsap.set(word, { autoAlpha: 0 });
      gsap.set(getChars(word), { yPercent: 115, rotateX: -70, opacity: 0 });
    });
  }

  function flipWordIn(
    timeline: gsap.core.Timeline,
    word: HTMLElement,
    duration: number,
    ease: string
  ) {
    const chars = getChars(word);

    timeline.set(word, { autoAlpha: 1 }).fromTo(
      chars,
      { yPercent: 115, rotateX: -70, opacity: 0 },
      {
        yPercent: 0,
        rotateX: 0,
        opacity: 1,
        duration,
        ease,
        stagger: STAGGER,
      }
    );
  }

  function flipWordSwap(
    timeline: gsap.core.Timeline,
    outgoing: HTMLElement,
    incoming: HTMLElement,
    inDuration: number,
    outDuration: number,
    ease: string
  ) {
    const outgoingChars = getChars(outgoing);
    const incomingChars = getChars(incoming);
    const label = `swap-${timeline.labels ? Object.keys(timeline.labels).length : 0}`;

    timeline
      .addLabel(label)
      .to(
        outgoingChars,
        {
          yPercent: -115,
          rotateX: 70,
          opacity: 0,
          duration: outDuration,
          ease,
          stagger: STAGGER,
        },
        label
      )
      .set(incoming, { autoAlpha: 1 }, label)
      .fromTo(
        incomingChars,
        { yPercent: 115, rotateX: -70, opacity: 0 },
        {
          yPercent: 0,
          rotateX: 0,
          opacity: 1,
          duration: inDuration,
          ease,
          stagger: STAGGER,
        },
        `${label}+=0.06`
      )
      .set(outgoing, { autoAlpha: 0 });
  }

  function initHeadline(root: HTMLElement) {
    if (timelines.has(root) || root.dataset.headlineInitialized === "true") return;
    root.dataset.headlineInitialized = "true";

    const words = Array.from(root.querySelectorAll<HTMLElement>("[data-headline-word]"));
    if (words.length === 0) return;

    const finalWord = root.querySelector<HTMLElement>('[data-final-word="true"]') ?? words.at(-1);
    if (finalWord) {
      observeHeadlineFit(root, finalWord);
    }

    resetWords(words);
    fitHeadlineToFinalWord(root, finalWord);

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.set(words[0], { autoAlpha: 1 });
      gsap.set(getChars(words[0]), { yPercent: 0, rotateX: 0, opacity: 1 });
      root.dataset.headlineReady = "true";
      window._gsapHeadlineDone = true;
      document.dispatchEvent(new CustomEvent("gsap-headline-complete"));
      return;
    }

    const holdDuration = Number(root.dataset.holdDuration ?? 0.72);
    const replaceDuration = Number(root.dataset.replaceDuration ?? 0.52);
    const collapseDuration = Number(root.dataset.collapseDuration ?? 0.42);
    const ease = root.dataset.ease ?? "power3.inOut";

    const timeline = gsap.timeline({
      repeat: 0,
      defaults: { ease },
      onComplete: () => {
        window._gsapHeadlineDone = true;
        document.dispatchEvent(new CustomEvent("gsap-headline-complete"));
      },
    });

    root.dataset.headlineReady = "true";

    flipWordIn(timeline, words[0], replaceDuration, ease);
    timeline.to({}, { duration: holdDuration });

    words.slice(1).forEach((incoming, index) => {
      flipWordSwap(timeline, words[index], incoming, replaceDuration, collapseDuration, ease);
      timeline.to({}, { duration: holdDuration });
    });

    timelines.set(root, timeline);
  }

  function initHeadlines() {
    if (didInitHeadlines) return;
    didInitHeadlines = true;
    document.querySelectorAll<HTMLElement>("[data-gsap-text-headline]").forEach(initHeadline);
  }

  if (document.readyState !== "loading") {
    initHeadlines();
  } else {
    document.addEventListener("DOMContentLoaded", initHeadlines);
  }
</script>
