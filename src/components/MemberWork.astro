---
// ONE WORK'S FIGURE on the member page — extracted from [slug].astro
// (2026-09-23) so the page can loop over project SECTIONS (a run of loose
// works, or a project's works under its heading) without Astro's rule against
// local components inside a page file. Moved verbatim, embed handling
// included: a video work (2026-09-23, "motion embeds") spreads
// embedDataAttrs(w.embed) on the trigger and shows a play badge over its
// poster, exactly as before this file existed.
import type { EmbedRef } from "../lib/embed.ts";
import { embedDataAttrs } from "../lib/embed.ts";
import { hostLabel } from "../lib/links.ts";
import { splitParagraphs } from "../lib/paragraphs.ts";
import { workSizeWidth } from "../lib/workSize.ts";

interface WorkProps {
  url: string;
  width: number;
  height: number;
  caption?: string;
  description?: string;
  link?: string;
  siteLink?: string;
  pswpMeta?: string;
  /** The text block after this work, already picked for the page's locale (workTextAfter in links.ts). */
  textAfter?: string;
  /** S/M/L (2026-10-16); absent = L. See src/lib/workSize.ts. */
  size?: string;
  /** The member's switch (2026-10-31): `true` prints the description under the picture as well as in the lightbox. */
  showDescription?: boolean;
  /** The carousel this work is a slide of (2026-10-23); MemberProject groups on it. */
  carouselId?: string;
  embed?: EmbedRef;
  color?: string;
  rendered: { src: string; srcSet: { attribute: string } };
  /** THE PROJECT THIS WORK IS IN, as data-pswp-* strings — see projectSlideData() in lib/projects.ts. */
  slide: { project?: string; projectLink?: string; affiliations?: string };
}

interface Props {
  work: WorkProps;
  /** This work's position in the member's own (unsectioned) works list — drives eager/lazy loading. */
  index: number;
  displayName: string;
  /** t("member.workAlt") — the alt-text fallback for an uncaptioned image. */
  workAlt: string;
  /** t("member.lightbox.link") — accessible name / title for the "where this appeared" link. */
  linkTitle: string;
  /** t("member.lightbox.siteLink") — accessible name / title for the member's own-site link. */
  siteLinkTitle: string;
}

const { work: w, index: i, displayName, workAlt, linkTitle, siteLinkTitle } = Astro.props as Props;
// THE WAY OUT (2026-10-31, Josh: "on desktop the image should have a small
// arrow diagonally up icon that would send you to the linked publication or
// url"): the publication the piece appeared in first, else the member's own
// page about it. One arrow, one destination; both still live in the lightbox.
const outHref = w.link || w.siteLink;
const outTitle = w.link ? linkTitle : siteLinkTitle;
const showDesc = w.showDescription === true && Boolean(w.description?.trim());
---

{/* NO MORPH FROM THE CARD (2026-10-20, Josh: "the build up of the page is not
    smooth and images and text jitter" on iOS). The first figure carried the
    card frame's view-transition name, so the picture flew from the card to
    its place here while the page is held invisible for its 500ms pause
    (Layout.astro). WebKit paints a named element at full strength even
    under an opacity-0 ancestor (Chromium does not), so on an iPhone the
    picture flew in, vanished at the end of the view transition, and faded
    back in with the page. Now it arrives with the page, once. The name's
    morph in [slug].astro went the same way. */}
<figure
  class="mprof__work"
  style={`--work-ar: ${w.width / w.height}; --size-w: ${workSizeWidth(w)}`}
>
  <a
    class="mprof__work-link"
    href={w.url}
    target="_blank"
    rel="noreferrer"
    data-pswp-width={w.width}
    data-pswp-height={w.height}
    data-pswp-caption={w.caption?.trim() || undefined}
    data-pswp-description={w.description || undefined}
    data-pswp-link={w.link || undefined}
    data-pswp-site-link={w.siteLink || undefined}
    data-pswp-meta={w.pswpMeta || undefined}
    data-pswp-project={w.slide.project}
    data-pswp-project-link={w.slide.projectLink}
    data-pswp-affiliations={w.slide.affiliations}
    {...embedDataAttrs(w.embed)}
  >
    <img
      class="mprof__img"
      src={w.rendered.src}
      srcset={w.rendered.srcSet.attribute}
      sizes="(min-width: 768px) min(94vw, 900px), 94vw"
      width={w.width}
      height={w.height}
      loading={i === 0 ? "eager" : "lazy"}
      decoding="async"
      alt={w.caption?.trim() || `${displayName} — ${workAlt}`}
      style={`background-color: ${w.color ?? "var(--color-border)"}`}
    />
    {w.embed && <span class="vscn-play vscn-play--over" aria-hidden="true" />}
  </a>
  {/* THE ARROW OUT, in the picture's top-right corner (2026-10-31). A
      SIBLING of the lightbox trigger, never inside it — an anchor cannot
      hold an anchor, and the picture's own click stays the lightbox's. It
      finds the corner from the same --size-w / --work-ar formula the frame
      is centred by (profile.css .mprof__out). Desktop only: the CSS hides
      it on a phone, where the lightbox's own links do the job. */}
  {outHref && (
    <a class="mprof__out" href={outHref} target="_blank" rel="noopener" title={outTitle} aria-label={outTitle}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        <path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  )}
  {/* NO DESCRIPTION UNDER THE PICTURE BY DEFAULT (2026-10-16, Josh: "we also
      want to get rid of image descriptions on the profile page"); the member
      switches it on PER WORK since 2026-10-31 (showDescription). The title
      stays; the lightbox reads the description either way, behind the
      title's dropdown (data-pswp-description above). */}
  {(w.caption?.trim() || showDesc || w.link || w.siteLink) && (
    <figcaption class="mprof__caption">
      {w.caption?.trim() && <span class="mprof__caption-line">{w.caption}</span>}
      {showDesc && <span class="mprof__desc">{w.description}</span>}
      {/* Where the piece lives in the world: the member's own project page
          first, then the publication it appeared in (two links since
          2026-09-10). In the caption and not on the image, because the
          image's own anchor is the lightbox trigger — wrapping that in an
          outbound link would take the reader off the page every time they
          tried to look closer. The host IS the link text. */}
      {(w.siteLink || w.link) && (
        <span class="mprof__caption-links">
          {w.siteLink && (
            <a class="mprof__link" href={w.siteLink} target="_blank" rel="noopener" title={siteLinkTitle}>
              {hostLabel(w.siteLink)}
            </a>
          )}
          {w.link && (
            <a class="mprof__link" href={w.link} target="_blank" rel="noopener" title={linkTitle}>
              {hostLabel(w.link)}
            </a>
          )}
        </span>
      )}
    </figcaption>
  )}
</figure>
{
  /* THE TEXT BLOCK AFTER THE WORK (2026-10-16, Josh: "make it possible to
     add text block in between image in projects"). A sibling of the figure,
     not inside it: it is the project's own words between two pictures, not a
     caption, so it takes the column's width and the lightbox never reads it. */
  w.textAfter?.trim() && (
    <div class="mprof__text">
      {splitParagraphs(w.textAfter).map((para) => <span class="mprof__para">{para}</span>)}
    </div>
  )
}
