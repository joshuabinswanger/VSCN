---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import CommunityCardPreview from "./community/CommunityCardPreview.astro";
import MemberTypeSelector from "./MemberTypeSelector.astro";
import BilingualField from "./BilingualField.astro";
import TagSelector from "./TagSelector.astro";
import OpenToSelector from "./OpenToSelector.astro";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === "de" ? "/de" : "";
---

<div id="ob-loading" class="ob-loading">{t("profile.loading")}</div>

<div id="onboarding-wrap" class="onboarding-wrap" data-lang={lang} style="display:none;">
  {
    /* EMPTY UNTIL setStep FILLS IT, and that is the honest state rather than a
      missing one: how many steps there are depends on whether this account
      still has to verify its email, which is not known until the auth guard
      has run — and #onboarding-wrap stays display:none until it has, so
      nothing here is ever seen unfilled. It used to ship "1 / 5" and a 20%
      bar, which were a different format and the wrong count by the time the
      closing steps landed (2026-09-08). */
  }
  <div id="ob-progress" class="ob-progress">
    <div class="ob-progress-bar">
      <div id="ob-progress-fill" class="ob-progress-fill" style="width:0"></div>
    </div>
    <span id="ob-progress-text" class="ob-progress-text"></span>
  </div>

  <p role="alert" id="ob-error" class="msg-err" style="display:none;"></p>

  <!-- Step auth: Create account -->
  <div class="onboarding-step" data-step="-1" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.auth.title")}</h1>
      <p class="ob-sub">{t("onboarding.auth.sub")}</p>
    </header>
    <div id="ob-auth-cta" class="ob-footer">
      <button id="ob-start-auth" type="button" class="btn-solid">{t("onboarding.auth.cta")}</button>
    </div>
    <div id="ob-auth-form" style="display:none;">
      <div class="ob-fields">
        <div class="field">
          <label class="label" for="ob-email">{t("onboarding.auth.email")}</label>
          <input id="ob-email" type="email" class="input" autocomplete="email" />
        </div>
        <div class="field">
          <label class="label" for="ob-password">{t("onboarding.auth.password")}</label>
          <input id="ob-password" type="password" class="input" autocomplete="new-password" />
        </div>
        <div class="field">
          <label class="label" for="ob-password-confirm">{t("onboarding.auth.passwordConfirm")}</label>
          <input id="ob-password-confirm" type="password" class="input" autocomplete="new-password" />
        </div>
      </div>
      <div class="ob-footer">
        <button id="ob-next-auth" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
      </div>
    </div>
    <p class="ob-have-account">
      {t("onboarding.auth.haveAccount")}
      <a href={`${prefix}/login`}>{t("onboarding.auth.cta.login")}</a>
    </p>
  </div>

  <!-- Step 0: About you -->
  <div class="onboarding-step" data-step="0">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.step1.title")}</h1>
      <p class="ob-sub">{t("onboarding.step1.sub")}</p>
    </header>
    <div class="ob-fields">
      <MemberTypeSelector lang={lang} name="ob-member-type" />
      <div class="field">
        <label class="label" for="ob-name">{t("profile.label.name")}</label>
        <input id="ob-name" type="text" class="input" placeholder={t("profile.ph.name")} />
      </div>
      {/* The German twin behind the EN/DE switch — see the same pair in ProfileForm.astro. */}
      <BilingualField
        lang={lang}
        id="ob-role"
        label={t("profile.label.role")}
        labelEn={t("profile.label.role.en")}
        labelDe={t("profile.label.role.de")}
        placeholder={t("profile.ph.role")}
        placeholderDe={t("profile.ph.role.de")}
        noteDe={t("profile.note.role.de")}
      />
      <div class="field">
        <label id="ob-portfolio-label" class="label" for="ob-portfolio"
          >{t("profile.label.portfolio")}</label
        >
        <div class="input-prefix-wrap">
          <span class="input-prefix">https://</span>
          <input
            id="ob-portfolio"
            type="text"
            class="input input-prefixed"
            placeholder={t("profile.ph.portfolio")}
          />
        </div>
      </div>
      {
        /* One row per link, the same control the profile editor grew on
        2026-09-04 — a member who signs up with a LinkedIn and an Instagram had
        no way to say so here, and the editor they would have to go to
        afterwards is a page they have not seen yet. The STORED shape is
        unchanged: the rows are joined back into the single comma-separated
        `socialMedia` string by joinSocial(), so firestore.rules, the
        build-time directory snapshot and every profile stored before today
        keep working untouched. A <p> rather than a <label>: there is no single
        control left to point at. */
      }
      <div class="field">
        <p id="ob-social-label" class="label">{t("profile.label.social")}</p>
        <div id="ob-social-editor" class="social-editor"></div>
        <button type="button" id="ob-social-add" class="btn-outline social-add">
          {t("profile.social.add")}
        </button>
        <p id="ob-social-status" class="field-note" style="display:none;"></p>
        <p class="field-note">{t("profile.note.social")}</p>
        {
          /* Cloned by renderSocial(). Rendered here rather than built in JS so
          each clone carries Astro's data-astro-cid-* attribute and matches the
          scoped rules below — a node built with document.createElement() would
          match none of them. */
        }
        <template data-ob-social-tpl="row">
          <div class="social-row">
            <div class="input-prefix-wrap">
              <span class="input-prefix">https://</span>
              <input type="text" class="input input-prefixed" data-social-input />
            </div>
            <button type="button" class="social-row-remove" data-social-remove>✕</button>
          </div>
        </template>
      </div>
      <div class="field">
        <label class="label" for="ob-phone">{t("profile.label.phone")}</label>
        <input
          id="ob-phone"
          type="tel"
          class="input"
          placeholder="+41 79 123 45 67"
          autocomplete="tel"
        />
        <p class="field-note">{t("profile.note.phone")}</p>
      </div>
    </div>
    <div class="ob-footer">
      <button id="ob-next-0" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
    </div>
  </div>

  <!-- Step 1: Community goals -->
  <div class="onboarding-step" data-step="1" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.step2.title")}</h1>
      <p class="ob-sub">{t("onboarding.step2.sub")}</p>
    </header>
    <div class="ob-fields">
      <div class="field">
        <label class="checkbox-label" for="ob-wants-to-contribute">
          <input id="ob-wants-to-contribute" type="checkbox" />
          <span>{t("profile.wantsToContribute")}</span>
        </label>
        <p class="field-note">{t("profile.wantsToContribute.note")}</p>
      </div>
      <div class="field">
        <label class="label" for="ob-preferred-language">{t("profile.label.preferredLanguage")}</label>
        <select id="ob-preferred-language" class="input">
          <option value="de" selected={lang === "de"}>{t("profile.lang.de")}</option>
          <option value="en" selected={lang !== "de"}>{t("profile.lang.en")}</option>
        </select>
        <p class="field-note">{t("profile.note.preferredLanguage")}</p>
      </div>
      <div class="field">
        <label class="checkbox-label" for="ob-receive-community-emails">
          <input id="ob-receive-community-emails" type="checkbox" />
          <span>{t("profile.receiveCommunityEmails")}</span>
        </label>
        <p class="field-note">{t("profile.receiveCommunityEmails.note")}</p>
      </div>
      <div class="field">
        <OpenToSelector lang={lang} />
      </div>
      <div class="field">
        <label class="label" for="ob-platform-request">{t("onboarding.request.label")}</label>
        <p class="field-note">{t("onboarding.request.helper")}</p>
        <textarea id="ob-platform-request" rows="4" maxlength="1000" class="input textarea"
        ></textarea>
      </div>
    </div>
    <div class="ob-footer">
      <button id="ob-next-1" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
    </div>
  </div>

  <!-- Step 2: Bridge -->
  <div class="onboarding-step ob-bridge" data-step="2" style="display:none;">
    <div class="ob-bridge-icon">✓</div>
    <h1 class="ob-title">{t("onboarding.bridge.title")}</h1>
    <p class="ob-sub">{t("onboarding.bridge.sub")}</p>
    <div class="ob-footer ob-footer--bridge">
      <button id="ob-continue-2" type="button" class="btn-solid"
        >{t("onboarding.bridge.continue")}</button
      >
      <button id="ob-skip-2" type="button" class="btn-link">{t("onboarding.nav.skip")}</button>
    </div>
  </div>

  <!-- Step 3: Tags -->
  <div class="onboarding-step" data-step="3" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.step3.title")}</h1>
      <p class="ob-sub">{t("onboarding.step3.sub")}</p>
    </header>
    <div class="ob-fields">
      {
        /* Wrapped and identified since the gallery step grew a SECOND
          selector on 2026-09-08 (the cover image's tags). The script used to
          reach this one with a bare `tag-selector` query, which means "the
          first one in the document" — true only by the accident that this
          step is written above that one. Both are scoped by wrapper now. */
      }
      <div class="field" id="ob-member-tags-field">
        <label class="label" for="ob-tag-input">{t("profile.label.tags")}</label>
        <TagSelector lang={lang} maxTags={7} inputId="ob-tag-input" />
        {
          /* The cap, stated by the field that sets it — TagSelector stopped
            asserting a number it cannot know (see the note in its markup).
            Here it is the only word on the subject, so it stays. */
        }
        <p class="field-note">{t("profile.note.tags")}</p>
      </div>
    </div>
    <div class="ob-footer ob-footer--with-skip">
      <button id="ob-skip-3" type="button" class="btn-link">{t("onboarding.nav.skip")}</button>
      <button id="ob-next-3" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
    </div>
  </div>

  <!-- Step 4: Bio & Avatar -->
  <div class="onboarding-step" data-step="4" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.step4.title")}</h1>
      <p class="ob-sub">{t("onboarding.step4.sub")}</p>
    </header>
    <div class="ob-fields">
      <div class="ob-avatar-row">
        <div id="ob-avatar-wrap" class="ob-avatar-wrap">
          <img id="ob-avatar-img" src="" alt="" class="ob-avatar-img" />
          <div id="ob-avatar-ph" class="ob-avatar-ph">?</div>
        </div>
        <div>
          <label class="btn-outline" for="ob-avatar-input">
            {t("profile.chooseImage")}
            <input
              id="ob-avatar-input"
              class="picker-input"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/avif"
            />
          </label>
          <p id="ob-upload-status" class="ob-upload-status" style="display:none;"></p>
        </div>
      </div>
      <BilingualField
        lang={lang}
        id="ob-bio"
        rows={4}
        label={t("profile.label.bio")}
        labelEn={t("profile.label.bio.en")}
        labelDe={t("profile.label.bio.de")}
        placeholder={t("profile.ph.bio")}
        placeholderDe={t("profile.ph.bio.de")}
        note={t("profile.note.bio")}
        noteDe={t("profile.note.bio.de")}
      />
    </div>
    <div class="ob-footer ob-footer--with-skip">
      <button id="ob-skip-4" type="button" class="btn-link">{t("onboarding.nav.skip")}</button>
      <button id="ob-next-4" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
    </div>
  </div>

  {
    /* Step 5: Show your work. The directory is image-led — a member with no
    gallery holds a typographic tag card — so this is the step that decides
    which face they get. It is also the step most likely to be empty: a
    research group signing up has nothing to upload and must not be made to
    feel the flow broke. Hence a full-width skip that reads as an answer,
    not an escape. */
  }
  <div class="onboarding-step" data-step="5" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.step5.title")}</h1>
      <p class="ob-sub">{t("onboarding.step5.sub")}</p>
    </header>
    <div class="ob-fields">
      <div class="field">
        <div id="ob-gallery-grid" class="ob-gallery-grid"></div>
        <label class="btn-outline ob-gallery-add" for="ob-gallery-input">
          {t("profile.gallery.add")}
          <input
            id="ob-gallery-input"
            class="picker-input"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            multiple
          />
        </label>
        <p id="ob-gallery-status" class="ob-upload-status" style="display:none;"></p>
        <!--
          Two notes, one shown. An unverified account holds exactly one gallery
          image (MAX_UNVERIFIED_GALLERY_IMAGES in lib/gallery.ts), so "Up to 8"
          was a lie at the moment it was read — 2026-09-03. Auth state is
          client-only in a static build, so both are rendered and the verify
          block in the script below swaps them. The verified note is the
          server default deliberately: #onboarding-wrap stays display:none
          until onUserAuthenticated has run (and the anonymous path can only
          reach step -1), so nothing can flash either way — and defaulting to
          verified keeps the swap a single block that mirrors the banner
          (act for unverified, nothing to undo for verified).
        -->
        {
          /* THREE NOTES BECAME TWO, AND ONE OF THEM CHANGES (2026-09-04, Josh:
            "here it should be clearer in the communication").

            The step used to say the same thing in three registers at once: a
            note that named the one-image limit, a second note telling you that
            having nothing to show is fine — still on screen after you had
            already uploaded something — and the verify banner at the foot of
            the page repeating the limit a third time in different words. A
            member reading all three has to work out that they are one fact.

            So the limit is now ONE line that says what is true right now, the
            formats and the captions-come-later promise are their own quiet
            line, and the "nothing to show yet" reassurance leaves the moment
            it stops being the question being asked. The banner no longer
            mentions images at all — the limit belongs next to the uploader,
            not in a strip about email. */
        }
        <p id="ob-gallery-limit" class="field-note">{t("onboarding.step5.note")}</p>
        <p class="field-note">{t("onboarding.step5.formats")}</p>
        <p id="ob-gallery-later" class="field-note">{t("onboarding.step5.later")}</p>
      </div>

      {
        /* THE COVER IMAGE'S WORDS, ASKED FOR HERE (2026-09-08, Josh: "already
          expose the image title and description and tags for the first image
          upload"). Until today this step took the bytes and nothing else, and
          the note under it promised that captions "come later, in your
          profile" — so the picture that becomes the member's card in the
          directory arrived untitled, undescribed and untagged, and the wall
          filters by exactly those tags.

          THE FIRST IMAGE ONLY, and that is not a shortcut: an unverified
          account may hold exactly one gallery image
          (MAX_UNVERIFIED_GALLERY_IMAGES), so for most members arriving here
          the first image IS the gallery; the first image is also the card's
          cover, whose proportions draw the card; and a form per image would
          make this step the profile editor. Everything else about every
          image — the German pair, the link, the order — stays in the editor,
          and the note below says so.

          Hidden until an image exists: there is nothing to name before then.
          `hidden`, not display:none, so renderGallery owns the one flag. */
      }
      <div class="ob-cover" id="ob-cover-fields" hidden>
        <div class="ob-cover-header">
          <p class="label">{t("onboarding.step5.cover.title")}</p>
          <p class="field-note">{t("onboarding.step5.cover.note")}</p>
        </div>
        <div class="field">
          <label class="label" for="ob-img-caption">{t("profile.gallery.caption")}</label>
          <input
            id="ob-img-caption"
            type="text"
            class="input"
            placeholder={t("profile.gallery.caption.ph")}
          />
          <p class="field-note">{t("profile.gallery.captionNote")}</p>
        </div>
        {
          /* THE LONG PROMPT IS A NOTE, NOT THE LABEL. In the editor "About
            this image — how it was made, who it was for, what it shows" is an
            aria-label on an unlabelled row; set as a visible `.label` here it
            rendered as a shouted uppercase sentence three-quarters the width
            of the form. So the label names the field and the sentence keeps
            its job as guidance, in the voice every other note on this step
            uses. No placeholder, like the editor's. */
        }
        <div class="field">
          <label class="label" for="ob-img-description"
            >{t("profile.gallery.description.label")}</label
          >
          <textarea id="ob-img-description" class="input textarea" rows="3"></textarea>
          <p class="field-note">{t("profile.gallery.description")}</p>
        </div>
        {
          /* WHAT IS IN THE PICTURE, not who made it. Same element, same
            curated registry as the member's own tags two steps back, capped
            at 5 like the editor's per-image selector — and read by the
            community wall's filter, which is why it is worth asking now
            rather than leaving the first artwork in the directory
            untaggable. */
        }
        <div class="field" id="ob-image-tags-field">
          <label class="label" for="ob-img-tags">{t("profile.gallery.tags")}</label>
          <TagSelector lang={lang} maxTags={7} inputId="ob-img-tags" />
          <p class="field-note">{t("profile.gallery.tagsNote")}</p>
        </div>
      </div>
    </div>
    <div class="ob-footer ob-footer--with-skip">
      <button id="ob-skip-5" type="button" class="btn-link">{t("onboarding.step5.skip")}</button>
      <button id="ob-next-5" type="button" class="btn-solid">{t("onboarding.nav.next")}</button>
    </div>
  </div>

  {
    /* Step 6: Verify your email (2026-09-08, Josh: "step in onboarding … the
    verify step"). The same screen as /verify-email, inside the wizard, so a
    member is asked to open their inbox at the point where the answer matters
    — the next step can only publish a verified account — rather than by a
    banner they can read past. Placed after the gallery so the mail has had
    the whole wizard to arrive. Shown only to an unverified account; a
    verified one steps straight from the gallery to visibility, and setStep
    leaves this out of the count for them. "Verify later" is a real exit:
    the standalone page stays for the emailed link, and the banner above the
    wizard keeps offering the resend on every other step. */
  }
  <div class="onboarding-step" data-step="6" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("verify.title")}</h1>
      {
        /* THE SPAM LINE IS PART OF THE OPENING SENTENCE (2026-09-08, Josh:
          "put the Spam notice in the first sentence"). It stood as its own
          quiet note further down, under the button — which is where a member
          looks only after the link has failed to arrive, and by then they
          have already decided the mail is missing. Where the address is named
          is where "and if it is not there, look in spam" belongs. */
      }
      <p class="ob-sub">
        {t("verify.sub")} <strong id="ob-verify-email"></strong>{t("verify.sub.suffix")}
        {t("verify.spam")}
      </p>
    </header>
    <div class="ob-fields">
      <div class="ob-verify-actions">
        <button id="ob-verify-check" type="button" class="btn-solid">{t("verify.cta")}</button>
        <p role="alert" id="ob-verify-status" class="msg-err" style="display:none;"></p>
        <p class="ob-verify-resend">
          <span>{t("verify.resend.label")}</span>
          <button id="ob-verify-resend" type="button" class="btn-link">{t("verify.resend.btn")}</button>
        </p>
        <p role="status" id="ob-verify-resent" class="msg-ok" style="display:none;">{t("verify.resend.msg")}</p>
      </div>
    </div>
    <div class="ob-footer ob-footer--with-skip">
      <button id="ob-skip-6" type="button" class="btn-link">{t("onboarding.verify.later")}</button>
      <span></span>
    </div>
  </div>

  {
    /* Step 7: Your visibility (2026-09-08, Josh: "a step where you can set
    your account active"). The one deliberate act the wizard asks for: being
    listed. Ticked by default, because being visible is the default and
    hiding is the choice (2026-09-04, "it should be an active task to untick
    it") — until today that default was written silently at the bridge and
    again at Finish, so a member never saw it. An unverified account cannot be
    published (canPublish in firestore.rules), so for them the box is locked
    off and the note says so, with the way back to the verification step;
    verifying is what publishes them, through the emailed link. */
  }
  <div class="onboarding-step" data-step="7" style="display:none;">
    <header class="ob-header">
      <h1 class="ob-title">{t("onboarding.visibility.title")}</h1>
      <p class="ob-sub">{t("onboarding.visibility.sub")}</p>
    </header>
    <div class="ob-fields">
      <div class="field">
        <label class="checkbox-label" for="ob-active">
          <input id="ob-active" type="checkbox" checked />
          <span>{t("onboarding.visibility.label")}</span>
        </label>
        <p class="field-note">{t("profile.active.note")}</p>
      </div>
      <p id="ob-visibility-locked" class="ob-notice" style="display:none;">
        {t("onboarding.visibility.locked")}
        <button id="ob-visibility-verify" type="button" class="btn-resend-verify"
          >{t("onboarding.visibility.backToVerify")}</button
        >
      </p>
    </div>
    <div class="ob-footer">
      <button id="ob-finish" type="button" class="btn-solid">{t("onboarding.nav.finish")}</button>
    </div>
  </div>

  <!-- Step 8: Done -->
  <div class="onboarding-step ob-done" data-step="8" style="display:none;">
    <header class="ob-header ob-done-header">
      <h1 class="ob-title">{t("onboarding.done.title")}</h1>
      <p class="ob-sub">{t("onboarding.done.sub")}</p>
    </header>
    <div class="ob-done-card">
      <CommunityCardPreview />
    </div>
    {
      /* Filled by finishToPreview from what is actually true of the profile
        it just wrote: listed, hidden by choice, or hidden until verified. The
        one sentence it used to carry ("may take a moment to appear") was told
        to every member, including the ones whose profile was not going to
        appear at all (2026-09-08, Josh: "disclaimer when inactive"). */
    }
    <p id="ob-done-disclaimer" class="ob-notice">{t("onboarding.done.disclaimer")}</p>
    <div class="ob-footer ob-footer--done">
      <a href={`${prefix}/profile`} class="btn-outline">{t("onboarding.done.edit")}</a>
      <a href={`${prefix}/community`} class="btn-solid">{t("onboarding.done.goCommunity")}</a>
    </div>
  </div>
</div>

{
  /* THE VERIFY BANNER IS GONE FROM THE WIZARD (2026-09-08, Josh: "the verify
    your email box should only appear once in the profile view not during
    onboarding"). The amber strip rode along under every step, asking for
    something the wizard now has a whole step for — so an unverified member
    was told twice on the way to that step and, on the step itself, would have
    read the same sentence above the screen making the same request. /profile
    keeps its copy, where it is the only thing that can ask. Resending lives
    on the verify step and on /verify-email. */
}

<style>
  .ob-loading {
    margin-top: 3rem;
    color: #999;
    font-size: var(--fs-90);
  }


  /* The amber banner's own rules went with it; what survives is the quiet
     link inside it, because the visibility step's way back to verification
     wears the same face (see .ob-notice .btn-resend-verify below). */
  .btn-resend-verify {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: var(--fs-88);
    font-weight: 600;
    color: #92400e;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .btn-resend-verify:hover {
    color: #78350f;
  }

  /* THE WIZARD SITS FLAT ON THE PAGE (2026-09-08, Josh: "restyle onboarding
     … white boxes are obsolete"). From 560px up it was a white rounded sheet
     with its own padding, a card drawn around a form; the profile editor lost
     the same sheet on 2026-09-02 and this is the form a member meets first,
     so it now reads as the same page as the one they edit in afterwards:
     the editor's 560px measure, the page ground, no border. */
  .onboarding-wrap {
    width: 100%;
    max-width: 560px;
    margin: clamp(2rem, 4vw, 4rem) auto;
    padding: 0 15px;
    box-sizing: border-box;

    @media (--bp-desktop) {
      padding: 0;
    }
  }

  /* Progress in the editor's tab voice — the same uppercase, spaced, muted
     caption its section tabs use, over a hairline in the border colour with
     the dark part travelled. It was a 3px grey bar with "1 / 5" beside it. */
  .ob-progress {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .ob-progress-bar {
    width: 100%;
    height: 2px;
    background: var(--color-border);
    overflow: hidden;
  }

  .ob-progress-fill {
    height: 100%;
    background: var(--color-dark);
    transition: width 0.4s ease;
  }

  .ob-progress-text {
    color: var(--color-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ob-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }

  .ob-title {
    color: var(--color-dark);
  }

  .ob-sub {
    color: var(--color-muted);
    margin-top: 0;
  }

  /* The editor's rhythm (its form grid runs at 2rem); 3rem was the sheet's
     air, and without the sheet it read as fields drifting apart. */
  .ob-fields {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* The editor's checkbox row, for the visibility step. */
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-95);
    color: #333;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--color-dark);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-label:has(input:disabled) {
    color: var(--color-muted);
    cursor: default;
  }

  /* The verify step's controls — the standalone page's column, one gap. */
  .ob-verify-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .ob-verify-resend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--fs-88);
    color: var(--color-muted);
  }

  .ob-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 1.75rem;
  }

  .ob-footer--with-skip {
    justify-content: space-between;
    align-items: center;
  }

  .ob-footer--bridge {
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-top: 2rem;
  }

  /* The way across to /login from the signup step. Sits outside
     #ob-auth-form so it is there whether the fields are revealed or not:
     a returning member arriving on a "Join our community" CTA needs it
     before they have typed anything. Matches .auth-sub / .toggle-link on
     the login page, which is the other half of the same pair. */
  .ob-have-account {
    font-size: var(--fs-88);
    color: var(--color-muted);
    margin-top: 1.25rem;
    margin-bottom: 0;
  }

  .ob-have-account a {
    color: var(--color-dark);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #ccc;
    transition: border-color 0.15s;
  }

  .ob-have-account a:hover {
    border-color: var(--color-dark);
  }

  /* Bridge step */
  .ob-bridge {
    text-align: center;
    padding: 1rem 0;
  }

  .ob-bridge-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    color: #16a34a;
    font-size: var(--fs-140);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .ob-bridge .ob-sub {
    max-width: 320px;
    margin: 0 auto 0;
  }

  /* Avatar row */
  .ob-avatar-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .ob-avatar-wrap {
    flex-shrink: 0;
    position: relative;
  }

  .ob-avatar-img,
  .ob-avatar-ph {
    width: 64px;
    height: 64px;
    border-radius: 50%;
  }

  .ob-avatar-img {
    display: none;
    object-fit: cover;
  }

  .ob-avatar-ph {
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-160);
    color: #bbb;
    border: 1.5px solid #e5e5e5;
  }

  .ob-avatar-wrap.has-image .ob-avatar-img {
    display: block;
  }

  .ob-avatar-wrap.has-image .ob-avatar-ph {
    display: none;
  }

  .ob-upload-status {
    font-size: var(--fs-82);
    color: var(--color-muted);
    margin-top: 0.4rem;
  }

  /* Gallery (step 5). Thumbnails, and — since 2026-09-08 — the words for the
     FIRST of them, under .ob-cover below. The note that used to stand here
     said the editor was the only place an image got a caption, a description
     and a project; projects are gone, and the cover's three fields are asked
     for here now, because the cover is the card. What the editor still owns
     alone: the German pair, the per-image link, the order, and every image
     after the first. */
  .ob-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 10px;
    margin-bottom: 1rem;
  }

  .ob-gallery-grid:empty {
    display: none;
  }

  /* `.field` is a flex column, so a bare label stretches edge to edge and
     reads as a drop zone rather than a button. */
  .ob-gallery-add {
    align-self: flex-start;
  }

  /* The thumbs are built by the script, so they never carry Astro's scope
     attribute and a plainly-scoped `.ob-gallery-thumb` would compile to a
     selector that matches nothing. `:global()` under the container — which IS
     in the template and does carry the attribute — is what keeps these rules
     scoped to this component without depending on the attribute. */
  .ob-gallery-grid :global(.ob-gallery-thumb) {
    position: relative;
    aspect-ratio: 1;
  }

  .ob-gallery-grid :global(.ob-gallery-thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    box-sizing: border-box;
  }

  .ob-gallery-grid :global(.ob-gallery-thumb-remove) {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 50%;
    font-size: var(--fs-80);
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }

  .ob-gallery-grid :global(.ob-gallery-thumb-remove:hover) {
    background: var(--color-error);
  }

  /* The cover image's three fields. A hairline, not a box: this is a second
     question inside one step, and a panel around it would be the sheet this
     form just lost. Its own 1.5rem rhythm — tighter than .ob-fields' 2rem,
     because these three belong to each other more than they belong to the
     step. */
  .ob-cover {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .ob-cover-header {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  /* Reuse ProfileForm field/tag styles */
  .input-prefix-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color 0.15s;
    min-width: 0;
  }

  .input-prefix-wrap:focus-within {
    border-color: #111;
  }

  .input-prefix {
    padding: 8px 10px;
    background: #f5f5f5;
    color: var(--color-muted);
    font-size: var(--fs-88);
    border-right: 1.5px solid var(--color-border);
    white-space: nowrap;
  }

  .input-prefixed {
    border: none;
    border-radius: 0;
    flex: 1;
    min-width: 0;
  }

  .input-prefixed:focus {
    border-color: transparent;
  }

  /* ── Social links ─────────────────────────────────────── */
  /* The profile editor's rules, kept in step by hand like everything else
     under "Reuse ProfileForm field/tag styles" above — a stack of the same
     prefixed input, each with its own remove control. No border around a row
     and no per-row label: a link is one value, so a bordered block would be a
     box drawn around a single input. */
  .social-editor {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  .social-editor:empty {
    display: none;
  }

  .social-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    min-width: 0;
  }

  .social-row .input-prefix-wrap {
    flex: 1 1 auto;
  }

  .social-add {
    width: fit-content;
  }

  /* An outline circle, in the flow rather than pinned to a corner — there is
     no block here for it to sit in. */
  .social-row-remove {
    flex: 0 0 auto;
    align-self: center;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    color: var(--color-muted);
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    font-size: var(--fs-70);
    line-height: 1;
    cursor: pointer;
  }

  .social-row-remove:hover {
    color: #fff;
    background: var(--color-error);
    border-color: var(--color-error);
  }

  /* Done step (step 5) */
  .ob-done .ob-done-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .ob-done-card {
    width: 100%;
    margin-bottom: 1.25rem;
  }

  /* One notice, two homes: the Done step's disclaimer and the visibility
     step's locked note. Amber like the verify banner, because both of them
     are about the same thing — a profile the directory is not showing. */
  .ob-notice {
    margin: 0;
    padding: 0.75rem 1rem;
    background: #fffbeb;
    border: 1.5px solid #fde68a;
    border-radius: var(--radius-sm);
    color: #92400e;
    font-size: var(--fs-85);
    line-height: 1.5;
  }

  .ob-done .ob-notice {
    margin-bottom: 1.5rem;
  }

  .ob-notice .btn-resend-verify {
    font-size: inherit;
    margin-left: 0.35rem;
  }

  .ob-footer--done {
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  .ob-footer--done .btn-outline,
  .ob-footer--done .btn-solid {
    text-decoration: none;
  }
</style>

