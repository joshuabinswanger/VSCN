---
import { hasDetail, type MemberViewBase } from "../../lib/memberView.ts";
import { href, socialLinks } from "../../lib/links.ts";
import { useTranslations, type Lang } from "../../i18n/utils.ts";

interface Props {
  member: MemberViewBase;
  lang: Lang;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);

// Native <details> on purpose. ClientRouter is active site-wide, so any script
// here would need an astro:page-load / astro:before-swap pair and would leak
// state across navigations if it got that wrong. A disclosure element needs
// none of that, and comes with keyboard and screen-reader behaviour already
// correct.

const bio = member.bio.trim();
const portfolio = member.portfolio.trim();
const social = socialLinks(member.socialMedia.trim());
const tags = member.tags;

// Nothing to disclose — a profile that is name + role only. Rendering an
// empty toggle would promise content that isn't there.
const show = hasDetail(member);
---

{
  show && (
    <details class="pdisc">
      <summary class="pdisc__toggle" aria-label={`${t("community.card.expand")} ${member.displayName}`}></summary>

      <div class="pdisc__body">
        <div class="pdisc__body-inner">
          {bio && <p class="pdisc__bio">{bio}</p>}

          {tags.length > 0 && (
            <div class="pdisc__row">
              <span class="pdisc__key">{t("member.tags")}</span>
              <ul class="pdisc__vals">
                {tags.map((tag) => (
                  <li class="pdisc__val">{tag}</li>
                ))}
              </ul>
            </div>
          )}

          {(portfolio || social.length > 0) && (
            <div class="pdisc__row">
              <span class="pdisc__key">{t("member.elsewhere")}</span>
              <ul class="pdisc__vals pdisc__vals--links">
                {portfolio && (
                  <li>
                    <a class="pdisc__link" href={href(portfolio)} target="_blank" rel="noopener noreferrer">
                      {portfolio}
                    </a>
                  </li>
                )}
                {social.map((s) =>
                  s.href ? (
                    <li>
                      <a class="pdisc__link" href={s.href} target="_blank" rel="noopener noreferrer">
                        {s.label}
                      </a>
                    </li>
                  ) : (
                    <li class="pdisc__val">{s.label}</li>
                  ),
                )}
              </ul>
            </div>
          )}
        </div>
      </div>
    </details>
  )
}

<style>
  .pdisc {
    font-family: "Archivo", sans-serif;
  }

  .pdisc__toggle {
    /* Kill the native marker in both engines; the chevron is drawn below so it
       can sit on the correct side and use the type scale. */
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    width: 1rem;
    flex: 0 0 1rem;
    justify-content: center;
    padding: 0;
    color: var(--color-muted);
  }
  .pdisc__toggle::-webkit-details-marker {
    display: none;
  }
  .pdisc__toggle::marker {
    content: "";
  }

  .pdisc__toggle::after {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-0.12rem);
    transition: transform 320ms ease;
  }
  .pdisc[open] .pdisc__toggle::after {
    transform: rotate(225deg) translate(-0.08rem, -0.08rem);
  }

  .pdisc__toggle:focus-visible {
    color: var(--color-dark);
  }

  .pdisc__body {
    margin-top: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Animate the native details content while keeping the rule attached to the
     full disclosure, so it moves down as the profile opens. */
  .pdisc {
    interpolate-size: allow-keywords;
  }
  .pdisc::details-content {
    block-size: 0;
    content-visibility: hidden;
    overflow: hidden;
    transition:
      block-size 320ms ease,
      content-visibility 320ms allow-discrete;
  }
  .pdisc[open]::details-content {
    block-size: auto;
    content-visibility: visible;
  }

  .pdisc__body-inner {
    min-height: 0;
  }

  .pdisc__bio {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-dark);
  }

  .pdisc__row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pdisc__key {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pdisc__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdisc__val {
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 5px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    /* `socialMedia` is free text and one real value is a comma-joined handle
       plus a full LinkedIn URL. Without this it overruns the card's lane on
       mobile, since there is no space in the URL to break at. */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .pdisc__vals--links {
    flex-direction: column;
    gap: 0.3rem;
  }

  .pdisc__link {
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Long URLs must not widen the card's lane. */
    overflow-wrap: anywhere;
  }
  .pdisc__link:hover {
    color: var(--color-muted);
  }
</style>
