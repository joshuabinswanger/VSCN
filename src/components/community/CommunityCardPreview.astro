---
// Client-bindable shell of the directory card, for the profile editor and the
// onboarding "done" step. The real cards (CommunityImageCard/CommunityTextCard)
// are build-time components fed by Firestore; this shell is bound from live
// form state by renderCardPreview() in src/lib/profilePreview.ts — same
// pattern as ProfileViewPreview: the component owns the design, a function
// binds values, so the preview cannot drift from the real rendering.
//
// It shows the card's FACE: name band, artwork frame (first gallery image)
// when there is one, role line. With no artwork it collapses to the
// typographic card's face — which is exactly what /community renders for that
// member, so the honesty is the point.
---

<div class="ccpv" data-ccpv-root>
  <p class="ccpv__name" data-ccpv="name"></p>
  <div class="ccpv__frame" data-ccpv="frame" hidden>
    <img class="ccpv__img" data-ccpv="img" alt="" />
  </div>
  <p class="ccpv__role" data-ccpv="role" hidden></p>
</div>

<style>
  .ccpv {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 22rem;
    font-family: "Archivo", sans-serif;
  }

  /* Name band — mirrors .ccard__name / .ctcard__name. */
  .ccpv__name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-dark);
  }

  /* Artwork frame — mirrors .ccard__frame. Aspect ratio and dominant colour
     are bound inline per image. */
  .ccpv__frame {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
  }
  .ccpv__frame[hidden] {
    display: none;
  }

  .ccpv__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ccpv__role {
    min-width: 0;
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
  }
  .ccpv__role[hidden] {
    display: none;
  }
</style>
