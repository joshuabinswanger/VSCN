---
// Client-bindable shell of the directory card, for the profile editor and the
// onboarding "done" step. The real cards (CommunityImageCard/CommunityTextCard)
// are build-time components fed by Firestore; this shell is bound from live
// form state by renderCardPreview() in src/lib/profilePreview.ts — same
// pattern as ProfileViewPreview: the component owns the design, a function
// binds values, so the preview cannot drift from the real rendering.
//
// It shows the card's FACE: name band, artwork frame (first gallery image)
// when there is one, role line. With no artwork it shows the typographic
// card's face — the same framed rectangle holding the member's tags stacked
// vertically, falling back to their member-type label, and collapsing to a
// rule when there is neither — which is exactly what /community renders for
// that member, so the honesty is the point. The role always sits on its own
// line below, never inside the frame.
---

<div class="ccpv" data-ccpv-root>
  <p class="ccpv__name" data-ccpv="name"></p>
  <div class="ccpv__frame" data-ccpv="frame" hidden>
    <img class="ccpv__img" data-ccpv="img" alt="" />
  </div>
  <div class="ccpv__tframe" data-ccpv="tframe" hidden>
    <ul class="ccpv__tags" data-ccpv="tags"></ul>
  </div>
  <p class="ccpv__role" data-ccpv="role" hidden></p>
  <template data-ccpv-tpl="tag"><li class="ccpv__tag"></li></template>
</div>

<style>
  .ccpv {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 22rem;
    font-family: "Archivo", sans-serif;
  }

  /* Name band — mirrors .ccard__name / .ctcard__name. */
  .ccpv__name {
    margin: 0;
    font-size: 1.2rem;
    /* Explicit, matching .ccard__name / .ctcard__name. Unset it and this
       resolves to `normal` independently of the real cards, which is how the
       preview silently drifted before. */
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-dark);
  }

  /* Artwork frame — mirrors .ccard__frame: no box, the picture is its own
     edge. The ground stays: it is the fallback colour under an image that
     fades in, not a drawn surface. Aspect ratio and dominant colour are
     bound inline per image. */
  .ccpv__frame {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: var(--color-bg);
  }
  .ccpv__frame[hidden] {
    display: none;
  }

  .ccpv__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Typographic frame — mirrors .ctcard__frame: one hairline where the box's
     top edge used to be, holding tag lines where the artwork would stand.
     Inline padding went with the border, which only ever inset tags from a
     box edge; the vertical padding stays. No --frame-cap here: the preview
     sits in a form, not a grid slot. */
  .ccpv__tframe {
    box-sizing: border-box;
    overflow: hidden;
    padding: 0.7rem 0;
    border-top: 1.5px solid var(--color-border);
    border-radius: 0;
    min-height: 3rem;
  }
  .ccpv__tframe[hidden] {
    display: none;
  }

  /* Nothing to hold — mirrors .ctcard__frame--rule. Now the SAME drawing as
     the base rule with nothing standing under the line, rather than a
     different one: it inherits the hairline and only drops the space. Must
     stay after .ccpv__tframe in source — equal specificity, later wins.
     Toggled by renderCardPreview(). */
  .ccpv__tframe--rule {
    padding: 0;
    min-height: 0;
    margin-block: 0.35rem 0.15rem;
  }

  .ccpv__tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* The tag voice — mirrors .ctcard__tag. */
  .ccpv__tag {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ccpv__role {
    min-width: 0;
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-dark);
  }
  .ccpv__role[hidden] {
    display: none;
  }
</style>
