---
// Client-bindable shell of the directory card, for the profile editor and the
// onboarding "done" step. The real card (CommunityImageCard) is a build-time
// component fed by Firestore; this shell is bound from live form state by
// renderCardPreview() in src/lib/profilePreview.ts — same pattern as
// ProfileViewPreview: the component owns the design, a function binds values,
// so the preview cannot drift from the real rendering.
//
// IT IS THE CARD'S OWN MARKUP NOW, CAROUSEL INCLUDED (2026-09-02, Josh:
// "carousel shouls be the same elemnt in preview as well"). It used to be a
// `.ccpv__*` design of its own — a name band, ONE image in a frame, a role
// line — which meant a member with six gallery images was shown a card that
// could hold one, and the thing the card actually does in the directory was
// the one thing the preview could not show. Every element below carries the
// same `ccard__*` class the real card gives it, in the same order and nesting;
// the rules come from the one stylesheet both import
// (src/styles/communityCard.css) and the paging comes from the one module both
// call (src/lib/communityCarousel.ts).
//
// AND THE COLUMN (2026-10-12, gallery card v2). The card's words stand
// beside the picture, open, so the preview carries them too or it would be
// previewing half a card. Since 2026-10-16 they are the member page's column
// (picture, name, role, affiliation, place, open to, bio, looking for, links,
// PROFILE →), drawn by communityCard.css — a plain sheet, so the same
// `ccard__*` markup below, left empty with `data-ccpv` hooks, takes the card's
// rules exactly. (Until then it was MemberDetailPanel's scoped `shell` mode.)
//
// What is still the preview's own, and has to be:
//   - `.ccard--preview`, which takes back the affordances the shell cannot
//     honour: the name's hover underline, the frame's zoom-in cursor, the
//     button's and the chips' pointers. All are inert here (see below), and
//     all are described in that stylesheet's foot rather than here, because
//     they are rules about the card.
//   - the TYPOGRAPHIC face (`.ccpv__tframe`). It began as a mirror of
//     CommunityTextCard, the gallery's no-artwork card; that component was
//     deleted on 2026-09-08 once neither gallery dealt it any more, so this
//     is now the ONLY copy of that drawing and there is nothing left to share
//     rules with. It is the no-artwork case: a framed rectangle of tag lines
//     with nothing to page, so it has no carousel to get wrong. OPEN: the
//     public galleries no longer render a card for a member with an empty
//     gallery at all, so what this face previews is a card that page will not
//     show — whether the editor should say that instead is undecided.
//   - the arrows, dots and live region are RENDERED ALWAYS and hidden when
//     there is nothing to page. The real card omits them from the markup
//     because it knows the gallery at build time; a shell that is refilled on
//     every gallery change has to keep the boxes and toggle them.
//
// Empty on the server, filled on the client: the editor is behind auth and the
// member's data never reaches the build, so there is nothing to render here
// until the form has loaded. The one thing rendered with words is the
// profile button's label, which is the page's language and nobody's data.
import { useTranslations, type Lang } from "../../i18n/utils.ts";
import "../../styles/communityCard.css";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

{/* The slot's stand-in: an inline-size container, so the card can measure
    the room it has the way a directory card measures its cell. */}
<div class="ccpv-slot">
<article class="ccard ccard--preview" data-ccpv-root>
  <div class="ccard__body" data-ccpv="body" hidden>
    {
      /* The frame IS the Embla viewport, exactly as on the card: the module
         is handed this node and everything it needs is INSIDE — a track it
         may translate, with the click target, the arrows and the live region
         as siblings of that track, untouched by the motion. The aspect ratio
         and the dominant colour are bound inline per image, and
         `data-position-label` carries the translated "Image {n} of {total}"
         the live region is rebuilt from. */
    }
    <div class="ccard__frame" data-ccpv="frame" data-carousel>
      <div class="ccard__track" data-ccpv="track"></div>
      {
        /* No click overlay: the slides are the lightbox's triggers (see the
           card), href-less here so a link to the raw Storage file can never
           take the member out of their unsaved form. */
      }
      <button
        class="ccard__arrow ccard__arrow--prev"
        type="button"
        data-carousel-prev
        data-ccpv="prev"
        hidden
      >
        <span aria-hidden="true"></span>
      </button>
      <button
        class="ccard__arrow ccard__arrow--next"
        type="button"
        data-carousel-next
        data-ccpv="next"
        hidden
      >
        <span aria-hidden="true"></span>
      </button>
      {/* Empty at render: a live region has to be in the DOM before the change
          it announces. */}
      <p class="ccard__live" aria-live="polite" aria-atomic="true" data-carousel-live></p>
    </div>
  </div>

  {
    /* The typographic face — inherited from the deleted CommunityTextCard's
       .ctcard__frame: one hairline where the
       box's top edge used to be, holding tag lines where the artwork would
       stand. Shown only when the member has no gallery at all, which is
       exactly the rule /community applies (`hasArtwork`). It stands where
       the picture would (the card's first column, both rows). */
  }
  <div class="ccpv__tframe" data-ccpv="tframe" hidden>
    <ul class="ccpv__tags" data-ccpv="tags"></ul>
  </div>

  {
    /* The column, as the card renders it: an <h2> like the card's, and a
       <span> where the card has an <a> — the card's name links to the
       member's page, and a live control that walked the member out of an
       unsaved form would be a trap, the same call the profile-page preview
       makes for its back link. Every line hidden until it has words. */
  }
  {/* THE WORDS, one box (2026-10-16, Josh: "on desktop the images to be
      totally centered and the text to the left"): name and role, the panel,
      the count. A desktop hangs it off the centred picture's left edge; a
      phone dissolves it (display: contents) and places its parts itself. */}
  <div class="ccard__words">
    <div class="ccard__head">
      <img class="ccard__avatar" data-ccpv="avatar" width="112" height="112" alt="" hidden />
      <h2 class="ccard__name"><span class="ccard__name-link" data-ccpv="name"></span></h2>
      <p class="ccard__role" data-ccpv="role" hidden></p>
      <p class="ccard__affiliation" data-ccpv="affiliation" hidden></p>
      <p class="ccard__where" data-ccpv="where" hidden></p>
      <p class="ccard__open" data-ccpv="open" hidden></p>
    </div>
    <div class="ccard__more">
      <p class="ccard__bio" data-ccpv="bio" hidden></p>
      <div class="ccard__row ccard__row--needs" data-ccpv="needs-row" hidden>
        <h3 class="ccard__key">{t("member.needs")}</h3>
        <ul class="ccard__vals" data-ccpv="needs"></ul>
      </div>
      <ul class="ccard__links" data-ccpv="links" hidden></ul>
      {/* Last, as on the card — a <span> here because there is no page to
          go to from an unsaved form. */}
      <span class="ccard__profile">
        {t("community.card.profile")}
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </div>
  {/* The count, outside the words as on the card. */}
  <div class="ccard__foot">
    <div class="ccard__dots" data-ccpv="dots" hidden></div>
  </div>

  {
    /* Cloned by the renderer. A template's content is inert, so cloning is the
       cheapest way to keep the shape of a slide in markup instead of in string
       concatenation — and the clone carries this component's scope attribute,
       which a node built in JS would not (see renderProfilePreview's header).
       The slide's data-pswp-* set (+ data-work-url) is what communityCarousel.ts reads; it is
       filled per image so the shell speaks the card's own contract. The
       column's link and value templates follow it. */
  }
  <template data-ccpv-tpl="slide"
    ><a class="ccard__slide" tabindex="-1"><img class="ccard__img" alt="" decoding="async" /></a></template
  >
  <template data-ccpv-tpl="dot"><span class="cdot"></span></template>
  <template data-ccpv-tpl="tag"><li class="ccpv__tag"></li></template>
  <template data-ccpv-tpl="plink"><li><a class="ccard__link" target="_blank" rel="noopener"></a></li></template>
  <template data-ccpv-tpl="pval"><li class="ccard__val"></li></template>
</article>
</div>

<style>
  /* ── The typographic face ──────────────────────────────
     The only design left in this component, and only because it is the
     no-artwork case (see the header). Carried over from the deleted
     CommunityTextCard's .ctcard__frame, and now the only copy of it: inline
     padding went with the border, which only ever inset tags from a box edge; the
     vertical padding stays. No --frame-cap here — the preview sits in a form,
     not a grid slot. In the picture's place on the card's grid. */
  .ccpv__tframe {
    grid-area: 1 / 1 / 3 / 2;
    box-sizing: border-box;
    overflow: hidden;
    padding: 0.7rem 0;
    border-top: 1.5px solid var(--color-border);
    border-radius: 0;
    min-height: 3rem;
  }

  /* Nothing to hold — was .ctcard__frame--rule. The SAME drawing as the
     base rule with nothing standing under the line, rather than a different
     one: it inherits the hairline and only drops the space. Must stay after
     .ccpv__tframe in source — equal specificity, later wins. Toggled by
     renderCardPreview(). */
  .ccpv__tframe--rule {
    padding: 0;
    min-height: 0;
    margin-block: 0.35rem 0.15rem;
  }

  .ccpv__tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* The tag voice — was .ctcard__tag; before that, MemberDetailPanel's chips
     without the chip border. */
  .ccpv__tag {
    color: var(--color-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* THE FRAME THE DIRECTORY WOULD GIVE (2026-10-15, the pages card): a form
     has no viewport-tall cell, so the preview states a height of its own —
     the card's grid then fills it exactly as the directory's cell does. The
     phone's rule in communityCard.css lets the card grow instead. */
  .ccpv-slot {
    container-type: inline-size;
  }
  .ccard--preview {
    --cpage-h: 30rem;
    --cpage-pic-h: 24rem;
    --ccard-side-w: 16rem;
    /* Narrower than a page: the plain words | air | picture, no mirror
       column to centre the picture against. */
    --ccard-pic-room: calc(100cqw - var(--ccard-side-w) - var(--ccard-air));
  }
  @media (--bp-desktop) {
    .ccard--preview {
      grid-template-columns: fit-content(var(--ccard-side-w)) var(--ccard-air) auto;
    }
  }
</style>
