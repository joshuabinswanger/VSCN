---
import { getImage } from "astro:assets";
import type { MemberView } from "../../lib/memberView.ts";
import { memberHref, workCaption, workDescription } from "../../lib/links.ts";
import { embedDataAttrs } from "../../lib/embed.ts";
import { projectSlideData } from "../../lib/projects.ts";
import { useTranslations, type Lang } from "../../i18n/utils.ts";
import MemberDetailPanel from "./MemberDetailPanel.astro";
// THIS CARD'S SURFACE, in a file of its own so the profile editor's preview
// can render the identical card — carousel included — instead of a still
// picture that looks like one. See the header of communityCard.css; moving
// the rules out of a scoped <style> is the whole mechanism, because a scoped
// block cannot be shared.
import "../../styles/communityCard.css";

interface Props {
  member: MemberView;
  lang: Lang;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);

// Gallery images are Firebase Storage remote URLs; getImage optimises them at
// build time (remotePatterns in astro.config.mjs). Originals are client-side
// compressed to a 4K-capped WebP already (MAX_EDGE in gallery.ts) — these are
// the sizes the card lays out. The widest slot is 8 of the grid's 24 columns —
// ~667px at --grid-max — so 1400 is what covers the biggest card at 2x DPR,
// and 800 the common ones.
const works = await Promise.all(
  member.works.map(async (w) => ({
    ...w,
    rendered: await getImage({
      src: w.url,
      width: w.width,
      height: w.height,
      widths: [400, 800, 1400],
      format: "webp",
    }),
  }))
);

const frame = works[0];

// A single work still gets the track markup — same box, same CSS — but no
// carousel semantics, no controls and no Embla instance. Calling one picture a
// carousel would be a lie to a screen reader, and a drag handler on it would
// only buy a non-passive touchmove for nothing.
const isCarousel = works.length > 1;

// Deliberately UNDER-sized on mobile (a full-bleed card is really ~92vw): at
// 55vw no phone DPR ever selects the 1400w variant, only the 800. The page
// stacks every gallery image of every member into the DOM, and decoded-image
// memory is what crash-looped iOS Safari ("a problem repeatedly occurred") —
// an 800 upscaled a hair on a 3x screen is invisible; 60 × 1400 decodes is a
// dead tab. This describes the CARD, not the slide, and must stay that way: a
// `sizes` rewritten to match the track's slide widths puts the 1400s back on
// phones and the crash back with them.
const SIZES = "(max-width: 767px) 55vw, 680px";

// The frame keeps the artwork's TRUE aspect at every ratio — nothing here is
// cropped or letterboxed. Tall artwork is bounded by getting narrower instead,
// which the stylesheet does with --frame-ar and the slot height the grid hands
// down; see .ccard__frame. This ratio is the input to that.
const frameAspect = frame.width / frame.height;

const profileHref = memberHref(lang, member.slug);

// WHAT THE LIGHTBOX GETS, one entry per work. EVERY SLIDE IS A LIGHTBOX ITEM
// (2026-09-08, Josh: "photoswipe should pick all images in the gallery ...
// not only the currently showing one"): each slide carries the full
// `data-pswp-*` set the shared text renderer reads (lightboxText.ts), and
// CommunityGrid's lightbox opens the card's whole carousel from these,
// starting on the slide the visitor was looking at. The single link over the
// frame is still the click target and still mirrors the selected slide's set
// (see `syncTrigger` in communityCarousel.ts) — that keeps its href, and so
// the no-script fallback, pointing at the picture on screen.
//
// The meta line is the member's name and nothing else, exactly as the wall's
// tile resolves it (CommunityWorkCard): full screen, the card's own name
// heading is covered, so the name is the one thing the view has lost — and
// since 2026-09-03 it is a LINK to their page while the lightbox is open, which
// is the only route out of a full-screen picture to the person who made it.
// `data-pswp-profile` is what carries it — on every slide, because a slide is
// now a lightbox item in its own right, and on the trigger too.
const pswpFor = (w: (typeof works)[number]) => {
  // THE PROJECT THIS WORK IS IN (2026-09-23) — the lightbox's "Part of …"
  // line and its affiliations, same data the member page's trigger carries.
  const slide = projectSlideData(member.projects?.find((p) => p.id === w.projectId), lang);
  return {
    width: String(w.width),
    height: String(w.height),
    // PICKED FOR THIS PAGE'S LOCALE (2026-09-25), the member page's rule
    // (workCaption/workDescription in links.ts). These read the raw English
    // fields, so /de/community's lightbox showed English under a German
    // interface.
    caption: workCaption(w, lang)?.trim() || "",
    // THE DESCRIPTION — the only one there is, since 2026-09-04 (see
    // GalleryItem.description in gallery.ts). What this feeds is the lightbox,
    // which has room for it: the card itself never prints it.
    description: workDescription(w, lang) || "",
    // Where the image appeared — already absolute and already filtered for
    // linkability by workLink(). Per slide, unlike `meta` and the profile
    // href below: every image in this card is the same member's, but each
    // one appeared somewhere of its own.
    link: w.link || "",
    // The member's own project page for the piece (2026-09-10) — same treatment.
    siteLink: w.siteLink || "",
    meta: member.displayName,
    project: slide.project || "",
    projectLink: slide.projectLink || "",
    affiliations: slide.affiliations || "",
  };
};

// Alt: the member's own caption when they wrote one, a translated fallback
// otherwise — never "" (a named debt of the prototype this card graduated
// from).
const altFor = (w: (typeof works)[number]) =>
  workCaption(w, lang)?.trim() || `${member.displayName} — ${t("member.workAlt")}`;


// "Image {n} of {total}". Filled here for the per-slide labels and handed to
// the client as a template too, because the live region rebuilds it at every
// slide change and the client script has no translations. The placeholders are
// literal, so a translator may move them within the sentence.
const positionTemplate = t("community.card.imagePosition");
const positionFor = (i: number) =>
  positionTemplate.replace("{n}", String(i + 1)).replace("{total}", String(works.length));
---

<article class="ccard" style={`--frame-ar:${frameAspect}`}>
  {
    /* THE SECOND CARD (2026-10-12, Josh's sketch): the artwork on the left,
      the words beside it on the right, open; a foot row under the words with
      the pager at the picture's bottom-right corner and a filled PROFILE →
      at the far right; a rail down the card's right edge that folds the
      words away. The grid that places these is in communityCard.css; the
      column is MemberDetailPanel in its column mode, below. The frame and
      everything in it is the first card's, untouched — the carousel, the
      lightbox contract and the member-page morph all key off it. */
  }
  <div class="ccard__body">
    {
      /* The frame IS the Embla viewport. Wrapping it in one would have moved
        transition:name off the box the member-page morph is keyed to, and
        broken the frame's width formula, which reads this element's aspect
        box. So Embla is handed this node as its root and everything it needs
        is added INSIDE: a track it may translate, with the click target, the
        arrows and the live region as siblings of that track, untouched by
        the motion. */
    }
    <div
      class="ccard__frame"
      style={`aspect-ratio:${frame.width} / ${frame.height};${frame.color ? `background:${frame.color}` : ""}`}
      transition:name={`mimg-${member.id}`}
      data-carousel
      data-position-label={isCarousel ? positionTemplate : undefined}
      role={isCarousel ? "group" : undefined}
      aria-roledescription={isCarousel ? t("community.card.carousel") : undefined}
      aria-label={isCarousel ? `${member.displayName} — ${t("community.card.gallery")}` : undefined}
    >
      <div class="ccard__track">
        {
          /* Only the first image carries a real src. The rest of the gallery
            waits as data-src until the visitor first touches or hovers THIS
            carousel, or until Embla reports the slide entering the frame (see
            the script's hydrate) — before that, every member's whole gallery
            decoded at once, which is what crash-looped iOS Safari. Embla
            operates on existing DOM and never writes src, so moving the
            images into a track leaves this defence exactly as it was.
            Off-screen slides are aria-hidden and the script keeps that in step
            with the selected index: previously every work's alt text was
            announced at once, because opacity:0 hides nothing from a screen
            reader. */
          works.map((w, i) => (
            <div
              class="ccard__slide"
              role={isCarousel ? "group" : undefined}
              aria-roledescription={isCarousel ? t("community.card.image") : undefined}
              aria-label={isCarousel ? positionFor(i) : undefined}
              aria-hidden={isCarousel && i !== 0 ? "true" : undefined}
              data-work-url={w.url}
              data-pswp-width={pswpFor(w).width}
              data-pswp-height={pswpFor(w).height}
              data-pswp-caption={pswpFor(w).caption || undefined}
              data-pswp-description={pswpFor(w).description || undefined}
              data-pswp-link={pswpFor(w).link || undefined}
              data-pswp-site-link={pswpFor(w).siteLink || undefined}
              data-pswp-meta={pswpFor(w).meta}
              data-pswp-profile={profileHref}
              data-pswp-project={pswpFor(w).project || undefined}
              data-pswp-project-link={pswpFor(w).projectLink || undefined}
              data-pswp-affiliations={pswpFor(w).affiliations || undefined}
              {...embedDataAttrs(w.embed)}
            >
              <img
                class="ccard__img"
                src={i === 0 ? w.rendered.src : undefined}
                srcset={i === 0 ? w.rendered.srcSet.attribute : undefined}
                data-src={i === 0 ? undefined : w.rendered.src}
                data-srcset={i === 0 ? undefined : w.rendered.srcSet.attribute}
                sizes={SIZES}
                width={w.width}
                height={w.height}
                style={w.color ? `background:${w.color}` : undefined}
                alt={altFor(w)}
                loading="lazy"
                decoding="async"
              />
              {w.embed && <span class="vscn-play vscn-play--over" aria-hidden="true" />}
            </div>
          ))
        }
      </div>
      {
        /* Whole-artwork click target. A sibling of the arrows AND of the track
          rather than a wrapper, so no interactive element nests inside another
          and Embla never translates it; the arrows sit above it on z-index and
          keep working. It is also the carousel's only tab stop, which is what
          the keydown handler hangs the arrow keys off — see the script.

          IT OPENS THE PICTURE, NOT THE PROFILE (2026-09-01, Josh: "on click
          directly lightbox"). Clicking an image to be taken somewhere else is
          the one thing a wall of artwork should not do — the picture is what
          was clicked, so the picture is what opens. The profile did not lose
          its way in: the name at the head of the column is a link to it, and
          the foot row ends with an explicit PROFILE → button (see
          .ccard__foot). That pairing — image opens image, a named control
          goes to the person — is the same one the ledger rows use.

          The href is the ORIGINAL upload of THE SELECTED SLIDE, rewritten by
          the script on every carousel move (rendered from slide 0, so it is
          right before any script runs). It is what keeps the link meaningful
          with scripting off, and it is how the lightbox knows which slide to
          open on: CommunityGrid intercepts the click, gathers every
          .ccard__slide in this frame as the lightbox's items, and starts on
          the one whose data-work-url matches this href. The data-pswp-* copy
          on the link itself is a mirror kept for that contract's readability;
          the lightbox reads the slides. */
      }
      <a
        class="ccard__frame-link"
        href={frame.url}
        target="_blank"
        rel="noreferrer"
        data-pswp-width={pswpFor(frame).width}
        data-pswp-height={pswpFor(frame).height}
        data-pswp-caption={pswpFor(frame).caption || undefined}
        data-pswp-description={pswpFor(frame).description || undefined}
        data-pswp-link={pswpFor(frame).link || undefined}
        data-pswp-site-link={pswpFor(frame).siteLink || undefined}
        data-pswp-meta={pswpFor(frame).meta}
        data-pswp-profile={profileHref}
        data-pswp-project={pswpFor(frame).project || undefined}
        data-pswp-project-link={pswpFor(frame).projectLink || undefined}
        data-pswp-affiliations={pswpFor(frame).affiliations || undefined}
        aria-label={`${t("community.card.openImage")} ${member.displayName}`}></a>
      {
        isCarousel && (
          <>
            <button
              class="ccard__arrow ccard__arrow--prev"
              type="button"
              data-carousel-prev
              aria-label={t("community.card.prev")}
            >
              <span aria-hidden="true" />
            </button>
            <button
              class="ccard__arrow ccard__arrow--next"
              type="button"
              data-carousel-next
              aria-label={t("community.card.next")}
            >
              <span aria-hidden="true" />
            </button>
            {/* Empty at render: a live region has to be in the DOM before the
                change it announces, and "Image 1 of 3" from every card at page
                load is noise, not information. */}
            <p class="ccard__live" aria-live="polite" aria-atomic="true" data-carousel-live />
          </>
        )
      }
    </div>
  </div>

  {
    /* THE HEAD: name and role, at the top of the words. The h2 is the
      directory's outline (h1 member count → h2 member) and its link is the
      way to the member's page, keyed for the morph that page plays on
      arrival. A name is not an affordance, though — nothing says it is
      clickable before pointing at it — which is why the foot row ends with a
      button that says where it goes.
      OUTSIDE THE FOLD, not slotted into the panel (2026-10-12, Josh: "on
      mobile start closed and show name always"). A folded <details> renders
      nothing but its summary, so a name inside it could not outlive the
      fold. The desktop fold still takes it — "fold everything", by the
      card's grid in communityCard.css — but on a phone the card starts
      folded and the name is what stays. */
  }
  <div class="ccard__head">
    <h2 class="ccard__name">
      <a class="ccard__name-link" href={profileHref} transition:name={`mname-${member.id}`}>
        {member.displayName}
      </a>
    </h2>
    {member.role && <p class="ccard__role">{member.role}</p>}
  </div>

  {
    /* THE COLUMN: the rest of the member's words, open, and the rail that
      folds them. MemberDetailPanel owns the bio, the links and the tag chips
      (every chip a way into the directory's tag filter) and the native
      <details> that folds them — the same component the ledger rows use, in
      its column mode. forceShow: a member with no bio, no links and no tags
      still needs the rail, or the card could not fold. */
  }
  <MemberDetailPanel member={member} lang={lang} forceShow mode="column" />

  {
    /* THE FOOT, on the picture's bottom edge: the count "‹ 1 / 3 ›" just past
      the frame's bottom-right corner (the sketch's place for it), and the
      PROFILE → button at the far right. The foot goes with the column when
      the column is folded; a folded card is the picture and the rail, nothing
      else. */
  }
  <div class="ccard__foot">
    {
      /* The count row. Not aria-hidden (since 2026-09-28) — the chevrons are
        named buttons a screen reader can reach and press — but NOT tab
        stops. A directory page holds a couple of dozen cards; giving each
        one two focusable chevrons would put dozens of tab stops in front of
        the member links that are the page's actual journey, to duplicate
        paging the edge arrows and the frame's arrow keys already do. The
        position is also spoken by the live region inside the frame. The
        dots themselves are pointer-events:none indicators.
        THE POSITION AS TEXT (2026-09-28, Josh: "try text instead of dots").
        The dots stay in the markup and the engine, hidden by one rule in
        communityCard.css, so switching back is that rule. The chevrons page
        (communityCarousel.ts wires them, src/lib/pager.ts draws the same
        pair for the preview) and carry the edge arrows' names. */
    }
    {
      isCarousel && (
        <div class="ccard__dots">
          <button
            class="pager-chev pager-chev--prev"
            type="button"
            tabindex="-1"
            aria-label={t("community.card.prev")}
            title={t("community.card.prev")}
          >
            <span aria-hidden="true" />
          </button>
          <span class="ccard__count">1 / {works.length}</span>
          <button
            class="pager-chev pager-chev--next"
            type="button"
            tabindex="-1"
            aria-label={t("community.card.next")}
            title={t("community.card.next")}
          >
            <span aria-hidden="true" />
          </button>
          {works.map((_, i) => (
            <span class="ccard__dot" class:list={{ "ccard__dot--on": i === 0 }} />
          ))}
        </div>
      )
    }
    {
      /* THE NAMED WAY TO THE PERSON (2026-09-01, Josh: "add 'view profile'
        button to image cards"), a FILLED button since the second card
        (2026-10-12). It exists because the frame stopped going there: the
        artwork opens the artwork, so the journey to a member's page needs a
        control that says where it goes. A LINK, not a button element,
        because it goes somewhere. The arrow is markup, aria-hidden, so the
        link reads as "Profile" and not as "Profile right arrow". */
    }
    <a class="ccard__profile" href={profileHref}>
      {t("community.card.profile")}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<script>
  // The wiring lives in src/lib/communityCarousel.ts, shared with the profile
  // editor's card preview — see that file's header. This card's job is only to
  // start it: the markup contract is above, the behaviour is there, and the
  // navigation sweep registers itself inside the module.
  import { initCarousels } from "../../lib/communityCarousel.ts";

  document.addEventListener("astro:page-load", () => initCarousels());
  initCarousels();
</script>
