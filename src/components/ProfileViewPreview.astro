---
// The member's public profile page, rendered as an empty shell that
// renderProfilePreview() (src/lib/profilePreview.ts) fills from live form
// state.
//
// IT IS THE PAGE'S OWN MARKUP, NOT A LOOKALIKE (2026-09-01, Josh: "profile
// preview should actually show the profile page 1 to 1, atm it is not accurate
// at all"). Every element below carries the same `mprof__*` class the real
// page gives it, in the same order and nesting, and the rules come from the
// one stylesheet both import — src/styles/profile.css, which is why those
// rules left the page's scoped <style> block. The previous shell had its own
// `.ppv__*` design that tried to track the page by hand and had drifted on
// almost every axis: no profile picture at all, the meta rows in a different
// order under headings the page does not print, links stacked where the page
// wraps them, and a different type scale.
//
// What is still the preview's own, and has to be:
//   - the stage around it (the threshold rule, the note, the white sheet),
//     which is editor chrome and belongs to no page;
//   - `.mprof--preview`, which drops the page's outer padding — the sheet
//     already provides that air;
//   - `.mprof__empty`, the "no images yet" note. The real page renders no
//     gallery section at all when a member has no artwork, and in the editor
//     an absent section and an empty one look identical while only one of them
//     is worth acting on.
//
// Empty on the server, filled on the client: the editor is behind auth and the
// member's data never reaches the build, so there is nothing to render here
// until the form has loaded.
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import "../styles/profile.css";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

{
  /* The threshold. Everything below the rule is the visitor's rendering, and
     nothing above it is — before this, the preview ran flush against the
     editor's own fields and there was no line to say where one stopped.

     A hairline, a micro-label and white space; no grey panel. The sheet is
     plain white against the page's warm #fcfbfa ground, which is what makes it
     read as a separate surface without a fill to say so. */
}
<div class="ppv-stage">
  <p class="ppv-stage__threshold">
    <span class="ppv-stage__badge">{t("profile.view.threshold")}</span>
  </p>
  <p class="ppv-stage__note">{t("profile.view.note")}</p>

  <div class="ppv-sheet">
    <article class="mprof mprof--preview" data-ppv-root>
      {
        /* The page's back link, printed and inert. A <span> rather than the
           page's <a>: it is here so the composition is complete, and a live
           control that walks the member out of an unsaved form would be a
           trap. Same class, so it sits exactly where the page puts it. */
      }
      <span class="mprof__back">&#8592; {t("member.backToCommunity")}</span>

      <header class="mprof__head">
        {
          /* Hidden until the member has a picture, which is also how the grid
             above it behaves on the real page: with no <img> the copy block
             takes the first column by auto-placement, so the head reads the
             same either way. */
        }
        <img class="mprof__avatar" data-ppv="avatar" alt="" width="144" height="144" hidden />
        <div class="mprof__head-copy">
          {/* An <h1> like the page's — the sheet is a rendering of a page, and
              a heading demoted for being inside an editor would be a different
              document. */}
          <h1 class="mprof__name" data-ppv="name"></h1>
          <p class="mprof__role" data-ppv="role" hidden></p>
          <p class="mprof__affiliation" data-ppv="affiliation" hidden></p>
          <p class="mprof__where" data-ppv="where" hidden></p>
          <p class="mprof__open" data-ppv="open" hidden></p>
        </div>
      </header>

      <p class="mprof__bio" data-ppv="bio" hidden></p>

      {
        /* THE THREE META ROWS, IN THE PAGE'S ORDER — needs, then tags, then
           links — and with the page's labelling: only the needs row prints a
           key. Tags and links are self-evident as chips and as links, and the
           real page says so by omitting the heading; the old shell printed
           "TAGS" and "ELSEWHERE" over both. */
      }
      <div class="mprof__meta">
        <div class="mprof__row" data-ppv="needs-row" hidden>
          <h2 class="mprof__key">{t("member.needs")}</h2>
          <ul class="mprof__vals" data-ppv="needs"></ul>
        </div>

        <div class="mprof__row" data-ppv="tags-row" hidden>
          <ul class="mprof__vals" data-ppv="tags"></ul>
        </div>

        <div class="mprof__row" data-ppv="links-row" hidden>
          <ul class="mprof__vals mprof__vals--links" data-ppv="links"></ul>
        </div>
      </div>

      <div class="mprof__works" data-ppv="works" hidden></div>
      <p class="mprof__empty" data-ppv="works-empty" hidden></p>

      {
        /* Cloned by the renderer. Rendered here rather than built in JS for
           one reason that has outlived the scoped styles: a template's content
           is inert, so cloning it is the cheapest way to keep the shape of a
           list item in markup instead of in string concatenation. */
      }
      <template data-ppv-tpl="val"><li class="mprof__val"></li></template>
      <template data-ppv-tpl="link"
        ><li><a class="mprof__link" target="_blank" rel="noopener noreferrer"></a></li></template
      >
      {
        /* The border belongs to the link, not to the figure — exactly as on
           the page, where .mprof__work-link is the framed element and the
           figcaption follows it outside the frame. No href: the page's link
           opens the lightbox, and there is none here. */
      }
      <template data-ppv-tpl="work"
        ><figure class="mprof__work">
          <a class="mprof__work-link"><img class="mprof__img" alt="" decoding="async" /></a>
          <figcaption class="mprof__caption" data-ppv-work="caption-block" hidden>
            <span class="mprof__caption-line" data-ppv-work="caption" hidden></span>
            <span class="mprof__desc" data-ppv-work="desc" hidden></span>
          </figcaption>
        </figure></template
      >
    </article>
  </div>
</div>

<style>
  /* ── Stage: where the editor stops and the visitor view starts ──
     Everything in this block is the editor's frame around the preview. The
     page itself is styled by src/styles/profile.css, shared with the real
     page — nothing here may describe it. */
  .ppv-stage {
    font-family: "Archivo", sans-serif;
  }

  /* Label, then a rule to the right edge — the same typographic voice as the
     meta keys inside, so the threshold belongs to the page rather than
     announcing itself as a widget. */
  .ppv-stage__threshold {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
  }

  .ppv-stage__threshold::after {
    content: "";
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-border);
  }

  .ppv-stage__badge {
    flex: 0 0 auto;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ppv-stage__note {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 46ch;
  }

  /* The page-like containment: a sheet of white with a hairline round it and
     real margin inside. The padding is the breathing room — the preview used
     to start at the editor's own left edge, which is exactly why it read as
     more form rather than as a page. */
  .ppv-sheet {
    margin-top: 1.75rem;
    padding: clamp(1.25rem, 5vw, 3rem);
    background: #fff;
    border: 1px solid var(--color-border);
    /* Square, like every other frame on the site. */
    border-radius: 0;
  }
</style>
