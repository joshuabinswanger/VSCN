---
// The member's public profile page, rendered as an empty shell that
// renderProfilePreview() (src/lib/profilePreview.ts) fills from live form
// state. Same design as the profile page at /proto/profile/<id>, so what the
// editor shows and what a visitor gets are one composition rather than two
// that have to be kept in step by hand.
//
// Empty on the server, filled on the client: the editor is behind auth and the
// member's data never reaches the build, so there is nothing to render here
// until the form has loaded.
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
---

{
  /* The threshold. Everything below the rule is the visitor's rendering, and
     nothing above it is — before this, the preview ran flush against the
     editor's own fields and there was no line to say where one stopped.

     A hairline, a micro-label and white space; no grey panel. The sheet is
     plain white against the page's warm #fcfbfa ground, which is what makes it
     read as a separate surface without a fill to say so. */
}
<div class="ppv-stage">
  <p class="ppv-stage__threshold">
    <span class="ppv-stage__badge">{t("profile.view.threshold")}</span>
  </p>
  <p class="ppv-stage__note">{t("profile.view.note")}</p>

  <div class="ppv-sheet">
    <section class="ppv">
      <header class="ppv__head">
        <h3 class="ppv__name" data-ppv="name"></h3>
        <p class="ppv__role" data-ppv="role" hidden></p>
        <p class="ppv__role" data-ppv="affiliation" hidden></p>
        <p class="ppv__where" data-ppv="where" hidden></p>
        <p class="ppv__open" data-ppv="open" hidden></p>
      </header>

      <p class="ppv__bio" data-ppv="bio" hidden></p>

      <div class="ppv__meta">
        <div class="ppv__row" data-ppv="tags-row" hidden>
          <span class="ppv__key">{t("profile.view.tags")}</span>
          <ul class="ppv__vals" data-ppv="tags"></ul>
        </div>

        <div class="ppv__row" data-ppv="needs-row" hidden>
          <span class="ppv__key">{t("profile.view.needs")}</span>
          <ul class="ppv__vals" data-ppv="needs"></ul>
        </div>

        <div class="ppv__row" data-ppv="links-row" hidden>
          <span class="ppv__key">{t("profile.view.elsewhere")}</span>
          <ul class="ppv__vals ppv__vals--links" data-ppv="links"></ul>
        </div>

      </div>

      <div class="ppv__works" data-ppv="works" hidden></div>
      <p class="ppv__empty" data-ppv="works-empty" hidden></p>

      {/* Cloned by the renderer. Rendered here rather than built in JS so the
          clones inherit Astro's scope attribute and match the styles below. */}
      <template data-ppv-tpl="val"><li class="ppv__val"></li></template>
      <template data-ppv-tpl="link"
        ><li><a class="ppv__link" target="_blank" rel="noopener noreferrer"></a></li></template
      >
      {/* The frame is an inner div, not the figure, so the caption block sits
          OUTSIDE the border — same relationship the real page has, where the
          border belongs to the lightbox link and the figcaption follows it. */}
      <template data-ppv-tpl="work"
        ><figure class="ppv__work">
          <div class="ppv__frame"><img class="ppv__img" alt="" decoding="async" /></div>
          <figcaption class="ppv__caption" data-ppv-work="caption-block" hidden>
            <span class="ppv__caption-line" data-ppv-work="caption" hidden></span>
            <span class="ppv__desc" data-ppv-work="desc" hidden></span>
          </figcaption>
        </figure></template
      >
    </section>
  </div>
</div>

<style>
  /* ── Stage: where the editor stops and the visitor view starts ── */
  .ppv-stage {
    font-family: "Archivo", sans-serif;
  }

  /* Label, then a rule to the right edge — the same typographic voice as the
     .ppv__key rows inside, so the threshold belongs to the page rather than
     announcing itself as a widget. */
  .ppv-stage__threshold {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0;
  }

  .ppv-stage__threshold::after {
    content: "";
    flex: 1 1 auto;
    height: 1px;
    background: var(--color-border);
  }

  .ppv-stage__badge {
    flex: 0 0 auto;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ppv-stage__note {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 46ch;
  }

  /* The page-like containment: a sheet of white with a hairline round it and
     real margin inside. The padding is the breathing room — the preview used
     to start at the editor's own left edge, which is exactly why it read as
     more form rather than as a page. */
  .ppv-sheet {
    margin-top: 1.75rem;
    padding: clamp(1.25rem, 5vw, 3rem);
    background: #fff;
    border: 1px solid var(--color-border);
    /* Square, like every other frame on the site. */
    border-radius: 0;
  }

  .ppv {
    font-family: "Archivo", sans-serif;
  }

  /* The renderer hides empty sections with the `hidden` attribute, which the UA
     stylesheet implements as `display: none` — and ANY author `display` beats
     it. Several parts here are `display: flex`, so without this rule an empty
     "Open to" or "Elsewhere" row renders as a stray heading with nothing under
     it. Served specificity (0,4,0) against the class rules' (0,2,0), counting
     Astro's scope attribute on every compound. */
  .ppv [hidden] {
    display: none;
  }

  /* ── Identity ─────────────────────────────────────────── */
  /* The card's name band grown to page scale — same face, same tightness. */
  .ppv__name {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-dark);
    overflow-wrap: anywhere;
  }

  .ppv__role {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-dark);
  }

  .ppv__where {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* Availability — a dot plus the words, never a bare coloured pill: the page
     has no accent colour, and a dot alone carries no meaning to anyone who
     cannot see it. The only round thing here, and deliberately so. */
  .ppv__open {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.55rem 0 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ppv__open::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    background: var(--color-dark);
    border-radius: 50%;
  }

  /* ── Bio ──────────────────────────────────────────────── */
  .ppv__bio {
    margin: 2rem 0 0;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-dark);
    white-space: pre-line;
  }

  /* ── Meta rows ────────────────────────────────────────── */
  .ppv__meta {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    margin-top: 2.2rem;
  }

  .ppv__row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ppv__key {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ppv__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ppv__val {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 5px 7px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    /* Square corners throughout, as on the cards. */
    border-radius: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ppv__vals--links {
    flex-direction: column;
    gap: 0.35rem;
  }

  .ppv__link {
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }
  .ppv__link:hover {
    color: var(--color-muted);
  }

  /* ── Work ─────────────────────────────────────────────── */
  .ppv__works {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3rem;
  }

  .ppv__work {
    margin: 0;
  }

  .ppv__frame {
    border: 1.5px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    overflow: hidden;
  }

  .ppv__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ppv__caption {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0.7rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .ppv__caption-line {
    color: var(--color-dark);
  }

  .ppv__desc {
    max-width: 62ch;
    white-space: pre-line;
  }

  /* The honest empty state. Every member has an empty gallery today, so this
     is the common case rather than an edge one — it has to read as an
     invitation, not as a failure. */
  .ppv__empty {
    margin: 3rem 0 0;
    padding: 2rem 1.25rem;
    border: 1.5px dashed var(--color-border);
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: center;
    color: var(--color-muted);
  }
</style>
