---
// The site had no footer until the legal pages needed somewhere to be linked
// from. Rendered by Layout.astro on every page but the fullscreen landing
// hero; not persisted across view transitions, so the hrefs are simply the
// current page's locale — no client script to keep them in step, unlike the
// navbar's.
//
// IT IS CHROME, NOT CONTENT (2026-09-10, Josh: "footer should always be at the
// bottom left on desktop and only appear when fully scrolled down"). Fixed to
// the bottom-left corner, mirroring the language toggle's bottom-right, so the
// two read as one bottom bar rather than as two unrelated fixtures. Being out
// of flow it costs the page no height; .page-wrap's 80px bottom padding is
// what keeps it off the last line of content.
// On a phone it is content after all: a stacked list below the page, always
// visible, since 2026-09-24 — see the mobile block in the styles below.
import { useTranslations } from "../i18n/utils.ts";
import type { Lang } from "../i18n/utils.ts";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === "de" ? "/de" : "";
const year = new Date().getFullYear();

// The other locale's address for THIS page — the same rule the navbar's
// persisted toggle applies client-side in updateNavLinks(), computed here at
// build because the footer is re-rendered for every page rather than carried
// across navigations.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const otherLangHref =
  lang === "de" ? path.replace(/^\/de/, "").replace(/\/+$/, "") || "/" : "/de" + path;
---

<footer class="site-footer" id="site-footer">
  {
    /* The phone's language switch (2026-09-24, Josh: "the language switch on
       mobile has to be placed underneath, so when you scroll all the way to
       the bottom, above the impressum etc."). Hidden on desktop, where the
       navbar's fixed toggle keeps its corner. The id is what Navbar's click
       listener and OnboardingForm's save-before-leaving hook look for. */
  }
  <a href={otherLangHref} class="footer-lang" id="footer-lang">
    {/* One line per branch: whitespace between the spans would render. */}
    {
      lang === "de" ? (
        <><span class="lang-tgt">EN</span><span class="lang-sep"> / </span><span class="lang-cur">DE</span></>
      ) : (
        <><span class="lang-cur">EN</span><span class="lang-sep"> / </span><span class="lang-tgt">DE</span></>
      )
    }
  </a>
  <nav class="footer-links" aria-label={t("footer.aria")}>
    <a href={`${prefix}/impressum`}>{t("footer.impressum")}</a>
    <a href={`${prefix}/contact`}>{t("footer.contact")}</a>
    <a href={`${prefix}/privacy`}>{t("footer.privacy")}</a>
  </nav>
  <span class="footer-copy">© {year} VSCN</span>
</footer>
{
  /* THE END-OF-SCROLL MARK. Empty, zero-height, and the last child of
     .page-wrap — the footer above it is fixed, so this is what actually ends
     the flow. The observer in the script watches it against .page-wrap; the
     wrap's 80px bottom padding sits BELOW it, which is why the footer fades in
     as you arrive at the end rather than after it. */
}
<div class="footer-sentinel" id="footer-sentinel" aria-hidden="true"></div>

<style>
  .site-footer {
    /* Same corner geometry as .lang-toggle in Navbar.astro, mirrored. Keep the
       two in step: they are one bar with a hole in the middle. */
    position: fixed;
    left: 30px;
    bottom: 20px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    font-family: "Archivo", sans-serif;
    /* The toggle's size, not a size of its own — at the same bottom offset a
       face that differs from the toggle's sits visibly off its line. The token
       is what keeps the two in step; see --font-size-chrome in global.css. */
    font-size: var(--font-size-chrome);
    color: var(--color-muted);

    /* Hidden until the sentinel says we are at the end. `visibility` is
       load-bearing next to `opacity`: opacity alone leaves the three links
       clickable and in the tab order while nothing is on screen. It is
       transitioned too, so it flips only after the fade has finished. */
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }

  .site-footer.is-visible {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.25s ease,
      visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer,
    .site-footer.is-visible {
      transition: none;
    }
  }

  .footer-sentinel {
    height: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer-links a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-dark);
  }

  /* Desktop keeps the navbar's fixed toggle in the bottom-right corner; this
     copy exists only for the phone layout below. Same faces as .lang-toggle in
     Navbar.astro, so the two read as one control in two places. */
  .footer-lang {
    display: none;
    text-decoration: none;
    color: var(--color-muted);
  }

  .footer-lang .lang-cur {
    color: var(--color-dark);
    font-weight: 600;
  }

  .footer-lang .lang-tgt {
    font-weight: 400;
    transition: color 0.15s;
  }

  .footer-lang:hover .lang-tgt,
  .footer-lang:focus-visible .lang-tgt {
    color: var(--color-dark);
  }

  /* A STACKED LIST ON A PHONE (2026-09-24, Josh: "move the impressum etc as a
     stacked list at the bottom. as is common with mobile versions"). The
     footer drops back into the flow: after the content, always visible, one
     link per line. Visible without the scroll gate because there is nothing
     to hide it from — it is below the content, not over it. The observer
     still toggles .is-visible; nothing on mobile reads it.
     THE LANGUAGE SWITCH HEADS IT (same day, Josh: "underneath, so when you
     scroll all the way to the bottom, above the impressum etc. think from a
     UX perspective"). A floating EN / DE on a phone sat on top of whatever
     scrolled under it and competed with Save for the bottom edge; at the end
     of the page it is where people look for it, and one tap from there. So on
     mobile the navbar's fixed toggle is hidden (Navbar.astro) and this one
     joins the footer. Every row carries block padding: each is a tap target.
     TWO COLUMNS (same day, Josh: "put the de en on the right the rest on the
     left"). The legal links and the © stack down the left; the switch stands
     alone on the right, level with the first link. It is a setting, not one
     of the links, and the right-hand side is where it has sat on desktop all
     along. A grid rather than a flex row so the switch can take row 1 of its
     own column while the list runs on down the other. */
  @media (--bp-mobile) {
    .footer-lang {
      display: block;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      padding-block: 0.4rem;
    }

    .site-footer {
      position: static;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 0.75rem 1.5rem;
      margin: 3rem 30px 0;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
      opacity: 1;
      visibility: visible;
      transition: none;
    }

    .footer-links {
      grid-column: 1;
      grid-row: 1;
      flex-direction: column;
      gap: 0;
    }

    .footer-copy {
      grid-column: 1;
    }

    .footer-links a {
      padding-block: 0.4rem;
    }
  }
</style>

<script>
  // Reveal the footer only once the bottom of .page-wrap is reached. An
  // IntersectionObserver rather than a scroll-driven animation on purpose:
  // Safari has no animation-timeline, and the Browser pane cannot drive one
  // either, so a scroll timeline would be both unsupported and unverifiable.
  //
  // A page too short to scroll has no bottom to reach, so the observer fires
  // on load and the links stand from the start — you are already at the end.
  let observer: IntersectionObserver | null = null;

  function initFooterReveal() {
    observer?.disconnect();
    observer = null;

    const footer = document.getElementById("site-footer");
    const sentinel = document.getElementById("footer-sentinel");
    // Neither exists on the fullscreen landing page, which renders no footer.
    if (!footer || !sentinel) return;

    const root = sentinel.closest<HTMLElement>(".page-wrap");
    if (!root) return;

    observer = new IntersectionObserver(
      ([entry]) => footer.classList.toggle("is-visible", entry.isIntersecting),
      { root },
    );
    observer.observe(sentinel);
  }

  // The footer is not transition:persist, so every swap brings a new element
  // and a new sentinel; the old observer is dropped in initFooterReveal above.
  document.addEventListener("astro:page-load", initFooterReveal);
</script>
