# Copy this file to .env and fill in your Firebase project values.
# Find these in: Firebase Console → Project Settings → Your Apps → SDK setup

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
# Cloudflare Turnstile site key (public) for App Check — see
# documentation/20260907-turnstile-app-check-provider.md. Unset → no App Check on
# the page. Dev uses Cloudflare's always-pass test key 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: Firebase Admin service account JSON (one line, no newlines).
# Generate in: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# GitHub rebuild dispatch — server-side only, handled by the `requestRebuild`
# Cloud Function (functions/src/index.ts). The token is a Secret Manager secret,
# NOT an env var here, and must never get a PUBLIC_ prefix (Astro would inline
# it into the client bundle):
#   npx -y firebase-tools@latest functions:secrets:set GITHUB_REBUILD_TOKEN
# Non-secret owner/repo params live in functions/.env.
