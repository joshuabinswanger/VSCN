rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /tags/{slug} {
      // Public tag registry. Readable by everyone.
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.token.email_verified == true
                            && validTag(request.resource.data);

      allow delete: if false;
    }

    match /visualNeeds/{id} {
      // Public registry of 'what do you need visuals for' options.
      allow read: if true;
      allow write: if false;
    }

    match /openTo/{id} {
      // Public registry of 'Open To' options.
      allow read: if true;
      allow write: if false;
    }

    match /publicProfiles/{uid} {
      // Public directory data only. Never store phone numbers or emails here.
      allow read: if true;

      // Verification is demanded at the moment the profile would become
      // PUBLIC, which is the moment it could carry someone else's address.
      // A member holding an explicit `active: false` draft may write freely.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validPublicProfile(request.resource.data)
                            && canPublish(request.resource.data, request.auth);

      // purgeAccount (Admin SDK) is the only path that removes an account.
      allow delete: if false;
    }

    match /users/{uid} {
      // Private owner profile data. Contains email and phone.
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && validPrivateUser(request.resource.data)
                    && serverFieldsAbsent(request.resource.data);

      allow update: if isOwner(uid)
                    && validPrivateUser(request.resource.data)
                    && serverFieldsUntouched(request.resource.data, resource.data);

      // purgeAccount (Admin SDK) is the only path that removes an account.
      allow delete: if false;
    }

    match /onboardingRequests/{uid} {
      // Private onboarding feedback. Users can only access their own request.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validOnboardingRequest(request.resource.data, request.auth);

      allow delete: if false;
    }

    match /slugs/{slug} {
      // uid behind a public URL segment. Owned by the onPublicProfileWritten
      // function; the build reads it, nothing in a browser writes it.
      allow read: if true;
      allow write: if false;
    }

    match /deletions/{uid} {
      // The purge job. Admin-visible for the queues screen; server-written.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminActions/{id} {
      // Audit log of privileged mutations. Appended by callables only.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /images/{imageId} {
      // Every image is a record here FIRST, then bytes, then `live` — so a
      // Storage object can never exist without a document pointing at it.
      // Public read: these are the public artworks; nothing private lives here.
      allow read: if true;

      // A client always creates in the `uploading` state and as its own work.
      // `curated` and `provenance` are written only by scripts (Admin SDK).
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'uploading'
                    && request.resource.data.origin == 'member'
                    && !('provenance' in request.resource.data)
                    && validImage(request.resource.data, imageId);

      // Identity fields are pinned. The owner may move status forward, edit
      // caption/description, and bump updatedAt — nothing else.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.kind == resource.data.kind
                    && request.resource.data.storagePath == resource.data.storagePath
                    && request.resource.data.origin == resource.data.origin
                    && request.resource.data.get('provenance', null) == resource.data.get('provenance', null)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validImage(request.resource.data, imageId);

      // Clients MARK (status: pendingDeletion); only the sweeper deletes.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Publishing gate. Writes are evaluated against the MERGED document, so a
// `merge: true` write that leaves `active` alone still sees its stored value
// here — a member cannot dodge the check by omitting the field on an update.
//
// The default MUST be true, and that is not a stylistic choice. Both readers
// publish on `active !== false` (membersBuild.ts and getMembers in
// firestore.ts), so a document with NO `active` key is PUBLISHED. Defaulting
// to false here would have meant an unverified member could skip the gate
// simply by never writing the field — which is what every client does today,
// so the gate would have been bypassed by default rather than by attack.
// Absent means public; only an explicit `active: false` is a draft.
function canPublish(data, auth) {
  return data.get('active', true) != true
      || auth.token.email_verified == true;
}

function validPublicProfile(data) {
  let allowedKeys = ['displayName', 'photoURL', 'photoImageId', 'photoColor', 'memberType', 'role', 'bio', 'portfolio', 'socialMedia', 'affiliation', 'location', 'languages', 'visualNeeds', 'openTo', 'primaryAudiences', 'tags', 'gallery', 'active', 'createdAt', 'updatedAt'];

  return data.keys().hasOnly(allowedKeys)
    && validPublicFields(data);
}

function validPrivateUser(data) {
  let allowedKeys = ['displayName', 'photoURL', 'photoImageId', 'photoColor', 'memberType', 'role', 'bio', 'portfolio', 'socialMedia', 'affiliation', 'location', 'languages', 'visualNeeds', 'openTo', 'primaryAudiences', 'tags', 'gallery', 'phone', 'email', 'wantsToContribute', 'onboardingComplete', 'status', 'deletionRequestedAt', 'purgeAfter', 'createdAt', 'updatedAt'];

  return data.keys().hasOnly(allowedKeys)
    && validPublicFields(data)
    && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
    && (!('wantsToContribute' in data) || data.wantsToContribute is bool)
    && (!('onboardingComplete' in data) || data.onboardingComplete is bool);
}

function validPublicFields(data) {
  return (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
    && (!('bio' in data) || (data.bio is string
                             && data.bio.size() <= 500
                             && validBioWordCount(data.bio)))
    && (!('memberType' in data) || validMemberType(data.memberType))
    && (!('role' in data) || (data.role is string && data.role.size() <= 100))
    && (!('portfolio' in data) || (data.portfolio is string && data.portfolio.size() <= 200))
    // 500, not 200: the editor now offers six link rows, and six real URLs
    // (a LinkedIn vanity path alone runs ~55 chars) overrun 200 long before
    // the sixth. The field is still ONE comma-joined string — the rows are a
    // view of it — so this cap is what actually bounds the list. Its client
    // mirror is MAX_SOCIAL_MEDIA in src/lib/links.ts; change them together.
    && (!('socialMedia' in data) || (data.socialMedia is string && data.socialMedia.size() <= 500))
    && (!('affiliation' in data) || (data.affiliation is string && data.affiliation.size() <= 150))
    && (!('location' in data) || (data.location is string && data.location.size() <= 100))
    && (!('languages' in data) || validLanguages(data.languages))
    && (!('visualNeeds' in data) || (data.visualNeeds is list && data.visualNeeds.size() <= 8))
    && (!('openTo' in data) || (data.openTo is list && data.openTo.size() <= 5))
    && (!('primaryAudiences' in data) || validPrimaryAudiences(data.primaryAudiences))
    && (!('tags' in data) || (data.tags is list && data.tags.size() <= 7))
    && (!('gallery' in data) || validGallery(data.gallery))
    // NO `projects` CHECK, AND NO 'projects' IN allowedKeys ABOVE — the
    // feature was withdrawn (2026-09-01, Josh: "drop projects for now"), so a
    // write that still carries the field is now REJECTED rather than
    // validated. That is deliberate: it is what stops a stale client from
    // quietly re-seeding a field nothing reads. Clients send
    // `projects: deleteField()` instead, which merges to an ABSENT key and so
    // passes hasOnly — the same trick the legacy `primaryAudience` cleanup
    // uses (see updateUser in src/lib/firestore.ts). Documents written before
    // the withdrawal keep their stored `projects` until their owner next
    // saves; nothing reads it in the meantime.
    && (!('active' in data) || data.active is bool)
    && (!('photoColor' in data) || (data.photoColor is string && data.photoColor.matches('#[0-9a-f]{6}')))
    && (!('photoURL' in data) || data.photoURL == '' || validStorageUrl(data.photoURL))
    && (!('photoImageId' in data) || (data.photoImageId is string && data.photoImageId.size() <= 40))
    && (!('createdAt' in data) || data.createdAt is timestamp)
    && (!('updatedAt' in data) || data.updatedAt is timestamp);
}

// One ruleset serves both Firebase projects, so both buckets must be accepted:
// a prod-only allowlist deployed to dev rejects every avatar/gallery save
// there, which breaks exactly the authenticated dev testing the rules
// deploy exists for. Rules have no notion of "current project", hence the
// explicit pair.
function validStorageUrl(url) {
  return url.matches('https://firebasestorage\\.googleapis\\.com/v0/b/vscn-39508\\.firebasestorage\\.app/.*')
      || url.matches('https://storage\\.googleapis\\.com/vscn-39508\\.firebasestorage\\.app/.*')
      || url.matches('https://firebasestorage\\.googleapis\\.com/v0/b/vscn-dev-f4b60\\.firebasestorage\\.app/.*')
      || url.matches('https://storage\\.googleapis\\.com/vscn-dev-f4b60\\.firebasestorage\\.app/.*');
}

// Keep MAX_GALLERY_IMAGES in src/lib/gallery.ts in sync with the size cap
// and the unrolled item checks below (rules cannot loop over lists).
function validGallery(value) {
  return value is list
    && value.size() <= 8
    && (value.size() < 1 || validGalleryItem(value[0]))
    && (value.size() < 2 || validGalleryItem(value[1]))
    && (value.size() < 3 || validGalleryItem(value[2]))
    && (value.size() < 4 || validGalleryItem(value[3]))
    && (value.size() < 5 || validGalleryItem(value[4]))
    && (value.size() < 6 || validGalleryItem(value[5]))
    && (value.size() < 7 || validGalleryItem(value[6]))
    && (value.size() < 8 || validGalleryItem(value[7]));
}

function validGalleryItem(item) {
  return item is map
    // 'projectId' IS GONE from this list, so a gallery array whose items still
    // carry the tag is rejected outright. The editor strips it on load
    // (sanitizeGalleryItems in src/lib/gallery.ts) precisely so that a member
    // whose images were tagged before the withdrawal can still save.
    && item.keys().hasOnly(['imageId', 'url', 'caption', 'description', 'width', 'height', 'color'])
    && (!('color' in item) || (item.color is string && item.color.matches('#[0-9a-f]{6}')))
    && item.url is string
    && validStorageUrl(item.url)
    && (!('caption' in item) || (item.caption is string && item.caption.size() <= 140))
    && (!('description' in item) || (item.description is string && item.description.size() <= 600))
    && item.imageId is string && item.imageId.size() > 0 && item.imageId.size() <= 40
    && item.width is int && item.width > 0 && item.width <= 10000
    && item.height is int && item.height > 0 && item.height <= 10000;
}

// Keep in sync with LANGUAGES in src/lib/firestore.ts.
function validLanguages(value) {
  return value is list
    && value.size() <= 4
    && (value.size() < 1 || validLanguageCode(value[0]))
    && (value.size() < 2 || validLanguageCode(value[1]))
    && (value.size() < 3 || validLanguageCode(value[2]))
    && (value.size() < 4 || validLanguageCode(value[3]));
}

function validLanguageCode(value) {
  return value is string
    && (value == 'de' || value == 'en' || value == 'fr' || value == 'it');
}

// Keep in sync with MEMBER_TYPES in src/lib/firestore.ts.
function validMemberType(value) {
  return value is string
    && (value == 'creator'
        || value == 'scientist'
        || value == 'both'
        || value == 'organization');
}

function validPrimaryAudiences(value) {
  return value is list
    && value.size() <= 4
    && (value.size() < 1 || validPrimaryAudienceValue(value[0]))
    && (value.size() < 2 || validPrimaryAudienceValue(value[1]))
    && (value.size() < 3 || validPrimaryAudienceValue(value[2]))
    && (value.size() < 4 || validPrimaryAudienceValue(value[3]));
}

function validPrimaryAudienceValue(value) {
  return value is string
    && (value == 'science'
        || value == 'public'
        || value == 'policy-makers'
        || value == 'education');
}

function validOnboardingRequest(data, auth) {
  let allowedKeys = ['userId', 'message', 'lang', 'displayName', 'createdAt', 'updatedAt'];

  return data.keys().hasOnly(allowedKeys)
    && data.userId == auth.uid
    && data.message is string
    && data.message.size() > 0
    && data.message.size() <= 1000
    && data.lang is string
    && (data.lang == 'en' || data.lang == 'de')
    && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
    && (!('createdAt' in data) || data.createdAt is timestamp)
    && (!('updatedAt' in data) || data.updatedAt is timestamp);
}

function validBioWordCount(bio) {
  // Keep this regex in sync with MAX_BIO_WORDS in src/lib/validation.ts.
  return bio.size() == 0 || bio.matches('^\\s*\\S+(\\s+\\S+){0,34}\\s*$');
}

// Keep in sync with ImageDoc in functions/src/types.ts and src/lib/images.ts.
// The storagePath check binds the record to exactly one object: the document
// id IS the filename, and the owner IS the folder.
function validImage(data, imageId) {
  return data.keys().hasOnly(['ownerUid', 'kind', 'storagePath', 'width', 'height', 'color',
                              'caption', 'description', 'origin', 'provenance', 'status',
                              'createdAt', 'updatedAt'])
    && data.ownerUid is string
    && (data.kind == 'avatar' || data.kind == 'gallery')
    && data.storagePath == 'users/' + data.ownerUid + '/' + data.kind + '/' + imageId + '.webp'
    && data.width is int && data.width > 0 && data.width <= 10000
    && data.height is int && data.height > 0 && data.height <= 10000
    && (!('color' in data) || (data.color is string && data.color.matches('#[0-9a-f]{6}')))
    && (!('caption' in data) || (data.caption is string && data.caption.size() <= 140))
    && (!('description' in data) || (data.description is string && data.description.size() <= 600))
    && (data.origin == 'member' || data.origin == 'curated')
    && (data.status == 'uploading' || data.status == 'live' || data.status == 'pendingDeletion')
    && data.createdAt is timestamp
    && data.updatedAt is timestamp;
}

function validTag(data) {
  return data.label is string
    && data.label.size() > 0
    && data.label.size() <= 50
    && data.createdAt is timestamp
    && data.createdBy is string
    && (!('active' in data) || data.active is bool)
    && (!('group' in data) || data.group is string)
    && (!('updatedAt' in data) || data.updatedAt is timestamp);
}

function isAdmin() {
  return request.auth != null && request.auth.token.admin == true;
}

function isOwner(uid) {
  return request.auth != null && request.auth.uid == uid;
}

// Lifecycle fields on users/{uid} are written ONLY by Cloud Functions. They
// sit in the client allowlist purely because hasOnly() sees the MERGED
// document — a member's ordinary save would otherwise be rejected the moment
// a function had stamped `status` on their doc. Pinned unchanged instead.
// `email` is the same story: syncEmail (Cloud Function) mirrors it from the
// auth token, so a client is never the one writing it.
function serverFieldsAbsent(data) {
  return !('status' in data)
      && !('deletionRequestedAt' in data)
      && !('purgeAfter' in data)
      && !('email' in data);
}

function serverFieldsUntouched(data, existing) {
  return data.get('status', null) == existing.get('status', null)
      && data.get('deletionRequestedAt', null) == existing.get('deletionRequestedAt', null)
      && data.get('purgeAfter', null) == existing.get('purgeAfter', null)
      && data.get('email', null) == existing.get('email', null);
}
