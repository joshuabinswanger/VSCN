rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{filename} {
      // Anyone can read avatars (needed to display them in the community page)
      allow read: if true;

      // Owner-only writes. Unique immutable names: {uid}-{timestamp}.webp,
      // always WebP because the client re-encodes before upload.
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '-[0-9]+\\.webp')
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType == 'image/webp';

      // Delete must also match legacy fixed-path names ({uid}.{ext}) so members
      // can still replace/remove avatars uploaded before this change.
      allow delete: if request.auth != null
                    && (filename.matches(request.auth.uid + '-[0-9]+\\.webp')
                        || filename.matches(request.auth.uid + '\\.[a-zA-Z]+'));
    }

    match /galleries/{uid}/{filename} {
      // Anyone can read gallery images (displayed on the public community page)
      allow read: if true;

      // Only the owner can upload into their own gallery folder.
      // The image count is enforced via the gallery array in firestore.rules.
      //
      // THE CEILING MOVES WITH MAX_EDGE (2026-09-02). It was 2 MB, sized for
      // the 2000px WebP the client used to produce; compressGalleryImage() now
      // caps the longest edge at 4000px, which is four times the pixels and
      // lands photographic work in the 2-4 MB range. Left at 2 MB, every upload
      // of a decent-sized artwork would have been rejected HERE, and a Storage
      // rule rejection surfaces as an opaque permission error that says nothing
      // about size — the same class of silent failure as the hasOnly trap in
      // firestore.rules. 8 MB has headroom over the worst 4K WebP without
      // becoming a place to park originals.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 8 * 1024 * 1024
                   && request.resource.contentType == 'image/webp';

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Reject everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
