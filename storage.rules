rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Only the server promotes validated bytes here. Public pages use these
    // stable paths; direct member writes are forbidden, including overwrites.
    match /users/{uid}/{kind}/{filename} {
      allow read: if kind == 'avatar' || kind == 'gallery';
      allow write: if false;
    }

    // Browser uploads are private until completeImageUpload validates the
    // exact object generation and copies it to users/.
    match /pending/{uid}/{kind}/{filename} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && (kind == 'avatar' || kind == 'gallery')
                   && (filename == uid + '-' + kind + '.webp'
                       || (request.auth.token.email_verified == true
                           && filename.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.webp')))
                   && request.resource.contentType == 'image/webp'
                   && hasUploadPermit(uid, kind, filename)
                   && ((kind == 'avatar' && request.resource.size <= 2 * 1024 * 1024)
                       || (kind == 'gallery' && request.resource.size <= 8 * 1024 * 1024));
    }

    function hasUploadPermit(uid, kind, filename) {
      let permit = firestore.get(/databases/(default)/documents/uploadPermits/$(filename)).data;
      let image = firestore.get(/databases/(default)/documents/images/$(permit.imageId)).data;
      return permit.ownerUid == uid && permit.kind == kind
        && permit.imageId + '.webp' == filename
        && permit.uploadPath == 'pending/' + uid + '/' + kind + '/' + filename
        && permit.storagePath == 'users/' + uid + '/' + kind + '/' + filename
        && permit.expiresAt > request.time
        && image.ownerUid == uid && image.kind == kind
        && image.storagePath == permit.storagePath && image.status == 'uploading';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
