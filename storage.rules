rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /avatars/{filename} {
      // Anyone can read avatars (needed to display them in the community page)
      allow read: if true;

      // Only authenticated users can write their own avatar.
      // The filename must be {uid}.{ext} — enforced by matching the uid segment
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '\\.[a-zA-Z]+')
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Only the owner can delete their own avatar
      allow delete: if request.auth != null
                    && filename.matches(request.auth.uid + '\\.[a-zA-Z]+');
    }

    match /galleries/{uid}/{filename} {
      // Anyone can read gallery images (displayed on the public community page)
      allow read: if true;

      // Only the owner can upload into their own gallery folder.
      // The image count is enforced via the gallery array in firestore.rules.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Reject everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
